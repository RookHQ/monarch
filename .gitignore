node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
.DS_Store
.env
.env.*
reports/
.worktrees/
apps/docs/test-results/
playwright-report/

# Visual baselines are Linux-only (CI). Local macOS runs write here; never commit them.
apps/docs/tests/__screenshots__/**/*-darwin.png

# Copied from the root LICENSE and NOTICE at pack time (scripts/copy-license.mjs).
packages/*/LICENSE
packages/*/NOTICE

# Figma Code Connect output and the private node map (monarch figma-connect)
figma/*.figma.tsx
figma/map.json

# Native platforms (platforms/android, platforms/ios)
platforms/**/.gradle/
platforms/**/build/
platforms/**/local.properties
platforms/**/.build/
platforms/**/.swiftpm/
platforms/**/xcuserdata/
platforms/**/DerivedData/
platforms/**/*.xcodeproj/
platforms/**/.kotlin/
# SwiftPM state of the generated root Package.swift (swift package describe/resolve at the root).
/.build/
/.swiftpm/

# Review sheet build output (scripts/review-sheet)
platforms/review-sheet/

# Scratch output of platforms/ios/Scripts/build-previews.sh pilots (the project it generates is ignored above)
platforms/ios/.preview-scratch/
