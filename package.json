{
  "name": "monarch",
  "private": true,
  "description": "Rook Monarch: the design authority for every Rook application.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "packages/conformance",
    "apps/docs"
  ],
  "scripts": {
    "build": "npm run build -w @rookcom/monarch-tokens && npm run build -w @rookcom/monarch-react && npm run build -w @rookcom/monarch-conformance",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise packages --config .dependency-cruiser.cjs",
    "registry:validate": "node packages/conformance/dist/cli.js registry validate --registry registry",
    "registry:components": "tsx scripts/registry/build-components.mjs",
    "registry:components:check": "tsx scripts/registry/build-components.mjs --check",
    "docs:generate": "tsx scripts/registry/build-docs.mjs",
    "docs:generate:check": "tsx scripts/registry/build-docs.mjs --check",
    "components:check": "tsx packages/react/scripts/check-components.ts",
    "visual:budget": "node scripts/visual/check-baseline-budget.mjs",
    "new:component": "tsx packages/react/scripts/new-component.ts",
    "verify": "npm run format:check && npm run lint && npm run build && npm run typecheck && npm run deps:check && npm run components:check && npm run visual:budget && npm test && npm run registry:validate && npm run registry:components:check && npm run docs:generate:check",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-compatibility.mjs && prettier --write registry/compatibility.json",
    "release": "npm run verify && changeset publish",
    "build:docs": "npm run build -w @rookcom/monarch-docs",
    "test:visual": "playwright test --project visual",
    "test:a11y": "playwright test --project a11y-chromium --project a11y-firefox --project a11y-webkit",
    "test:visual:update": "playwright test --project visual --update-snapshots"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.10.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
