{
  "name": "monarch",
  "private": true,
  "description": "Monarch: an open-source design system for everyone who builds.",
  "license": "Apache-2.0",
  "author": "Rook Platforms (https://rookhq.com)",
  "homepage": "https://monarchui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RookHQ/monarch.git"
  },
  "bugs": {
    "url": "https://github.com/RookHQ/monarch/issues"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "packages/conformance",
    "apps/docs"
  ],
  "scripts": {
    "build": "npm run build -w @rookcom/monarch-tokens && npm run build -w @rookcom/monarch-react && npm run build -w @rookcom/monarch-conformance",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise packages --config .dependency-cruiser.cjs",
    "registry:validate": "node packages/conformance/dist/cli.js registry validate --registry registry",
    "registry:components": "tsx --tsconfig packages/react/tsconfig.json scripts/registry/build-components.mjs",
    "registry:components:check": "tsx --tsconfig packages/react/tsconfig.json scripts/registry/build-components.mjs --check",
    "registry:entry-styles": "node scripts/registry/build-entry-styles.mjs",
    "registry:conformance": "node scripts/registry/build-conformance-data.mjs",
    "registry:conformance:check": "node scripts/registry/build-conformance-data.mjs --check",
    "docs:generate": "tsx --tsconfig packages/react/tsconfig.json scripts/registry/build-docs.mjs",
    "docs:generate:check": "tsx --tsconfig packages/react/tsconfig.json scripts/registry/build-docs.mjs --check",
    "components:check": "tsx --tsconfig packages/react/tsconfig.json packages/react/scripts/check-components.ts",
    "visual:budget": "node scripts/visual/check-baseline-budget.mjs",
    "size:check": "tsx --tsconfig packages/react/tsconfig.json scripts/size/check.ts",
    "new:component": "tsx packages/react/scripts/new-component.ts",
    "verify": "npm run format:check && npm run legal:check && npm run lint && npm run build && npm run size:check && npm run typecheck && npm run deps:check && npm run components:check && npm run visual:budget && npm test && npm run registry:validate && npm run registry:components:check && npm run registry:conformance:check && npm run docs:generate:check && npm run contrast:check && npm run native:tokens:check && npm run native:brand:check && npm run native:package:check && npm run native:version:check && npm run native:components:check && npm run native:status:check && npm run native:fixtures:check && npm run native:glyphs:check && npm run native:parity:check && npm run build:docs && npm run docs:budget && npm run docs:links && npm run docs:csp && npm run docs:seo",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-compatibility.mjs && node scripts/native/sync-version.mjs && prettier --write registry/compatibility.json templates/starters/*/package.json",
    "release": "npm run verify && changeset publish",
    "build:docs": "npm run build -w @rookcom/monarch-docs",
    "docs:budget": "node scripts/docs/check-performance-budget.mjs",
    "docs:links": "node scripts/docs/check-links.mjs",
    "docs:csp": "node scripts/docs/check-csp.mjs",
    "docs:seo": "node scripts/docs/check-seo.mjs",
    "docs:og": "node scripts/docs/render-og.mjs",
    "test:visual": "playwright test --project visual",
    "test:a11y": "playwright test --project a11y-chromium --project a11y-firefox --project a11y-webkit",
    "test:devices": "playwright test --project devices",
    "test:visual:update": "playwright test --project visual --update-snapshots",
    "contrast": "tsx scripts/tokens/contrast-matrix.ts",
    "contrast:check": "tsx scripts/tokens/contrast-matrix.ts --check",
    "native:tokens": "tsx packages/tokens/scripts/emit-native.ts",
    "native:tokens:check": "tsx packages/tokens/scripts/emit-native.ts --check",
    "legal:check": "node scripts/legal/check.mjs",
    "native:brand": "tsx packages/tokens/scripts/emit-brand-vectors.ts",
    "native:brand:check": "tsx packages/tokens/scripts/emit-brand-vectors.ts --check",
    "native:package": "node scripts/native/emit-root-package.mjs",
    "native:package:check": "node scripts/native/emit-root-package.mjs --check",
    "native:version": "node scripts/native/sync-version.mjs",
    "native:version:check": "node scripts/native/sync-version.mjs --check",
    "native:components": "node scripts/native/components-report.mjs",
    "native:components:check": "node scripts/native/components-report.mjs --check",
    "native:status:check": "node scripts/native/status-check.mjs",
    "native:fixtures": "node scripts/native/fixtures.mjs",
    "native:fixtures:check": "node scripts/native/fixtures.mjs --check",
    "native:glyphs": "node scripts/native/glyphs.mjs",
    "native:glyphs:check": "node scripts/native/glyphs.mjs --check",
    "native:parity:check": "node scripts/native/parity-lint.mjs",
    "review-sheet": "node scripts/review-sheet/build.mjs",
    "review-sheet:test": "node --test scripts/review-sheet/build.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.1",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
