<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest of the unit tests (C-052). supportsRtl lets the windows that
  Compose opens for dialogs, sheets and menus lay out right to left in a test
  that sets an RTL layout direction or the ldrtl qualifier, as they do in an
  app that supports RTL. Without it Android keeps every window left to right.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:supportsRtl="true" />
</manifest>
