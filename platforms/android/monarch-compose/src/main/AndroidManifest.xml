<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Merged into the app's manifest. MonarchAiSystemSpeechRecognizer asks the system whether a
      speech recognition service exists; from Android 11 that service is only visible to an app
      that declares the query. The library declares no permission: an app that uses voice input
      declares android.permission.RECORD_AUDIO itself.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

</manifest>
