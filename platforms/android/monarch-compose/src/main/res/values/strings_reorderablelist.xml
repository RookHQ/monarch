<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the drag handle of a row of a MonarchReorderableList. %1$s is the item's label. -->
    <string name="monarch_reorderablelist_handle">Reorder %1$s</string>
    <!-- Spoken name of the move up button of a row of a MonarchReorderableList. %1$s is the item's label. -->
    <string name="monarch_reorderablelist_move_up">Move %1$s up</string>
    <!-- Spoken name of the move down button of a row of a MonarchReorderableList. %1$s is the item's label. -->
    <string name="monarch_reorderablelist_move_down">Move %1$s down</string>
    <!-- Visible text of the move up button of a row of a MonarchReorderableList. -->
    <string name="monarch_reorderablelist_up">Up</string>
    <!-- Visible text of the move down button of a row of a MonarchReorderableList. -->
    <string name="monarch_reorderablelist_down">Down</string>
    <!-- Announced when a drag starts in a MonarchReorderableList: the item's label (1), its position (2) and the number of items (3). -->
    <string name="monarch_reorderablelist_picked_up">Picked up %1$s. Position %2$d of %3$d.</string>
    <!-- Announced after a move by an action or a button in a MonarchReorderableList: label (1), new position (2), number of items (3). -->
    <string name="monarch_reorderablelist_moved">%1$s moved to position %2$d of %3$d.</string>
    <!-- Announced when a drag ends in a MonarchReorderableList: label (1), position (2), number of items (3). -->
    <string name="monarch_reorderablelist_dropped">%1$s dropped at position %2$d of %3$d.</string>
    <!-- Announced when a drag is cancelled in a MonarchReorderableList: label (1), position (2), number of items (3). -->
    <string name="monarch_reorderablelist_cancelled">Reorder cancelled. %1$s returned to position %2$d of %3$d.</string>
</resources>
