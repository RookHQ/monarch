<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Placeholder of an empty MonarchDurationInput. Shows the format the field reads; the unit letters are read in English. -->
    <string name="monarch_durationinput_placeholder">e.g. 1h 30m</string>
    <!-- Error of a MonarchDurationInput when the text cannot be read as a duration. -->
    <string name="monarch_durationinput_invalid">Use a duration like 1h 30m, 90m or 1.5h.</string>
    <!-- Error of a MonarchDurationInput outside both bounds. %1$s is the shortest and %2$s the longest allowed duration, already formatted. -->
    <string name="monarch_durationinput_between">Enter between %1$s and %2$s.</string>
    <!-- Error of a MonarchDurationInput shorter than allowed. %1$s is the shortest allowed duration, already formatted. -->
    <string name="monarch_durationinput_at_least">Enter at least %1$s.</string>
    <!-- Error of a MonarchDurationInput longer than allowed. %1$s is the longest allowed duration, already formatted. -->
    <string name="monarch_durationinput_at_most">Enter at most %1$s.</string>
    <!-- Spoken name of the + button of a MonarchDurationInput, and of the increase action of its field. -->
    <string name="monarch_durationinput_increment">Increase</string>
    <!-- Spoken name of the − button of a MonarchDurationInput, and of the decrease action of its field. -->
    <string name="monarch_durationinput_decrement">Decrease</string>
</resources>
