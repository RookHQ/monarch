<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button of a MonarchCalendarToolbar that moves to the range containing today. -->
    <string name="monarch_calendartoolbar_today">Today</string>
    <!-- TalkBack name of the previous arrow of a MonarchCalendarToolbar. %1$s is the unit, such as "week". -->
    <string name="monarch_calendartoolbar_previous">Previous %1$s</string>
    <!-- TalkBack name of the next arrow of a MonarchCalendarToolbar. %1$s is the unit, such as "week". -->
    <string name="monarch_calendartoolbar_next">Next %1$s</string>
    <!-- TalkBack name of the view switcher of a MonarchCalendarToolbar. -->
    <string name="monarch_calendartoolbar_view">Calendar view</string>
    <!-- Name of the day view in the switcher of a MonarchCalendarToolbar. -->
    <string name="monarch_calendartoolbar_view_day">Day</string>
    <!-- Name of the week view in the switcher of a MonarchCalendarToolbar. -->
    <string name="monarch_calendartoolbar_view_week">Week</string>
    <!-- Name of the month view in the switcher of a MonarchCalendarToolbar. -->
    <string name="monarch_calendartoolbar_view_month">Month</string>
    <!-- Name of the agenda view in the switcher of a MonarchCalendarToolbar. -->
    <string name="monarch_calendartoolbar_view_agenda">Agenda</string>
    <!-- Unit of the day view, in the arrow names "Previous day" and "Next day". -->
    <string name="monarch_calendartoolbar_unit_day">day</string>
    <!-- Unit of the week view, in the arrow names "Previous week" and "Next week". -->
    <string name="monarch_calendartoolbar_unit_week">week</string>
    <!-- Unit of the month view, in the arrow names "Previous month" and "Next month". -->
    <string name="monarch_calendartoolbar_unit_month">month</string>
    <!-- Unit of the agenda view, in the arrow names "Previous period" and "Next period". -->
    <string name="monarch_calendartoolbar_unit_agenda">period</string>
    <!-- TalkBack name of the busy indicator after the title of a MonarchCalendarToolbar. -->
    <string name="monarch_calendartoolbar_loading">Loading</string>
</resources>
