<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deprecated (D7): the monarch_inlineerrorretry_tone_* keys are aliases of the shared
         monarch_internal_tone_* names, which are the default. They still work as app overrides and
         are removed no earlier than 2027-02-13 (90-day window, two patch releases). Override the shared
         names, or pass toneLabel, instead. -->
    <!-- Read by TalkBack before the message of a MonarchInlineErrorRetry in the info tone. -->
    <string name="monarch_inlineerrorretry_tone_info">@string/monarch_internal_tone_info</string>
    <!-- Read by TalkBack before the message of a MonarchInlineErrorRetry in the success tone. -->
    <string name="monarch_inlineerrorretry_tone_success">@string/monarch_internal_tone_success</string>
    <!-- Read by TalkBack before the message of a MonarchInlineErrorRetry in the warning tone. -->
    <string name="monarch_inlineerrorretry_tone_warning">@string/monarch_internal_tone_warning</string>
    <!-- Read by TalkBack before the message of a MonarchInlineErrorRetry in the danger tone. -->
    <string name="monarch_inlineerrorretry_tone_danger">@string/monarch_internal_tone_danger</string>
    <!-- Label of the retry button of a MonarchInlineErrorRetry. -->
    <string name="monarch_inlineerrorretry_retry">Try again</string>
    <!-- State of the retry button of a MonarchInlineErrorRetry while the retry runs. Read by TalkBack. -->
    <string name="monarch_inlineerrorretry_retrying">Retrying</string>
</resources>
