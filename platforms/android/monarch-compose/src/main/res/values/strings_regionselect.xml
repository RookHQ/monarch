<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The label of a MonarchRegionSelect field for a country without its own word for its regions. -->
    <string name="monarch_regionselect_label">Region</string>
    <!-- The label of a MonarchRegionSelect field for the United States. -->
    <string name="monarch_regionselect_label_us">State</string>
    <!-- The label of a MonarchRegionSelect field for Canada. -->
    <string name="monarch_regionselect_label_ca">Province or territory</string>
    <!-- The label of a MonarchRegionSelect field for Australia. -->
    <string name="monarch_regionselect_label_au">State or territory</string>
    <!-- The label of a MonarchRegionSelect field for the United Kingdom. -->
    <string name="monarch_regionselect_label_gb">Nation</string>
    <!-- The label of a MonarchRegionSelect field for India. -->
    <string name="monarch_regionselect_label_in">State or union territory</string>
    <!-- Shown under a disabled MonarchRegionSelect field while no country is chosen. -->
    <string name="monarch_regionselect_choose_country_first">Choose a country first</string>
