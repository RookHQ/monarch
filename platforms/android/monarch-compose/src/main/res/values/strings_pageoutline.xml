<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchPageOutline: the title and the spoken name of the outline. -->
    <string name="monarch_pageoutline_title">On this page</string>
    <!-- MonarchPageOutline: shown when the document has no headings. -->
    <string name="monarch_pageoutline_empty">Headings you add appear here.</string>
    <!-- MonarchPageOutline: the state TalkBack reads on the heading of the section being read. -->
    <string name="monarch_pageoutline_current">Current section</string>
    <!-- MonarchPageOutline: the word count in the stats line; %s is the formatted number. -->
    <plurals name="monarch_pageoutline_words">
        <item quantity="one">%s word</item>
        <item quantity="other">%s words</item>
    </plurals>
    <!-- MonarchPageOutline: the reading time in the stats line; %d is the number of minutes. -->
    <plurals name="monarch_pageoutline_minutes">
        <item quantity="one">%d min read</item>
        <item quantity="other">%d min read</item>
    </plurals>
    <!-- MonarchPageOutline: the stats line, the word count then the reading time. -->
    <string name="monarch_pageoutline_stats">%1$s · %2$s</string>
</resources>
