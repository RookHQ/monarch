<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the list of a MonarchMentionPicker, read by TalkBack. -->
    <string name="monarch_mentionpicker_label">Suggestions</string>
    <!-- Heading of the people in a MonarchMentionPicker when channels are also shown. -->
    <string name="monarch_mentionpicker_people">People</string>
    <!-- Heading of the channels in a MonarchMentionPicker when people are also shown. -->
    <string name="monarch_mentionpicker_channels">Channels</string>
    <!-- Shown and announced by a MonarchMentionPicker while the search runs. -->
    <string name="monarch_mentionpicker_loading">Searching…</string>
    <!-- Shown and announced by a MonarchMentionPicker when nothing matches. -->
    <string name="monarch_mentionpicker_empty">No matches</string>
    <!-- Shown and announced by a MonarchMentionPicker when the search failed. -->
    <string name="monarch_mentionpicker_error">Couldn’t load suggestions.</string>
    <!-- Announced by a MonarchMentionPicker when suggestions arrive. %1$d is the number of suggestions. -->
    <plurals name="monarch_mentionpicker_count">
        <item quantity="one">%1$d suggestion</item>
        <item quantity="other">%1$d suggestions</item>
    </plurals>
</resources>
