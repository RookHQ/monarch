<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiMessage: read by TalkBack before an assistant message. -->
    <string name="monarch_aimessage_assistant_said">Assistant said:</string>
    <!-- MonarchAiMessage: read by TalkBack before the person's own message. -->
    <string name="monarch_aimessage_you_said">You said:</string>
    <!-- MonarchAiMessage: read by TalkBack before a system or tool message. -->
    <string name="monarch_aimessage_system_said">System message:</string>
    <!-- MonarchAiMessage: the name in the header when the message has no agent. -->
    <string name="monarch_aimessage_assistant">Assistant</string>
    <!-- MonarchAiMessage: the notice under a reply cut short by the output limit. -->
    <string name="monarch_aimessage_finish_length">This answer was cut short because it reached the length limit.</string>
    <!-- MonarchAiMessage: the notice under a reply stopped by a safety filter. -->
    <string name="monarch_aimessage_finish_content_filter">This answer was stopped by a safety filter.</string>
    <!-- MonarchAiMessage: the notice under a reply the model declined to give. -->
    <string name="monarch_aimessage_finish_refusal">The assistant declined to answer this.</string>
    <!-- MonarchAiMessage: shown on a message written while offline that has not been sent yet. -->
    <string name="monarch_aimessage_queued">Queued. It will send when you are back online.</string>
    <!-- MonarchAiMessage: the button that removes a queued message before it is sent. -->
    <string name="monarch_aimessage_cancel_queued">Cancel</string>
    <!-- MonarchAiMessage: the button on an error that picks up a reply whose connection dropped. -->
    <string name="monarch_aimessage_resume">Resume</string>
</resources>
