<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of the filter tabs of a MonarchPreviewRows. -->
    <string name="monarch_previewrows_filter">Show rows</string>
    <!-- Tab of a MonarchPreviewRows that shows every row. -->
    <string name="monarch_previewrows_all">All</string>
    <!-- Status of a row of a MonarchPreviewRows that will be imported as it is. In badges and tabs. -->
    <string name="monarch_previewrows_ready">Ready</string>
    <!-- Status of a row of a MonarchPreviewRows imported with warnings. In badges, tabs and before warnings. -->
    <string name="monarch_previewrows_warning">Warning</string>
    <!-- Status of a row of a MonarchPreviewRows skipped for errors. In badges, tabs and before errors. -->
    <string name="monarch_previewrows_error">Error</string>
    <!-- Status of a row of a MonarchPreviewRows that matches an existing record. In badges and tabs. -->
    <string name="monarch_previewrows_duplicate">Duplicate</string>
    <!-- Heading of one row of a MonarchPreviewRows: the number of the row in the file. -->
    <string name="monarch_previewrows_row">Row %1$d</string>
    <!-- How TalkBack reads the heading of a row of a MonarchPreviewRows: the heading, then the status. -->
    <string name="monarch_previewrows_row_spoken">%1$s, %2$s</string>
    <!-- Title of a MonarchPreviewRows when the file has no data rows. -->
    <string name="monarch_previewrows_empty_title">No rows to preview</string>
    <!-- Message of a MonarchPreviewRows when the file has no data rows. -->
    <string name="monarch_previewrows_empty_message">The file has a header row but no data rows.</string>
    <!-- Title of a MonarchPreviewRows when the chosen filter matches no row. -->
    <string name="monarch_previewrows_filtered_title">No rows with this result</string>
    <!-- Read by TalkBack for a missing value of a MonarchPreviewRows, which is shown as a dash. -->
    <string name="monarch_previewrows_no_value">No value</string>
    <!-- How a MonarchPreviewRows reads a problem: the status, then the problem. -->
    <string name="monarch_previewrows_issue_spoken">%1$s: %2$s</string>
    <!-- How a MonarchPreviewRows writes a problem tied to a field: the field, then the message. -->
    <string name="monarch_previewrows_issue_field">%1$s: %2$s</string>
    <!-- The dash shown for a missing value of a MonarchPreviewRows. -->
    <string name="monarch_previewrows_dash" translatable="false">—</string>
    <!-- Caption before the outcome badge of each row of a MonarchPreviewRows. -->
    <string name="monarch_previewrows_result">Result</string>
    <!-- Caption before the problems of each row of a MonarchPreviewRows. -->
    <string name="monarch_previewrows_issues">Issues</string>
</resources>
