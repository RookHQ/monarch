<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchFieldRenderer: the message of a required question without an answer. -->
    <string name="monarch_fieldrenderer_required">This field is required.</string>
    <!-- MonarchFieldRenderer: the message of a required consent that is not ticked. -->
    <string name="monarch_fieldrenderer_must_agree">Tick this to continue.</string>
    <!-- MonarchFieldRenderer: the message of text that is not an email address. -->
    <string name="monarch_fieldrenderer_email">Enter an email address, like name@example.com.</string>
    <!-- MonarchFieldRenderer: the message of text that is not a web address. -->
    <string name="monarch_fieldrenderer_url">Enter a web address, like https://example.com.</string>
    <!-- MonarchFieldRenderer: the message of an answer that is not a number. -->
    <string name="monarch_fieldrenderer_number">Enter a number.</string>
    <!-- MonarchFieldRenderer: the message of a number below the minimum. %1$s is the minimum, formatted. -->
    <string name="monarch_fieldrenderer_min">Enter %1$s or more.</string>
    <!-- MonarchFieldRenderer: the message of a number above the maximum. %1$s is the maximum, formatted. -->
    <string name="monarch_fieldrenderer_max">Enter %1$s or less.</string>
    <!-- MonarchFieldRenderer: the message of text shorter than the minimum. %1$d is the fewest characters. -->
    <plurals name="monarch_fieldrenderer_min_length">
        <item quantity="one">Use at least %1$d character.</item>
        <item quantity="other">Use at least %1$d characters.</item>
    </plurals>
    <!-- MonarchFieldRenderer: the message of text longer than the maximum. %1$d is the most characters. -->
    <plurals name="monarch_fieldrenderer_max_length">
        <item quantity="one">Use %1$d character or fewer.</item>
        <item quantity="other">Use %1$d characters or fewer.</item>
    </plurals>
    <!-- MonarchFieldRenderer: the message of fewer options than the minimum. %1$d is the fewest. -->
    <string name="monarch_fieldrenderer_min_selections">Choose at least %1$d.</string>
    <!-- MonarchFieldRenderer: the message of more options than the maximum. %1$d is the most. -->
    <string name="monarch_fieldrenderer_max_selections">Choose %1$d or fewer.</string>
    <!-- MonarchFieldRenderer: the yes option of a yes-or-no question. -->
    <string name="monarch_fieldrenderer_yes">Yes</string>
    <!-- MonarchFieldRenderer: the no option of a yes-or-no question. -->
    <string name="monarch_fieldrenderer_no">No</string>
    <!-- MonarchFieldRenderer: the placeholder of a menu while nothing is chosen. -->
    <string name="monarch_fieldrenderer_choose">Choose…</string>
    <!-- MonarchFieldRenderer: the button of a date question without an answer. -->
    <string name="monarch_fieldrenderer_choose_date">Choose a date</string>
    <!-- MonarchFieldRenderer: the button of a time question without an answer. -->
    <string name="monarch_fieldrenderer_choose_time">Choose a time</string>
    <!-- MonarchFieldRenderer: the confirm button of the date and time dialogs. -->
    <string name="monarch_fieldrenderer_confirm">OK</string>
    <!-- MonarchFieldRenderer: the dismiss button of the date and time dialogs. -->
    <string name="monarch_fieldrenderer_cancel">Cancel</string>
    <!-- MonarchFieldRenderer: the note on an answer filled automatically with enough confidence. -->
    <string name="monarch_fieldrenderer_ai_filled">Filled in automatically. Check it is right.</string>
    <!-- MonarchFieldRenderer: the note on an answer filled automatically with low confidence. -->
    <string name="monarch_fieldrenderer_ai_check">Filled in automatically, but unsure. Please check.</string>
    <!-- MonarchFieldRenderer: the visible text of the button that removes a chosen file. -->
    <string name="monarch_fieldrenderer_remove">Remove</string>
    <!-- MonarchFieldRenderer: the TalkBack name of a file's remove button. %1$s is the file name. -->
    <string name="monarch_fieldrenderer_remove_file">Remove %1$s</string>
</resources>
