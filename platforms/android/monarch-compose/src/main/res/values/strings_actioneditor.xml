<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchActionEditor: the TalkBack name of the list of actions. -->
    <string name="monarch_actioneditor_label">Actions</string>
    <!-- MonarchActionEditor: the heading of one action. %1$d is its position, from 1. -->
    <string name="monarch_actioneditor_action">Action %1$d</string>
    <!-- MonarchActionEditor: the label of the menu that picks the kind of action. -->
    <string name="monarch_actioneditor_type">Action</string>
    <!-- MonarchActionEditor: the visible text of the button that removes an action. -->
    <string name="monarch_actioneditor_remove">Remove</string>
    <!-- MonarchActionEditor: the TalkBack name of the remove button. %1$d is the action's position. -->
    <string name="monarch_actioneditor_remove_item">Remove action %1$d</string>
    <!-- MonarchActionEditor: the visible text of the button that moves an action one place earlier. -->
    <string name="monarch_actioneditor_move_up">Move up</string>
    <!-- MonarchActionEditor: the visible text of the button that moves an action one place later. -->
    <string name="monarch_actioneditor_move_down">Move down</string>
    <!-- MonarchActionEditor: the TalkBack name of the move up button. %1$d is the action's position. -->
    <string name="monarch_actioneditor_move_up_item">Move up: action %1$d</string>
    <!-- MonarchActionEditor: the TalkBack name of the move down button. %1$d is the action's position. -->
    <string name="monarch_actioneditor_move_down_item">Move down: action %1$d</string>
    <!-- MonarchActionEditor: announced after a move. %1$s is the action's type, %2$d its new position, %3$d the count. -->
    <string name="monarch_actioneditor_moved">%1$s moved to position %2$d of %3$d.</string>
    <!-- MonarchActionEditor: the button that adds an action. -->
    <string name="monarch_actioneditor_add">Add action</string>
    <!-- MonarchActionEditor: shown when there are no actions. -->
    <string name="monarch_actioneditor_empty">No actions yet.</string>
    <!-- MonarchActionEditor: the empty choice of an optional menu, and the placeholder of menus. -->
    <string name="monarch_actioneditor_choose">Choose…</string>
    <!-- MonarchActionEditor: the error of an empty required parameter. %1$s is the parameter's label. -->
    <string name="monarch_actioneditor_required">Fill in “%1$s”.</string>
    <!-- MonarchActionEditor: the error of a number that is not a number or is out of range. %1$s is the parameter's label. -->
    <string name="monarch_actioneditor_out_of_range">Enter an allowed number for “%1$s”.</string>
    <!-- MonarchActionEditor: a stored type the list no longer has. %1$s is the stored key. -->
    <string name="monarch_actioneditor_unknown_type">%1$s (not available)</string>
    <!-- MonarchActionEditor: the warning on an action whose type is disabled. -->
    <string name="monarch_actioneditor_unavailable">This action cannot run right now.</string>
    <!-- MonarchActionEditor: shown instead of the add button at the limit. %1$d is the most actions. -->
    <plurals name="monarch_actioneditor_max_reached">
        <item quantity="one">You can add up to %1$d action.</item>
        <item quantity="other">You can add up to %1$d actions.</item>
    </plurals>
</resources>
