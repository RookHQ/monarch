<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of a saved card in MonarchPaymentMethodCard. %1$s is the network, %2$s the last four digits. -->
    <string name="monarch_paymentmethodcard_name">%1$s ending in %2$s</string>
    <!-- Expiry line of a valid card in MonarchPaymentMethodCard. %1$s is the date as MM/YY. -->
    <string name="monarch_paymentmethodcard_expires">Expires %1$s</string>
    <!-- Expiry line of an expired card in MonarchPaymentMethodCard. %1$s is the date as MM/YY. -->
    <string name="monarch_paymentmethodcard_expired_on">Expired %1$s</string>
    <!-- Badge of the default payment method in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_default_badge">Default</string>
    <!-- Badge of a card that expires this month or next in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_expiring_badge">Expires soon</string>
    <!-- Badge of an expired card in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_expired_badge">Expired</string>
    <!-- Button that makes the card the default in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_make_default">Make default</string>
    <!-- Button that removes the card in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_remove">Remove</string>
    <!-- What TalkBack reads for an action of MonarchPaymentMethodCard. %1$s is the action, %2$s the card's name. -->
    <string name="monarch_paymentmethodcard_action_label">%1$s, %2$s</string>
    <!-- Title of the removal confirmation of MonarchPaymentMethodCard. %1$s is the card's name. -->
    <string name="monarch_paymentmethodcard_remove_title">Remove %1$s?</string>
    <!-- Message of the removal confirmation of MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_remove_message">It will no longer be charged. To use it again, add it as a new payment method.</string>
    <!-- Confirming button of the removal confirmation of MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_remove_confirm">Remove card</string>
    <!-- Cancelling button of the removal confirmation of MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_cancel">Cancel</string>
    <!-- Shown and announced by MonarchPaymentMethodCard when making the card the default or removing it fails. -->
    <string name="monarch_paymentmethodcard_failed">That did not work. Try again.</string>
    <!-- Display name of the Visa network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_visa">Visa</string>
    <!-- Display name of the Mastercard network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_mastercard">Mastercard</string>
    <!-- Display name of the American Express network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_amex">American Express</string>
    <!-- Display name of the RuPay network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_rupay">RuPay</string>
    <!-- Display name of the Discover network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_discover">Discover</string>
    <!-- Display name of the Diners Club network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_diners">Diners Club</string>
    <!-- Display name of the JCB network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_jcb">JCB</string>
    <!-- Display name of the UnionPay network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_unionpay">UnionPay</string>
    <!-- Display name of the Maestro network in MonarchPaymentMethodCard. -->
    <string name="monarch_paymentmethodcard_brand_maestro">Maestro</string>
</resources>
