<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchScopeSelector: the heading and TalkBack name of the whole selector. -->
    <string name="monarch_scopeselector_label">Scopes</string>
    <!-- MonarchScopeSelector: shown when there are no groups. -->
    <string name="monarch_scopeselector_empty">There are no scopes to choose from.</string>
    <!-- MonarchScopeSelector: the summary of a group while its scopes load. -->
    <string name="monarch_scopeselector_loading">Loading scopes…</string>
    <!-- MonarchScopeSelector: the summary of a group that offers no scopes. -->
    <string name="monarch_scopeselector_no_scopes">No scopes available.</string>
    <!-- MonarchScopeSelector: the summary of a group. %1$d is the number selected, %2$d the number of scopes. -->
    <plurals name="monarch_scopeselector_count">
        <item quantity="one">%1$d of %2$d scope</item>
        <item quantity="other">%1$d of %2$d scopes</item>
    </plurals>
    <!-- MonarchScopeSelector: the button that selects every scope of a group. -->
    <string name="monarch_scopeselector_select_all">Select all</string>
    <!-- MonarchScopeSelector: the button that clears every scope of a group. -->
    <string name="monarch_scopeselector_clear_all">Clear all</string>
    <!-- MonarchScopeSelector: the TalkBack name of Select all. %1$s is the group's name. -->
    <string name="monarch_scopeselector_select_all_in">Select all in %1$s</string>
    <!-- MonarchScopeSelector: the TalkBack name of Clear all. %1$s is the group's name. -->
    <string name="monarch_scopeselector_clear_all_in">Clear all in %1$s</string>
    <!-- MonarchScopeSelector: the paging button. %1$d is how many it shows, %2$d how many are hidden. -->
    <plurals name="monarch_scopeselector_show_more">
        <item quantity="one">Show %1$d more of %2$d</item>
        <item quantity="other">Show %1$d more of %2$d</item>
    </plurals>
</resources>
