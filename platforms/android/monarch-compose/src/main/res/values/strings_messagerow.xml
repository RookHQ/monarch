<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown under a MonarchMessageRow that is still sending. -->
    <string name="monarch_messagerow_sending">Sending…</string>
    <!-- Shown under a MonarchMessageRow that failed to send, when the app gives no error message. -->
    <string name="monarch_messagerow_failed">Not sent</string>
    <!-- Button that sends a failed MonarchMessageRow again. -->
    <string name="monarch_messagerow_retry">Retry</string>
    <!-- Button that throws away a failed MonarchMessageRow. -->
    <string name="monarch_messagerow_discard">Discard</string>
    <!-- Marker after the body of an edited MonarchMessageRow. -->
    <string name="monarch_messagerow_edited">(edited)</string>
    <!-- What TalkBack reads for the edited marker of a MonarchMessageRow when it opens the edit history. -->
    <string name="monarch_messagerow_edit_history">Edited. Show edit history</string>
    <!-- Body of a deleted MonarchMessageRow. -->
    <string name="monarch_messagerow_deleted">This message was deleted.</string>
    <!-- Thread reply count of a MonarchMessageRow. %1$d is the number of replies. -->
    <plurals name="monarch_messagerow_replies">
        <item quantity="one">%1$d reply</item>
        <item quantity="other">%1$d replies</item>
    </plurals>
    <!-- What a long press on a MonarchMessageRow does; TalkBack reads it as the action. -->
    <string name="monarch_messagerow_actions">Message actions</string>
    <!-- Goes between the author, the tags and the date in what TalkBack reads for a MonarchMessageRow. -->
    <string name="monarch_messagerow_separator">", "</string>
</resources>
