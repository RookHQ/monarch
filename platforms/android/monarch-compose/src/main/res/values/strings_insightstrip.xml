<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button of a MonarchInsightStrip that shows the insights beyond its limit. %d is how many are hidden. -->
    <plurals name="monarch_insightstrip_show_more">
        <item quantity="one">Show %d more</item>
        <item quantity="other">Show %d more</item>
    </plurals>
    <!-- Button of a MonarchInsightStrip that hides the insights beyond its limit again. -->
    <string name="monarch_insightstrip_show_less">Show fewer</string>
    <!-- Shown by a MonarchInsightStrip that has no insights. -->
    <string name="monarch_insightstrip_empty">Nothing needs attention right now.</string>
    <!-- What TalkBack reads for the placeholder cards of a MonarchInsightStrip while it loads. -->
    <string name="monarch_insightstrip_loading">Loading insights</string>
    <!-- Button of a MonarchInsightStrip that loads the insights again after an error. -->
    <string name="monarch_insightstrip_retry">Try again</string>
    <!-- Button on an insight of a MonarchInsightStrip that removes it. -->
    <string name="monarch_insightstrip_dismiss">Dismiss</string>
    <!-- Header of the section of an insight that shows the evidence behind it. -->
    <string name="monarch_insightstrip_evidence">Show evidence</string>
    <!-- Badge on an insight of a MonarchInsightStrip that a fixed rule raised. -->
    <string name="monarch_insightstrip_origin_rule">Rule-based</string>
    <!-- Badge on an insight of a MonarchInsightStrip that a model raised. -->
    <string name="monarch_insightstrip_origin_ai">AI insight</string>
    <!-- The badge words below differ from the shared tone names on purpose: they are the visible severity
         words of the web AiInsightCallout (Info, Positive, Warning, Critical). Not deprecated. -->
    <!-- Badge on an insight with the neutral tone. -->
    <string name="monarch_insightstrip_tone_neutral">Note</string>
    <!-- Badge on an insight with the info tone. -->
    <string name="monarch_insightstrip_tone_info">Info</string>
    <!-- Badge on an insight with the success tone. -->
    <string name="monarch_insightstrip_tone_success">Positive</string>
    <!-- Badge on an insight with the warning tone. -->
    <string name="monarch_insightstrip_tone_warning">Warning</string>
    <!-- Badge on an insight with the danger tone. -->
    <string name="monarch_insightstrip_tone_danger">Critical</string>
</resources>
