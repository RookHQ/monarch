    <string name="monarch_embeddedappframe_error_title">This page didn’t open</string>
    <!-- MonarchEmbeddedAppFrame, the explanation under the error title. -->
    <string name="monarch_embeddedappframe_error_description">The app didn’t respond in time. It may be briefly unavailable. Try again, or open the page directly.</string>
    <!-- MonarchEmbeddedAppFrame, the button that loads the page again. -->
    <string name="monarch_embeddedappframe_retry">Try again</string>
    <!-- MonarchEmbeddedAppFrame, the button that opens the page outside the frame. -->
    <string name="monarch_embeddedappframe_open">Open the page</string>
</resources>
