<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchForceGraph, the button that zooms in. -->
    <string name="monarch_forcegraph_zoom_in">Zoom in</string>
    <!-- MonarchForceGraph, the button that zooms out. -->
    <string name="monarch_forcegraph_zoom_out">Zoom out</string>
    <!-- MonarchForceGraph, the button that undoes zoom, pan and moved nodes. -->
    <string name="monarch_forcegraph_reset_view">Reset view</string>
    <!-- MonarchForceGraph, the table heading of the node column. -->
    <string name="monarch_forcegraph_node">Node</string>
    <!-- MonarchForceGraph, the table heading of the group column. -->
    <string name="monarch_forcegraph_group">Group</string>
    <!-- MonarchForceGraph, the table heading of the linked nodes. -->
    <string name="monarch_forcegraph_connections">Connections</string>
    <!-- MonarchForceGraph, the group of a node without one. -->
    <string name="monarch_forcegraph_no_group">No group</string>
    <!-- MonarchForceGraph, the spoken name of the legend of link kinds. -->
    <string name="monarch_forcegraph_edge_legend">Link types</string>
    <!-- MonarchForceGraph, the number of nodes in the summary read by TalkBack. -->
    <plurals name="monarch_forcegraph_node_count">
        <item quantity="one">%1$d node</item>
        <item quantity="other">%1$d nodes</item>
    </plurals>
    <!-- MonarchForceGraph, the number of links in the summary. -->
    <plurals name="monarch_forcegraph_link_count">
        <item quantity="one">%1$d link</item>
        <item quantity="other">%1$d links</item>
    </plurals>
    <!-- MonarchForceGraph, the number of groups in the summary. -->
    <plurals name="monarch_forcegraph_group_count">
        <item quantity="one">%1$d group</item>
        <item quantity="other">%1$d groups</item>
    </plurals>
    <!-- MonarchForceGraph, the number of a node's links, read for the node and shown in its details. -->
    <plurals name="monarch_forcegraph_connection_count">
        <item quantity="one">%1$d connection</item>
        <item quantity="other">%1$d connections</item>
    </plurals>
    <!-- MonarchForceGraph, the first sentence of the summary. %1$s the nodes, %2$s the links. -->
    <string name="monarch_forcegraph_size">%1$s and %2$s</string>
    <!-- MonarchForceGraph, the first sentence with the groups. %1$s the size sentence, %2$s the groups. -->
    <string name="monarch_forcegraph_in_groups">%1$s in %2$s</string>
    <!-- MonarchForceGraph, a sentence of the summary. %1$s the node, %2$s its number of links. -->
    <string name="monarch_forcegraph_most_connected">Most connected: %1$s (%2$s)</string>
    <!-- MonarchForceGraph, read for a node without links. %1$s label, %2$s group, %3$s the connections. -->
    <string name="monarch_forcegraph_describe">%1$s, %2$s. %3$s</string>
    <!-- MonarchForceGraph, read for a linked node. %1$s label, %2$s group, %3$s the connections, %4$s the linked nodes. -->
    <string name="monarch_forcegraph_describe_linked">%1$s, %2$s. %3$s: %4$s</string>
    <!-- MonarchForceGraph, a linked node with the kind of the link. %1$s the node, %2$s the kind. -->
    <string name="monarch_forcegraph_link_with_kind">%1$s (%2$s)</string>
</resources>
