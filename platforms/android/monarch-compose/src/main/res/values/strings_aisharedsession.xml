    <string name="monarch_aisharedsession_speaking_one">%1$s is speaking</string>
    <!-- MonarchAiSharedSession: several people speaking. -->
    <string name="monarch_aisharedsession_speaking_many">%1$s are speaking</string>
    <!-- MonarchAiSharedSession: one person reviewing. -->
    <string name="monarch_aisharedsession_reviewing_one">%1$s is reviewing</string>
    <!-- MonarchAiSharedSession: several people reviewing. -->
    <string name="monarch_aisharedsession_reviewing_many">%1$s are reviewing</string>
