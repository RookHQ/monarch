<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchStackedProportionBar, shown under an empty track when every value is 0 or there are no parts. -->
    <string name="monarch_stackedproportionbar_empty">No data yet</string>
    <!-- MonarchStackedProportionBar, the value and the share after a legend label: "1,204 · 34%". -->
    <string name="monarch_stackedproportionbar_value_and_share">%1$s · %2$s</string>
    <!-- MonarchStackedProportionBar, one part as TalkBack reads it: "Replied 182 · 9%". %1$s name, %2$s value and share. -->
    <string name="monarch_stackedproportionbar_entry">%1$s %2$s</string>
    <!-- MonarchStackedProportionBar, a share too small to round to the smallest step: "<1%". %1$s is the step. -->
    <string name="monarch_stackedproportionbar_share_below">&lt;%1$s</string>
    <!-- MonarchStackedProportionBar, a share just under the whole: ">99%". %1$s is the whole less one step. -->
    <string name="monarch_stackedproportionbar_share_above">&gt;%1$s</string>
</resources>
