<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchUnsavedChangesGuard: the title of the dialog. -->
    <string name="monarch_unsavedchangesguard_title">Discard unsaved changes?</string>
    <!-- MonarchUnsavedChangesGuard: the message of the dialog. -->
    <string name="monarch_unsavedchangesguard_message">Your changes have not been saved. If you leave now, they will be lost.</string>
    <!-- MonarchUnsavedChangesGuard: the safe choice, which closes the dialog and stays on the screen. -->
    <string name="monarch_unsavedchangesguard_keep_editing">Keep editing</string>
    <!-- MonarchUnsavedChangesGuard: the destructive choice, which leaves without saving. -->
    <string name="monarch_unsavedchangesguard_discard">Discard changes</string>
    <!-- MonarchUnsavedChangesGuard: the choice that saves, then leaves. -->
    <string name="monarch_unsavedchangesguard_save">Save and leave</string>
    <!-- MonarchUnsavedChangesGuard: shown and announced in the dialog when the save failed. -->
    <string name="monarch_unsavedchangesguard_save_failed">Your changes could not be saved. Try again.</string>
</resources>
