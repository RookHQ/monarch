<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The name TalkBack reads for a MonarchAvailabilityToggle. -->
    <string name="monarch_availabilitytoggle_label">Available for new work</string>
    <!-- Visible status word of a MonarchAvailabilityToggle while the person is available; also its spoken state. -->
    <string name="monarch_availabilitytoggle_available">Available</string>
    <!-- Visible status word of a MonarchAvailabilityToggle while the person is away; also its spoken state. -->
    <string name="monarch_availabilitytoggle_away">Away</string>
    <!-- Hint under the status word of a MonarchAvailabilityToggle while available, shown with showHint. -->
    <string name="monarch_availabilitytoggle_available_hint">Automatic assignment can give you new work.</string>
    <!-- Hint under the status word of a MonarchAvailabilityToggle while away, shown with showHint. -->
    <string name="monarch_availabilitytoggle_away_hint">Automatic assignment skips you. You can still work on what you have.</string>
    <!-- What TalkBack adds to the state of a MonarchAvailabilityToggle while a change is saved. -->
    <string name="monarch_availabilitytoggle_pending">Saving</string>
    <!-- Spoken state of a MonarchAvailabilityToggle while saving. %1$s is the status word, %2$s the saving word. -->
    <string name="monarch_availabilitytoggle_spoken_pending">%1$s, %2$s</string>
</resources>
