<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by MonarchStatCard in place of a missing value: an em dash. -->
    <string name="monarch_statcard_dash">—</string>
    <!-- What TalkBack reads for a missing value in MonarchStatCard. -->
    <string name="monarch_statcard_empty">No data</string>
    <!-- The state TalkBack reads while the value of a MonarchStatCard loads. -->
    <string name="monarch_statcard_loading">Loading</string>
    <!-- The name of the help button of a MonarchStatCard. %1$s is the card's label, such as Revenue. -->
    <string name="monarch_statcard_help">About %1$s</string>
</resources>
