<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiPromptTemplatePicker: the heading of the gallery. -->
    <string name="monarch_aiprompttemplatepicker_title">Prompt templates</string>
    <!-- MonarchAiPromptTemplatePicker: the placeholder of the search field. -->
    <string name="monarch_aiprompttemplatepicker_search">Search templates</string>
    <!-- MonarchAiPromptTemplatePicker: the category filter that shows every category. -->
    <string name="monarch_aiprompttemplatepicker_all_categories">All</string>
    <!-- MonarchAiPromptTemplatePicker: the heading of a template's text when it has no blanks. -->
    <string name="monarch_aiprompttemplatepicker_template">Template</string>
    <!-- MonarchAiPromptTemplatePicker: the heading of the filled prompt. -->
    <string name="monarch_aiprompttemplatepicker_preview">Prompt preview</string>
    <!-- MonarchAiPromptTemplatePicker: the button that hands the filled prompt to the app. -->
    <string name="monarch_aiprompttemplatepicker_use">Use template</string>
    <!-- MonarchAiPromptTemplatePicker: the button that closes the picker. -->
    <string name="monarch_aiprompttemplatepicker_cancel">Cancel</string>
    <!-- MonarchAiPromptTemplatePicker: the button that goes back from a template to the gallery. -->
    <string name="monarch_aiprompttemplatepicker_back">All templates</string>
    <!-- MonarchAiPromptTemplatePicker: added after the label of a field that may stay empty. -->
    <string name="monarch_aiprompttemplatepicker_optional">Optional</string>
    <!-- MonarchAiPromptTemplatePicker: the error of an empty required field; %1$s is its label in lower case. -->
    <string name="monarch_aiprompttemplatepicker_missing">Enter %1$s.</string>
    <!-- MonarchAiPromptTemplatePicker: the title when there are no templates. -->
    <string name="monarch_aiprompttemplatepicker_empty">No templates yet</string>
    <!-- MonarchAiPromptTemplatePicker: the title when the search finds nothing; %1$s is the query. -->
    <string name="monarch_aiprompttemplatepicker_no_results">No templates match “%1$s”</string>
    <!-- MonarchAiPromptTemplatePicker: the button under the gallery that opens the chosen template. -->
    <string name="monarch_aiprompttemplatepicker_continue">Continue</string>
    <!-- MonarchAiPromptTemplatePicker: the hint under the gallery while no template is chosen. -->
    <string name="monarch_aiprompttemplatepicker_choose">Choose a template to continue.</string>
</resources>
