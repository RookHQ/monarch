<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of the stage strip of a MonarchStageJourney. -->
    <string name="monarch_stagejourney_stages">Stages</string>
    <!-- Title of the current-stage card. %1$s is the stage, such as "Examination". -->
    <string name="monarch_stagejourney_now">Now: %1$s</string>
    <!-- How long the item has been in the stage. %1$s is a relative time, such as "3 days ago". -->
    <string name="monarch_stagejourney_since">since %1$s</string>
    <!-- State of a finished stage, read by TalkBack. -->
    <string name="monarch_stagejourney_done">done</string>
    <!-- State of the current stage, read by TalkBack. -->
    <string name="monarch_stagejourney_current">current stage</string>
    <!-- Outcome of a journey that ended well, read with the current stage. -->
    <string name="monarch_stagejourney_success">Completed</string>
    <!-- Outcome of a journey that ended early, read with the current stage. -->
    <string name="monarch_stagejourney_closed">Closed</string>
    <!-- Heading above the move buttons of a MonarchStageJourney. -->
    <string name="monarch_stagejourney_next_steps">Next steps</string>
    <!-- TalkBack name of a forward or exit move. %1$s is the target stage. -->
    <string name="monarch_stagejourney_move_to">Move to %1$s</string>
    <!-- Text of a back move. %1$s is the earlier stage. -->
    <string name="monarch_stagejourney_back_to">Back to %1$s</string>
    <!-- Added to the TalkBack name of a move that opens a form. -->
    <string name="monarch_stagejourney_needs_input">asks for details</string>
    <!-- Announced when the current stage changes. %1$s is the new stage. -->
    <string name="monarch_stagejourney_moved">Moved to %1$s</string>
    <!-- Shown when a move fails without a message of its own. -->
    <string name="monarch_stagejourney_failed">The move did not go through. Try again.</string>
    <!-- First entry of a MonarchStageHistory. %1$s is the first stage. -->
    <string name="monarch_stagejourney_history_started">Started at %1$s</string>
    <!-- Word TalkBack reads between two stages in a MonarchStageHistory entry. -->
    <string name="monarch_stagejourney_history_to">to</string>
    <!-- Marker of a move back to an earlier stage in a MonarchStageHistory. -->
    <string name="monarch_stagejourney_history_moved_back">(moved back)</string>
    <!-- Shown when a MonarchStageHistory has no entries. -->
    <string name="monarch_stagejourney_history_empty">No stage moves yet.</string>
</resources>
