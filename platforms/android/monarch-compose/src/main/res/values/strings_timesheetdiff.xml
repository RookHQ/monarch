<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchTimesheetDiff. -->
    <string name="monarch_timesheetdiff_title">What changed</string>
    <!-- Kind of an entry added in the new version of a timesheet, shown in a badge. -->
    <string name="monarch_timesheetdiff_added">Added</string>
    <!-- Kind of an entry removed from the new version of a timesheet, shown in a badge. -->
    <string name="monarch_timesheetdiff_removed">Removed</string>
    <!-- Kind of an entry changed between two versions of a timesheet. %1$s is the list of changed fields, such as "time, project". -->
    <string name="monarch_timesheetdiff_changed">Changed %1$s</string>
    <!-- Name of the date field in "Changed date". -->
    <string name="monarch_timesheetdiff_field_date">date</string>
    <!-- Name of the minutes field in "Changed time". -->
    <string name="monarch_timesheetdiff_field_minutes">time</string>
    <!-- Name of the project field in "Changed project". -->
    <string name="monarch_timesheetdiff_field_project">project</string>
    <!-- Name of the activity field in "Changed activity". -->
    <string name="monarch_timesheetdiff_field_activity">activity</string>
    <!-- Name of the task field in "Changed task". -->
    <string name="monarch_timesheetdiff_field_task">task</string>
    <!-- Name of the billable field in "Changed billable". -->
    <string name="monarch_timesheetdiff_field_billable">billable</string>
    <!-- Name of the note field in "Changed note". -->
    <string name="monarch_timesheetdiff_field_note">note</string>
    <!-- Name of a start time field in "Changed start". -->
    <string name="monarch_timesheetdiff_field_start">start</string>
    <!-- Name of an end time field in "Changed end". -->
    <string name="monarch_timesheetdiff_field_end">end</string>
    <!-- Read by TalkBack before the old line of a changed entry. -->
    <string name="monarch_timesheetdiff_before">Before</string>
    <!-- Read by TalkBack before the new line of a changed entry. -->
    <string name="monarch_timesheetdiff_after">After</string>
    <!-- Shown in an entry line when the entry has no project. -->
    <string name="monarch_timesheetdiff_no_project">No project</string>
    <!-- Shown in an entry line when the time is not billable. -->
    <string name="monarch_timesheetdiff_non_billable">non-billable</string>
    <!-- Shown when two versions of a timesheet are the same. -->
    <string name="monarch_timesheetdiff_no_changes">No changes.</string>
    <!-- The totals line. %1$s is the change of the total time, such as "+1h 30m". -->
    <string name="monarch_timesheetdiff_totals">Total %1$s</string>
    <!-- The totals line with billable time. %1$s is the change of the total, %2$s of the billable time. -->
    <string name="monarch_timesheetdiff_totals_billable">Total %1$s · billable %2$s</string>
    <!-- Read by TalkBack for time gained. %1$s is a duration in words, such as "1 hour, 30 minutes". -->
    <string name="monarch_timesheetdiff_plus">plus %1$s</string>
    <!-- Read by TalkBack for time lost. %1$s is a duration in words, such as "45 minutes". -->
    <string name="monarch_timesheetdiff_minus">minus %1$s</string>
</resources>
