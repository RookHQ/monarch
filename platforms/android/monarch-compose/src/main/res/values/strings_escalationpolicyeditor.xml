<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchEscalationPolicyEditor: the TalkBack name of the list of levels. -->
    <string name="monarch_escalationpolicyeditor_label">Escalation levels</string>
    <!-- MonarchEscalationPolicyEditor: the heading of one level. %1$d is its position, from 1. -->
    <string name="monarch_escalationpolicyeditor_level">Level %1$d</string>
    <!-- MonarchEscalationPolicyEditor: the label of the field with the time before a level fires. -->
    <string name="monarch_escalationpolicyeditor_after">After</string>
    <!-- MonarchEscalationPolicyEditor: the label of the picker of the targets a level notifies. -->
    <string name="monarch_escalationpolicyeditor_notify">Notify</string>
    <!-- MonarchEscalationPolicyEditor: the line under each heading. %1$s is the duration, such as 15m; %2$s the names notified. -->
    <string name="monarch_escalationpolicyeditor_summary">After %1$s, notify %2$s</string>
    <!-- MonarchEscalationPolicyEditor: the names in the summary while a level notifies nobody. -->
    <string name="monarch_escalationpolicyeditor_nobody">nobody yet</string>
    <!-- MonarchEscalationPolicyEditor: the visible text of the button that removes a level, without an icon. -->
    <string name="monarch_escalationpolicyeditor_remove">Remove</string>
    <!-- MonarchEscalationPolicyEditor: the TalkBack name of the remove button. %1$d is the level's position. -->
    <string name="monarch_escalationpolicyeditor_remove_level">Remove level %1$d</string>
    <!-- MonarchEscalationPolicyEditor: the button that adds a level. -->
    <string name="monarch_escalationpolicyeditor_add">Add level</string>
    <!-- MonarchEscalationPolicyEditor: the warning shown when the app supplies nothing to notify. -->
    <string name="monarch_escalationpolicyeditor_no_targets">There is nothing to notify yet. Add a channel or a person first, or this policy cannot reach anyone.</string>
    <!-- MonarchEscalationPolicyEditor: the error of a level that notifies nobody. -->
    <string name="monarch_escalationpolicyeditor_targets_problem">Choose at least one target. A level that notifies nobody does nothing.</string>
    <!-- MonarchEscalationPolicyEditor: the error of a level that is not later than the one before. -->
    <string name="monarch_escalationpolicyeditor_order_problem">This level must come later than the one before it.</string>
    <!-- MonarchEscalationPolicyEditor: shown instead of the add button at the limit. %1$d is the limit. -->
    <plurals name="monarch_escalationpolicyeditor_max_reached">
        <item quantity="one">A policy can have up to %1$d level.</item>
        <item quantity="other">A policy can have up to %1$d levels.</item>
    </plurals>
</resources>
