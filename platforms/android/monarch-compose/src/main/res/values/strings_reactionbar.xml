<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of a MonarchReactionBar. -->
    <string name="monarch_reactionbar_label">Reactions</string>
    <!-- Spoken name of a chip of a MonarchReactionBar: the emoji's name (1) and the number of reactions (2). -->
    <plurals name="monarch_reactionbar_reaction">
        <item quantity="one">%1$s, %2$d reaction</item>
        <item quantity="other">%1$s, %2$d reactions</item>
    </plurals>
    <!-- Read after a chip's name in a MonarchReactionBar: who reacted (1), such as "Ana and Ben". -->
    <string name="monarch_reactionbar_reacted_by">Reacted by %1$s</string>
    <!-- Spoken name of the add button of a MonarchReactionBar. -->
    <string name="monarch_reactionbar_add">Add reaction</string>
    <!-- Visible text of the add button of a MonarchReactionBar when the app gives no icon. -->
    <string name="monarch_reactionbar_add_text">+</string>
</resources>
