<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default heading of MonarchAiSuggestedActions. -->
    <string name="monarch_aisuggestedactions_title">Suggested actions</string>
    <!-- Origin label of MonarchAiSuggestedActions when a model suggested the actions. -->
    <string name="monarch_aisuggestedactions_origin_ai">Suggested by AI</string>
    <!-- Origin label of MonarchAiSuggestedActions when fixed rules suggested the actions. -->
    <string name="monarch_aisuggestedactions_origin_rule">Rule-based</string>
    <!-- Button of a suggested action that runs it. -->
    <string name="monarch_aisuggestedactions_run">Run</string>
    <!-- What TalkBack reads for the Run button of a suggested action. %1$s is the action, such as "Send the reminder". -->
    <string name="monarch_aisuggestedactions_run_action">Run %1$s</string>
    <!-- What the Run button of a suggested action reads while the action runs. -->
    <string name="monarch_aisuggestedactions_running">Running…</string>
    <!-- Shown in place of the Run button once a suggested action finished. -->
    <string name="monarch_aisuggestedactions_done">Done</string>
    <!-- Shown under a suggested action whose run failed, and in the approval dialog. -->
    <string name="monarch_aisuggestedactions_failed">That didn’t work. Try again.</string>
    <!-- Name of the button that dismisses a suggested action. %1$s is the action. -->
    <string name="monarch_aisuggestedactions_dismiss">Dismiss “%1$s”</string>
    <!-- Text of the button that dismisses a suggested action, when the app gives no icon. -->
    <string name="monarch_aisuggestedactions_dismiss_text">Dismiss</string>
    <!-- Tag of a suggested action that asks for approval before it runs. -->
    <string name="monarch_aisuggestedactions_needs_approval">Needs approval</string>
    <!-- Tag of a suggested action with a medium risk. -->
    <string name="monarch_aisuggestedactions_risk_medium">Medium risk</string>
    <!-- Tag of a suggested action with a high risk. -->
    <string name="monarch_aisuggestedactions_risk_high">High risk</string>
    <!-- Tag of a suggested action that cannot be undone. -->
    <string name="monarch_aisuggestedactions_risk_destructive">Destructive</string>
    <!-- Title of the dialog that asks to approve a suggested action. %1$s is the action. -->
    <string name="monarch_aisuggestedactions_approval_title">Run “%1$s”?</string>
    <!-- Text of the approval dialog of a suggested action without a description. -->
    <string name="monarch_aisuggestedactions_approval_description">Check what this action will do before it runs.</string>
    <!-- Confirm button of the approval dialog of a suggested action. -->
    <string name="monarch_aisuggestedactions_approve">Run action</string>
    <!-- Cancel button of the approval dialog of a suggested action. -->
    <string name="monarch_aisuggestedactions_cancel">Cancel</string>
    <!-- Announced when a suggested action finishes. %1$s is the action. -->
    <string name="monarch_aisuggestedactions_done_announcement">“%1$s” done.</string>
    <!-- Shown by MonarchAiSuggestedActions when there are no actions. -->
    <string name="monarch_aisuggestedactions_empty">No suggestions right now.</string>
</resources>
