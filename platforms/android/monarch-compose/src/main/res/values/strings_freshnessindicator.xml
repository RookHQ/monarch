<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The time of a MonarchFreshnessIndicator, with the relative time, for example "3 minutes ago". -->
    <string name="monarch_freshnessindicator_updated">Updated %1$s</string>
    <!-- Shown by a MonarchFreshnessIndicator when the data was never updated. -->
    <string name="monarch_freshnessindicator_never">Never updated</string>
    <!-- Shown by a MonarchFreshnessIndicator while the status is being read. -->
    <string name="monarch_freshnessindicator_checking">Checking…</string>
    <!-- Flag after the time of a MonarchFreshnessIndicator when the data is stale. Also announced. -->
    <string name="monarch_freshnessindicator_stale">Out of date</string>
    <!-- Flag after the time of a MonarchFreshnessIndicator when the data is expired. Also announced. -->
    <string name="monarch_freshnessindicator_expired">Very out of date</string>
    <!-- Shown by a MonarchFreshnessIndicator in the error status when the app gives no error text. -->
    <string name="monarch_freshnessindicator_error">Status unavailable</string>
    <!-- Label of the refresh button of a MonarchFreshnessIndicator. -->
    <string name="monarch_freshnessindicator_refresh">Refresh</string>
    <!-- State of the refresh button of a MonarchFreshnessIndicator while a refresh runs. Read by TalkBack. -->
    <string name="monarch_freshnessindicator_refreshing">Refreshing</string>
    <!-- Announced by a MonarchFreshnessIndicator when a refresh ends. -->
    <string name="monarch_freshnessindicator_refreshed">Refreshed.</string>
    <!-- Announced by a MonarchFreshnessIndicator when a refresh ends in the error status. -->
    <string name="monarch_freshnessindicator_refresh_failed">Refresh failed.</string>
    <!-- How TalkBack joins the parts of the line of a MonarchFreshnessIndicator, which are shown with middle dots. -->
    <string name="monarch_freshnessindicator_spoken_separator">", "</string>
</resources>
