<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchCallStage, the name of the stage when it has no title. -->
    <string name="monarch_callstage_region">Call</string>
    <!-- MonarchCallStage, the spoken name of the running call timer. -->
    <string name="monarch_callstage_duration">Call duration</string>
    <!-- MonarchCallStage, shown instead of the head count while you are the only one on the call. -->
    <string name="monarch_callstage_waiting">Waiting for others…</string>
    <!-- MonarchCallStage, the head count in the header. -->
    <plurals name="monarch_callstage_in_call">
        <item quantity="one">%1$d in call</item>
        <item quantity="other">%1$d in call</item>
    </plurals>
    <!-- MonarchCallStage, the badge while audio-only mode is on. -->
    <string name="monarch_callstage_low_data">Low data</string>
    <!-- MonarchCallStage, the warning while the connection recovers. -->
    <string name="monarch_callstage_reconnecting">You’re offline. Trying to reconnect…</string>
    <!-- MonarchCallStage, the hint shown when the app detects speech while the microphone is off. -->
    <string name="monarch_callstage_muted_hint">You’re muted. Turn on your microphone to talk.</string>
    <!-- MonarchCallStage, the header button that continues the call in picture in picture. -->
    <string name="monarch_callstage_picture_in_picture">Picture in picture</string>
    <!-- MonarchCallStage, the header button that docks the stage in a corner. -->
    <string name="monarch_callstage_shrink">Shrink call</string>
    <!-- MonarchCallStage, the header button that brings the docked stage back to full size. -->
    <string name="monarch_callstage_expand">Expand call</string>
    <!-- MonarchCallStage, the header button that minimizes the docked stage. -->
    <string name="monarch_callstage_minimize">Minimize call</string>
</resources>
