<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What TalkBack reads for the masked key of a MonarchApiKeyRow. %1$s is the visible prefix, such as sk_live_4f2a. -->
    <string name="monarch_apikeyrow_prefix">Key starting with %1$s</string>
    <!-- The word before the creation time of a MonarchApiKeyRow, followed by a relative time such as 3 days ago. -->
    <string name="monarch_apikeyrow_created">Created</string>
    <!-- The word before the last use of a MonarchApiKeyRow, followed by a relative time. -->
    <string name="monarch_apikeyrow_last_used">Last used</string>
    <!-- Shown in a MonarchApiKeyRow when the key was never used. -->
    <string name="monarch_apikeyrow_never_used">Never used</string>
    <!-- The word before the expiry of a MonarchApiKeyRow, followed by a relative time such as in 5 days. -->
    <string name="monarch_apikeyrow_expires">Expires</string>
    <!-- Spoken name of the scope list of a MonarchApiKeyRow. -->
    <string name="monarch_apikeyrow_scopes">Scopes</string>
    <!-- Shown in a MonarchApiKeyRow when the key has no scopes. -->
    <string name="monarch_apikeyrow_no_scopes">No scopes</string>
    <!-- Badge of a MonarchApiKeyRow for the scopes past the limit. %1$s is their formatted number. -->
    <string name="monarch_apikeyrow_more_scopes">+%1$s</string>
    <!-- Status badge of a MonarchApiKeyRow for a working key. -->
    <string name="monarch_apikeyrow_status_active">Active</string>
    <!-- Status badge of a MonarchApiKeyRow for a key that expires soon. -->
    <string name="monarch_apikeyrow_status_expiring">Expiring soon</string>
    <!-- Status badge of a MonarchApiKeyRow for an expired key. -->
    <string name="monarch_apikeyrow_status_expired">Expired</string>
    <!-- Status badge of a MonarchApiKeyRow for a revoked key. -->
    <string name="monarch_apikeyrow_status_revoked">Revoked</string>
    <!-- Visible text of the actions button of a MonarchApiKeyRow when no icon is given. -->
    <string name="monarch_apikeyrow_menu">Actions</string>
    <!-- Spoken name of the actions button of a MonarchApiKeyRow. %1$s is the key's name. -->
    <string name="monarch_apikeyrow_actions">Actions for %1$s</string>
    <!-- Menu item of a MonarchApiKeyRow that rotates the key. -->
    <string name="monarch_apikeyrow_rotate">Rotate</string>
    <!-- Menu item of a MonarchApiKeyRow that revokes the key. -->
    <string name="monarch_apikeyrow_revoke">Revoke</string>
    <!-- Title of the rotation dialog of a MonarchApiKeyRow. %1$s is the key's name. -->
    <string name="monarch_apikeyrow_rotate_title">Rotate %1$s?</string>
    <!-- Message of the rotation dialog of a MonarchApiKeyRow. -->
    <string name="monarch_apikeyrow_rotate_message">A new key is issued and shown once. Update every place that uses this key before the old one stops working.</string>
    <!-- Confirm button of the rotation dialog of a MonarchApiKeyRow. -->
    <string name="monarch_apikeyrow_rotate_confirm">Rotate key</string>
    <!-- Title of the revocation dialog of a MonarchApiKeyRow. %1$s is the key's name. -->
    <string name="monarch_apikeyrow_revoke_title">Revoke %1$s?</string>
    <!-- Message of the revocation dialog of a MonarchApiKeyRow. -->
    <string name="monarch_apikeyrow_revoke_message">Requests that use this key will be rejected. Apps using it stop working right away. This cannot be undone.</string>
    <!-- Confirm button of the revocation dialog of a MonarchApiKeyRow. -->
    <string name="monarch_apikeyrow_revoke_confirm">Revoke key</string>
    <!-- Label of the field of the revocation dialog of a MonarchApiKeyRow where the phrase is typed. %1$s is the phrase. -->
    <string name="monarch_apikeyrow_revoke_phrase_prompt">Type %1$s to confirm</string>
    <!-- Cancel button of the dialogs of a MonarchApiKeyRow. -->
    <string name="monarch_apikeyrow_cancel">Cancel</string>
    <!-- Shown and announced by a MonarchApiKeyRow while the rotation runs. -->
    <string name="monarch_apikeyrow_rotating">Rotating…</string>
    <!-- Shown and announced by a MonarchApiKeyRow while the revocation runs. -->
    <string name="monarch_apikeyrow_revoking">Revoking…</string>
    <!-- Shown by a MonarchApiKeyRow when the rotation fails without a message. -->
    <string name="monarch_apikeyrow_rotate_failed">The key was not rotated.</string>
    <!-- Shown by a MonarchApiKeyRow when the revocation fails without a message. -->
    <string name="monarch_apikeyrow_revoke_failed">The key was not revoked.</string>
</resources>
