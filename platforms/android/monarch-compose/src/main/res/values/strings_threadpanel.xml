<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchThreadPanel. -->
    <string name="monarch_threadpanel_title">Thread</string>
    <!-- Button in the header of a MonarchThreadPanel that closes it; also offered when the thread was deleted. -->
    <string name="monarch_threadpanel_close">Close</string>
    <!-- Chip of a MonarchThreadPanel that follows the thread, while not following. -->
    <string name="monarch_threadpanel_follow">Follow</string>
    <!-- Chip of a MonarchThreadPanel that follows the thread, while following. -->
    <string name="monarch_threadpanel_following">Following</string>
    <!-- Announced after following the thread of a MonarchThreadPanel. -->
    <string name="monarch_threadpanel_followed_notice">You’ll be notified about replies</string>
    <!-- Announced after unfollowing the thread of a MonarchThreadPanel. -->
    <string name="monarch_threadpanel_unfollowed_notice">You won’t be notified about replies</string>
    <!-- Announced when following or unfollowing the thread of a MonarchThreadPanel fails. -->
    <string name="monarch_threadpanel_follow_failed">Thread notifications didn’t change. Try again.</string>
    <!-- Divider of a MonarchThreadPanel between the root message and the replies. %1$d is the number of replies. -->
    <plurals name="monarch_threadpanel_reply_count">
        <item quantity="one">%1$d reply</item>
        <item quantity="other">%1$d replies</item>
    </plurals>
    <!-- TalkBack name of the list of replies of a MonarchThreadPanel. -->
    <string name="monarch_threadpanel_replies">Replies</string>
    <!-- What TalkBack reads for the placeholders of a MonarchThreadPanel while the thread loads. -->
    <string name="monarch_threadpanel_loading">Loading thread…</string>
    <!-- Shown by a MonarchThreadPanel when the thread could not be loaded. -->
    <string name="monarch_threadpanel_error">This thread couldn’t be loaded.</string>
    <!-- Shown by a MonarchThreadPanel when the thread was deleted. -->
    <string name="monarch_threadpanel_deleted">This thread was deleted.</string>
</resources>
