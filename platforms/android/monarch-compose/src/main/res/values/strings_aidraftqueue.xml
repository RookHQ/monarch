<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiDraftQueue: the TalkBack name of the queue of AI-written drafts when it has no title. -->
    <string name="monarch_aidraftqueue_label">Drafts to review</string>
    <!-- MonarchAiDraftQueue: the progress of the review. %1$d is the number reviewed, %2$d the number of drafts. -->
    <plurals name="monarch_aidraftqueue_progress">
        <item quantity="one">%1$d of %2$d reviewed</item>
        <item quantity="other">%1$d of %2$d reviewed</item>
    </plurals>
    <!-- MonarchAiDraftQueue: shown when there are no drafts. -->
    <string name="monarch_aidraftqueue_empty">No drafts to review</string>
    <!-- MonarchAiDraftQueue: the status badge of a draft that waits for a decision. -->
    <string name="monarch_aidraftqueue_status_draft">Needs review</string>
    <!-- MonarchAiDraftQueue: the status badge of a draft that is being written again. -->
    <string name="monarch_aidraftqueue_status_regenerating">Writing</string>
    <!-- MonarchAiDraftQueue: the status badge of an approved draft. -->
    <string name="monarch_aidraftqueue_status_approved">Approved</string>
    <!-- MonarchAiDraftQueue: the status badge of a sent draft. -->
    <string name="monarch_aidraftqueue_status_sent">Sent</string>
    <!-- MonarchAiDraftQueue: the status badge of a skipped draft. -->
    <string name="monarch_aidraftqueue_status_skipped">Skipped</string>
    <!-- MonarchAiDraftQueue: shown instead of the text while a draft is being written again. -->
    <string name="monarch_aidraftqueue_writing">AI is still writing…</string>
    <!-- MonarchAiDraftQueue: read by TalkBack before the text of each draft. -->
    <string name="monarch_aidraftqueue_ai_draft">AI draft</string>
    <!-- MonarchAiDraftQueue: how TalkBack reads a draft's text. %1$s is "AI draft", %2$s the text. -->
    <string name="monarch_aidraftqueue_spoken_body">%1$s, %2$s</string>
    <!-- MonarchAiDraftQueue: the heading of what the draft answers or is based on. -->
    <string name="monarch_aidraftqueue_context">Context</string>
    <!-- MonarchAiDraftQueue: the button that approves a draft. -->
    <string name="monarch_aidraftqueue_approve">Approve</string>
    <!-- MonarchAiDraftQueue: the button that sends an approved draft. -->
    <string name="monarch_aidraftqueue_send">Send</string>
    <!-- MonarchAiDraftQueue: the button that edits a draft. -->
    <string name="monarch_aidraftqueue_edit">Edit</string>
    <!-- MonarchAiDraftQueue: the button that asks for a new version of a draft. -->
    <string name="monarch_aidraftqueue_regenerate">Regenerate</string>
    <!-- MonarchAiDraftQueue: the button that skips a draft without sending it. -->
    <string name="monarch_aidraftqueue_skip">Skip</string>
    <!-- MonarchAiDraftQueue: the button that saves an edited draft. -->
    <string name="monarch_aidraftqueue_save">Save</string>
    <!-- MonarchAiDraftQueue: the button that closes the editor without saving. -->
    <string name="monarch_aidraftqueue_cancel">Cancel</string>
    <!-- MonarchAiDraftQueue: the label of the editor. %1$s is the draft's title. -->
    <string name="monarch_aidraftqueue_edit_field">Edit draft: %1$s</string>
    <!-- MonarchAiDraftQueue: announced when a draft needs review again. %1$s is the draft's title. -->
    <string name="monarch_aidraftqueue_announce_ready">New draft ready: %1$s</string>
    <!-- MonarchAiDraftQueue: announced when a draft's status changes. %1$s is the status, %2$s the draft's title. -->
    <string name="monarch_aidraftqueue_announce">%1$s: %2$s</string>
</resources>
