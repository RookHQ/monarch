<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Send button of a MonarchMessageComposer. -->
    <string name="monarch_messagecomposer_send">Send</string>
    <!-- Send button of a MonarchMessageComposer while it edits a message. -->
    <string name="monarch_messagecomposer_save">Save</string>
    <!-- What the send button of a MonarchMessageComposer reads while the message is sending. -->
    <string name="monarch_messagecomposer_sending">Sending…</string>
    <!-- Button of a MonarchMessageComposer that stops editing a message. -->
    <string name="monarch_messagecomposer_cancel">Cancel</string>
    <!-- Button of a MonarchMessageComposer that opens the app's file or photo picker. -->
    <string name="monarch_messagecomposer_attach">Attach files</string>
    <!-- Button of a MonarchMessageComposer that opens the emoji picker. -->
    <string name="monarch_messagecomposer_emoji">Add emoji</string>
    <!-- TalkBack name of the mode buttons of a MonarchMessageComposer, such as reply or internal note. -->
    <string name="monarch_messagecomposer_modes">Message type</string>
    <!-- Context above the text of a MonarchMessageComposer that answers a message. %1$s is the author. -->
    <string name="monarch_messagecomposer_replying_to">Replying to %1$s</string>
    <!-- Button of a MonarchMessageComposer that removes the reply context. -->
    <string name="monarch_messagecomposer_dismiss_reply">Stop replying</string>
    <!-- Context above the text of a MonarchMessageComposer that edits a message. -->
    <string name="monarch_messagecomposer_editing">Editing message</string>
    <!-- What TalkBack reads for the character count of a MonarchMessageComposer. %1$d is the number left. -->
    <plurals name="monarch_messagecomposer_remaining">
        <item quantity="one">%1$d character left</item>
        <item quantity="other">%1$d characters left</item>
    </plurals>
    <!-- What TalkBack reads for the character count of a MonarchMessageComposer over its limit. %1$d is the excess. -->
    <plurals name="monarch_messagecomposer_over">
        <item quantity="one">%1$d character over the limit</item>
        <item quantity="other">%1$d characters over the limit</item>
    </plurals>
    <!-- Draft status under a MonarchMessageComposer while the draft saves. -->
    <string name="monarch_messagecomposer_draft_saving">Saving draft…</string>
    <!-- Draft status under a MonarchMessageComposer once the draft is saved. -->
    <string name="monarch_messagecomposer_draft_saved">Draft saved</string>
    <!-- Draft status under a MonarchMessageComposer when the draft could not be saved. -->
    <string name="monarch_messagecomposer_draft_error">Draft not saved</string>
</resources>
