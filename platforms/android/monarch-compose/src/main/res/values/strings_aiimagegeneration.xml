<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiImageGeneration: the TalkBack name of the group of images generated by AI. -->
    <string name="monarch_aiimagegeneration_label">AI generated images</string>
    <!-- MonarchAiImageGeneration: the status line while images are generating and the progress is unknown. -->
    <string name="monarch_aiimagegeneration_pending">Generating images…</string>
    <!-- MonarchAiImageGeneration: the status line while images are generating. %1$s is a percentage such as 40%. -->
    <string name="monarch_aiimagegeneration_pending_progress">Generating images… %1$s</string>
    <!-- MonarchAiImageGeneration: the status line while low-quality previews are refined and the progress is unknown. -->
    <string name="monarch_aiimagegeneration_progressive">Refining images…</string>
    <!-- MonarchAiImageGeneration: the status line while previews are refined. %1$s is a percentage such as 80%. -->
    <string name="monarch_aiimagegeneration_progressive_progress">Refining images… %1$s</string>
    <!-- MonarchAiImageGeneration: the status line when generation finished. %d is the number of images. -->
    <plurals name="monarch_aiimagegeneration_done">
        <item quantity="one">%d image generated</item>
        <item quantity="other">%d images generated</item>
    </plurals>
    <!-- MonarchAiImageGeneration: announced by TalkBack once when generation finishes. %d is the number of images. -->
    <plurals name="monarch_aiimagegeneration_announce_done">
        <item quantity="one">%d image generated.</item>
        <item quantity="other">%d images generated.</item>
    </plurals>
    <!-- MonarchAiImageGeneration: the message when image generation failed. -->
    <string name="monarch_aiimagegeneration_error">The images could not be generated.</string>
    <!-- MonarchAiImageGeneration: the button that starts image generation again after a failure. -->
    <string name="monarch_aiimagegeneration_retry">Try again</string>
    <!-- MonarchAiImageGeneration: read by TalkBack for an image whose alt text is still empty. %1$d is its position. -->
    <string name="monarch_aiimagegeneration_image_name">Generated image %1$d</string>
    <!-- MonarchAiImageGeneration: shown in place of an image that is missing after generation. -->
    <string name="monarch_aiimagegeneration_unavailable">Preview unavailable</string>
    <!-- MonarchAiImageGeneration: the label of the alt text field under an image. %1$d is its position. -->
    <string name="monarch_aiimagegeneration_alt_label">Alt text for image %1$d</string>
    <!-- MonarchAiImageGeneration: the error under an empty alt text field. -->
    <string name="monarch_aiimagegeneration_alt_required">Describe the image for people who cannot see it.</string>
    <!-- MonarchAiImageGeneration: the button that chooses an image. -->
    <string name="monarch_aiimagegeneration_select">Use image</string>
    <!-- MonarchAiImageGeneration: the TalkBack name of the button that chooses an image. %1$d is its position. -->
    <string name="monarch_aiimagegeneration_select_name">Use image %1$d</string>
    <!-- MonarchAiImageGeneration: the mark on the chosen image. -->
    <string name="monarch_aiimagegeneration_selected">Selected</string>
    <!-- MonarchAiImageGeneration: the button that asks for more images like one. -->
    <string name="monarch_aiimagegeneration_variations">More like this</string>
    <!-- MonarchAiImageGeneration: the TalkBack name of the button that asks for more images like one. %1$d is its position. -->
    <string name="monarch_aiimagegeneration_variations_name">More like this, image %1$d</string>
</resources>
