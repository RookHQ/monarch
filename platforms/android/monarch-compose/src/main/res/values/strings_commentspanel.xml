<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchCommentsPanel. -->
    <string name="monarch_commentspanel_title">Comments</string>
    <!-- Button in the header of a MonarchCommentsPanel that closes it. -->
    <string name="monarch_commentspanel_close">Close</string>
    <!-- Filter segment of a MonarchCommentsPanel that lists open threads. -->
    <string name="monarch_commentspanel_open">Open</string>
    <!-- Filter segment of a MonarchCommentsPanel that lists resolved threads. -->
    <string name="monarch_commentspanel_resolved">Resolved</string>
    <!-- Button of a MonarchCommentsPanel that returns from a thread to the list. -->
    <string name="monarch_commentspanel_back">All comments</string>
    <!-- What TalkBack reads for the placeholders of a MonarchCommentsPanel while the threads load. -->
    <string name="monarch_commentspanel_loading">Loading comments…</string>
    <!-- Title of a MonarchCommentsPanel without open threads. -->
    <string name="monarch_commentspanel_empty_open">No open comments</string>
    <!-- Title of a MonarchCommentsPanel without resolved threads. -->
    <string name="monarch_commentspanel_empty_resolved">No resolved comments</string>
    <!-- Text under the empty title of the open threads of a MonarchCommentsPanel. -->
    <string name="monarch_commentspanel_empty_hint">Select text to start a discussion.</string>
    <!-- Number of comments of a thread in the list of a MonarchCommentsPanel. %1$d is the number. -->
    <plurals name="monarch_commentspanel_comment_count">
        <item quantity="one">%1$d comment</item>
        <item quantity="other">%1$d comments</item>
    </plurals>
    <!-- The quote of a thread in the list of a MonarchCommentsPanel. %1$s is the quoted text. -->
    <string name="monarch_commentspanel_quote">“%1$s”</string>
    <!-- Announced after a thread of a MonarchCommentsPanel is resolved. -->
    <string name="monarch_commentspanel_resolved_notice">Thread resolved</string>
    <!-- Announced after a thread of a MonarchCommentsPanel is reopened. -->
    <string name="monarch_commentspanel_reopened_notice">Thread reopened</string>
</resources>
