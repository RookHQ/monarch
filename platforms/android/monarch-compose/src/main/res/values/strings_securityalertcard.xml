<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchSecurityAlertCard: the card title. -->
    <string name="monarch_securityalertcard_title">Security alerts</string>
    <!-- MonarchSecurityAlertCard: the line under the title. -->
    <string name="monarch_securityalertcard_description">Recent security notifications and account activity.</string>
    <!-- MonarchSecurityAlertCard: the name TalkBack reads for the list of alerts. -->
    <string name="monarch_securityalertcard_list_label">Security alerts</string>
    <!-- MonarchSecurityAlertCard: the badge of an alert of info severity. -->
    <string name="monarch_securityalertcard_severity_info">Info</string>
    <!-- MonarchSecurityAlertCard: the badge of an alert of low severity. -->
    <string name="monarch_securityalertcard_severity_low">Low</string>
    <!-- MonarchSecurityAlertCard: the badge of an alert of medium severity. -->
    <string name="monarch_securityalertcard_severity_medium">Medium</string>
    <!-- MonarchSecurityAlertCard: the badge of an alert of high severity. -->
    <string name="monarch_securityalertcard_severity_high">High</string>
    <!-- MonarchSecurityAlertCard: the badge of an alert of critical severity. -->
    <string name="monarch_securityalertcard_severity_critical">Critical</string>
    <!-- MonarchSecurityAlertCard: the state TalkBack reads for an unread alert. -->
    <string name="monarch_securityalertcard_unread">Unread</string>
    <!-- MonarchSecurityAlertCard: the header badge. %1$d is the number of unread alerts. -->
    <plurals name="monarch_securityalertcard_unread_count">
        <item quantity="one">%1$d unread</item>
        <item quantity="other">%1$d unread</item>
    </plurals>
    <!-- MonarchSecurityAlertCard: the button that marks one alert read. -->
    <string name="monarch_securityalertcard_mark_read">Mark as read</string>
    <!-- MonarchSecurityAlertCard: the button that marks every alert read. -->
    <string name="monarch_securityalertcard_mark_all_read">Mark all as read</string>
    <!-- MonarchSecurityAlertCard: the visible title of a dismiss button without an icon. -->
    <string name="monarch_securityalertcard_dismiss_title">Dismiss</string>
    <!-- MonarchSecurityAlertCard: the TalkBack name of a dismiss button. %1$s is the alert title. -->
    <string name="monarch_securityalertcard_dismiss">Dismiss %1$s</string>
    <!-- MonarchSecurityAlertCard: announced after a dismissal. %1$s is the alert title. -->
    <string name="monarch_securityalertcard_dismissed">Dismissed %1$s</string>
    <!-- MonarchSecurityAlertCard: shown and read while loading. -->
    <string name="monarch_securityalertcard_loading">Loading alerts</string>
    <!-- MonarchSecurityAlertCard: the title of the empty state. -->
    <string name="monarch_securityalertcard_empty_title">No security alerts</string>
    <!-- MonarchSecurityAlertCard: the line under the empty state. -->
    <string name="monarch_securityalertcard_empty_description">Alerts about sign-ins and account changes appear here.</string>
    <!-- MonarchSecurityAlertCard: the title of the failed state. -->
    <string name="monarch_securityalertcard_error_title">Couldn’t load security alerts</string>
</resources>
