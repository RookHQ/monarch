<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The label of the MonarchAddressAutocomplete search field and the title of its sheet. -->
    <string name="monarch_addressautocomplete_label">Address</string>
    <!-- Shown in the empty MonarchAddressAutocomplete search field and in the sheet's search field. -->
    <string name="monarch_addressautocomplete_placeholder">Start typing an address</string>
    <!-- Shown in the MonarchAddressAutocomplete sheet while suggestions load. -->
    <string name="monarch_addressautocomplete_searching">Searching…</string>
    <!-- Shown under the MonarchAddressAutocomplete field while the details of the picked address load. -->
    <string name="monarch_addressautocomplete_resolving">Getting the address details…</string>
    <!-- Shown in the MonarchAddressAutocomplete sheet when the search finds nothing. -->
    <string name="monarch_addressautocomplete_empty">No addresses found</string>
    <!-- Shown in the MonarchAddressAutocomplete sheet when the search fails. A retry button follows. -->
    <string name="monarch_addressautocomplete_search_failed">Couldn’t search addresses.</string>
    <!-- Shown under the MonarchAddressAutocomplete field when the details of the picked address could not be loaded. -->
    <string name="monarch_addressautocomplete_resolve_failed">Couldn’t get that address. Enter it manually or try another.</string>
    <!-- The MonarchAddressAutocomplete button and sheet row that open the address form. -->
    <string name="monarch_addressautocomplete_enter_manually">Enter the address manually</string>
    <!-- The MonarchAddressAutocomplete button that closes the address form. -->
    <string name="monarch_addressautocomplete_back_to_search">Search for an address</string>
    <!-- Announced after a MonarchAddressAutocomplete suggestion fills in the address form. -->
    <string name="monarch_addressautocomplete_filled">Address filled in. Check the details.</string>
    <!-- The button that closes the MonarchAddressAutocomplete sheet. -->
    <string name="monarch_addressautocomplete_cancel">Cancel</string>
    <!-- The label of the first street line of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_line1">Street address</string>
    <!-- The label of the second street line of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_line2">Apartment, suite, etc.</string>
    <!-- The label of the city field of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_city">City</string>
    <!-- The label of the region field of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_region">State or region</string>
    <!-- The label of the postal code field of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_postal_code">Postal code</string>
    <!-- The label of the country field of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_country">Country</string>
    <!-- The helper text of the optional fields of the MonarchAddressAutocomplete form. -->
    <string name="monarch_addressautocomplete_optional">Optional</string>
    <!-- Shown in the MonarchAddressAutocomplete sheet until the search is long enough. %1$d is the number of characters needed. -->
    <plurals name="monarch_addressautocomplete_too_short">
        <item quantity="one">Type at least %1$d character to search.</item>
        <item quantity="other">Type at least %1$d characters to search.</item>
    </plurals>
    <!-- Shown and announced in the MonarchAddressAutocomplete sheet with the number of suggestions found. -->
    <plurals name="monarch_addressautocomplete_results">
        <item quantity="one">%1$d address found</item>
        <item quantity="other">%1$d addresses found</item>
    </plurals>
</resources>
