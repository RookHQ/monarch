<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the + button of a MonarchNumberInput, and of the increase action of its field. -->
    <string name="monarch_numberinput_increment">Increase</string>
    <!-- Spoken name of the − button of a MonarchNumberInput, and of the decrease action of its field. -->
    <string name="monarch_numberinput_decrement">Decrease</string>
    <!-- Error of a MonarchNumberInput when the text is not a number. -->
    <string name="monarch_numberinput_invalid">Enter a number.</string>
    <!-- Error of a MonarchNumberInput outside both bounds. %1$s is the smallest value, %2$s the largest. -->
    <string name="monarch_numberinput_range">Enter a number from %1$s to %2$s.</string>
    <!-- Error of a MonarchNumberInput below its only bound. %1$s is the smallest value. -->
    <string name="monarch_numberinput_range_minimum">Enter %1$s or more.</string>
    <!-- Error of a MonarchNumberInput above its only bound. %1$s is the largest value. -->
    <string name="monarch_numberinput_range_maximum">Enter %1$s or less.</string>
</resources>
