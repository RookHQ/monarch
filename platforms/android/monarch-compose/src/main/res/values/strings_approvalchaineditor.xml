<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchApprovalChainEditor: the heading of the list of steps. -->
    <string name="monarch_approvalchaineditor_title">Steps, in order</string>
    <!-- MonarchApprovalChainEditor: the heading of one step. %1$d is its position, from 1. -->
    <string name="monarch_approvalchaineditor_step">Step %1$d</string>
    <!-- MonarchApprovalChainEditor: the label of the menu that picks the kind of approver. -->
    <string name="monarch_approvalchaineditor_approver">Approver</string>
    <!-- MonarchApprovalChainEditor: the label of a target picker when the kind has no label of its own. -->
    <string name="monarch_approvalchaineditor_target">Choose</string>
    <!-- MonarchApprovalChainEditor: shown in a target picker while nothing is chosen. -->
    <string name="monarch_approvalchaineditor_target_placeholder">Choose…</string>
    <!-- MonarchApprovalChainEditor: the label of the optional name of a step. -->
    <string name="monarch_approvalchaineditor_label">Label (optional)</string>
    <!-- MonarchApprovalChainEditor: the placeholder of the optional name of a step. -->
    <string name="monarch_approvalchaineditor_label_placeholder">e.g. Finance check</string>
    <!-- MonarchApprovalChainEditor: the button that adds a step. -->
    <string name="monarch_approvalchaineditor_add_step">Add step</string>
    <!-- MonarchApprovalChainEditor: the visible text of the button that removes a step, without an icon. -->
    <string name="monarch_approvalchaineditor_remove">Remove</string>
    <!-- MonarchApprovalChainEditor: the TalkBack name of the remove button. %1$d is the step's position. -->
    <string name="monarch_approvalchaineditor_remove_step">Remove step %1$d</string>
    <!-- MonarchApprovalChainEditor: the error of a target picker with nothing chosen. -->
    <string name="monarch_approvalchaineditor_target_required">Choose who decides this step.</string>
    <!-- MonarchApprovalChainEditor: shown instead of the add button at the limit. %1$d is the limit. -->
    <plurals name="monarch_approvalchaineditor_max_reached">
        <item quantity="one">A chain can have up to %1$d step.</item>
        <item quantity="other">A chain can have up to %1$d steps.</item>
    </plurals>
</resources>
