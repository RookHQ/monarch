<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchMergeDialog. -->
    <string name="monarch_mergedialog_title">Merge records</string>
    <!-- Line under the heading of a MonarchMergeDialog that explains the choices. -->
    <string name="monarch_mergedialog_description">Choose the record to keep and which value to keep for each field. The other records are merged into it.</string>
    <!-- Heading of the record choice of a MonarchMergeDialog. -->
    <string name="monarch_mergedialog_keep">Record to keep</string>
    <!-- Badge on the kept record of a MonarchMergeDialog. Not read by TalkBack: the selected state says it. -->
    <string name="monarch_mergedialog_kept">Kept</string>
    <!-- Heading of the field choices of a MonarchMergeDialog. -->
    <string name="monarch_mergedialog_values">Values to keep</string>
    <!-- Heading of the fields that match in every record of a MonarchMergeDialog. -->
    <string name="monarch_mergedialog_same">Same in every record</string>
    <!-- Shown by a MonarchMergeDialog for an empty value. -->
    <string name="monarch_mergedialog_empty">Empty</string>
    <!-- Source of a value in a MonarchMergeDialog. The argument is the record's title. -->
    <string name="monarch_mergedialog_from">from %1$s</string>
    <!-- Heading of the consequences of a MonarchMergeDialog. -->
    <string name="monarch_mergedialog_consequences">What happens</string>
    <!-- Label of the cancel button of a MonarchMergeDialog. -->
    <string name="monarch_mergedialog_cancel">Cancel</string>
    <!-- Message of a MonarchMergeDialog after a failed merge. Also announced. -->
    <string name="monarch_mergedialog_error">The records could not be merged. Nothing was changed.</string>
    <!-- Label of the merge button of a MonarchMergeDialog: the number of records merged. -->
    <plurals name="monarch_mergedialog_confirm">
        <item quantity="one">Merge %1$d record</item>
        <item quantity="other">Merge %1$d records</item>
    </plurals>
</resources>
