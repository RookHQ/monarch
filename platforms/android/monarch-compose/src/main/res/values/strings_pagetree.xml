<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of a MonarchPageTree, the pages of a document. -->
    <string name="monarch_pagetree_label">Pages</string>
    <!-- Title of a page of a MonarchPageTree whose title is blank. -->
    <string name="monarch_pagetree_untitled">Untitled page</string>
    <!-- Shown under an empty group of a MonarchPageTree that cannot add pages. -->
    <string name="monarch_pagetree_no_pages">No pages yet.</string>
    <!-- TalkBack name of the add button of a group of a MonarchPageTree. The argument is the group name. -->
    <string name="monarch_pagetree_add_page">Add page to %1$s</string>
    <!-- Visible text of the add button of a group of a MonarchPageTree when the app gives no icon. -->
    <string name="monarch_pagetree_add_page_text">Add page</string>
    <!-- Button under an empty group of a MonarchPageTree that adds its first page. -->
    <string name="monarch_pagetree_add_first_page">Add first page</string>
    <!-- Button after the groups of a MonarchPageTree that adds a group; also the confirm button of the add dialog. -->
    <string name="monarch_pagetree_add_group">Add group</string>
    <!-- TalkBack name of the menu button of a group of a MonarchPageTree. The argument is the group name. -->
    <string name="monarch_pagetree_group_actions">Actions for %1$s</string>
    <!-- TalkBack name of the menu button of a page of a MonarchPageTree. The argument is the page title. -->
    <string name="monarch_pagetree_page_actions">Actions for %1$s</string>
    <!-- Visible text of a menu button of a MonarchPageTree when the app gives no icon. -->
    <string name="monarch_pagetree_more">More</string>
    <!-- Menu item of a group of a MonarchPageTree that renames it; also the title of the rename dialog. -->
    <string name="monarch_pagetree_rename_group">Rename group</string>
    <!-- Menu item of a group of a MonarchPageTree that moves it up. -->
    <string name="monarch_pagetree_move_group_up">Move group up</string>
    <!-- Menu item of a group of a MonarchPageTree that moves it down. -->
    <string name="monarch_pagetree_move_group_down">Move group down</string>
    <!-- Menu item and confirm button of a MonarchPageTree that delete a group. -->
    <string name="monarch_pagetree_delete_group">Delete group</string>
    <!-- Menu item of a page of a MonarchPageTree that moves it to another group. The argument is the group name. -->
    <string name="monarch_pagetree_move_to">Move to %1$s</string>
    <!-- Menu item and confirm button of a MonarchPageTree that delete a page. -->
    <string name="monarch_pagetree_delete_page">Delete page</string>
    <!-- Title of the dialog of a MonarchPageTree that adds a group. -->
    <string name="monarch_pagetree_add_group_title">Add a group</string>
    <!-- Label of the name field in the dialogs of a MonarchPageTree. -->
    <string name="monarch_pagetree_group_name">Group name</string>
    <!-- Name the add group dialog of a MonarchPageTree starts with. -->
    <string name="monarch_pagetree_new_group_name">New group</string>
    <!-- Confirm button of the rename dialog of a MonarchPageTree. -->
    <string name="monarch_pagetree_rename_submit">Rename</string>
    <!-- Button that closes a dialog of a MonarchPageTree without a change. -->
    <string name="monarch_pagetree_cancel">Cancel</string>
    <!-- Title of the delete group dialog of a MonarchPageTree. The argument is the group name. -->
    <string name="monarch_pagetree_delete_group_title">Delete the “%1$s” group?</string>
    <!-- What else the delete group dialog of a MonarchPageTree deletes: the number of pages in the group. -->
    <plurals name="monarch_pagetree_delete_group_consequence">
        <item quantity="one">Its page is deleted too</item>
        <item quantity="other">Its %1$d pages are deleted too</item>
    </plurals>
    <!-- Label of the field of the delete group dialog of a MonarchPageTree that asks for the group name. -->
    <string name="monarch_pagetree_type_to_confirm">Type %1$s to confirm</string>
    <!-- Title of the delete page dialog of a MonarchPageTree. The argument is the page title. -->
    <string name="monarch_pagetree_delete_page_title">Delete “%1$s”?</string>
    <!-- Warning in the delete dialogs of a MonarchPageTree. -->
    <string name="monarch_pagetree_cannot_undo">This cannot be undone.</string>
    <!-- Announced by a MonarchPageTree after a group moves: its name, its new position and the number of groups. -->
    <string name="monarch_pagetree_group_moved">%1$s moved to position %2$d of %3$d.</string>
    <!-- Announced by a MonarchPageTree after a page moves to another group: the page title and the group name. -->
    <string name="monarch_pagetree_page_moved_to">%1$s moved to %2$s.</string>
</resources>
