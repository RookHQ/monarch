<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the on-track state of a MonarchSlaIndicator, shown when there is no countdown and read by TalkBack. -->
    <string name="monarch_slaindicator_on_track">On track</string>
    <!-- Name of the at-risk state of a MonarchSlaIndicator. -->
    <string name="monarch_slaindicator_at_risk">At risk</string>
    <!-- Name of the breached state of a MonarchSlaIndicator. -->
    <string name="monarch_slaindicator_breached">Breached</string>
    <!-- Name of the paused state of a MonarchSlaIndicator. -->
    <string name="monarch_slaindicator_paused">Paused</string>
    <!-- Name of the met state of a MonarchSlaIndicator. -->
    <string name="monarch_slaindicator_met">Met</string>
    <!-- Name of the not-applicable state of a MonarchSlaIndicator, shown with showNotApplicable and always read by TalkBack. -->
    <string name="monarch_slaindicator_not_applicable">No SLA</string>
    <!-- Shown by a MonarchSlaIndicator for a missing target without showNotApplicable: a dash. -->
    <string name="monarch_slaindicator_not_applicable_mark">—</string>
    <!-- Text of a MonarchSlaIndicator while time is left. %1$s is a duration such as "2h 15m". -->
    <string name="monarch_slaindicator_remaining">%1$s left</string>
    <!-- Text of a MonarchSlaIndicator once the due time has passed. %1$s is a duration such as "40m". -->
    <string name="monarch_slaindicator_overdue">Overdue %1$s</string>
    <!-- A duration under one minute in a MonarchSlaIndicator, visible. -->
    <string name="monarch_slaindicator_less_than_a_minute">&lt;1m</string>
    <!-- A duration under one minute in a MonarchSlaIndicator, as TalkBack reads it. -->
    <string name="monarch_slaindicator_less_than_a_minute_spoken">less than a minute</string>
    <!-- What TalkBack hears about the due time of a MonarchSlaIndicator. %1$s is a date and time. -->
    <string name="monarch_slaindicator_due">due %1$s</string>
    <!-- What TalkBack hears when an earlier target of the same item was breached. -->
    <string name="monarch_slaindicator_earlier_breach">an earlier target was breached</string>
    <!-- Announced when the state of a MonarchSlaIndicator changes. %1$s is the target, %2$s the state. -->
    <string name="monarch_slaindicator_changed">%1$s: %2$s</string>
    <!-- Announced when the state of a MonarchSlaIndicator without a target name changes. %1$s is the state. -->
    <string name="monarch_slaindicator_changed_no_target">SLA %1$s</string>
</resources>
