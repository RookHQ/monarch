<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Placeholder of the text field of a MonarchAiPromptInput while it is empty. -->
    <string name="monarch_aipromptinput_placeholder">Send a message…</string>
    <!-- Button of a MonarchAiPromptInput that sends the prompt. -->
    <string name="monarch_aipromptinput_send">Send</string>
    <!-- Button of a MonarchAiPromptInput that stops the running response. -->
    <string name="monarch_aipromptinput_stop">Stop</string>
    <!-- Button of a MonarchAiPromptInput that opens the app's file or photo picker. -->
    <string name="monarch_aipromptinput_attach">Attach files</string>
    <!-- Shown over a MonarchAiPromptInput while files are dragged onto it. -->
    <string name="monarch_aipromptinput_drop_hint">Drop files to attach</string>
    <!-- Visible character counter of a MonarchAiPromptInput. %1$d is the count, %2$d the limit. -->
    <string name="monarch_aipromptinput_counter">%1$d / %2$d</string>
    <!-- What TalkBack reads for the character counter of a MonarchAiPromptInput. %1$d is the count, %2$d the limit. -->
    <plurals name="monarch_aipromptinput_counter_label">
        <item quantity="one">%1$d of %2$d characters</item>
        <item quantity="other">%1$d of %2$d characters</item>
    </plurals>
    <!-- Announced once when a MonarchAiPromptInput nears its limit. %1$d is the number of characters left. -->
    <plurals name="monarch_aipromptinput_counter_warning">
        <item quantity="one">%1$d character left</item>
        <item quantity="other">%1$d characters left</item>
    </plurals>
    <!-- Announced once when a MonarchAiPromptInput goes over its limit, and the error of its field. %1$d is the excess. -->
    <plurals name="monarch_aipromptinput_counter_over">
        <item quantity="one">%1$d character over the limit</item>
        <item quantity="other">%1$d characters over the limit</item>
    </plurals>
    <!-- Token estimate under the text of a MonarchAiPromptInput. %1$d is the estimated number of tokens. -->
    <plurals name="monarch_aipromptinput_tokens">
        <item quantity="one">≈ %1$d token</item>
        <item quantity="other">≈ %1$d tokens</item>
    </plurals>
</resources>
