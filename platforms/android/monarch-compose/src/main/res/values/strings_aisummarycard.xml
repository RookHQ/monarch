<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The provenance label above the title of a MonarchAiSummaryCard. -->
    <string name="monarch_aisummarycard_ai_summary">AI summary</string>
    <!-- The button of a MonarchAiSummaryCard that asks for a new summary. -->
    <string name="monarch_aisummarycard_refresh">Refresh</string>
    <!-- The age of the summary in a MonarchAiSummaryCard. %1$s is a relative time, such as 3 hours ago. -->
    <string name="monarch_aisummarycard_generated">Generated %1$s</string>
    <!-- Shown and announced while a MonarchAiSummaryCard writes its summary. -->
    <string name="monarch_aisummarycard_generating">Generating summary…</string>
    <!-- Announced when a MonarchAiSummaryCard finishes writing its summary. -->
    <string name="monarch_aisummarycard_updated">Summary updated.</string>
    <!-- The warning of a MonarchAiSummaryCard whose data changed since the summary was written. -->
    <string name="monarch_aisummarycard_stale">The data changed since this summary was written. Refresh to update it.</string>
    <!-- The error title of a MonarchAiSummaryCard whose summary could not be generated. -->
    <string name="monarch_aisummarycard_error">The summary couldn’t be generated.</string>
    <!-- Shown by a MonarchAiSummaryCard with no summary and nothing generating. -->
    <string name="monarch_aisummarycard_empty">No summary yet.</string>
    <!-- The heading of the source list of a MonarchAiSummaryCard. -->
    <string name="monarch_aisummarycard_sources">Sources</string>
</resources>
