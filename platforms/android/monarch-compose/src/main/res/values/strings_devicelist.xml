<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchDeviceList: the title when the app gives none. -->
    <string name="monarch_devicelist_title">Devices</string>
    <!-- MonarchDeviceList: the line under the title when the app gives none. -->
    <string name="monarch_devicelist_description">Devices that have accessed your account.</string>
    <!-- MonarchDeviceList: the spoken name of the list. -->
    <string name="monarch_devicelist_list_label">Devices</string>
    <!-- MonarchDeviceList: the name of a device with a blank name. -->
    <string name="monarch_devicelist_unnamed">Unknown device</string>
    <!-- MonarchDeviceList: the badge of the device showing the list. -->
    <string name="monarch_devicelist_current">This device</string>
    <!-- MonarchDeviceList: the badge of a blocked device. -->
    <string name="monarch_devicelist_blocked">Blocked</string>
    <!-- MonarchDeviceList: before the last-used time, as in "Last used 5 minutes ago". -->
    <string name="monarch_devicelist_last_used">Last used</string>
    <!-- MonarchDeviceList: before the first-seen time, as in "First seen 3 months ago". -->
    <string name="monarch_devicelist_first_seen">First seen</string>
    <!-- MonarchDeviceList: the row button and the confirm button. -->
    <string name="monarch_devicelist_remove">Remove</string>
    <!-- MonarchDeviceList: the spoken name of a row button; %s is the device's name. -->
    <string name="monarch_devicelist_remove_label">Remove %s</string>
    <!-- MonarchDeviceList: the title of the confirmation; %s is the device's name. -->
    <string name="monarch_devicelist_confirm_title">Remove %s?</string>
