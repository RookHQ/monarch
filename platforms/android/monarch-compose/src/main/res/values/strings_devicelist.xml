    <string name="monarch_devicelist_remove_failed">Couldn’t remove %s. Try again.</string>
    <!-- MonarchDeviceList: the loading state. -->
    <string name="monarch_devicelist_loading">Loading devices</string>
    <!-- MonarchDeviceList: the title of the empty state. -->
    <string name="monarch_devicelist_empty_title">No devices yet</string>
    <!-- MonarchDeviceList: the line under the empty state. -->
    <string name="monarch_devicelist_empty_message">Devices appear here when they access your account.</string>
    <!-- MonarchDeviceList: the title of the failed state. -->
    <string name="monarch_devicelist_error_title">Couldn’t load your devices</string>
