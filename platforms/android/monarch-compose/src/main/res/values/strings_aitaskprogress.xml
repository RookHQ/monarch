<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiTaskProgress: the status badge of a running task. -->
    <string name="monarch_aitaskprogress_status_running">Running</string>
    <!-- MonarchAiTaskProgress: the status badge of a paused task. -->
    <string name="monarch_aitaskprogress_status_paused">Paused</string>
    <!-- MonarchAiTaskProgress: the status badge of a finished task. -->
    <string name="monarch_aitaskprogress_status_done">Done</string>
    <!-- MonarchAiTaskProgress: the status badge of a failed task. -->
    <string name="monarch_aitaskprogress_status_failed">Failed</string>
    <!-- MonarchAiTaskProgress: the status badge of a cancelled task. -->
    <string name="monarch_aitaskprogress_status_cancelled">Cancelled</string>
    <!-- MonarchAiTaskProgress: the spoken name of the progress bar. %1$s is the task title. -->
    <string name="monarch_aitaskprogress_progress_label">%1$s progress</string>
    <!-- MonarchAiTaskProgress: the percentage, shown and read as the bar's value. %1$d is a whole percentage. -->
    <string name="monarch_aitaskprogress_progress_value">%1$d%% complete</string>
    <!-- MonarchAiTaskProgress: when the task started. %1$s is a relative time such as "5 minutes ago". -->
    <string name="monarch_aitaskprogress_started">Started %1$s</string>
    <!-- MonarchAiTaskProgress: the time left when it is under a minute. -->
    <string name="monarch_aitaskprogress_eta_under_minute">Less than a minute left</string>
    <!-- MonarchAiTaskProgress: the time left in minutes. %1$d is the number of minutes. -->
    <plurals name="monarch_aitaskprogress_eta_minutes">
        <item quantity="one">About %1$d minute left</item>
        <item quantity="other">About %1$d minutes left</item>
    </plurals>
    <!-- MonarchAiTaskProgress: the time left in hours. %1$d is the number of hours. -->
    <plurals name="monarch_aitaskprogress_eta_hours">
        <item quantity="one">About %1$d hour left</item>
        <item quantity="other">About %1$d hours left</item>
    </plurals>
    <!-- MonarchAiTaskProgress: the button that cancels the task. -->
    <string name="monarch_aitaskprogress_cancel">Cancel</string>
    <!-- MonarchAiTaskProgress: the button that minimizes the card, and its spoken name when it shows an icon. -->
    <string name="monarch_aitaskprogress_minimize">Minimize</string>
    <!-- MonarchAiTaskProgress: the toggle that asks for a notification when the task ends. -->
    <string name="monarch_aitaskprogress_notify">Notify me when done</string>
    <!-- MonarchAiTaskProgress: announced when the status changes. %1$s is the title, %2$s the status. -->
    <string name="monarch_aitaskprogress_announce">%1$s: %2$s</string>
</resources>
