<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchFavoritesList, the section of pinned destinations. -->
    <string name="monarch_favoriteslist_title">Favorites</string>
    <!-- Visible text of the button of a MonarchFavoritesList that starts edit mode. -->
    <string name="monarch_favoriteslist_edit">Edit</string>
    <!-- Spoken name of the button of a MonarchFavoritesList that starts edit mode. -->
    <string name="monarch_favoriteslist_edit_label">Edit favorites</string>
    <!-- Visible text and spoken name of the button of a MonarchFavoritesList that ends edit mode. -->
    <string name="monarch_favoriteslist_done">Done</string>
    <!-- Visible text of the remove button of a row of a MonarchFavoritesList in edit mode. -->
    <string name="monarch_favoriteslist_remove">Remove</string>
    <!-- Spoken name of the remove button and the remove action of a row of a MonarchFavoritesList. %1$s is the destination, such as Roadmap. -->
    <string name="monarch_favoriteslist_remove_label">Remove %1$s from favorites</string>
    <!-- Announced by a MonarchFavoritesList after a destination is removed. %1$s is the destination, such as Roadmap. -->
    <string name="monarch_favoriteslist_removed">%1$s removed from favorites.</string>
</resources>
