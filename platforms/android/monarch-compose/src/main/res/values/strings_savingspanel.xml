<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchSavingsPanel, the card title when the app gives none. -->
    <string name="monarch_savingspanel_title">Savings</string>
    <!-- MonarchSavingsPanel, the start of the headline; %1$d is the number of unused items. -->
    <plurals name="monarch_savingspanel_headline_count">
        <item quantity="one">%1$d unused item</item>
        <item quantity="other">%1$d unused items</item>
    </plurals>
    <!-- MonarchSavingsPanel, the headline with the renewal cost; %1$s is the start of the headline, %2$s the cost. -->
    <string name="monarch_savingspanel_headline_cost">%1$s cost %2$s to renew</string>
    <!-- MonarchSavingsPanel, the headline with the unpriced count; %1$s is the headline so far, %2$d the count. -->
    <plurals name="monarch_savingspanel_headline_unpriced">
        <item quantity="one">%1$s (%2$d without a price)</item>
        <item quantity="other">%1$s (%2$d without a price)</item>
    </plurals>
    <!-- MonarchSavingsPanel, the end of the headline; %1$s is the headline so far. -->
    <string name="monarch_savingspanel_headline_end">%1$s.</string>
    <!-- MonarchSavingsPanel, the name TalkBack gives the categories. -->
    <string name="monarch_savingspanel_categories">Unused by reason</string>
    <!-- MonarchSavingsPanel, read before the decision summary. -->
    <string name="monarch_savingspanel_decisions">Decisions</string>
    <!-- MonarchSavingsPanel, the savings line; %1$s is the amounts, joined with plus signs. -->
    <string name="monarch_savingspanel_potential_savings">Letting the marked items lapse saves %1$s.</string>
    <!-- MonarchSavingsPanel, the name TalkBack gives the list of items. -->
    <string name="monarch_savingspanel_items">Unused items</string>
    <!-- MonarchSavingsPanel, the line after the list; %1$d is the number of items not shown. -->
    <plurals name="monarch_savingspanel_more">
        <item quantity="one">and %1$d more</item>
        <item quantity="other">and %1$d more</item>
    </plurals>
    <!-- MonarchSavingsPanel, an item without a price. -->
    <string name="monarch_savingspanel_unpriced">No price</string>
    <!-- MonarchSavingsPanel, the title of the empty state. -->
    <string name="monarch_savingspanel_empty_title">Nothing unused</string>
    <!-- MonarchSavingsPanel, the message of the empty state. -->
    <string name="monarch_savingspanel_empty_message">Everything renewing is in use.</string>
    <!-- MonarchSavingsPanel, the title of the error state. -->
    <string name="monarch_savingspanel_error_title">Savings could not be loaded.</string>
    <!-- MonarchSavingsPanel, what TalkBack reads while the panel loads. -->
    <string name="monarch_savingspanel_loading">Loading savings</string>
</resources>
