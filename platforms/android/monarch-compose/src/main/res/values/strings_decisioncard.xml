<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the group of choices of a MonarchDecisionCard, shown above them. -->
    <string name="monarch_decisioncard_choices">Decision</string>
    <!-- Label of the choice of a MonarchDecisionCard that clears the decision. -->
    <string name="monarch_decisioncard_none">No decision</string>
    <!-- Label of the reason field of a MonarchDecisionCard. -->
    <string name="monarch_decisioncard_reason">Reason</string>
    <!-- Added to the reason label of a MonarchDecisionCard when a reason is not required. -->
    <string name="monarch_decisioncard_optional">optional</string>
    <!-- The reason label of a MonarchDecisionCard with the optional mark. %1$s is the label, %2$s the mark. -->
    <string name="monarch_decisioncard_reason_optional">%1$s (%2$s)</string>
    <!-- Placeholder of the reason field of a MonarchDecisionCard. -->
    <string name="monarch_decisioncard_reason_placeholder">Why? Others will see this.</string>
    <!-- Error of a MonarchDecisionCard when a required reason is missing. -->
    <string name="monarch_decisioncard_reason_required">Add a reason for this decision.</string>
    <!-- Shown under the reason of a MonarchDecisionCard near its limit. %d is the number of characters left. -->
    <plurals name="monarch_decisioncard_characters_left">
        <item quantity="one">%d character left</item>
        <item quantity="other">%d characters left</item>
    </plurals>
    <!-- Button of a MonarchDecisionCard that saves the decision. -->
    <string name="monarch_decisioncard_save">Save decision</string>
    <!-- Shown and announced by a MonarchDecisionCard after the decision was saved. -->
    <string name="monarch_decisioncard_saved">Decision saved.</string>
    <!-- Before the time of the saved decision of a MonarchDecisionCard, as in "Decided 3 hours ago". -->
    <string name="monarch_decisioncard_decided">Decided</string>
    <!-- After the time of the saved decision of a MonarchDecisionCard. %1$s is the person who decided. -->
    <string name="monarch_decisioncard_decided_by">by %1$s</string>
    <!-- Read-only MonarchDecisionCard when nothing has been decided. -->
    <string name="monarch_decisioncard_undecided">No decision yet</string>
</resources>
