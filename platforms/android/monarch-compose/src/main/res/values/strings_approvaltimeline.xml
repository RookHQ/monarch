<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchApprovalTimeline, the spoken name of the steps of one approval. -->
    <string name="monarch_approvaltimeline_label">Approval timeline</string>
    <!-- MonarchApprovalTimeline, the status of a step: the request was sent. -->
    <string name="monarch_approvaltimeline_status_submitted">Submitted</string>
    <!-- MonarchApprovalTimeline, the status of a step: someone approved. -->
    <string name="monarch_approvaltimeline_status_approved">Approved</string>
    <!-- MonarchApprovalTimeline, the status of a step: someone rejected it. -->
    <string name="monarch_approvaltimeline_status_rejected">Rejected</string>
    <!-- MonarchApprovalTimeline, the status of the step that is waiting for a decision now. -->
    <string name="monarch_approvaltimeline_status_pending">Waiting for a decision</string>
    <!-- MonarchApprovalTimeline, the status of a later step that has not started. -->
    <string name="monarch_approvaltimeline_status_waiting">Up next</string>
    <!-- MonarchApprovalTimeline, the status of a step that was passed over. -->
    <string name="monarch_approvaltimeline_status_skipped">Skipped</string>
    <!-- MonarchApprovalTimeline, the status of a step that was withdrawn before a decision. -->
    <string name="monarch_approvaltimeline_status_cancelled">Cancelled</string>
    <!-- MonarchApprovalTimeline, the people who can decide a step that is not decided yet. %1$s is a list of names. -->
    <string name="monarch_approvaltimeline_approvers">Decided by %1$s</string>
    <!-- MonarchApprovalTimeline, after an approver who stands in for someone else. %1$s is the other person's name. -->
    <string name="monarch_approvaltimeline_delegated_from">standing in for %1$s</string>
    <!-- MonarchApprovalTimeline, spoken on the step that is waiting for a decision now. -->
    <string name="monarch_approvaltimeline_current">Current step</string>
    <!-- MonarchApprovalTimeline, shown when an approval has no steps because it was not submitted. -->
    <string name="monarch_approvaltimeline_empty">Not submitted yet</string>
</resources>
