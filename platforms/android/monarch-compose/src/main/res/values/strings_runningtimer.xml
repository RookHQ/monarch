<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Start button of a stopped MonarchRunningTimer panel. -->
    <string name="monarch_runningtimer_start">Start timer</string>
    <!-- Stop button of a running MonarchRunningTimer; stops the timer and logs the time. -->
    <string name="monarch_runningtimer_stop">Stop</string>
    <!-- TalkBack name of the stop button of a MonarchRunningTimer indicator. -->
    <string name="monarch_runningtimer_stop_and_log">Stop timer and log time</string>
    <!-- Visible text of the menu button of a MonarchRunningTimer indicator when the app gives no icon. -->
    <string name="monarch_runningtimer_more">More</string>
    <!-- TalkBack name of the menu button of a MonarchRunningTimer indicator. -->
    <string name="monarch_runningtimer_more_actions">More timer actions</string>
    <!-- Action that throws the running time away without logging it. -->
    <string name="monarch_runningtimer_discard">Discard without logging</string>
    <!-- Title of the confirmation before discarding a running timer. -->
    <string name="monarch_runningtimer_discard_title">Discard the running timer?</string>
    <!-- Message of the confirmation before discarding a running timer. -->
    <string name="monarch_runningtimer_discard_message">The tracked time will not be saved.</string>
    <!-- Confirm button of the confirmation before discarding a running timer. -->
    <string name="monarch_runningtimer_discard_confirm">Discard</string>
    <!-- Action that stops the timer at an earlier time. -->
    <string name="monarch_runningtimer_stopped_earlier">I stopped earlier</string>
    <!-- Title of the dialog that asks when the person stopped working. -->
    <string name="monarch_runningtimer_stopped_earlier_title">When did you stop?</string>
    <!-- Explanation in the dialog that asks when the person stopped working. -->
    <string name="monarch_runningtimer_stopped_earlier_message">The time between the start and the time you choose is saved. It cannot be in the future or before the timer started.</string>
    <!-- When the timer started, in the stop-earlier dialog. %1$s is a date and time. -->
    <string name="monarch_runningtimer_started">Started %1$s</string>
    <!-- The length of work that will be saved, in the stop-earlier dialog. %1$s is a duration such as "2h 05m". -->
    <string name="monarch_runningtimer_work_duration">That is %1$s of work.</string>
    <!-- Save button of the stop-earlier dialog. -->
    <string name="monarch_runningtimer_save">Save this time</string>
    <!-- Cancel button of the dialogs of a MonarchRunningTimer. -->
    <string name="monarch_runningtimer_cancel">Cancel</string>
    <!-- Error in the stop-earlier dialog for a time after now. -->
    <string name="monarch_runningtimer_stopped_at_future">The time cannot be in the future.</string>
    <!-- Error in the stop-earlier dialog for a time less than a minute after the start. -->
    <string name="monarch_runningtimer_stopped_at_too_early">It must be at least a minute after the timer started.</string>
    <!-- Shown when a timer action fails without a message of its own. -->
    <string name="monarch_runningtimer_failed">That did not work. Try again.</string>
    <!-- State of a running timer, read by TalkBack and announced when it starts. -->
    <string name="monarch_runningtimer_running">Timer running</string>
    <!-- State of a stopped timer, read by TalkBack and announced when it stops. -->
    <string name="monarch_runningtimer_stopped">Timer stopped</string>
    <!-- What the indicator shows when the app gives no label. -->
    <string name="monarch_runningtimer_default_label">Timer</string>
    <!-- TalkBack action name of the indicator's clock when it opens what is being timed. -->
    <string name="monarch_runningtimer_open">Open</string>
    <!-- Warning on a timer that has run long. %1$s is a duration such as "12h". -->
    <string name="monarch_runningtimer_long_running">This timer has been running for over %1$s. If you forgot to stop it, choose the time you finished or discard it and add the time by hand.</string>
</resources>
