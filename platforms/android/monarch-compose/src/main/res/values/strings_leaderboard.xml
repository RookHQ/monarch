<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tag after the viewer's own name in a MonarchLeaderboard. -->
    <string name="monarch_leaderboard_you">(you)</string>
    <!-- Shown by a MonarchLeaderboard without entries. -->
    <string name="monarch_leaderboard_empty">Nothing to rank yet</string>
    <!-- What TalkBack reads for the placeholder rows of a loading MonarchLeaderboard. -->
    <string name="monarch_leaderboard_loading">Loading ranking</string>
    <!-- Read before each row of a MonarchLeaderboard. %1$d is the rank. -->
    <string name="monarch_leaderboard_rank">Rank %1$d:</string>
    <!-- What TalkBack reads for the value of a row of a MonarchLeaderboard. %1$s is the value, %2$s what it counts. -->
    <string name="monarch_leaderboard_value">%1$s %2$s</string>
    <!-- Note or button under a MonarchLeaderboard for the entries not shown. %1$d is how many. -->
    <plurals name="monarch_leaderboard_more">
        <item quantity="one">%1$d more</item>
        <item quantity="other">%1$d more</item>
    </plurals>
</resources>
