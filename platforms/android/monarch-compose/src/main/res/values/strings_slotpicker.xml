<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchSlotPicker: shown before a day is chosen. -->
    <string name="monarch_slotpicker_choose_day">Choose a day to see available times.</string>
    <!-- MonarchSlotPicker: shown when the chosen day has no times. -->
    <string name="monarch_slotpicker_empty">No times are available on this day. Try another day.</string>
    <!-- MonarchSlotPicker: announced while times load. -->
    <string name="monarch_slotpicker_loading">Loading available times</string>
    <!-- MonarchSlotPicker: announced when times arrive; the number of open times and the day. -->
    <plurals name="monarch_slotpicker_loaded">
        <item quantity="one">%1$d time on %2$s</item>
        <item quantity="other">%1$d times on %2$s</item>
    </plurals>
    <!-- MonarchSlotPicker: announced when the day has no open times; the day. -->
    <string name="monarch_slotpicker_loaded_none">No times available on %1$s</string>
    <!-- MonarchSlotPicker: the spoken name of the group of times; the day. -->
    <string name="monarch_slotpicker_times">Available times on %1$s</string>
    <!-- MonarchSlotPicker: under a time with limited places; the number of places. -->
    <plurals name="monarch_slotpicker_seats_left">
        <item quantity="one">%d left</item>
        <item quantity="other">%d left</item>
    </plurals>
    <!-- MonarchSlotPicker: the label of the time zone picker. -->
    <string name="monarch_slotpicker_time_zone">Time zone</string>
    <!-- MonarchSlotPicker: shown when the zone cannot be changed; the zone's name. -->
    <string name="monarch_slotpicker_shown_in">Times shown in %1$s</string>
    <!-- MonarchSlotPicker: shown when the business works in another zone; that zone's name. -->
    <string name="monarch_slotpicker_converted_from">Times are converted from %1$s.</string>
    <!-- MonarchSlotPicker: the warning when the selection is not an open time of the day; the time. -->
    <string name="monarch_slotpicker_not_open">%1$s is not an open time on this day.</string>
    <!-- MonarchSlotPicker: the button that offers a way out when no time fits. -->
    <string name="monarch_slotpicker_choose_outside">Choose another time</string>
    <!-- MonarchSlotPicker: the retry button in the error banner. -->
    <string name="monarch_slotpicker_retry">Try again</string>
</resources>
