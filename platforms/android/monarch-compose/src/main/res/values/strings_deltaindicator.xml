<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchDeltaIndicator, spoken: an increase. %1$s is the size of the change, such as "12%". -->
    <string name="monarch_deltaindicator_up">up %1$s</string>
    <!-- MonarchDeltaIndicator, spoken: a decrease. %1$s is the size of the change, such as "12%". -->
    <string name="monarch_deltaindicator_down">down %1$s</string>
    <!-- MonarchDeltaIndicator, spoken after a change in the good direction. %1$s is the rest of the sentence. -->
    <string name="monarch_deltaindicator_better">%1$s, better</string>
    <!-- MonarchDeltaIndicator, spoken after a change in the bad direction. %1$s is the rest of the sentence. -->
    <string name="monarch_deltaindicator_worse">%1$s, worse</string>
    <!-- MonarchDeltaIndicator, shown and spoken when the change is zero or inside the flat threshold. -->
    <string name="monarch_deltaindicator_flat">No change</string>
    <!-- MonarchDeltaIndicator, shown and spoken when there is nothing to compare with. -->
    <string name="monarch_deltaindicator_no_data">No earlier data</string>
</resources>
