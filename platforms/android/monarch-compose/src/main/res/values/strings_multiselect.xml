<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text of the MonarchMultiSelect button while nothing is chosen. -->
    <string name="monarch_multiselect_select">Select…</string>
    <!-- Text of the MonarchMultiSelect button once something is chosen. -->
    <string name="monarch_multiselect_change">Edit selection</string>
    <!-- The button that closes the MonarchMultiSelect sheet. -->
    <string name="monarch_multiselect_done">Done</string>
    <!-- Spoken value of the MonarchMultiSelect button while nothing is chosen. -->
    <string name="monarch_multiselect_none">None</string>
    <!-- Count of a MonarchMultiSelect with a limit, under the field and in the sheet. The quantity is the most allowed; %1$d is the number chosen, %2$d the most allowed. -->
    <plurals name="monarch_multiselect_count">
        <item quantity="one">%1$d of %2$d selected</item>
        <item quantity="other">%1$d of %2$d selected</item>
    </plurals>
    <!-- Spoken name of the remove button of a chosen value of a MonarchMultiSelect. %1$s is the value's label. -->
    <string name="monarch_multiselect_remove">Remove %1$s</string>
</resources>
