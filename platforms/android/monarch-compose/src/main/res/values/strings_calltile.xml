<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of your own MonarchCallTile. %1$s is your name. -->
    <string name="monarch_calltile_you">%1$s (you)</string>
    <!-- Written in the name bar of a MonarchCallTile when the microphone is off and there is no icon; also read. -->
    <string name="monarch_calltile_muted">Muted</string>
    <!-- Written in the name bar of a MonarchCallTile when the participant shares their screen and there is no icon; also read. -->
    <string name="monarch_calltile_sharing_screen">Sharing screen</string>
    <!-- Text of the raised-hand badge of a MonarchCallTile; also read. -->
    <string name="monarch_calltile_hand_raised">Hand raised</string>
    <!-- Read in the state of a MonarchCallTile while the participant speaks. -->
    <string name="monarch_calltile_speaking">Speaking</string>
    <!-- What TalkBack reads for the Pin button of a MonarchCallTile. %1$s is the participant's name. -->
    <string name="monarch_calltile_pin">Pin %1$s</string>
    <!-- What TalkBack reads for the Pin button of a pinned MonarchCallTile. %1$s is the participant's name. -->
    <string name="monarch_calltile_unpin">Unpin %1$s</string>
    <!-- What TalkBack reads for the full-screen button of a MonarchCallTile. %1$s is the participant's name. -->
    <string name="monarch_calltile_full_screen">Show %1$s full screen</string>
    <!-- Visible text of the Pin button of a MonarchCallTile without an icon. -->
    <string name="monarch_calltile_pin_button">Pin</string>
    <!-- Visible text of the Pin button of a pinned MonarchCallTile without an icon. -->
    <string name="monarch_calltile_unpin_button">Unpin</string>
    <!-- Visible text of the full-screen button of a MonarchCallTile without an icon. -->
    <string name="monarch_calltile_full_screen_button">Full screen</string>
    <!-- Announced for a new reaction on a MonarchCallTile. %1$s is the participant's name, %2$s the emoji. -->
    <string name="monarch_calltile_reacted">%1$s reacted %2$s</string>
    <!-- Read for three connection bars on a MonarchCallTile. -->
    <string name="monarch_calltile_quality_good">Good connection</string>
    <!-- Read for two connection bars on a MonarchCallTile. -->
    <string name="monarch_calltile_quality_fair">Unstable connection</string>
    <!-- Read for one connection bar on a MonarchCallTile. -->
    <string name="monarch_calltile_quality_poor">Poor connection</string>
</resources>
