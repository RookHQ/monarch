<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the MonarchAiInlinePrompt sheet, its pane title, and the item that MonarchAiInlinePromptArea adds to the text selection menu. -->
    <string name="monarch_aiinlineprompt_label">Ask AI</string>
    <!-- Placeholder of the prompt field of a MonarchAiInlinePrompt while it is empty. -->
    <string name="monarch_aiinlineprompt_placeholder">Ask AI to edit or write…</string>
    <!-- Accessible name of the prompt field of a MonarchAiInlinePrompt. -->
    <string name="monarch_aiinlineprompt_input_label">Prompt</string>
    <!-- Button of a MonarchAiInlinePrompt that sends the prompt. -->
    <string name="monarch_aiinlineprompt_submit">Send</string>
    <!-- Label before the excerpt of the text a MonarchAiInlinePrompt acts on. -->
    <string name="monarch_aiinlineprompt_context">Selection</string>
    <!-- Name of the group of quick prompts in a MonarchAiInlinePrompt. -->
    <string name="monarch_aiinlineprompt_suggestions">Suggestions</string>
    <!-- Status shown and announced in a MonarchAiInlinePrompt while the prompt is being sent. -->
    <string name="monarch_aiinlineprompt_pending">Sending…</string>
</resources>
