<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of a MonarchDashboardGrid. -->
    <string name="monarch_dashboardgrid_label">Dashboard</string>
    <!-- Spoken name of the drag handle of a widget in a MonarchDashboardGrid in edit mode. %1$s is the widget's label. -->
    <string name="monarch_dashboardgrid_handle">Move %1$s</string>
    <!-- Visible text of the Move earlier button of a widget in a MonarchDashboardGrid in edit mode. -->
    <string name="monarch_dashboardgrid_earlier">Earlier</string>
    <!-- Visible text of the Move later button of a widget in a MonarchDashboardGrid in edit mode. -->
    <string name="monarch_dashboardgrid_later">Later</string>
    <!-- Spoken name of the Move earlier button of a widget in a MonarchDashboardGrid. %1$s is the widget's label. -->
    <string name="monarch_dashboardgrid_move_earlier">Move %1$s earlier</string>
    <!-- Spoken name of the Move later button of a widget in a MonarchDashboardGrid. %1$s is the widget's label. -->
    <string name="monarch_dashboardgrid_move_later">Move %1$s later</string>
    <!-- Announced when a drag starts in a MonarchDashboardGrid: label (1), position (2), number of widgets (3). -->
    <string name="monarch_dashboardgrid_picked_up">Picked up %1$s. Position %2$d of %3$d.</string>
    <!-- Announced after a move by a button or an action in a MonarchDashboardGrid: label (1), new position (2), number of widgets (3). -->
    <string name="monarch_dashboardgrid_moved">%1$s moved to position %2$d of %3$d.</string>
    <!-- Announced when a drag ends in a MonarchDashboardGrid: label (1), position (2), number of widgets (3). -->
    <string name="monarch_dashboardgrid_dropped">%1$s dropped at position %2$d of %3$d.</string>
    <!-- Announced when a drag is cancelled in a MonarchDashboardGrid: label (1), position (2), number of widgets (3). -->
    <string name="monarch_dashboardgrid_cancelled">Move cancelled. %1$s returned to position %2$d of %3$d.</string>
</resources>
