<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken before the breadcrumb path of a MonarchSearchResultItem. -->
    <string name="monarch_searchresultitem_location">Location</string>
    <!-- How a MonarchSearchResultItem speaks its path: the word Location (1), then the segments (2) separated by commas. -->
    <string name="monarch_searchresultitem_path">%1$s: %2$s</string>
    <!-- Separates the path segments when they are spoken. -->
    <string name="monarch_searchresultitem_path_separator">", "</string>
</resources>
