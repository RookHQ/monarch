<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Header of the people column of a MonarchTeamCalendar. -->
    <string name="monarch_teamcalendar_person">Person</string>
    <!-- Name of a MonarchTeamCalendar grid, read by TalkBack. %1$s is the range, such as "November 2026". -->
    <string name="monarch_teamcalendar_grid">Team calendar, %1$s</string>
    <!-- Read by TalkBack with the date of today in a MonarchTeamCalendar. -->
    <string name="monarch_teamcalendar_today">Today</string>
    <!-- Read by TalkBack with a holiday's day and shown in its tooltip in a MonarchTeamCalendar. %1$s is the holiday's name. -->
    <string name="monarch_teamcalendar_holiday">Holiday: %1$s</string>
    <!-- Read by TalkBack for a bar of a MonarchTeamCalendar that spans several days. %1$s is the first day, %2$s the last. -->
    <string name="monarch_teamcalendar_range">%1$s to %2$s</string>
    <!-- Read by TalkBack for a half day in the first half in a MonarchTeamCalendar. -->
    <string name="monarch_teamcalendar_first_half">first half</string>
    <!-- Read by TalkBack for a half day in the second half in a MonarchTeamCalendar. -->
    <string name="monarch_teamcalendar_second_half">second half</string>
    <!-- Read by TalkBack for an entry of a MonarchTeamCalendar that waits for approval. -->
    <string name="monarch_teamcalendar_pending">pending</string>
    <!-- Title of the empty state of a MonarchTeamCalendar without members. -->
    <string name="monarch_teamcalendar_empty_title">Nobody to show</string>
    <!-- Message of the empty state of a MonarchTeamCalendar without members. -->
    <string name="monarch_teamcalendar_empty_description">People and their time away appear here.</string>
    <!-- The line under the grid of a MonarchTeamCalendar that explains how it is drawn. -->
    <string name="monarch_teamcalendar_legend">Shaded columns are weekends and holidays. Half bars are half days; faded bars are waiting for approval.</string>
    <!-- Read by TalkBack while a MonarchTeamCalendar shows its placeholder. -->
    <string name="monarch_teamcalendar_loading">Loading team calendar</string>
</resources>
