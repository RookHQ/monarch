<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bar of a MonarchScreenShareView when someone else shares. %1$s is the presenter's name. -->
    <string name="monarch_screenshareview_presenting">%1$s is presenting</string>
    <!-- Bar of a MonarchScreenShareView when the person using the app shares. -->
    <string name="monarch_screenshareview_you_are_presenting">You are presenting</string>
    <!-- What TalkBack reads for the shared picture of a MonarchScreenShareView. %1$s is the presenter's name. -->
    <string name="monarch_screenshareview_region">Screen shared by %1$s</string>
    <!-- Shown by a MonarchScreenShareView while the shared screen has not arrived. -->
    <string name="monarch_screenshareview_waiting">Waiting for the shared screen…</string>
    <!-- Shown instead of the picture when the person using the app shares, to avoid a mirror effect. -->
    <string name="monarch_screenshareview_local_preview_hidden">Your screen is being shared. The preview is hidden to avoid a mirror effect.</string>
    <!-- Button of a MonarchScreenShareView that shows the person's own shared screen anyway. -->
    <string name="monarch_screenshareview_show_preview">Show preview</string>
    <!-- Button of a MonarchScreenShareView that fits the whole screen in the view. -->
    <string name="monarch_screenshareview_fit">Fit to view</string>
    <!-- Button of a MonarchScreenShareView that zooms in one step; also a TalkBack action on the picture. -->
    <string name="monarch_screenshareview_zoom_in">Zoom in</string>
    <!-- Button of a MonarchScreenShareView that zooms out one step; also a TalkBack action on the picture. -->
    <string name="monarch_screenshareview_zoom_out">Zoom out</string>
    <!-- Button of a MonarchScreenShareView that starts picture in picture. -->
    <string name="monarch_screenshareview_picture_in_picture">Picture in picture</string>
    <!-- Button of a MonarchScreenShareView that ends picture in picture. -->
    <string name="monarch_screenshareview_exit_picture_in_picture">Exit picture in picture</string>
    <!-- Button of a MonarchScreenShareView that enters full screen. -->
    <string name="monarch_screenshareview_full_screen">Full screen</string>
    <!-- Button of a MonarchScreenShareView that leaves full screen. -->
    <string name="monarch_screenshareview_exit_full_screen">Exit full screen</string>
    <!-- Button of a MonarchScreenShareView that stops sharing the person's screen. -->
    <string name="monarch_screenshareview_stop_sharing">Stop sharing</string>
</resources>
