<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchPasskeyManager: the title when the app gives none. -->
    <string name="monarch_passkeymanager_title">Passkeys</string>
    <!-- MonarchPasskeyManager: the line under the title when the app gives none. -->
    <string name="monarch_passkeymanager_description">Sign in with your fingerprint, face or screen lock instead of a password. Passkeys can’t be phished or reused.</string>
    <!-- MonarchPasskeyManager: the spoken name of the list. -->
    <string name="monarch_passkeymanager_list_label">Your passkeys</string>
    <!-- MonarchPasskeyManager: the add button. -->
    <string name="monarch_passkeymanager_add">Add a passkey</string>
    <!-- MonarchPasskeyManager: the row's rename button. -->
    <string name="monarch_passkeymanager_rename">Rename</string>
    <!-- MonarchPasskeyManager: the spoken name of a rename button; %s is the passkey's name. -->
    <string name="monarch_passkeymanager_rename_label">Rename %s</string>
    <!-- MonarchPasskeyManager: the title of the rename dialog. -->
    <string name="monarch_passkeymanager_rename_title">Rename passkey</string>
    <!-- MonarchPasskeyManager: the label of the name field in the rename dialog. -->
    <string name="monarch_passkeymanager_name_field">Name</string>
    <!-- MonarchPasskeyManager: the button that saves a new name. -->
    <string name="monarch_passkeymanager_save">Save</string>
    <!-- MonarchPasskeyManager: the row's remove button. -->
    <string name="monarch_passkeymanager_remove">Remove</string>
    <!-- MonarchPasskeyManager: the spoken name of a remove button; %s is the passkey's name. -->
    <string name="monarch_passkeymanager_remove_label">Remove %s</string>
    <!-- MonarchPasskeyManager: before the time a passkey was added, as in "Added 3 days ago". -->
    <string name="monarch_passkeymanager_created">Added</string>
    <!-- MonarchPasskeyManager: before the time a passkey was last used, as in "Last used 2 hours ago". -->
    <string name="monarch_passkeymanager_last_used">Last used</string>
    <!-- MonarchPasskeyManager: instead of the last-used time of a passkey never used. -->
    <string name="monarch_passkeymanager_never_used">Never used</string>
    <!-- MonarchPasskeyManager: the badge of a passkey a password manager syncs. -->
    <string name="monarch_passkeymanager_synced">Synced</string>
    <!-- MonarchPasskeyManager: the title of the removal confirmation; %s is the passkey's name. -->
    <string name="monarch_passkeymanager_confirm_title">Remove %s?</string>
    <!-- MonarchPasskeyManager: the text of the removal confirmation. -->
    <string name="monarch_passkeymanager_confirm_message">You won’t be able to sign in with this passkey any more.</string>
    <!-- MonarchPasskeyManager: the warning in the confirmation when the last passkey is the only way to sign in. -->
    <string name="monarch_passkeymanager_last_method_warning">This is your only way to sign in. Add another passkey or a password first, or you may lose access to your account.</string>
    <!-- MonarchPasskeyManager: the confirm button of the removal. -->
    <string name="monarch_passkeymanager_confirm_remove">Remove passkey</string>
    <!-- MonarchPasskeyManager: the button that closes a dialog. -->
    <string name="monarch_passkeymanager_cancel">Cancel</string>
    <!-- MonarchPasskeyManager: the warning when the device cannot create passkeys. -->
    <string name="monarch_passkeymanager_unsupported">This device can’t create passkeys. Try another device, or update this one.</string>
    <!-- MonarchPasskeyManager: the note when the person cancelled adding a passkey. -->
    <string name="monarch_passkeymanager_cancelled">Passkey setup was cancelled. Nothing was changed.</string>
    <!-- MonarchPasskeyManager: the failure when adding a passkey failed. -->
    <string name="monarch_passkeymanager_add_failed">Couldn’t add the passkey. Try again.</string>
    <!-- MonarchPasskeyManager: announced after a passkey is added. -->
    <string name="monarch_passkeymanager_added">Passkey added</string>
    <!-- MonarchPasskeyManager: announced after a passkey is renamed; %s is the new name. -->
    <string name="monarch_passkeymanager_renamed">Renamed to %s</string>
    <!-- MonarchPasskeyManager: announced after a passkey is removed; %s is the passkey's name. -->
    <string name="monarch_passkeymanager_removed">Removed %s</string>
    <!-- MonarchPasskeyManager: the failure when renaming failed. -->
    <string name="monarch_passkeymanager_rename_failed">Couldn’t rename the passkey. Try again.</string>
    <!-- MonarchPasskeyManager: the failure when removing failed; %s is the passkey's name. -->
    <string name="monarch_passkeymanager_remove_failed">Couldn’t remove %s. Try again.</string>
    <!-- MonarchPasskeyManager: the loading state. -->
    <string name="monarch_passkeymanager_loading">Loading passkeys</string>
    <!-- MonarchPasskeyManager: the title of the empty state. -->
    <string name="monarch_passkeymanager_empty_title">No passkeys yet</string>
    <!-- MonarchPasskeyManager: the line under the empty state. -->
    <string name="monarch_passkeymanager_empty_message">Add one to sign in faster and more safely.</string>
    <!-- MonarchPasskeyManager: the title of the failed state. -->
    <string name="monarch_passkeymanager_error_title">Couldn’t load your passkeys</string>
</resources>
