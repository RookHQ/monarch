<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiArtifactVersions: the TalkBack name of the version controls. -->
    <string name="monarch_aiartifactversions_label">Versions</string>
    <!-- MonarchAiArtifactVersions: the position. %1$d is the version number, %2$d the number of versions. -->
    <string name="monarch_aiartifactversions_position">Version %1$d of %2$d</string>
    <!-- MonarchAiArtifactVersions: the TalkBack name of the previous button. -->
    <string name="monarch_aiartifactversions_previous">Previous version</string>
    <!-- MonarchAiArtifactVersions: the TalkBack name of the next button. -->
    <string name="monarch_aiartifactversions_next">Next version</string>
    <!-- MonarchAiArtifactVersions: the menu button that jumps to any version. -->
    <string name="monarch_aiartifactversions_select">Choose a version</string>
    <!-- MonarchAiArtifactVersions: the short tag of a version in the menu. %1$d is the version number. -->
    <string name="monarch_aiartifactversions_version_tag">v%1$d</string>
    <!-- MonarchAiArtifactVersions: a version's name above the diff. %1$d is the version number. -->
    <string name="monarch_aiartifactversions_version_name">Version %1$d</string>
    <!-- MonarchAiArtifactVersions: the toggle that shows the changes from the previous version. -->
    <string name="monarch_aiartifactversions_compare">Compare with previous</string>
    <!-- MonarchAiArtifactVersions: announced when the menu changes the version. %1$d is the version, %2$d the count. -->
    <string name="monarch_aiartifactversions_announce">Showing version %1$d of %2$d</string>
