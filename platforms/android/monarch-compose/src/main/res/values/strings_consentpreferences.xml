<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchConsentPreferences: the heading. -->
    <string name="monarch_consentpreferences_title">Privacy choices</string>
    <!-- MonarchConsentPreferences: the sentence under the heading. -->
    <string name="monarch_consentpreferences_description">Choose which optional uses of your data we may turn on. Strictly necessary ones keep the app working and are always on.</string>
    <!-- MonarchConsentPreferences: the link to the privacy policy. -->
    <string name="monarch_consentpreferences_policy">Privacy policy</string>
    <!-- MonarchConsentPreferences: the note on a strictly necessary category. -->
    <string name="monarch_consentpreferences_always_on">Always on</string>
    <!-- MonarchConsentPreferences: the note on a category a Global Privacy Control signal keeps off. -->
    <string name="monarch_consentpreferences_global_privacy_control">Off because a Global Privacy Control signal is on.</string>
    <!-- MonarchConsentPreferences: the status of an allowed category in choice mode. -->
    <string name="monarch_consentpreferences_on">On</string>
    <!-- MonarchConsentPreferences: the status of a refused category in choice mode. -->
    <string name="monarch_consentpreferences_off">Off</string>
    <!-- MonarchConsentPreferences: the button that turns every optional category off. -->
    <string name="monarch_consentpreferences_reject_all">Reject all</string>
    <!-- MonarchConsentPreferences: the button that turns every optional category on. -->
    <string name="monarch_consentpreferences_accept_all">Accept all</string>
    <!-- MonarchConsentPreferences: the button that saves the switches as they are. -->
    <string name="monarch_consentpreferences_save">Save choices</string>
    <!-- MonarchConsentPreferences: the button that withdraws the saved decision. -->
    <string name="monarch_consentpreferences_withdraw">Withdraw consent</string>
    <!-- MonarchConsentPreferences: before the saved policy version, as in "Policy version 3". -->
    <string name="monarch_consentpreferences_policy_version">Policy version</string>
    <!-- MonarchConsentPreferences: before the time of the saved decision, as in "Saved 2 days ago". -->
    <string name="monarch_consentpreferences_saved">Saved</string>
</resources>
