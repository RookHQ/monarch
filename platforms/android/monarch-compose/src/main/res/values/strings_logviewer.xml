<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the scrolling log of a MonarchLogViewer. -->
    <string name="monarch_logviewer_log">Log</string>
    <!-- Spoken name of the level filters of a MonarchLogViewer. -->
    <string name="monarch_logviewer_levels">Levels</string>
    <!-- Level word of a MonarchLogViewer line and filter, for debug output. -->
    <string name="monarch_logviewer_level_debug">Debug</string>
    <!-- Level word of a MonarchLogViewer line and filter, for normal output. -->
    <string name="monarch_logviewer_level_info">Info</string>
    <!-- Level word of a MonarchLogViewer line and filter, for warnings. -->
    <string name="monarch_logviewer_level_warn">Warn</string>
    <!-- Level word of a MonarchLogViewer line and filter, for errors. -->
    <string name="monarch_logviewer_level_error">Error</string>
    <!-- Placeholder of the search field of a MonarchLogViewer. -->
    <string name="monarch_logviewer_search">Search</string>
    <!-- Spoken name of the clear button of the search field of a MonarchLogViewer. -->
    <string name="monarch_logviewer_clear_search">Clear search</string>
    <!-- Toggle of a MonarchLogViewer that keeps the newest line in view. -->
    <string name="monarch_logviewer_follow">Follow</string>
    <!-- Toggle of a MonarchLogViewer that wraps long lines. -->
    <string name="monarch_logviewer_wrap">Wrap lines</string>
    <!-- Line count of a MonarchLogViewer when every line is shown. %1$s is the formatted total. -->
    <plurals name="monarch_logviewer_count">
        <item quantity="one">%1$s line</item>
        <item quantity="other">%1$s lines</item>
    </plurals>
    <!-- Line count of a MonarchLogViewer when filters hide lines. %1$s is the formatted number shown, %2$s the formatted total. -->
    <plurals name="monarch_logviewer_count_filtered">
        <item quantity="one">%1$s of %2$s line</item>
        <item quantity="other">%1$s of %2$s lines</item>
    </plurals>
    <!-- Button of a MonarchLogViewer that scrolls to the newest line while following is paused. -->
    <string name="monarch_logviewer_jump_to_latest">Jump to latest</string>
    <!-- The same button when lines arrived while following was paused. %1$s is the formatted number of lines. -->
    <plurals name="monarch_logviewer_new_lines">
        <item quantity="one">%1$s new line</item>
        <item quantity="other">%1$s new lines</item>
    </plurals>
    <!-- Announced by a MonarchLogViewer when following stops. -->
    <string name="monarch_logviewer_follow_paused">Following paused</string>
    <!-- Announced by a MonarchLogViewer when following starts again. -->
    <string name="monarch_logviewer_follow_resumed">Following new lines</string>
    <!-- Shown by a MonarchLogViewer when there are no lines. -->
    <string name="monarch_logviewer_empty">No log lines yet.</string>
    <!-- Shown by a MonarchLogViewer when the filters hide every line. -->
    <string name="monarch_logviewer_no_matches">No lines match the filters.</string>
    <!-- Button of a MonarchLogViewer that empties the search and shows every level. -->
    <string name="monarch_logviewer_clear_filters">Clear filters</string>
    <!-- Shown by a MonarchLogViewer while the first lines load. -->
    <string name="monarch_logviewer_loading">Loading log</string>
</resources>
