<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchStepper, the TalkBack name of the stepper and of its compact summary. -->
    <string name="monarch_stepper_progress">Progress</string>
    <!-- MonarchStepper, the position of a step, read before its name and shown in the compact summary. %1$d step number from 1, %2$d number of steps: "Step 2 of 5". -->
    <string name="monarch_stepper_step_of">Step %1$d of %2$d</string>
    <!-- MonarchStepper, the TalkBack state of a finished step. -->
    <string name="monarch_stepper_complete">completed</string>
    <!-- MonarchStepper, the TalkBack state of a step with an error. -->
    <string name="monarch_stepper_error">needs attention</string>
    <!-- MonarchStepper, the TalkBack state of the current step. -->
    <string name="monarch_stepper_current">current step</string>
    <!-- MonarchStepper, the note under an optional step, also read by TalkBack. -->
    <string name="monarch_stepper_optional">Optional</string>
    <!-- MonarchStepper, the TalkBack state added to the current step while the stepper is busy. -->
    <string name="monarch_stepper_busy">in progress</string>
</resources>
