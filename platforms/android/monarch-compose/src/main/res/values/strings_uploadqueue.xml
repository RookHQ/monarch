<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The heading of the queue. -->
    <string name="monarch_uploadqueue_title">Uploads</string>
    <!-- The status of an upload waiting for its turn. -->
    <string name="monarch_uploadqueue_queued">Waiting</string>
    <!-- The status of an upload in progress whose progress is unknown. -->
    <string name="monarch_uploadqueue_uploading">Uploading…</string>
    <!-- The status of an upload in progress, with its percentage ("Uploading… 40%"). -->
    <string name="monarch_uploadqueue_uploading_percent">Uploading… %1$d%%</string>
    <!-- The status of a finished upload. -->
    <string name="monarch_uploadqueue_done">Uploaded</string>
    <!-- The status of a failed upload without a reason. -->
    <string name="monarch_uploadqueue_failed">Upload failed</string>
    <!-- The status of a failed upload, with the reason ("Upload failed: Too large"). -->
    <string name="monarch_uploadqueue_failed_reason">Upload failed: %1$s</string>
    <!-- The status of a cancelled upload. -->
    <string name="monarch_uploadqueue_cancelled">Cancelled</string>
    <!-- The visible text of the retry button of a row. -->
    <string name="monarch_uploadqueue_retry">Retry</string>
    <!-- The TalkBack name of the retry button, with the file name. -->
    <string name="monarch_uploadqueue_retry_label">Retry upload of %1$s</string>
    <!-- The visible text of the cancel button of a row. -->
    <string name="monarch_uploadqueue_cancel">Cancel</string>
    <!-- The TalkBack name of the cancel button, with the file name. -->
    <string name="monarch_uploadqueue_cancel_label">Cancel upload of %1$s</string>
    <!-- The visible text of the remove button of a row. -->
    <string name="monarch_uploadqueue_remove">Remove</string>
    <!-- The TalkBack name of the remove button, with the file name. -->
    <string name="monarch_uploadqueue_remove_label">Remove %1$s from the list</string>
    <!-- The header button that removes every upload that ended. -->
    <string name="monarch_uploadqueue_clear_finished">Clear finished</string>
    <!-- The TalkBack name of the progress bar of a row, with the file name. -->
    <string name="monarch_uploadqueue_progress_label">Upload progress of %1$s</string>
    <!-- The TalkBack name of the total progress bar in the header. -->
    <string name="monarch_uploadqueue_total_progress">Total upload progress</string>
    <!-- The first part of the summary: uploads done of those not cancelled ("2 of 5 uploaded"); the quantity is the second number. -->
    <plurals name="monarch_uploadqueue_summary_uploaded">
        <item quantity="one">%1$d of %2$d uploaded</item>
        <item quantity="other">%1$d of %2$d uploaded</item>
    </plurals>
    <!-- A part of the summary: the failed uploads ("1 failed"). -->
    <plurals name="monarch_uploadqueue_summary_failed">
        <item quantity="one">%1$d failed</item>
        <item quantity="other">%1$d failed</item>
    </plurals>
    <!-- A part of the summary: the cancelled uploads ("1 cancelled"). -->
    <plurals name="monarch_uploadqueue_summary_cancelled">
        <item quantity="one">%1$d cancelled</item>
        <item quantity="other">%1$d cancelled</item>
    </plurals>
    <!-- Joins the parts of the summary. -->
    <string name="monarch_uploadqueue_summary_separator">" · "</string>
    <!-- Announced when an upload finishes. -->
    <string name="monarch_uploadqueue_announce_done">%1$s uploaded.</string>
    <!-- Announced when an upload fails without a reason. -->
    <string name="monarch_uploadqueue_announce_failed">%1$s failed.</string>
    <!-- Announced when an upload fails, with the reason. -->
    <string name="monarch_uploadqueue_announce_failed_reason">%1$s failed: %2$s.</string>
    <!-- Announced when the last active upload of several ends and none failed. -->
    <plurals name="monarch_uploadqueue_announce_finished">
        <item quantity="one">All uploads finished: %1$d uploaded.</item>
        <item quantity="other">All uploads finished: %1$d uploaded.</item>
    </plurals>
    <!-- Announced when the last active upload of several ends and some failed; the quantity is the number failed. -->
    <plurals name="monarch_uploadqueue_announce_finished_failed">
        <item quantity="one">Uploads finished: %1$d uploaded, %2$d failed.</item>
        <item quantity="other">Uploads finished: %1$d uploaded, %2$d failed.</item>
    </plurals>
</resources>
