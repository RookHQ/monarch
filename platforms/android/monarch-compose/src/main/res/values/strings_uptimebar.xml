<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchUptimeBar, the name of a period where everything worked. -->
    <string name="monarch_uptimebar_operational">Operational</string>
    <!-- MonarchUptimeBar, the name of a slow period or one with some failures. -->
    <string name="monarch_uptimebar_degraded">Degraded</string>
    <!-- MonarchUptimeBar, the name of a period where part of the service was down. -->
    <string name="monarch_uptimebar_partial">Partial outage</string>
    <!-- MonarchUptimeBar, the name of a period where the service was down. -->
    <string name="monarch_uptimebar_down">Down</string>
    <!-- MonarchUptimeBar, the name of a period of planned work. -->
    <string name="monarch_uptimebar_maintenance">Maintenance</string>
    <!-- MonarchUptimeBar, the name of a period where nothing was measured. -->
    <string name="monarch_uptimebar_no_data">No data</string>
    <!-- MonarchUptimeBar, the name of the uptime value in the details and the summary; also names a bar without a label. -->
    <string name="monarch_uptimebar_uptime">Uptime</string>
    <!-- MonarchUptimeBar, the overall line under the bar: "99.83% uptime". %1$s is the percentage. -->
    <string name="monarch_uptimebar_overall">%1$s uptime</string>
    <!-- MonarchUptimeBar, the spoken name of the legend. -->
    <string name="monarch_uptimebar_legend">Legend</string>
    <!-- MonarchUptimeBar, the number of periods at the start of the summary: "Periods: 30". -->
    <string name="monarch_uptimebar_periods">Periods</string>
    <!-- MonarchUptimeBar, the button in the details and the TalkBack action that open a period in the app. -->
    <string name="monarch_uptimebar_open">Open</string>
    <!-- MonarchUptimeBar, the TalkBack action that opens one period: "Open, Mar 12". %1$s is the open word, %2$s the period. -->
    <string name="monarch_uptimebar_open_action">%1$s, %2$s</string>
    <!-- MonarchUptimeBar, a name and a value: "Operational 28", "Uptime 99.83%", "Checks 1,440". -->
    <string name="monarch_uptimebar_named_value">%1$s %2$s</string>
    <!-- MonarchUptimeBar, a label and a number: "Periods: 30". -->
    <string name="monarch_uptimebar_named_count">%1$s: %2$d</string>
    <!-- MonarchUptimeBar, one period and its details: "Mar 12: Degraded, Uptime 99.42%". -->
    <string name="monarch_uptimebar_period_details">%1$s: %2$s</string>
</resources>
