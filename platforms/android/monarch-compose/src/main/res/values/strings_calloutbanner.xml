<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deprecated (D7): the monarch_calloutbanner_tone_* keys are aliases of the shared
         monarch_internal_tone_* names, which are the default. They still work as app overrides and
         are removed no earlier than 2027-02-13 (90-day window, two patch releases). Override the shared
         names, or pass toneLabel, instead. -->
    <!-- Read by TalkBack before the text of a MonarchCalloutBanner in the info tone. -->
    <string name="monarch_calloutbanner_tone_info">@string/monarch_internal_tone_info</string>
    <!-- Read by TalkBack before the text of a MonarchCalloutBanner in the success tone. -->
    <string name="monarch_calloutbanner_tone_success">@string/monarch_internal_tone_success</string>
    <!-- Read by TalkBack before the text of a MonarchCalloutBanner in the warning tone. -->
    <string name="monarch_calloutbanner_tone_warning">@string/monarch_internal_tone_warning</string>
    <!-- Read by TalkBack before the text of a MonarchCalloutBanner in the danger tone. -->
    <string name="monarch_calloutbanner_tone_danger">@string/monarch_internal_tone_danger</string>
    <!-- Label, or TalkBack name, of the button that dismisses a MonarchCalloutBanner. -->
    <string name="monarch_calloutbanner_dismiss">Dismiss</string>
</resources>
