<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiPlan: the title and the spoken name of the plan. -->
    <string name="monarch_aiplan_title">Proposed plan</string>
    <!-- MonarchAiPlan: the line under the title while the plan waits for a decision. -->
    <string name="monarch_aiplan_description">The assistant will take these steps after you approve. Nothing runs until then.</string>
    <!-- MonarchAiPlan: added to the description while the plan can be edited. -->
    <string name="monarch_aiplan_edit_hint">You can edit, reorder, add or remove steps first.</string>
    <!-- MonarchAiPlan: the description and the description with the edit hint; %1$s is the description, %2$s the hint. -->
    <string name="monarch_aiplan_description_with_hint">%1$s %2$s</string>
    <!-- MonarchAiPlan: the line under the title once approved; also announced. -->
    <string name="monarch_aiplan_approved_notice">Plan approved. The assistant is working through it.</string>
    <!-- MonarchAiPlan: the line under the title once rejected; also announced. -->
    <string name="monarch_aiplan_rejected_notice">Plan rejected. The assistant will not take these steps.</string>
    <!-- MonarchAiPlan: the spoken name of a step's text; %d is its position. -->
    <string name="monarch_aiplan_step_label">Step %d</string>
    <!-- MonarchAiPlan: shown in an empty step. -->
    <string name="monarch_aiplan_step_placeholder">Describe this step</string>
    <!-- MonarchAiPlan: the name of an empty step in spoken names; %d is its position. -->
    <string name="monarch_aiplan_untitled_step">step %d</string>
    <!-- MonarchAiPlan: the spoken name of a step's remove button; %s is the step. -->
    <string name="monarch_aiplan_remove">Remove %s</string>
    <!-- MonarchAiPlan: the visible text of a step's remove button when there is no icon. -->
    <string name="monarch_aiplan_remove_text">Remove</string>
    <!-- MonarchAiPlan: announced after a step is removed; %s is the step. -->
    <string name="monarch_aiplan_removed">Removed %s</string>
    <!-- MonarchAiPlan: the button that adds a step. -->
    <string name="monarch_aiplan_add_step">Add step</string>
    <!-- MonarchAiPlan: the button that approves the plan. -->
    <string name="monarch_aiplan_approve">Approve plan</string>
    <!-- MonarchAiPlan: the button that rejects the plan. -->
    <string name="monarch_aiplan_reject">Reject</string>
    <!-- MonarchAiPlan: the note shown while every step is empty. -->
    <string name="monarch_aiplan_empty_plan">Add at least one step to approve the plan.</string>
</resources>
