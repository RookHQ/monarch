<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Names the stack of a MonarchPresenceAvatars. %1$d is the number of people. -->
    <plurals name="monarch_presenceavatars_label">
        <item quantity="one">%1$d person here</item>
        <item quantity="other">%1$d people here</item>
    </plurals>
    <!-- What TalkBack reads for a stack of MonarchPresenceAvatars that opens the list. %1$s is the name of the stack, %2$s the people shown. -->
    <string name="monarch_presenceavatars_summary">%1$s: %2$s</string>
    <!-- Goes between the people in what TalkBack reads for a stack of MonarchPresenceAvatars. -->
    <string name="monarch_presenceavatars_summary_separator">"; "</string>
    <!-- What the stack of a MonarchPresenceAvatars does when tapped; TalkBack reads it as the action. -->
    <string name="monarch_presenceavatars_show_all">Show everyone here</string>
    <!-- Title of the list of a MonarchPresenceAvatars. -->
    <string name="monarch_presenceavatars_list">Everyone here</string>
    <!-- Button that closes the list of a MonarchPresenceAvatars. -->
    <string name="monarch_presenceavatars_done">Done</string>
    <!-- One person of a MonarchPresenceAvatars. %1$s is the name, %2$s the presence. -->
    <string name="monarch_presenceavatars_person">%1$s, %2$s</string>
    <!-- One person of a MonarchPresenceAvatars with an activity. %1$s is the name, %2$s the presence, %3$s the activity. -->
    <string name="monarch_presenceavatars_person_with_activity">%1$s, %2$s, %3$s</string>
</resources>
