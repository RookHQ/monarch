<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiUndoBanner: read by TalkBack before the title, so the banner is identified as an AI change. -->
    <string name="monarch_aiundobanner_ai_prefix">AI change:</string>
    <!-- MonarchAiUndoBanner: the title of the undo button. -->
    <string name="monarch_aiundobanner_undo">Undo</string>
    <!-- MonarchAiUndoBanner: the text of the link to the audit log entry. -->
    <string name="monarch_aiundobanner_audit">View in audit log</string>
    <!-- MonarchAiUndoBanner: the title of the dismiss button. -->
    <string name="monarch_aiundobanner_dismiss">Dismiss</string>
    <!-- MonarchAiUndoBanner: the title of the disclosure that holds more than three changes. %d is their count. -->
    <plurals name="monarch_aiundobanner_show_changes">
        <item quantity="one">Show %d change</item>
        <item quantity="other">Show %d changes</item>
    </plurals>
    <!-- MonarchAiUndoBanner: the spoken form of one change. %1$s is the field, %2$s the old value, %3$s the new value. -->
    <string name="monarch_aiundobanner_change">%1$s changed from %2$s to %3$s</string>
    <!-- MonarchAiUndoBanner: shown and announced after a successful undo. -->
    <string name="monarch_aiundobanner_undone">Changes undone</string>
    <!-- MonarchAiUndoBanner: shown and announced when the undo failed. -->
    <string name="monarch_aiundobanner_undo_failed">Couldn’t undo. Try again.</string>
    <!-- MonarchAiUndoBanner: shown and announced when the time to undo has run out. -->
    <string name="monarch_aiundobanner_expired">Undo is no longer available.</string>
</resources>
