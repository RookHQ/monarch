<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchDomainProgress, the title of the DNS step once the record is found. -->
    <string name="monarch_domainprogress_dns_title_done">DNS record found</string>
    <!-- MonarchDomainProgress, the title of the DNS step while the product waits for a record that proves the user owns the domain. -->
    <string name="monarch_domainprogress_dns_title_ownership">Ownership record needed</string>
    <!-- MonarchDomainProgress, the title of the DNS step while the product waits for the routing record. -->
    <string name="monarch_domainprogress_dns_title_waiting">Waiting for your DNS record</string>
    <!-- MonarchDomainProgress, the detail of the DNS step once the record is found. -->
    <string name="monarch_domainprogress_dns_detail_done">Your domain points here.</string>
    <!-- MonarchDomainProgress, the detail of the DNS step while the record is not found. -->
    <string name="monarch_domainprogress_dns_detail_waiting">Add the record shown below at your DNS provider.</string>
    <!-- MonarchDomainProgress, the title of the HTTPS certificate step once the certificate is issued. -->
    <string name="monarch_domainprogress_certificate_title_done">HTTPS certificate issued</string>
    <!-- MonarchDomainProgress, the title of the HTTPS certificate step before it is issued. -->
    <string name="monarch_domainprogress_certificate_title">HTTPS certificate</string>
    <!-- MonarchDomainProgress, the detail of the HTTPS certificate step once it is issued. -->
    <string name="monarch_domainprogress_certificate_detail_done">Secure connection works.</string>
    <!-- MonarchDomainProgress, the detail of the HTTPS certificate step before DNS is found. -->
    <string name="monarch_domainprogress_certificate_detail_todo">Starts automatically once DNS is found.</string>
    <!-- MonarchDomainProgress, the detail of the HTTPS certificate step while it is being issued. -->
    <string name="monarch_domainprogress_certificate_detail_current">Being issued now, usually 1 to 5 minutes.</string>
    <!-- MonarchDomainProgress, the title of the last step of a custom domain connection. -->
    <string name="monarch_domainprogress_live_title">Live</string>
    <!-- MonarchDomainProgress, the detail of the live step once the site loads. %1$s is the host name. -->
    <string name="monarch_domainprogress_live_detail_done">Your site loads on %1$s.</string>
    <!-- MonarchDomainProgress, the detail of the live step while the product checks the site. %1$s is the host name. -->
    <string name="monarch_domainprogress_live_detail_current">Checking that your site loads on %1$s.</string>
    <!-- MonarchDomainProgress, the detail of the live step before it starts. %1$s is the host name. -->
    <string name="monarch_domainprogress_live_detail_todo">We load %1$s over HTTPS before calling it live.</string>
    <!-- MonarchDomainProgress, the spoken state of a finished step. -->
    <string name="monarch_domainprogress_state_done">done</string>
    <!-- MonarchDomainProgress, the spoken state of the step in progress. -->
    <string name="monarch_domainprogress_state_current">in progress</string>
    <!-- MonarchDomainProgress, the spoken state of a step with a problem. -->
    <string name="monarch_domainprogress_state_error">needs attention</string>
    <!-- MonarchDomainProgress, the spoken state of a step that has not started. -->
    <string name="monarch_domainprogress_state_todo">not started</string>
    <!-- MonarchDomainProgress, the spoken name of the steps. %1$s is the host name. -->
    <string name="monarch_domainprogress_list_label">Progress for %1$s</string>
    <!-- MonarchDomainProgress, announced when the active step changes. %1$d is the position, %2$d the count of steps, %3$s the step title, %4$s its state. -->
    <string name="monarch_domainprogress_announcement">Step %1$d of %2$d: %3$s, %4$s.</string>
    <!-- MonarchDomainProgress, what public DNS shows for the host. %1$s is the host, %2$s what was found, such as "CNAME → domains.example.net". -->
    <string name="monarch_domainprogress_dns_seen">Public DNS for %1$s shows %2$s.</string>
    <!-- MonarchDomainProgress, used in place of the DNS records when public DNS shows none. -->
    <string name="monarch_domainprogress_no_record">no record yet</string>
    <!-- MonarchDomainProgress, shown while the product keeps checking a domain on its own. -->
    <string name="monarch_domainprogress_rechecking">We keep checking automatically, even after you close this page.</string>
    <!-- MonarchDomainProgress, shown while the product keeps checking a domain and will email the user. -->
    <string name="monarch_domainprogress_rechecking_email">We keep checking automatically, even after you close this page, and email you when it is live.</string>
    <!-- MonarchDomainProgress, shown while the product keeps checking a domain and will notify the user in the app. -->
    <string name="monarch_domainprogress_rechecking_in_app">We keep checking automatically, even after you close this page, and notify you here when it is live.</string>
    <!-- MonarchDomainProgress, when the product last checked the domain. %1$s is a relative time, such as "2 minutes ago". -->
    <string name="monarch_domainprogress_checked">Checked %1$s.</string>
</resources>
