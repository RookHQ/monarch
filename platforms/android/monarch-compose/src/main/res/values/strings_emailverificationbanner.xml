<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchEmailVerificationBanner: the bold first line. -->
    <string name="monarch_emailverificationbanner_title">Verify your email address</string>
    <!-- MonarchEmailVerificationBanner: the message. %1$s is the address waiting for verification. -->
    <string name="monarch_emailverificationbanner_message">We sent a verification link to %1$s. Open it to confirm the address belongs to you.</string>
    <!-- MonarchEmailVerificationBanner: the resend button. -->
    <string name="monarch_emailverificationbanner_resend">Resend email</string>
    <!-- MonarchEmailVerificationBanner: the resend button during the cooldown. %1$d is the seconds left. -->
    <string name="monarch_emailverificationbanner_resend_in">Resend in %1$ds</string>
    <!-- MonarchEmailVerificationBanner: shown and announced after a successful send. -->
    <string name="monarch_emailverificationbanner_sent">Verification email sent</string>
    <!-- MonarchEmailVerificationBanner: the button that changes the address. -->
    <string name="monarch_emailverificationbanner_change_email">Change email</string>
    <!-- MonarchEmailVerificationBanner: shown and announced when sending failed. -->
    <string name="monarch_emailverificationbanner_error">Couldn’t send the email. Try again.</string>
</resources>
