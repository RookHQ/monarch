<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the select-all checkbox of a MonarchDataTable. -->
    <string name="monarch_datatable_select_all">Select all rows</string>
    <!-- Spoken name of a row's checkbox in a MonarchDataTable. %1$s is the row's name. -->
    <string name="monarch_datatable_select_row">Select %1$s</string>
    <!-- Shown beside the select-all checkbox of a MonarchDataTable: the number of selected rows. -->
    <plurals name="monarch_datatable_selected_count">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>
    <!-- Spoken name of a row's actions button in a MonarchDataTable. %1$s is the row's name. -->
    <string name="monarch_datatable_row_actions">Actions for %1$s</string>
    <!-- Visible text of a row's actions button in a MonarchDataTable when the app gives no icon. -->
    <string name="monarch_datatable_actions_text">Actions</string>
    <!-- Name of the tap action of a row of a MonarchDataTable that opens, read as "Double-tap to open details". -->
    <string name="monarch_datatable_open">Open details</string>
    <!-- Sort button above the rows of a MonarchDataTable in the list layout. -->
    <string name="monarch_datatable_sort">Sort</string>
    <!-- State of a sorted column header or of the sort button of a MonarchDataTable. -->
    <string name="monarch_datatable_sorted_ascending">Sorted ascending</string>
    <!-- State of a sorted column header or of the sort button of a MonarchDataTable. -->
    <string name="monarch_datatable_sorted_descending">Sorted descending</string>
    <!-- State of a sortable column header of a MonarchDataTable that is not sorted. -->
    <string name="monarch_datatable_not_sorted">Not sorted</string>
    <!-- Visible mark after a header of a MonarchDataTable sorted ascending. Not read by TalkBack. -->
    <string name="monarch_datatable_mark_ascending">↑</string>
    <!-- Visible mark after a header of a MonarchDataTable sorted descending. Not read by TalkBack. -->
    <string name="monarch_datatable_mark_descending">↓</string>
    <!-- Shown in an empty cell of a MonarchDataTable. Not read by TalkBack, which reads the no-value text. -->
    <string name="monarch_datatable_empty_cell">—</string>
    <!-- Read by TalkBack for an empty cell of a MonarchDataTable. -->
    <string name="monarch_datatable_no_value">No value</string>
    <!-- Name of the placeholder rows of a MonarchDataTable while rows load. -->
    <string name="monarch_datatable_loading">Loading rows</string>
    <!-- Title of the empty state of a MonarchDataTable. -->
    <string name="monarch_datatable_empty_title">Nothing here yet</string>
    <!-- Message of the empty state of a MonarchDataTable. -->
    <string name="monarch_datatable_empty_message">Rows appear here once they are added.</string>
    <!-- Title of the empty state of a MonarchDataTable when filters match nothing. -->
    <string name="monarch_datatable_filtered_title">No rows match these filters</string>
    <!-- Message of the empty state of a MonarchDataTable when filters match nothing. -->
    <string name="monarch_datatable_filtered_message">Try removing a filter or searching for something else.</string>
    <!-- Title of the error state of a MonarchDataTable. -->
    <string name="monarch_datatable_error_title">These rows could not be loaded</string>
</resources>
