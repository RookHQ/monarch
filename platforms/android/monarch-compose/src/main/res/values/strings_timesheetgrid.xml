<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of a MonarchTimesheetGrid. -->
    <string name="monarch_timesheetgrid_caption">Time per row and day</string>
    <!-- Heading of the first column of a MonarchTimesheetGrid, above the row names. -->
    <string name="monarch_timesheetgrid_row_header">Project</string>
    <!-- Heading of the total column of a MonarchTimesheetGrid; also part of a row total's spoken name. -->
    <string name="monarch_timesheetgrid_total">Total</string>
    <!-- Name of the row of day totals of a MonarchTimesheetGrid. -->
    <string name="monarch_timesheetgrid_day_total">Day total</string>
    <!-- Spoken name of the day tabs of a MonarchTimesheetGrid in the day layout. -->
    <string name="monarch_timesheetgrid_days">Days</string>
    <!-- Spoken name of a row's actions button in a MonarchTimesheetGrid. %1$s is the row's name. -->
    <string name="monarch_timesheetgrid_row_actions">Actions for %1$s</string>
    <!-- Visible text of a row's actions button in a MonarchTimesheetGrid when the app gives no icon. -->
    <string name="monarch_timesheetgrid_actions_text">Actions</string>
    <!-- Spoken name of a cell of a MonarchTimesheetGrid. %1$s is the row's name, %2$s the day, such as "Atlas, Mon, Jan 12". -->
    <string name="monarch_timesheetgrid_cell_label">%1$s, %2$s</string>
    <!-- Shown and read with a locked day of a MonarchTimesheetGrid that has no reason. -->
    <string name="monarch_timesheetgrid_locked">Locked</string>
    <!-- Read for an empty cell or total of a MonarchTimesheetGrid. -->
    <string name="monarch_timesheetgrid_no_time">No time</string>
    <!-- Message of a MonarchTimesheetGrid cell whose text is not a duration. -->
    <string name="monarch_timesheetgrid_invalid">Use a time such as 1:30, 1.5 or 90m.</string>
    <!-- Message of a MonarchTimesheetGrid cell above the daily maximum. %1$s is the maximum, such as "24h". -->
    <string name="monarch_timesheetgrid_too_long">A day has at most %1$s.</string>
    <!-- Message of a MonarchTimesheetGrid cell whose save failed without a message. -->
    <string name="monarch_timesheetgrid_save_failed">That time could not be saved.</string>
    <!-- Under a day total of a MonarchTimesheetGrid. %1$s is the expected time, such as "8h". -->
    <string name="monarch_timesheetgrid_expected">of %1$s</string>
    <!-- Shown and read with a day total of a MonarchTimesheetGrid above the daily maximum. -->
    <string name="monarch_timesheetgrid_over_limit">Over limit</string>
    <!-- Shown by a MonarchTimesheetGrid without rows. -->
    <string name="monarch_timesheetgrid_empty">No time logged for this period.</string>
    <!-- Shown and read with today's heading in a MonarchTimesheetGrid. -->
    <string name="monarch_timesheetgrid_today">Today</string>
    <!-- Read with a MonarchTimesheetGrid cell while its value is saved. -->
    <string name="monarch_timesheetgrid_saving">Saving</string>
    <!-- A row's total in the day layout of a MonarchTimesheetGrid. %1$s is the duration, such as "7h 30m". -->
    <string name="monarch_timesheetgrid_period_total">Total %1$s</string>
</resources>
