<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiVoiceMode: the TalkBack name of the surface. %1$s is the assistant: "Voice conversation with Ada". -->
    <string name="monarch_aivoicemode_label">Voice conversation with %1$s</string>
    <!-- MonarchAiVoiceMode: the assistant's name when the app gives none. -->
    <string name="monarch_aivoicemode_assistant">Assistant</string>
    <!-- MonarchAiVoiceMode: the speaker of the person's own captions. -->
    <string name="monarch_aivoicemode_you">You</string>
    <!-- MonarchAiVoiceMode: the state text while the call is being set up. -->
    <string name="monarch_aivoicemode_state_connecting">Connecting…</string>
    <!-- MonarchAiVoiceMode: the state text while the assistant hears the person. -->
    <string name="monarch_aivoicemode_state_listening">Listening…</string>
    <!-- MonarchAiVoiceMode: the state text while the assistant prepares a reply. -->
    <string name="monarch_aivoicemode_state_thinking">Thinking…</string>
    <!-- MonarchAiVoiceMode: the state text while the assistant talks. -->
    <string name="monarch_aivoicemode_state_speaking">Speaking…</string>
    <!-- MonarchAiVoiceMode: the state text while the person's microphone is off. -->
    <string name="monarch_aivoicemode_state_muted">Muted</string>
    <!-- MonarchAiVoiceMode: the state text while the connection is restored. -->
    <string name="monarch_aivoicemode_state_reconnecting">Reconnecting…</string>
    <!-- MonarchAiVoiceMode: the state text once the call is over. -->
    <string name="monarch_aivoicemode_state_ended">Conversation ended</string>
    <!-- MonarchAiVoiceMode: the state text when the call failed. -->
    <string name="monarch_aivoicemode_state_error">Something went wrong</string>
    <!-- MonarchAiVoiceMode: shown beside the state when the microphone is muted while the assistant thinks or speaks. -->
    <string name="monarch_aivoicemode_microphone_muted">Your microphone is muted</string>
    <!-- MonarchAiVoiceMode: the toggle that mutes the microphone. -->
    <string name="monarch_aivoicemode_mute">Mute</string>
    <!-- MonarchAiVoiceMode: the button that stops the assistant's reply. -->
    <string name="monarch_aivoicemode_interrupt">Interrupt</string>
    <!-- MonarchAiVoiceMode: the toggle that shows or hides the captions. -->
    <string name="monarch_aivoicemode_captions">Captions</string>
    <!-- MonarchAiVoiceMode: the TalkBack name of the captions log. -->
    <string name="monarch_aivoicemode_captions_label">Captions</string>
    <!-- MonarchAiVoiceMode: the button that ends the call. -->
    <string name="monarch_aivoicemode_end">End</string>
    <!-- MonarchAiVoiceMode: the button that starts a new call after one ended. -->
    <string name="monarch_aivoicemode_restart">Start again</string>
    <!-- MonarchAiVoiceMode: the button that tries again after a failure. -->
    <string name="monarch_aivoicemode_retry">Retry</string>
    <!-- MonarchAiVoiceMode: shown in the captions log before anyone has spoken. -->
    <string name="monarch_aivoicemode_captions_empty">Captions appear here as you talk.</string>
    <!-- MonarchAiVoiceMode: read before the running time. %1$s is the time: "Call time: 4:05". -->
    <string name="monarch_aivoicemode_elapsed">Call time: %1$s</string>
    <!-- MonarchAiVoiceMode: the duration line once the call ended. %1$s is the time: "Lasted 4:05". -->
    <string name="monarch_aivoicemode_lasted">Lasted %1$s</string>
    <!-- MonarchAiVoiceMode: the error text when the app gives none. -->
    <string name="monarch_aivoicemode_error_fallback">The voice conversation stopped unexpectedly.</string>
    <!-- MonarchAiVoiceMode: announced when the call fails. %1$s state text, %2$s error: "Something went wrong: …". -->
    <string name="monarch_aivoicemode_announce_error">%1$s: %2$s</string>
    <!-- MonarchAiVoiceMode: what TalkBack reads for a final caption. %1$s speaker, %2$s words: "You: book a table". -->
    <string name="monarch_aivoicemode_caption">%1$s: %2$s</string>
</resources>
