<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchLineChart, the heading of the x column of the data table for categories when the app gives no xTitle. -->
    <string name="monarch_linechart_category">Category</string>
    <!-- MonarchLineChart, the heading of the x column of the data table for dates when the app gives no xTitle. -->
    <string name="monarch_linechart_date">Date</string>
    <!-- MonarchLineChart, the spoken summary of a chart or a series without values. -->
    <string name="monarch_linechart_no_data">No data</string>
    <!-- MonarchLineChart, the drill-in button of the inspection row. -->
    <string name="monarch_linechart_details">Details</string>
    <!-- MonarchLineChart, the TalkBack action that opens one x value: "Details, Mon". %1$s is the details word, %2$s the x value. -->
    <string name="monarch_linechart_details_action">%1$s, %2$s</string>
    <!-- MonarchLineChart, the button that ends the inspection of an x value. -->
    <string name="monarch_linechart_clear">Clear</string>
    <!-- MonarchLineChart, the number of x values at the start of the spoken summary. -->
    <plurals name="monarch_linechart_points">
        <item quantity="one">%d point</item>
        <item quantity="other">%d points</item>
    </plurals>
    <!-- MonarchLineChart, the first and last x value in the spoken summary: "Mon to Fri". -->
    <string name="monarch_linechart_range">%1$s to %2$s</string>
    <!-- MonarchLineChart, one series in the spoken summary: "Sessions: low 820, high 1,330, latest 1,330". %1$s series, %2$s lowest, %3$s highest, %4$s latest value. -->
    <string name="monarch_linechart_series_summary">%1$s: low %2$s, high %3$s, latest %4$s</string>
    <!-- MonarchLineChart, a series or a reference line with its value: "Sessions 820". %1$s name, %2$s value. -->
    <string name="monarch_linechart_value">%1$s %2$s</string>
    <!-- MonarchLineChart, one x value as TalkBack and the inspection row read it: "Mon: This week 820, Last week 700". -->
    <string name="monarch_linechart_point_values">%1$s: %2$s</string>
</resources>
