<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiSpendCap: the heading of the card; it also names the card for TalkBack. -->
    <string name="monarch_aispendcap_title">AI spending limit</string>
    <!-- MonarchAiSpendCap: the period in running text for a daily limit. -->
    <string name="monarch_aispendcap_period_day">today</string>
    <!-- MonarchAiSpendCap: the period in running text for a weekly limit. -->
    <string name="monarch_aispendcap_period_week">this week</string>
    <!-- MonarchAiSpendCap: the period in running text for a monthly limit. -->
    <string name="monarch_aispendcap_period_month">this month</string>
    <!-- MonarchAiSpendCap: the state badge while spending is below the warning share. -->
    <string name="monarch_aispendcap_state_ok">Within limit</string>
    <!-- MonarchAiSpendCap: the state badge at or above the warning share. -->
    <string name="monarch_aispendcap_state_warning">Close to the limit</string>
    <!-- MonarchAiSpendCap: the state badge at or over the limit. -->
    <string name="monarch_aispendcap_state_reached">Limit reached</string>
    <!-- MonarchAiSpendCap: the state badge when no limit is set. -->
    <string name="monarch_aispendcap_state_no_limit">No limit set</string>
    <!-- MonarchAiSpendCap: the amount line. %1$s is the amount spent, %2$s the limit, %3$s the period in running text. -->
    <string name="monarch_aispendcap_spent_of_limit">%1$s of %2$s %3$s</string>
    <!-- MonarchAiSpendCap: the amount line without a limit. %1$s is the amount spent, %2$s the period. -->
    <string name="monarch_aispendcap_spent_no_limit">%1$s spent %2$s</string>
    <!-- MonarchAiSpendCap: the TalkBack name of the bar. -->
    <string name="monarch_aispendcap_meter_label">Spent against the limit</string>
    <!-- MonarchAiSpendCap: what is left before the limit. %1$s is an amount. -->
    <string name="monarch_aispendcap_remaining">%1$s left</string>
    <!-- MonarchAiSpendCap: how far spending is past the limit. %1$s is an amount. -->
    <string name="monarch_aispendcap_over">%1$s over the limit</string>
    <!-- MonarchAiSpendCap: when the warning starts. %1$s is a percentage. -->
    <string name="monarch_aispendcap_warns_at">Warns at %1$s</string>
    <!-- MonarchAiSpendCap: what happens at the limit when AI pauses. -->
    <string name="monarch_aispendcap_behavior_summary_pause">At the limit, AI pauses and asks</string>
    <!-- MonarchAiSpendCap: what happens at the limit when AI keeps going. -->
    <string name="monarch_aispendcap_behavior_summary_notify">At the limit, AI keeps going and tells you</string>
    <!-- MonarchAiSpendCap: when the period starts again. %1$s is a date. -->
    <string name="monarch_aispendcap_resets">Resets %1$s</string>
    <!-- MonarchAiSpendCap: the caption of the list of spending per agent or feature. -->
    <string name="monarch_aispendcap_breakdown_label">Where it was spent</string>
    <!-- MonarchAiSpendCap: the button that opens the form when a limit is set. -->
    <string name="monarch_aispendcap_edit">Edit limit</string>
    <!-- MonarchAiSpendCap: the button that opens the form when no limit is set. -->
    <string name="monarch_aispendcap_set_limit">Set a limit</string>
    <!-- MonarchAiSpendCap: the title of the notice shown when the limit is reached and AI is paused. -->
    <string name="monarch_aispendcap_paused_title">AI is paused.</string>
    <!-- MonarchAiSpendCap: the body of that notice. %1$s is the limit, %2$s the period in running text. -->
    <string name="monarch_aispendcap_paused_body">The %1$s limit for %2$s has been reached. Nothing more is spent until the limit is raised or the period resets.</string>
    <!-- MonarchAiSpendCap: the notice action that opens the form. -->
    <string name="monarch_aispendcap_raise_limit">Raise limit</string>
    <!-- MonarchAiSpendCap: the action for people who cannot change the limit. -->
    <string name="monarch_aispendcap_request_increase">Request a higher limit</string>
    <!-- MonarchAiSpendCap: who can change the limit, shown to people who cannot. -->
    <string name="monarch_aispendcap_read_only">Only a workspace admin can change this limit.</string>
    <!-- MonarchAiSpendCap: the label of the amount field. -->
    <string name="monarch_aispendcap_amount_label">Limit</string>
    <!-- MonarchAiSpendCap: the help under the amount field. %1$s is the amount spent, %2$s the period. -->
    <string name="monarch_aispendcap_amount_hint">%1$s spent %2$s so far.</string>
    <!-- MonarchAiSpendCap: the error when the amount is empty. -->
    <string name="monarch_aispendcap_error_required">Enter an amount. To have no limit, use Remove limit.</string>
    <!-- MonarchAiSpendCap: the error when the amount is zero or less. -->
    <string name="monarch_aispendcap_error_positive">Enter an amount greater than zero.</string>
    <!-- MonarchAiSpendCap: the error when the amount is above the highest allowed. %1$s is that amount. -->
    <string name="monarch_aispendcap_error_max">Enter %1$s or less.</string>
    <!-- MonarchAiSpendCap: the warning when the new limit is below what is spent and AI pauses. %1$s is the amount spent, %2$s the period. -->
    <string name="monarch_aispendcap_below_spent_pause">This is below the %1$s already spent %2$s, so AI will pause straight away. Save again to confirm.</string>
    <!-- MonarchAiSpendCap: the same warning when AI keeps going. %1$s is the amount spent, %2$s the period. -->
    <string name="monarch_aispendcap_below_spent_notify">This is below the %1$s already spent %2$s, so the limit counts as reached straight away. Save again to confirm.</string>
    <!-- MonarchAiSpendCap: the label of the warn-at choice. -->
    <string name="monarch_aispendcap_warn_at_label">Warn me at</string>
    <!-- MonarchAiSpendCap: one warn-at choice. %1$s is a percentage. -->
    <string name="monarch_aispendcap_warn_at_option">%1$s of the limit</string>
    <!-- MonarchAiSpendCap: the label of the choice of what happens at the limit. -->
    <string name="monarch_aispendcap_behavior_label">When the limit is reached</string>
    <!-- MonarchAiSpendCap: the name of the pause choice. -->
    <string name="monarch_aispendcap_behavior_option_pause">Pause and ask</string>
    <!-- MonarchAiSpendCap: the name of the keep-going choice. -->
    <string name="monarch_aispendcap_behavior_option_notify">Keep going and tell me</string>
    <!-- MonarchAiSpendCap: what the pause choice means. -->
    <string name="monarch_aispendcap_behavior_description_pause">AI stops. Nothing more is spent until someone raises the limit or the period resets.</string>
    <!-- MonarchAiSpendCap: what the keep-going choice means. -->
    <string name="monarch_aispendcap_behavior_description_notify">AI carries on and you are notified. Spending can go over the limit.</string>
    <!-- MonarchAiSpendCap: the button that saves the form. -->
    <string name="monarch_aispendcap_save">Save</string>
    <!-- MonarchAiSpendCap: the save button after the below-spent warning. -->
    <string name="monarch_aispendcap_save_anyway">Save anyway</string>
    <!-- MonarchAiSpendCap: the button that closes the form without saving. -->
    <string name="monarch_aispendcap_cancel">Cancel</string>
    <!-- MonarchAiSpendCap: the button that starts removing the limit, and the confirming button of the dialog. -->
    <string name="monarch_aispendcap_remove_limit">Remove limit</string>
    <!-- MonarchAiSpendCap: the title of the dialog that confirms removing the limit. -->
    <string name="monarch_aispendcap_remove_confirm_title">Remove the spending limit?</string>
    <!-- MonarchAiSpendCap: what removing the limit means, in that dialog. -->
    <string name="monarch_aispendcap_remove_confirm_body">AI will be able to spend without a cap until a new limit is set.</string>
    <!-- MonarchAiSpendCap: the button of that dialog that keeps the limit. -->
    <string name="monarch_aispendcap_remove_cancel">Keep limit</string>
    <!-- MonarchAiSpendCap: announced when the state changes. %1$s is the title, %2$s the state, %3$s the amount line. -->
    <string name="monarch_aispendcap_announce">%1$s: %2$s. %3$s</string>
</resources>
