<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchSessionList: the title when the app gives none. -->
    <string name="monarch_sessionlist_title">Where you’re signed in</string>
    <!-- MonarchSessionList: the line under the title when the app gives none. -->
    <string name="monarch_sessionlist_description">Devices and browsers signed in to your account. Sign out any you don’t recognise.</string>
    <!-- MonarchSessionList: the spoken name of the list. -->
    <string name="monarch_sessionlist_list_label">Signed-in sessions</string>
    <!-- MonarchSessionList: the badge of the session showing the list. -->
    <string name="monarch_sessionlist_current">This device</string>
    <!-- MonarchSessionList: before the sign-in time, as in "Signed in 3 days ago". -->
    <string name="monarch_sessionlist_signed_in">Signed in</string>
    <!-- MonarchSessionList: before the last-active time, as in "Last active 5 minutes ago". -->
    <string name="monarch_sessionlist_last_active">Last active</string>
    <!-- MonarchSessionList: the row button and the confirm button for one session. -->
    <string name="monarch_sessionlist_sign_out">Sign out</string>
    <!-- MonarchSessionList: the spoken name of a row button; %s is the session's label. -->
    <string name="monarch_sessionlist_sign_out_label">Sign out %s</string>
    <!-- MonarchSessionList: the header button that signs out every other session, and its confirm button. -->
    <string name="monarch_sessionlist_sign_out_others">Sign out other devices</string>
    <!-- MonarchSessionList: the title of the confirmation for another session; %s is its label. -->
    <string name="monarch_sessionlist_confirm_title">Sign out %s?</string>
    <!-- MonarchSessionList: the title of the confirmation for the session showing the list. -->
    <string name="monarch_sessionlist_confirm_title_current">Sign out of this device?</string>
    <!-- MonarchSessionList: the text of the confirmation for another session. -->
    <string name="monarch_sessionlist_confirm_message">That device will need to sign in again.</string>
    <!-- MonarchSessionList: the text of the confirmation for the session showing the list. -->
    <string name="monarch_sessionlist_confirm_message_current">You’ll need to sign in again on this device.</string>
    <!-- MonarchSessionList: the title of the confirmation for every other session. -->
    <string name="monarch_sessionlist_others_title">Sign out other devices?</string>
    <!-- MonarchSessionList: the text of the confirmation for every other session; %d is their number. -->
    <plurals name="monarch_sessionlist_others_message">
        <item quantity="one">%d other device will be signed out and need to sign in again. This device stays signed in.</item>
        <item quantity="other">%d other devices will be signed out and need to sign in again. This device stays signed in.</item>
    </plurals>
    <!-- MonarchSessionList: the button that closes a confirmation. -->
    <string name="monarch_sessionlist_cancel">Cancel</string>
    <!-- MonarchSessionList: announced after one session is signed out; %s is its label. -->
    <string name="monarch_sessionlist_signed_out">Signed out %s</string>
    <!-- MonarchSessionList: announced after every other session is signed out; %d is their number. -->
    <plurals name="monarch_sessionlist_signed_out_others">
        <item quantity="one">Signed out %d other device</item>
        <item quantity="other">Signed out %d other devices</item>
    </plurals>
    <!-- MonarchSessionList: shown and announced when signing one session out failed; %s is its label. -->
    <string name="monarch_sessionlist_sign_out_failed">Couldn’t sign out %s. Try again.</string>
    <!-- MonarchSessionList: shown and announced when signing the other sessions out failed. -->
    <string name="monarch_sessionlist_sign_out_others_failed">Couldn’t sign out the other devices. Try again.</string>
    <!-- MonarchSessionList: the loading state. -->
    <string name="monarch_sessionlist_loading">Loading sessions</string>
    <!-- MonarchSessionList: the title of the empty state. -->
    <string name="monarch_sessionlist_empty_title">No active sessions</string>
    <!-- MonarchSessionList: the title of the failed state. -->
    <string name="monarch_sessionlist_error_title">Couldn’t load your sessions</string>
</resources>
