<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiBackgroundTasks: the button text and the panel heading. -->
    <string name="monarch_aibackgroundtasks_title">Background tasks</string>
    <!-- MonarchAiBackgroundTasks: the button badge; %1$d is the number of running tasks. -->
    <plurals name="monarch_aibackgroundtasks_running_count">
        <item quantity="one">%1$d running</item>
        <item quantity="other">%1$d running</item>
    </plurals>
    <!-- MonarchAiBackgroundTasks: the button badge while only queued tasks wait; %1$d is their number. -->
    <plurals name="monarch_aibackgroundtasks_queued_count">
        <item quantity="one">%1$d queued</item>
        <item quantity="other">%1$d queued</item>
    </plurals>
    <!-- MonarchAiBackgroundTasks: the button badge; %1$d is the number of tasks waiting on the person. -->
    <plurals name="monarch_aibackgroundtasks_needs_input_count">
        <item quantity="one">%1$d needs you</item>
        <item quantity="other">%1$d need you</item>
    </plurals>
    <!-- MonarchAiBackgroundTasks: the heading of tasks waiting on the person. -->
    <string name="monarch_aibackgroundtasks_group_needs_input">Needs you</string>
    <!-- MonarchAiBackgroundTasks: the heading of running and queued tasks. -->
    <string name="monarch_aibackgroundtasks_group_running">Running</string>
    <!-- MonarchAiBackgroundTasks: the heading of finished tasks. -->
    <string name="monarch_aibackgroundtasks_group_finished">Finished</string>
    <!-- MonarchAiBackgroundTasks: a heading with its count; %1$s is the heading, %2$d the count. -->
    <string name="monarch_aibackgroundtasks_group_heading">%1$s (%2$d)</string>
    <!-- MonarchAiBackgroundTasks: the status word of a queued task. -->
    <string name="monarch_aibackgroundtasks_status_queued">Queued</string>
    <!-- MonarchAiBackgroundTasks: the status word of a running task. -->
    <string name="monarch_aibackgroundtasks_status_running">Running</string>
    <!-- MonarchAiBackgroundTasks: the status word of a task waiting on the person. -->
    <string name="monarch_aibackgroundtasks_status_needs_input">Needs your input</string>
    <!-- MonarchAiBackgroundTasks: the status word of a task that succeeded. -->
    <string name="monarch_aibackgroundtasks_status_succeeded">Done</string>
    <!-- MonarchAiBackgroundTasks: the status word of a task that failed. -->
    <string name="monarch_aibackgroundtasks_status_failed">Failed</string>
    <!-- MonarchAiBackgroundTasks: the status word of a cancelled task. -->
    <string name="monarch_aibackgroundtasks_status_cancelled">Cancelled</string>
    <!-- MonarchAiBackgroundTasks: how long a task has run; %1$s is the duration, such as 3 min 12 sec. -->
    <string name="monarch_aibackgroundtasks_elapsed">Running for %1$s</string>
    <!-- MonarchAiBackgroundTasks: when a task ended; %1$s is relative text, such as 5 minutes ago. -->
    <string name="monarch_aibackgroundtasks_ended">Ended %1$s</string>
    <!-- MonarchAiBackgroundTasks: the name of a task's progress bar; %1$s is the task title. -->
    <string name="monarch_aibackgroundtasks_progress_label">%1$s progress</string>
    <!-- MonarchAiBackgroundTasks: the Open button of a task. -->
    <string name="monarch_aibackgroundtasks_open">Open</string>
    <!-- MonarchAiBackgroundTasks: the Cancel button of a queued, running or waiting task. -->
    <string name="monarch_aibackgroundtasks_cancel">Cancel</string>
    <!-- MonarchAiBackgroundTasks: the Retry button of a failed task. -->
    <string name="monarch_aibackgroundtasks_retry">Retry</string>
    <!-- MonarchAiBackgroundTasks: the Respond button of a task that needs input. -->
    <string name="monarch_aibackgroundtasks_respond">Respond</string>
    <!-- MonarchAiBackgroundTasks: the Dismiss button of a finished task. -->
    <string name="monarch_aibackgroundtasks_dismiss">Dismiss</string>
    <!-- MonarchAiBackgroundTasks: the button that removes every finished task. -->
    <string name="monarch_aibackgroundtasks_clear_finished">Clear finished</string>
    <!-- MonarchAiBackgroundTasks: what TalkBack reads for a task's button; %1$s is the action, %2$s the title. -->
    <string name="monarch_aibackgroundtasks_action_label">%1$s: %2$s</string>
    <!-- MonarchAiBackgroundTasks: shown when there are no tasks. -->
    <string name="monarch_aibackgroundtasks_empty">No background tasks</string>
    <!-- MonarchAiBackgroundTasks: announced when a task changes; %1$s is the title, %2$s the status word. -->
    <string name="monarch_aibackgroundtasks_announce">%1$s: %2$s</string>
</resources>
