<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken value of a star of a MonarchRatingPicker. %1$d is the value, %2$d the last value of the scale. -->
    <string name="monarch_ratingpicker_value">%1$d of %2$d</string>
    <!-- Spoken value of a labelled star. %1$d is the value, %2$d the last value, %3$s the value's label. -->
    <string name="monarch_ratingpicker_value_label">%1$d of %2$d, %3$s</string>
    <!-- Spoken value of a read-only MonarchRatingPicker without a rating. -->
    <string name="monarch_ratingpicker_none">No rating</string>
    <!-- Name of the action of a MonarchRatingPicker that clears the rating. -->
    <string name="monarch_ratingpicker_clear">Clear rating</string>
</resources>
