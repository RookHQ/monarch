<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the select-all checkbox of a MonarchDataGrid. -->
    <string name="monarch_datagrid_select_all">Select all rows</string>
    <!-- Spoken name of a row's checkbox in a MonarchDataGrid. %1$s is the row's name. -->
    <string name="monarch_datagrid_select_row">Select %1$s</string>
    <!-- Shown beside the select-all checkbox of a MonarchDataGrid in the list layout: the number of selected rows. -->
    <plurals name="monarch_datagrid_selected_count">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>
    <!-- Spoken name of a row's actions button in a MonarchDataGrid. %1$s is the row's name. -->
    <string name="monarch_datagrid_row_actions">Actions for %1$s</string>
    <!-- Visible text of a row's actions button in a MonarchDataGrid when the app gives no icon. -->
    <string name="monarch_datagrid_actions_text">Actions</string>
    <!-- Name of the tap action of a MonarchDataGrid column header, which opens the column menu. -->
    <string name="monarch_datagrid_column_options">Column options</string>
    <!-- Column menu item of a MonarchDataGrid. -->
    <string name="monarch_datagrid_sort_ascending">Sort ascending</string>
    <!-- Column menu item of a MonarchDataGrid. -->
    <string name="monarch_datagrid_sort_descending">Sort descending</string>
    <!-- Column menu item of the sorted column of a MonarchDataGrid. -->
    <string name="monarch_datagrid_clear_sort">Clear sort</string>
    <!-- Column menu item of a MonarchDataGrid. -->
    <string name="monarch_datagrid_pin_start">Pin to start</string>
    <!-- Column menu item of a MonarchDataGrid. -->
    <string name="monarch_datagrid_pin_end">Pin to end</string>
    <!-- Column menu item of a pinned column of a MonarchDataGrid. -->
    <string name="monarch_datagrid_unpin">Unpin</string>
    <!-- Column menu item of a MonarchDataGrid. -->
    <string name="monarch_datagrid_hide_column">Hide column</string>
    <!-- Column menu item of a MonarchDataGrid that makes the column wider. -->
    <string name="monarch_datagrid_widen">Widen column</string>
    <!-- Column menu item of a MonarchDataGrid that makes the column narrower. -->
    <string name="monarch_datagrid_narrow">Narrow column</string>
    <!-- State of a sorted column header or of the sort button of a MonarchDataGrid. -->
    <string name="monarch_datagrid_sorted_ascending">Sorted ascending</string>
    <!-- State of a sorted column header or of the sort button of a MonarchDataGrid. -->
    <string name="monarch_datagrid_sorted_descending">Sorted descending</string>
    <!-- State of a column header or of the sort button of a MonarchDataGrid that is not sorted. -->
    <string name="monarch_datagrid_not_sorted">Not sorted</string>
    <!-- State of a column header of a MonarchDataGrid pinned to the start edge. -->
    <string name="monarch_datagrid_pinned_start">Pinned to start</string>
    <!-- State of a column header of a MonarchDataGrid pinned to the end edge. -->
    <string name="monarch_datagrid_pinned_end">Pinned to end</string>
    <!-- Visible mark after a header of a MonarchDataGrid sorted ascending. Not read by TalkBack. -->
    <string name="monarch_datagrid_mark_ascending">↑</string>
    <!-- Visible mark after a header of a MonarchDataGrid sorted descending. Not read by TalkBack. -->
    <string name="monarch_datagrid_mark_descending">↓</string>
    <!-- Spoken name of an editable cell of a MonarchDataGrid. %1$s is the column, %2$s the row's name. -->
    <string name="monarch_datagrid_edit_label">%1$s for %2$s</string>
    <!-- A read-only cell of a MonarchDataGrid as TalkBack reads it. %1$s is the column, %2$s the value. -->
    <string name="monarch_datagrid_cell">%1$s: %2$s</string>
    <!-- Name of the tap action of a MonarchDataGrid row that opens, read as "Double-tap to open details". -->
    <string name="monarch_datagrid_open">Open details</string>
    <!-- Name of the tap action of a record of a MonarchDataGrid in the list layout that opens its editor. -->
    <string name="monarch_datagrid_edit_record">Edit</string>
    <!-- Sort button above the records of a MonarchDataGrid in the list layout. -->
    <string name="monarch_datagrid_sort">Sort</string>
    <!-- Button that closes the record editor of a MonarchDataGrid in the list layout. -->
    <string name="monarch_datagrid_done">Done</string>
    <!-- Shown in an empty cell of a MonarchDataGrid. Not read by TalkBack, which reads the no-value text. -->
    <string name="monarch_datagrid_empty_cell">—</string>
    <!-- Read by TalkBack for an empty cell of a MonarchDataGrid. -->
    <string name="monarch_datagrid_no_value">No value</string>
    <!-- Spoken name of the loading indicator of a MonarchDataGrid. -->
    <string name="monarch_datagrid_loading">Loading rows</string>
    <!-- Title of the empty state of a MonarchDataGrid without rows. -->
    <string name="monarch_datagrid_empty_title">Nothing here yet</string>
    <!-- Message of the empty state of a MonarchDataGrid without rows. -->
    <string name="monarch_datagrid_empty_message">Rows appear here once they are added.</string>
</resources>
