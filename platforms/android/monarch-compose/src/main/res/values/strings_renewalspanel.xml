<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchRenewalsPanel, the panel title when the app gives none. -->
    <string name="monarch_renewalspanel_title">Renewals</string>
    <!-- MonarchRenewalsPanel, the name TalkBack gives the list of renewals. -->
    <string name="monarch_renewalspanel_list">Renewals</string>
    <!-- MonarchRenewalsPanel, the name TalkBack gives the filter options. -->
    <string name="monarch_renewalspanel_filters">Filter renewals</string>
    <!-- MonarchRenewalsPanel, the name TalkBack gives the totals. -->
    <string name="monarch_renewalspanel_totals">Totals by currency</string>
    <!-- MonarchRenewalsPanel, the day count of a renewal due today. -->
    <string name="monarch_renewalspanel_today">today</string>
    <!-- MonarchRenewalsPanel, the day count of a future renewal; %1$d is the number of days. -->
    <plurals name="monarch_renewalspanel_in_days">
        <item quantity="one">in %1$d day</item>
        <item quantity="other">in %1$d days</item>
    </plurals>
    <!-- MonarchRenewalsPanel, the day count of a past renewal; %1$d is the number of days. -->
    <plurals name="monarch_renewalspanel_days_ago">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
    <!-- MonarchRenewalsPanel, the notice deadline under the date; %1$s is the date. -->
    <string name="monarch_renewalspanel_notice_by">Notice by %1$s</string>
    <!-- MonarchRenewalsPanel, in place of a missing renewal date. -->
    <string name="monarch_renewalspanel_unknown_date">Unknown date</string>
    <!-- MonarchRenewalsPanel, in place of a missing amount. -->
    <string name="monarch_renewalspanel_unpriced">No price</string>
    <!-- MonarchRenewalsPanel, an item that renews by itself. -->
    <string name="monarch_renewalspanel_auto_renews">Auto-renews</string>
    <!-- MonarchRenewalsPanel, an item that must be renewed by hand. -->
    <string name="monarch_renewalspanel_manual_renewal">Manual renewal</string>
    <!-- MonarchRenewalsPanel, in place of a missing owner. -->
    <string name="monarch_renewalspanel_no_owner">No owner</string>
    <!-- MonarchRenewalsPanel, in place of a missing next step. -->
    <string name="monarch_renewalspanel_no_next_action">No next action</string>
    <!-- MonarchRenewalsPanel, the prefix of an overdue next step. -->
    <string name="monarch_renewalspanel_overdue">Overdue</string>
    <!-- MonarchRenewalsPanel, the badge of an open renewal that is close or past. -->
    <string name="monarch_renewalspanel_due_soon">Due soon</string>
    <!-- MonarchRenewalsPanel, the likelihood of renewing; %1$d is the percent. -->
    <string name="monarch_renewalspanel_probability">%1$d%% likely</string>
    <!-- MonarchRenewalsPanel, the heading of a total; %1$s is the currency code, %2$d the number of renewals. -->
    <plurals name="monarch_renewalspanel_total_in">
        <item quantity="one">%1$s · %2$d renewal</item>
        <item quantity="other">%1$s · %2$d renewals</item>
    </plurals>
    <!-- MonarchRenewalsPanel, the estimated part of a total; %1$s is the amount. -->
    <string name="monarch_renewalspanel_estimated">Includes %1$s estimated</string>
    <!-- MonarchRenewalsPanel, the heading of the count of items without a price. -->
    <string name="monarch_renewalspanel_unpriced_count">Without a price</string>
    <!-- MonarchRenewalsPanel, the line under the count of items without a price. -->
    <string name="monarch_renewalspanel_unpriced_hint">Not included in the totals.</string>
    <!-- MonarchRenewalsPanel, the row action. -->
    <string name="monarch_renewalspanel_action">Update</string>
    <!-- MonarchRenewalsPanel, what TalkBack reads for the row action; %1$s is the action, %2$s the item name. -->
    <string name="monarch_renewalspanel_action_for">%1$s %2$s</string>
    <!-- MonarchRenewalsPanel, the title of the empty state. -->
    <string name="monarch_renewalspanel_empty_title">No renewals coming up</string>
    <!-- MonarchRenewalsPanel, the message of the empty state. -->
    <string name="monarch_renewalspanel_empty_message">Items appear here when their renewal date comes into the selected window.</string>
    <!-- MonarchRenewalsPanel, the title of the error state. -->
    <string name="monarch_renewalspanel_error_title">Renewals could not be loaded.</string>
    <!-- MonarchRenewalsPanel, what TalkBack reads while the renewals load. -->
    <string name="monarch_renewalspanel_loading">Loading renewals</string>
    <!-- MonarchRenewalsPanel, the built-in status open. -->
    <string name="monarch_renewalspanel_status_open">Open</string>
    <!-- MonarchRenewalsPanel, the built-in status in_progress. -->
    <string name="monarch_renewalspanel_status_in_progress">In progress</string>
    <!-- MonarchRenewalsPanel, the built-in status renewed. -->
    <string name="monarch_renewalspanel_status_renewed">Renewed</string>
    <!-- MonarchRenewalsPanel, the built-in status lost. -->
    <string name="monarch_renewalspanel_status_lost">Lost</string>
    <!-- MonarchRenewalsPanel, the built-in status void. -->
    <string name="monarch_renewalspanel_status_void">No longer due</string>
    <!-- MonarchRenewalsPanel, the heading of the item column of the table. -->
    <string name="monarch_renewalspanel_column_item">Item</string>
    <!-- MonarchRenewalsPanel, the heading of the renewal column of the table. -->
    <string name="monarch_renewalspanel_column_renewal">Renewal</string>
    <!-- MonarchRenewalsPanel, the heading of the amount column of the table. -->
    <string name="monarch_renewalspanel_column_amount">Amount</string>
    <!-- MonarchRenewalsPanel, the heading of the status column of the table. -->
    <string name="monarch_renewalspanel_column_status">Status</string>
</resources>
