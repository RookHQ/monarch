<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of the column of country names in the data table of a MonarchWorldMap. -->
    <string name="monarch_worldmap_country">Country</string>
    <!-- Heading of the column of values in the data table of a MonarchWorldMap. -->
    <string name="monarch_worldmap_value">Value</string>
    <!-- Spoken name of the tiles under a MonarchWorldMap that hold values belonging to no single country, such as Global. -->
    <string name="monarch_worldmap_extras">Other values</string>
    <!-- Note under a MonarchWorldMap listing codes it cannot draw. %1$s is their names, %2$s their total, already formatted. -->
    <string name="monarch_worldmap_unplaced">Not on the map: %1$s (%2$s)</string>
    <!-- One country of a MonarchWorldMap as TalkBack reads it and as written under the map. %1$s is the country name, %2$s its value and details. -->
    <string name="monarch_worldmap_country_value">%1$s: %2$s</string>
    <!-- Spoken summary that names a MonarchWorldMap. %1$s is the number of countries, already formatted, %2$s the top three countries and their values. -->
    <plurals name="monarch_worldmap_summary">
        <item quantity="one">%1$s country. Highest: %2$s.</item>
        <item quantity="other">%1$s countries. Highest: %2$s.</item>
    </plurals>
</resources>
