<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Visible due text of a MonarchIssueCard. %1$s is the short day, such as "Mar 12". -->
    <string name="monarch_issuecard_due">Due %1$s</string>
    <!-- Word added after the due text of a MonarchIssueCard when the due day has passed. -->
    <string name="monarch_issuecard_overdue">Overdue</string>
    <!-- What TalkBack reads for the tags of a MonarchIssueCard. %1$s is the tag names joined with commas. -->
    <string name="monarch_issuecard_tags">Labels: %1$s</string>
    <!-- What TalkBack reads for the empty assignee slot of a MonarchIssueCard. -->
    <string name="monarch_issuecard_unassigned">Unassigned</string>
    <!-- What TalkBack reads for the assignee avatar of a MonarchIssueCard. %1$s is the person's name. -->
    <string name="monarch_issuecard_assignee">Assigned to %1$s</string>
    <!-- What TalkBack reads for the read-only status of a MonarchIssueCard. %1$s is the status name. -->
    <string name="monarch_issuecard_status">Status: %1$s</string>
    <!-- What TalkBack reads for the read-only priority of a MonarchIssueCard. %1$s is the level name, such as "High". -->
    <string name="monarch_issuecard_priority">Priority: %1$s</string>
</resources>
