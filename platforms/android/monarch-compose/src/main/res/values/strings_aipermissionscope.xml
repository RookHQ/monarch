<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiPermissionScope: the TalkBack name of the list of apps. -->
    <string name="monarch_aipermissionscope_label">What the AI can access</string>
    <!-- MonarchAiPermissionScope: the access of a read-only row when the AI has none. -->
    <string name="monarch_aipermissionscope_access_none">No access</string>
    <!-- MonarchAiPermissionScope: the access of a read-only row when the AI may read. -->
    <string name="monarch_aipermissionscope_access_read">Can read</string>
    <!-- MonarchAiPermissionScope: the access of a read-only row when the AI may read and edit. -->
    <string name="monarch_aipermissionscope_access_write">Can read and edit</string>
    <!-- MonarchAiPermissionScope: the choice of no access in the editable control. -->
    <string name="monarch_aipermissionscope_option_none">None</string>
    <!-- MonarchAiPermissionScope: the choice of read access in the editable control. -->
    <string name="monarch_aipermissionscope_option_read">Read</string>
    <!-- MonarchAiPermissionScope: the choice of read and edit access in the editable control. -->
    <string name="monarch_aipermissionscope_option_write">Write</string>
    <!-- MonarchAiPermissionScope: the TalkBack name of a row's control. %1$s is the app: "Access to Calendar". -->
    <string name="monarch_aipermissionscope_control">Access to %1$s</string>
    <!-- MonarchAiPermissionScope: the link under the list to the full permission settings. -->
    <string name="monarch_aipermissionscope_manage">Manage permissions</string>
    <!-- MonarchAiPermissionScope: shown when the AI has access to no app. -->
    <string name="monarch_aipermissionscope_empty">The AI has no access to any app.</string>
</resources>
