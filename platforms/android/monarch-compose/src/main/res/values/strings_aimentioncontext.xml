<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiMentionContext: the name of the list. -->
    <string name="monarch_aimentioncontext_label">Add context</string>
    <!-- MonarchAiMentionContext: the heading of documents, when results have more than one kind. -->
    <string name="monarch_aimentioncontext_group_doc">Documents</string>
    <!-- MonarchAiMentionContext: the heading of people, when results have more than one kind. -->
    <string name="monarch_aimentioncontext_group_person">People</string>
    <!-- MonarchAiMentionContext: the heading of records, when results have more than one kind. -->
    <string name="monarch_aimentioncontext_group_record">Records</string>
    <!-- MonarchAiMentionContext: the heading of apps, when results have more than one kind. -->
    <string name="monarch_aimentioncontext_group_app">Apps</string>
    <!-- MonarchAiMentionContext: shown and read while searching. -->
    <string name="monarch_aimentioncontext_loading">Searching…</string>
    <!-- MonarchAiMentionContext: shown when nothing matches; %1$s is the text typed after @. -->
    <string name="monarch_aimentioncontext_empty">Nothing matches “%1$s”</string>
    <!-- MonarchAiMentionContext: shown for an empty query with no results. -->
    <string name="monarch_aimentioncontext_type_to_search">Type to search</string>
    <!-- MonarchAiMentionContext: shown and read when the search failed. -->
    <string name="monarch_aimentioncontext_error">Couldn’t load results.</string>
    <!-- MonarchAiMentionContext: the button that repeats a failed search. -->
    <string name="monarch_aimentioncontext_retry">Retry</string>
    <!-- MonarchAiMentionContext: a result's token estimate; %1$s is the compact number. -->
    <plurals name="monarch_aimentioncontext_tokens">
        <item quantity="one">%1$s token</item>
        <item quantity="other">%1$s tokens</item>
    </plurals>
    <!-- MonarchAiMentionContext: read when results arrive; %1$d is the number of results. -->
    <plurals name="monarch_aimentioncontext_count">
        <item quantity="one">%1$d result</item>
        <item quantity="other">%1$d results</item>
    </plurals>
</resources>
