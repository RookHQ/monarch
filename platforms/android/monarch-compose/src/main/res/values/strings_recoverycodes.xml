<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchRecoveryCodes: the name TalkBack reads for the codes. -->
    <string name="monarch_recoverycodes_list_label">Recovery codes</string>
    <!-- MonarchRecoveryCodes: above the codes when some are used. %1$d is the codes left, %2$d the total. -->
    <plurals name="monarch_recoverycodes_remaining">
        <item quantity="one">%1$d of %2$d code left</item>
        <item quantity="other">%1$d of %2$d codes left</item>
    </plurals>
    <!-- MonarchRecoveryCodes: the state TalkBack reads for a used code. -->
    <string name="monarch_recoverycodes_used">Used</string>
    <!-- MonarchRecoveryCodes: the copy button. -->
    <string name="monarch_recoverycodes_copy">Copy codes</string>
    <!-- MonarchRecoveryCodes: the copy button after a copy. -->
    <string name="monarch_recoverycodes_copied">Copied</string>
    <!-- MonarchRecoveryCodes: the button that saves the codes to a text file through the system file picker. -->
    <string name="monarch_recoverycodes_download">Download</string>
    <!-- MonarchRecoveryCodes: announced after the codes were written to the chosen file. -->
    <string name="monarch_recoverycodes_downloaded">Recovery codes saved to a file.</string>
    <!-- MonarchRecoveryCodes: shown and announced when the chosen file cannot be written. -->
    <string name="monarch_recoverycodes_download_failed">The codes could not be saved to that file. Try again or copy them.</string>
    <!-- MonarchRecoveryCodes: the button that opens the share sheet to save the codes. -->
    <string name="monarch_recoverycodes_save">Save or share</string>
    <!-- MonarchRecoveryCodes: the button that shows hidden codes. -->
    <string name="monarch_recoverycodes_reveal">Show codes</string>
    <!-- MonarchRecoveryCodes: the button that hides the codes. -->
    <string name="monarch_recoverycodes_conceal">Hide codes</string>
    <!-- MonarchRecoveryCodes: shown while the codes are hidden. -->
    <string name="monarch_recoverycodes_concealed_hint">Your codes are hidden. Show them only where nobody can see your screen.</string>
    <!-- MonarchRecoveryCodes: the button that replaces the codes. -->
    <string name="monarch_recoverycodes_regenerate">Generate new codes</string>
    <!-- MonarchRecoveryCodes: the title of the confirmation before replacing the codes. -->
    <string name="monarch_recoverycodes_regenerate_title">Generate new recovery codes?</string>
    <!-- MonarchRecoveryCodes: the text of the confirmation before replacing the codes. -->
    <string name="monarch_recoverycodes_regenerate_description">Your current codes will stop working straight away. Save the new ones somewhere safe.</string>
    <!-- MonarchRecoveryCodes: the confirming button of the confirmation. -->
    <string name="monarch_recoverycodes_regenerate_confirm">Generate new codes</string>
    <!-- MonarchRecoveryCodes: the cancelling button of the confirmation. -->
    <string name="monarch_recoverycodes_cancel">Cancel</string>
    <!-- MonarchRecoveryCodes: announced after new codes arrive. -->
    <string name="monarch_recoverycodes_regenerated">New recovery codes generated. The old ones no longer work.</string>
    <!-- MonarchRecoveryCodes: the acknowledgement checkbox. -->
    <string name="monarch_recoverycodes_acknowledge">I have saved my recovery codes</string>
    <!-- MonarchRecoveryCodes: shown and announced when Continue is pressed without the checkbox. -->
    <string name="monarch_recoverycodes_acknowledge_missing">Confirm that you have saved the codes.</string>
    <!-- MonarchRecoveryCodes: the button that finishes the step. -->
    <string name="monarch_recoverycodes_continue">Continue</string>
</resources>
