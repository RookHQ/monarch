<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the chart and the list of a MonarchGanttTimeline, read by TalkBack. -->
    <string name="monarch_gantttimeline_timeline">Timeline</string>
    <!-- Heading of the row-label column of a MonarchGanttTimeline chart. -->
    <string name="monarch_gantttimeline_row_header">Item</string>
    <!-- Name of the zoom menu of a MonarchGanttTimeline. -->
    <string name="monarch_gantttimeline_zoom">Zoom</string>
    <!-- Zoom level of a MonarchGanttTimeline: four weeks. -->
    <string name="monarch_gantttimeline_zoom_week">Weeks</string>
    <!-- Zoom level of a MonarchGanttTimeline: thirteen weeks. -->
    <string name="monarch_gantttimeline_zoom_month">Months</string>
    <!-- Zoom level of a MonarchGanttTimeline: nine months. -->
    <string name="monarch_gantttimeline_zoom_quarter">Quarters</string>
    <!-- Zoom level of a MonarchGanttTimeline: two years. -->
    <string name="monarch_gantttimeline_zoom_year">Years</string>
    <!-- Name of the backward arrow of a MonarchGanttTimeline toolbar. -->
    <string name="monarch_gantttimeline_earlier">Earlier</string>
    <!-- Name of the forward arrow of a MonarchGanttTimeline toolbar. -->
    <string name="monarch_gantttimeline_later">Later</string>
    <!-- Today button of a MonarchGanttTimeline toolbar and the label of the today line. -->
    <string name="monarch_gantttimeline_today">Today</string>
    <!-- Name of the chart and list switch of a MonarchGanttTimeline. -->
    <string name="monarch_gantttimeline_view">View</string>
    <!-- Chart choice of the MonarchGanttTimeline switch. -->
    <string name="monarch_gantttimeline_chart">Chart</string>
    <!-- List choice of the MonarchGanttTimeline switch. -->
    <string name="monarch_gantttimeline_list">List</string>
    <!-- Label of the milestone lane of a MonarchGanttTimeline and heading of its milestones in the list. -->
    <string name="monarch_gantttimeline_milestones">Milestones</string>
    <!-- Visible hint above an editable MonarchGanttTimeline chart. -->
    <string name="monarch_gantttimeline_hint">Touch and hold a bar to move it, or one of its ends to change that date.</string>
    <!-- What TalkBack reads for a MonarchGanttTimeline bar. %1$s is the label, %2$s the first day, %3$s the last day. -->
    <string name="monarch_gantttimeline_bar">%1$s, %2$s to %3$s</string>
    <!-- What TalkBack reads for a one-day MonarchGanttTimeline marker. %1$s is the label, %2$s the day. -->
    <string name="monarch_gantttimeline_bar_day">%1$s, %2$s</string>
    <!-- A conflict of a MonarchGanttTimeline item in words. %1$s is the app's message. -->
    <string name="monarch_gantttimeline_conflict">Conflict: %1$s</string>
    <!-- What TalkBack reads for a MonarchGanttTimeline milestone. %1$s is the name, %2$s the date. -->
    <string name="monarch_gantttimeline_milestone">Milestone %1$s, %2$s</string>
    <!-- What TalkBack reads for a reached MonarchGanttTimeline milestone. %1$s is the name, %2$s the date. -->
    <string name="monarch_gantttimeline_milestone_done">Milestone %1$s, %2$s, done</string>
    <!-- Row text of a MonarchGanttTimeline item that ended before the visible window. %1$s is the date. -->
    <string name="monarch_gantttimeline_ended">Ended %1$s</string>
    <!-- Row text of a MonarchGanttTimeline item that starts after the visible window. %1$s is the date. -->
    <string name="monarch_gantttimeline_starts">Starts %1$s</string>
    <!-- Row text of a MonarchGanttTimeline item without dates. -->
    <string name="monarch_gantttimeline_no_dates">No dates</string>
    <!-- Heading of the MonarchGanttTimeline items without dates. -->
    <plurals name="monarch_gantttimeline_unscheduled">
        <item quantity="one">Unscheduled · %1$d without dates</item>
        <item quantity="other">Unscheduled · %1$d without dates</item>
    </plurals>
    <!-- Announced after a MonarchGanttTimeline item's dates change. %1$s is the label, %2$s and %3$s the days. -->
    <string name="monarch_gantttimeline_changed">%1$s: %2$s to %3$s</string>
    <!-- Button of a MonarchGanttTimeline list row that opens the date range picker. -->
    <string name="monarch_gantttimeline_change_dates">Change dates</string>
    <!-- Confirm button of the MonarchGanttTimeline date range picker. -->
    <string name="monarch_gantttimeline_save">Save</string>
    <!-- Dismiss button of the MonarchGanttTimeline date range picker. -->
    <string name="monarch_gantttimeline_cancel">Cancel</string>
    <!-- Length of a MonarchGanttTimeline item. -->
    <plurals name="monarch_gantttimeline_duration">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <!-- Completion of a MonarchGanttTimeline item. %1$s is a percentage such as 60%. -->
    <string name="monarch_gantttimeline_progress">%1$s complete</string>
    <!-- The items a MonarchGanttTimeline item depends on. %1$s is a list of names. -->
    <string name="monarch_gantttimeline_depends_on">Depends on %1$s</string>
    <!-- State of a MonarchGanttTimeline parent whose children are shown. -->
    <string name="monarch_gantttimeline_expanded">Expanded</string>
    <!-- State of a MonarchGanttTimeline parent whose children are hidden. -->
    <string name="monarch_gantttimeline_collapsed">Collapsed</string>
    <!-- Visible caption of a MonarchGanttTimeline parent whose children are shown. -->
    <plurals name="monarch_gantttimeline_hide_children">
        <item quantity="one">Hide %1$d sub-item</item>
        <item quantity="other">Hide %1$d sub-items</item>
    </plurals>
    <!-- Visible caption of a MonarchGanttTimeline parent whose children are hidden. -->
    <plurals name="monarch_gantttimeline_show_children">
        <item quantity="one">Show %1$d sub-item</item>
        <item quantity="other">Show %1$d sub-items</item>
    </plurals>
    <!-- TalkBack action of a MonarchGanttTimeline bar. -->
    <string name="monarch_gantttimeline_move_earlier">Move a day earlier</string>
    <!-- TalkBack action of a MonarchGanttTimeline bar. -->
    <string name="monarch_gantttimeline_move_later">Move a day later</string>
    <!-- TalkBack action of a MonarchGanttTimeline bar. -->
    <string name="monarch_gantttimeline_start_earlier">Start a day earlier</string>
    <!-- TalkBack action of a MonarchGanttTimeline bar. -->
    <string name="monarch_gantttimeline_start_later">Start a day later</string>
    <!-- TalkBack action of a MonarchGanttTimeline bar. -->
    <string name="monarch_gantttimeline_end_earlier">End a day earlier</string>
    <!-- TalkBack action of a MonarchGanttTimeline bar. -->
    <string name="monarch_gantttimeline_end_later">End a day later</string>
    <!-- The visible window in a MonarchGanttTimeline toolbar. %1$s is the first day, %2$s the last. -->
    <string name="monarch_gantttimeline_range">%1$s – %2$s</string>
</resources>
