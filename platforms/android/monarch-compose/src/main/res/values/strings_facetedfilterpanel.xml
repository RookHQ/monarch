<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchFacetedFilterPanel, and the name TalkBack reads for the panel. -->
    <string name="monarch_facetedfilterpanel_title">Filters</string>
    <!-- Button of a MonarchFacetedFilterPanel that clears every filter. -->
    <string name="monarch_facetedfilterpanel_clear_all">Clear all</string>
    <!-- Visible button of a MonarchFacetedFilterPanel that clears the filters of one group. -->
    <string name="monarch_facetedfilterpanel_clear_group">Clear</string>
    <!-- What TalkBack reads for the button that clears one group. %1$s is the group name, such as Status. -->
    <string name="monarch_facetedfilterpanel_clear_group_label">Clear %1$s filter</string>
    <!-- Number of active filters in a group of a MonarchFacetedFilterPanel, shown under its name. -->
    <plurals name="monarch_facetedfilterpanel_active_count">
        <item quantity="one">%d selected</item>
        <item quantity="other">%d selected</item>
    </plurals>
    <!-- Button of a MonarchFacetedFilterPanel group that shows its hidden options. %d is how many are hidden. -->
    <plurals name="monarch_facetedfilterpanel_show_more">
        <item quantity="one">Show %d more</item>
        <item quantity="other">Show %d more</item>
    </plurals>
    <!-- Button of a MonarchFacetedFilterPanel group that hides the options again. -->
    <string name="monarch_facetedfilterpanel_show_fewer">Show fewer</string>
    <!-- Shown in an options group of a MonarchFacetedFilterPanel that has no options. -->
    <string name="monarch_facetedfilterpanel_no_options">No options</string>
    <!-- The chosen range of a range group. %1$s is the minimum, %2$s the maximum, each with its unit. -->
    <string name="monarch_facetedfilterpanel_range">%1$s – %2$s</string>
    <!-- State TalkBack reads for an open group of a MonarchFacetedFilterPanel. -->
    <string name="monarch_facetedfilterpanel_expanded">Expanded</string>
    <!-- State TalkBack reads for a closed group of a MonarchFacetedFilterPanel. -->
    <string name="monarch_facetedfilterpanel_collapsed">Collapsed</string>
    <!-- The label of the minimum field of a range group. -->
    <string name="monarch_facetedfilterpanel_minimum">Minimum</string>
    <!-- The label of the maximum field of a range group. -->
    <string name="monarch_facetedfilterpanel_maximum">Maximum</string>
</resources>
