<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchConnectedAppsList: the title when the app gives none. -->
    <string name="monarch_connectedappslist_title">Connected apps</string>
    <!-- MonarchConnectedAppsList: the line under the title when the app gives none. -->
    <string name="monarch_connectedappslist_description">Apps you signed in to with your account, and what they can see.</string>
    <!-- MonarchConnectedAppsList: the spoken name of the list. -->
    <string name="monarch_connectedappslist_list_label">Connected apps</string>
    <!-- MonarchConnectedAppsList: the badge of an app the identity provider reviewed. -->
    <string name="monarch_connectedappslist_verified">Verified</string>
    <!-- MonarchConnectedAppsList: the badge of a suspended app. -->
    <string name="monarch_connectedappslist_suspended">Suspended</string>
    <!-- MonarchConnectedAppsList: before the time the app was connected, as in "Connected 3 days ago". -->
    <string name="monarch_connectedappslist_connected">Connected</string>
    <!-- MonarchConnectedAppsList: before the time the app last used its access, as in "Last used 2 hours ago". -->
    <string name="monarch_connectedappslist_last_used">Last used</string>
    <!-- MonarchConnectedAppsList: before the workspace of a grant, as in "Workspace: Acme". -->
    <string name="monarch_connectedappslist_workspace">Workspace:</string>
    <!-- MonarchConnectedAppsList: the spoken name of an app's scope list; %s is the app's name. -->
    <string name="monarch_connectedappslist_scopes_label">What %s can access</string>
    <!-- MonarchConnectedAppsList: the row button and the confirm button. -->
    <string name="monarch_connectedappslist_revoke">Remove access</string>
    <!-- MonarchConnectedAppsList: the spoken name of a row button; %s is the app's name. -->
    <string name="monarch_connectedappslist_revoke_label">Remove access for %s</string>
    <!-- MonarchConnectedAppsList: the title of the confirmation; %s is the app's name. -->
    <string name="monarch_connectedappslist_confirm_title">Remove access for %s?</string>
    <!-- MonarchConnectedAppsList: the text of the confirmation. -->
    <string name="monarch_connectedappslist_confirm_message">You’ll be signed out of this app and it won’t see your information any more. You can sign in to it again later.</string>
    <!-- MonarchConnectedAppsList: the button that closes the confirmation. -->
    <string name="monarch_connectedappslist_cancel">Cancel</string>
    <!-- MonarchConnectedAppsList: announced after access is removed; %s is the app's name. -->
    <string name="monarch_connectedappslist_revoked">Removed access for %s</string>
    <!-- MonarchConnectedAppsList: shown and announced when removal failed without a message; %s is the app's name. -->
    <string name="monarch_connectedappslist_revoke_failed">Couldn’t remove access for %s. Try again.</string>
    <!-- MonarchConnectedAppsList: the loading state. -->
    <string name="monarch_connectedappslist_loading">Loading connected apps</string>
    <!-- MonarchConnectedAppsList: the title of the empty state. -->
    <string name="monarch_connectedappslist_empty_title">No connected apps</string>
    <!-- MonarchConnectedAppsList: the line under the empty state. -->
    <string name="monarch_connectedappslist_empty_message">When you sign in to an app with your account, it shows up here.</string>
    <!-- MonarchConnectedAppsList: the title of the error state. -->
    <string name="monarch_connectedappslist_error_title">Couldn’t load your connected apps</string>
</resources>
