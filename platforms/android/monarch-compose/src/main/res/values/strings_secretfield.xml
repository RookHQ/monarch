<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the reveal toggle of a MonarchSecretField, the same in both states. %1$s is the field's label, such as API key. -->
    <string name="monarch_secretfield_show_name">Show %1$s</string>
    <!-- Visible text of the reveal toggle of a MonarchSecretField while the secret is masked. -->
    <string name="monarch_secretfield_show">Show</string>
    <!-- Visible text of the reveal toggle of a MonarchSecretField while the secret is shown. -->
    <string name="monarch_secretfield_hide">Hide</string>
    <!-- Placeholder of a MonarchSecretField while a saved secret is not shown and nothing is typed. -->
    <string name="monarch_secretfield_saved_placeholder">Saved. Enter a new value to replace it</string>
    <!-- Supporting text of a MonarchSecretField while a saved secret is not shown and nothing is typed. -->
    <string name="monarch_secretfield_saved_description">A value is saved and hidden. Leave blank to keep it.</string>
</resources>
