<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchColumnChooser. -->
    <string name="monarch_columnchooser_title">Columns</string>
    <!-- Count under the heading of a MonarchColumnChooser: shown columns (1) of all columns (2). -->
    <plurals name="monarch_columnchooser_shown_count">
        <item quantity="one">%1$d of %2$d shown</item>
        <item quantity="other">%1$d of %2$d shown</item>
    </plurals>
    <!-- Placeholder and name of the search field of a MonarchColumnChooser. -->
    <string name="monarch_columnchooser_search">Find a column</string>
    <!-- Shown in a MonarchColumnChooser when the search matches no column. -->
    <string name="monarch_columnchooser_no_matches">No columns match.</string>
    <!-- Note under a column of a MonarchColumnChooser that cannot be hidden. -->
    <string name="monarch_columnchooser_required">Always shown</string>
    <!-- Button of a MonarchColumnChooser that shows every column. -->
    <string name="monarch_columnchooser_show_all">Show all</string>
    <!-- Button of a MonarchColumnChooser that restores the app's default columns. -->
    <string name="monarch_columnchooser_reset">Reset</string>
    <!-- Name of the clear button of the search field of a MonarchColumnChooser. -->
    <string name="monarch_columnchooser_clear_search">Clear search</string>
    <!-- Name of the button of a MonarchColumnChooser that moves a column up. %1$s is the column. -->
    <string name="monarch_columnchooser_move_up">Move %1$s up</string>
    <!-- Name of the button of a MonarchColumnChooser that moves a column down. %1$s is the column. -->
    <string name="monarch_columnchooser_move_down">Move %1$s down</string>
</resources>
