<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Count under a MonarchRichTextEditor without a limit, shown and read. %1$s is the number of characters. -->
    <plurals name="monarch_richtexteditor_count">
        <item quantity="one">%1$s character</item>
        <item quantity="other">%1$s characters</item>
    </plurals>
    <!-- Visible count under a MonarchRichTextEditor with a limit. %1$s is the characters, %2$s the limit. -->
    <string name="monarch_richtexteditor_count_of_limit">%1$s / %2$s</string>
    <!-- Spoken count of a MonarchRichTextEditor with a limit. %1$s is the number of characters left. -->
    <plurals name="monarch_richtexteditor_remaining">
        <item quantity="one">%1$s character left</item>
        <item quantity="other">%1$s characters left</item>
    </plurals>
    <!-- Spoken count and field error of a MonarchRichTextEditor past its limit. %1$s is the characters over. -->
    <plurals name="monarch_richtexteditor_over">
        <item quantity="one">%1$s character over the limit</item>
        <item quantity="other">%1$s characters over the limit</item>
    </plurals>
</resources>
