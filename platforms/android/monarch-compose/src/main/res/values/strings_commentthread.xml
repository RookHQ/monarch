<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of a MonarchCommentThread. %1$s is the author of the first comment. -->
    <string name="monarch_commentthread_label">Thread started by %1$s</string>
    <!-- What TalkBack reads for the quote of a MonarchCommentThread. %1$s is the quoted text. -->
    <string name="monarch_commentthread_quote">Quoted text: %1$s</string>
    <!-- Button of a MonarchCommentThread that shows folded replies. %1$d is their number. -->
    <plurals name="monarch_commentthread_show_earlier">
        <item quantity="one">Show %1$d earlier reply</item>
        <item quantity="other">Show %1$d earlier replies</item>
    </plurals>
    <!-- TalkBack name of the reply field of a MonarchCommentThread. -->
    <string name="monarch_commentthread_reply">Reply</string>
    <!-- Placeholder of the empty reply field of a MonarchCommentThread. -->
    <string name="monarch_commentthread_reply_placeholder">Reply…</string>
    <!-- Send button of the reply field of a MonarchCommentThread. -->
    <string name="monarch_commentthread_send">Send reply</string>
    <!-- Button of a MonarchCommentThread that resolves it. -->
    <string name="monarch_commentthread_resolve">Resolve</string>
    <!-- Button of a resolved MonarchCommentThread that reopens it. -->
    <string name="monarch_commentthread_reopen">Reopen</string>
    <!-- Badge of a resolved MonarchCommentThread. -->
    <string name="monarch_commentthread_resolved">Resolved</string>
    <!-- Shown instead of the reply field of a resolved MonarchCommentThread. -->
    <string name="monarch_commentthread_resolved_hint">This thread is resolved. Reopen it to reply.</string>
    <!-- Announced after a MonarchCommentThread is resolved. -->
    <string name="monarch_commentthread_resolved_notice">Thread resolved</string>
    <!-- Announced after a MonarchCommentThread is reopened. -->
    <string name="monarch_commentthread_reopened_notice">Thread reopened</string>
    <!-- Announced after a reply is posted to a MonarchCommentThread. -->
    <string name="monarch_commentthread_sent_notice">Reply sent</string>
    <!-- Shown when replying, resolving, reopening or deleting in a MonarchCommentThread fails. -->
    <string name="monarch_commentthread_action_failed">That didn’t work. Try again.</string>
    <!-- Menu and TalkBack action of a comment in a MonarchCommentThread that deletes it. -->
    <string name="monarch_commentthread_delete_comment">Delete comment</string>
    <!-- Title of the dialog that confirms deleting a comment of a MonarchCommentThread. -->
    <string name="monarch_commentthread_delete_title">Delete this comment?</string>
    <!-- Text of the dialog that confirms deleting a comment of a MonarchCommentThread. -->
    <string name="monarch_commentthread_delete_description">It is removed for everyone. This can’t be undone.</string>
    <!-- Confirm button of the dialog that deletes a comment of a MonarchCommentThread. -->
    <string name="monarch_commentthread_delete_confirm">Delete comment</string>
    <!-- Cancel button of the dialog that deletes a comment of a MonarchCommentThread. -->
    <string name="monarch_commentthread_cancel">Cancel</string>
</resources>
