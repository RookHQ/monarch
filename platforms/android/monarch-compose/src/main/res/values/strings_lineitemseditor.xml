<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchLineItemsEditor, the heading of the editor. -->
    <string name="monarch_lineitemseditor_label">Line items</string>
    <!-- MonarchLineItemsEditor, the header of a row: "Item 2". %1$d the 1-based row number. -->
    <string name="monarch_lineitemseditor_item">Item %1$d</string>
    <!-- MonarchLineItemsEditor, the label of a row's description field. -->
    <string name="monarch_lineitemseditor_description">Description</string>
    <!-- MonarchLineItemsEditor, the label of a row's quantity field. -->
    <string name="monarch_lineitemseditor_quantity">Quantity</string>
    <!-- MonarchLineItemsEditor, the label of a row's unit price field: "Unit price (USD)". %1$s the currency code. -->
    <string name="monarch_lineitemseditor_unit_price">Unit price (%1$s)</string>
    <!-- MonarchLineItemsEditor, the name of a row's amount when its header is read. -->
    <string name="monarch_lineitemseditor_amount">Amount</string>
    <!-- MonarchLineItemsEditor, the placeholder of an empty description field. -->
    <string name="monarch_lineitemseditor_description_placeholder">Item or service</string>
    <!-- MonarchLineItemsEditor, the button that adds a row. -->
    <string name="monarch_lineitemseditor_add_item">Add item</string>
    <!-- MonarchLineItemsEditor, the visible text of a row's remove button and of its swipe background. -->
    <string name="monarch_lineitemseditor_remove">Remove</string>
    <!-- MonarchLineItemsEditor, the spoken name of a row's remove button: "Remove item 2: Design hours". %1$d row number, %2$s description. -->
    <string name="monarch_lineitemseditor_remove_item">Remove item %1$d: %2$s</string>
    <!-- MonarchLineItemsEditor, the spoken name of the remove button of a row without a description: "Remove item 2". -->
    <string name="monarch_lineitemseditor_remove_item_untitled">Remove item %1$d</string>
    <!-- MonarchLineItemsEditor, shown in place of the rows when there are none. -->
    <string name="monarch_lineitemseditor_empty">No items yet. Add one to start.</string>
    <!-- MonarchLineItemsEditor, announced after a row is added: "Added item 3". -->
    <string name="monarch_lineitemseditor_added">Added item %1$d</string>
    <!-- MonarchLineItemsEditor, announced after a row is removed: "Removed item 2". -->
    <string name="monarch_lineitemseditor_removed">Removed item %1$d</string>
    <!-- MonarchLineItemsEditor, the subtotal row of the totals. -->
    <string name="monarch_lineitemseditor_subtotal">Subtotal</string>
    <!-- MonarchLineItemsEditor, the discount row of the totals and the label of its field. -->
    <string name="monarch_lineitemseditor_discount">Discount</string>
    <!-- MonarchLineItemsEditor, a total row with its rate: "Discount (5%)". %1$s the row name, %2$s the written rate. -->
    <string name="monarch_lineitemseditor_with_rate">%1$s (%2$s)</string>
    <!-- MonarchLineItemsEditor, the spoken name of the percent or amount choice of the discount. -->
    <string name="monarch_lineitemseditor_discount_type">Discount type</string>
    <!-- MonarchLineItemsEditor, the percent choice of the discount type. -->
    <string name="monarch_lineitemseditor_percent_option" formatted="false">%</string>
    <!-- MonarchLineItemsEditor, the tax row of the totals with its rate: "Tax (18%)". %1$s the written rate. -->
    <string name="monarch_lineitemseditor_tax_rate_title">Tax (%1$s)</string>
    <!-- MonarchLineItemsEditor, the tax row of the totals without a rate to show. -->
    <string name="monarch_lineitemseditor_tax">Tax</string>
    <!-- MonarchLineItemsEditor, the label of the tax rate field or menu. -->
    <string name="monarch_lineitemseditor_tax_rate">Tax rate</string>
    <!-- MonarchLineItemsEditor, the total row of the totals. -->
    <string name="monarch_lineitemseditor_total">Total</string>
    <!-- MonarchLineItemsEditor, said after the heading of a required editor: "Line items, Required". -->
    <string name="monarch_lineitemseditor_required">Required</string>
    <!-- MonarchLineItemsEditor, a read-only row's figures: "12 × $95.00". %1$s quantity, %2$s unit price. -->
    <string name="monarch_lineitemseditor_quantity_times_price">%1$s × %2$s</string>
    <!-- MonarchLineItemsEditor, two parts read as one: "Item 2, Amount $1,140.00", "Total, $2,257.13". -->
    <string name="monarch_lineitemseditor_pair">%1$s, %2$s</string>
    <!-- MonarchLineItemsEditor, a name and a value read together: "Amount $1,140.00". -->
    <string name="monarch_lineitemseditor_value">%1$s %2$s</string>
</resources>
