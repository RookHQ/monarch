<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of the menu button of a MonarchWidget. %1$s is the widget's title. -->
    <string name="monarch_widget_menu">More actions for %1$s</string>
    <!-- Visible text of the menu button of a MonarchWidget when the app gives no icon. -->
    <string name="monarch_widget_more">More</string>
    <!-- Visible text of the View all button of a MonarchWidget. -->
    <string name="monarch_widget_view_all">View all</string>
    <!-- TalkBack name of the View all button of a MonarchWidget. %1$s is the widget's title. -->
    <string name="monarch_widget_view_all_label">View all: %1$s</string>
    <!-- What TalkBack reads for the loading placeholder of a MonarchWidget. %1$s is the widget's title. -->
    <string name="monarch_widget_loading">Loading %1$s</string>
    <!-- Failure shown by a MonarchWidget when the app gives no message. -->
    <string name="monarch_widget_error">This section could not be loaded.</string>
    <!-- Title of the empty state of a MonarchWidget when the app gives no message. -->
    <string name="monarch_widget_empty">Nothing to show yet</string>
    <!-- Footer line of a MonarchWidget. %1$s is a relative time such as "5 minutes ago". -->
    <string name="monarch_widget_updated">Updated %1$s</string>
</resources>
