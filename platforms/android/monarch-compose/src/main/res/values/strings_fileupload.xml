<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main text of the zone of a MonarchFileUpload. -->
    <string name="monarch_fileupload_label">Choose files to upload</string>
    <!-- Button of a MonarchFileUpload that opens the system picker. -->
    <string name="monarch_fileupload_browse">Browse files</string>
    <!-- Hint of a MonarchFileUpload with a size limit: the largest size allowed per file. -->
    <string name="monarch_fileupload_limit_size">Up to %1$s each</string>
    <!-- Hint of a MonarchFileUpload with a count limit: the most files allowed. -->
    <plurals name="monarch_fileupload_limit_count">
        <item quantity="one">%1$d file max</item>
        <item quantity="other">%1$d files max</item>
    </plurals>
    <!-- How a MonarchFileUpload joins the size and the count limits in its hint. -->
    <string name="monarch_fileupload_limit_separator">" · "</string>
    <!-- Hint of a MonarchFileUpload once the most files allowed are attached. -->
    <plurals name="monarch_fileupload_limit_reached">
        <item quantity="one">Limit reached: %1$d file attached.</item>
        <item quantity="other">Limit reached: %1$d files attached.</item>
    </plurals>
    <!-- Refusal of a MonarchFileUpload for a file of a type that is not allowed: the file name. -->
    <string name="monarch_fileupload_invalid_type">%1$s is not an allowed file type.</string>
    <!-- Refusal of a MonarchFileUpload for a file over the size limit: the file name and the limit. -->
    <string name="monarch_fileupload_too_large">%1$s is larger than %2$s.</string>
    <!-- Refusal of a MonarchFileUpload for a file over the count limit: the file name and the limit. -->
    <plurals name="monarch_fileupload_too_many">
        <item quantity="one">%1$s was not added: up to %2$d file.</item>
        <item quantity="other">%1$s was not added: up to %2$d files.</item>
    </plurals>
    <!-- Announced by a MonarchFileUpload after files are accepted: their number. -->
    <plurals name="monarch_fileupload_added">
        <item quantity="one">%1$d file added.</item>
        <item quantity="other">%1$d files added.</item>
    </plurals>
</resources>
