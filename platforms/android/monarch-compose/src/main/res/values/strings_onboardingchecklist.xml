<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchOnboardingChecklist, the progress under the heading: "2 of 5 done". %1$d done steps, %2$d all steps (the quantity). -->
    <plurals name="monarch_onboardingchecklist_progress">
        <item quantity="one">%1$d of %2$d done</item>
        <item quantity="other">%1$d of %2$d done</item>
    </plurals>
    <!-- MonarchOnboardingChecklist, the spoken name of the progress bar. -->
    <string name="monarch_onboardingchecklist_progress_label">Setup progress</string>
    <!-- MonarchOnboardingChecklist, the label of the dismiss button, or its spoken name when it shows an icon. -->
    <string name="monarch_onboardingchecklist_dismiss">Dismiss checklist</string>
    <!-- MonarchOnboardingChecklist, the state TalkBack reads for a done step. -->
    <string name="monarch_onboardingchecklist_done">Done</string>
    <!-- MonarchOnboardingChecklist, the state TalkBack reads for a step that is not done. -->
    <string name="monarch_onboardingchecklist_not_done">Not done</string>
    <!-- MonarchOnboardingChecklist, added to the state of the first open step: "Not done, Current step". -->
    <string name="monarch_onboardingchecklist_current">Current step</string>
    <!-- MonarchOnboardingChecklist, the state of the first open step. %1$s the not-done state, %2$s the current word. -->
    <string name="monarch_onboardingchecklist_current_state">%1$s, %2$s</string>
    <!-- MonarchOnboardingChecklist, the message shown above the steps when every step is done. -->
    <string name="monarch_onboardingchecklist_complete">All done. You are set up.</string>
</resources>
