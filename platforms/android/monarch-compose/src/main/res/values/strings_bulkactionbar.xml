<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Count of a MonarchBulkActionBar when the total is known: the selected items and the total. Shown and announced. -->
    <plurals name="monarch_bulkactionbar_selected_of">
        <item quantity="one">%1$d of %2$d selected</item>
        <item quantity="other">%1$d of %2$d selected</item>
    </plurals>
    <!-- Count of a MonarchBulkActionBar when the total is not known: the selected items. Shown and announced. -->
    <plurals name="monarch_bulkactionbar_selected">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>
    <!-- Announced by a MonarchBulkActionBar when the selection is emptied. -->
    <string name="monarch_bulkactionbar_cleared">Selection cleared</string>
    <!-- Label of the button of a MonarchBulkActionBar that empties the selection. -->
    <string name="monarch_bulkactionbar_clear">Clear selection</string>
    <!-- Label of the button of a MonarchBulkActionBar that opens the menu of the other actions. -->
    <string name="monarch_bulkactionbar_more">More</string>
    <!-- TalkBack name of a MonarchBulkActionBar. -->
    <string name="monarch_bulkactionbar_bar">Bulk actions</string>
</resources>
