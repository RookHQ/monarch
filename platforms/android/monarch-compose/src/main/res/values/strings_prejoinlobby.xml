<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchPreJoinLobby. -->
    <string name="monarch_prejoinlobby_title">Join the call</string>
    <!-- TalkBack name of the camera preview area of a MonarchPreJoinLobby. -->
    <string name="monarch_prejoinlobby_preview">Your camera preview</string>
    <!-- Shown in the preview of a MonarchPreJoinLobby while the camera is off. -->
    <string name="monarch_prejoinlobby_camera_off">Camera is off</string>
    <!-- Shown in the preview of a MonarchPreJoinLobby while the camera is starting. -->
    <string name="monarch_prejoinlobby_starting_camera">Starting camera…</string>
    <!-- Shown in the preview of a MonarchPreJoinLobby when the preview failed. -->
    <string name="monarch_prejoinlobby_no_preview">No preview</string>
    <!-- TalkBack name of the microphone meter of a MonarchPreJoinLobby. -->
    <string name="monarch_prejoinlobby_mic_level">Microphone level</string>
    <!-- Value of the microphone meter of a MonarchPreJoinLobby while the microphone is off. -->
    <string name="monarch_prejoinlobby_muted">Muted</string>
    <!-- TalkBack name of the avatars of the people already in the call, in a MonarchPreJoinLobby. -->
    <string name="monarch_prejoinlobby_participants">People in the call</string>
    <!-- Line next to the avatars in a MonarchPreJoinLobby. %1$d is the number of people already in the call. -->
    <plurals name="monarch_prejoinlobby_already_in">
        <item quantity="one">%1$d already in the call</item>
        <item quantity="other">%1$d already in the call</item>
    </plurals>
    <!-- Cancel button of a MonarchPreJoinLobby. -->
    <string name="monarch_prejoinlobby_cancel">Cancel</string>
    <!-- Join button of a MonarchPreJoinLobby. -->
    <string name="monarch_prejoinlobby_join">Join now</string>
    <!-- What TalkBack reads for the join button of a MonarchPreJoinLobby while joining. -->
    <string name="monarch_prejoinlobby_joining">Joining…</string>
</resources>
