<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiToolCall: the state badge while the call waits for a person to approve it. -->
    <string name="monarch_aitoolcall_state_pending_approval">Waiting for approval</string>
    <!-- MonarchAiToolCall: the state badge while the call waits for the app to send its result. -->
    <string name="monarch_aitoolcall_state_awaiting_result">Waiting for result</string>
    <!-- MonarchAiToolCall: the state badge while the tool runs. -->
    <string name="monarch_aitoolcall_state_running">Running</string>
    <!-- MonarchAiToolCall: the state badge once the tool finished. -->
    <string name="monarch_aitoolcall_state_succeeded">Done</string>
    <!-- MonarchAiToolCall: the state badge when the tool failed. -->
    <string name="monarch_aitoolcall_state_failed">Failed</string>
    <!-- MonarchAiToolCall: the state badge when a person or a policy denied the call. -->
    <string name="monarch_aitoolcall_state_denied">Denied</string>
    <!-- MonarchAiToolCall: the state badge when the reply ended before the tool finished. -->
    <string name="monarch_aitoolcall_state_cancelled">Cancelled</string>
    <!-- MonarchAiToolCall: a duration under a minute. %1$s is the number of seconds, such as 0.4 or 12. -->
    <string name="monarch_aitoolcall_duration_seconds">%1$ss</string>
    <!-- MonarchAiToolCall: a duration of a minute or more. %1$d is the minutes, %2$02d the seconds. -->
    <string name="monarch_aitoolcall_duration_minutes">%1$dm %2$02ds</string>
    <!-- MonarchAiToolCall: the heading of the arguments block. -->
    <string name="monarch_aitoolcall_input">Input</string>
    <!-- MonarchAiToolCall: the heading of the result block. -->
    <string name="monarch_aitoolcall_output">Output</string>
    <!-- MonarchAiToolCall: read before the error message under a failed call. -->
    <string name="monarch_aitoolcall_error">Error</string>
    <!-- MonarchAiToolCall: names the tool in the details, before its exact name. -->
    <string name="monarch_aitoolcall_tool">Tool</string>
    <!-- MonarchAiToolCall: shown in the details when the call has no input and no output yet. -->
    <string name="monarch_aitoolcall_empty">No details yet.</string>
    <!-- MonarchAiToolCall: a label and the text after it, as in "Tool: send_email" and "Error: Timed out". -->
    <string name="monarch_aitoolcall_labelled">%1$s: %2$s</string>
    <!-- MonarchAiToolCall: announced when the state changes. %1$s is the tool label, %2$s the new state. -->
    <string name="monarch_aitoolcall_state_changed">%1$s: %2$s</string>
    <!-- MonarchAiToolCall: the button that shows the rest of a long input or output. -->
    <string name="monarch_aitoolcall_show_more">Show all</string>
    <!-- MonarchAiToolCall: how much of a long value is shown. %1$s and %2$s are formatted character counts. -->
    <string name="monarch_aitoolcall_truncated">Showing %1$s of %2$s characters</string>
    <!-- MonarchAiToolCall: the state TalkBack reads on the header while the details are shown. -->
    <string name="monarch_aitoolcall_expanded">Expanded</string>
    <!-- MonarchAiToolCall: the state TalkBack reads on the header while the details are hidden. -->
    <string name="monarch_aitoolcall_collapsed">Collapsed</string>
</resources>
