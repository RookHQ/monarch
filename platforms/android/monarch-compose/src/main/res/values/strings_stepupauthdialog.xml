<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchStepUpAuthDialog: the title. -->
    <string name="monarch_stepupauthdialog_title">Confirm it’s you</string>
    <!-- MonarchStepUpAuthDialog: the line under the title when the app gives none. -->
    <string name="monarch_stepupauthdialog_description">This action needs you to confirm your identity again.</string>
    <!-- MonarchStepUpAuthDialog: the TalkBack name of the method tabs. -->
    <string name="monarch_stepupauthdialog_method_picker">Verification method</string>
    <!-- MonarchStepUpAuthDialog: the tab of the password method. -->
    <string name="monarch_stepupauthdialog_method_password">Password</string>
    <!-- MonarchStepUpAuthDialog: the tab of the authenticator code method. -->
    <string name="monarch_stepupauthdialog_method_code">Authenticator app</string>
    <!-- MonarchStepUpAuthDialog: the tab of the passkey method. -->
    <string name="monarch_stepupauthdialog_method_passkey">Passkey</string>
    <!-- MonarchStepUpAuthDialog: the tab of the device biometrics or screen lock method. -->
    <string name="monarch_stepupauthdialog_method_device_owner">This device</string>
    <!-- MonarchStepUpAuthDialog: the label of the password field. -->
    <string name="monarch_stepupauthdialog_password_label">Password</string>
    <!-- MonarchStepUpAuthDialog: the error of an empty password. -->
    <string name="monarch_stepupauthdialog_password_required">Enter your password.</string>
    <!-- MonarchStepUpAuthDialog: the label of the code field. -->
    <string name="monarch_stepupauthdialog_code_label">Authentication code</string>
    <!-- MonarchStepUpAuthDialog: the help under the code field. -->
    <string name="monarch_stepupauthdialog_code_helper">Enter the 6-digit code from your authenticator app.</string>
    <!-- MonarchStepUpAuthDialog: the error of an incomplete code. -->
    <string name="monarch_stepupauthdialog_code_incomplete">Enter all 6 digits.</string>
    <!-- MonarchStepUpAuthDialog: the line of the passkey method. -->
    <string name="monarch_stepupauthdialog_passkey_description">Use your passkey, security key or device screen lock.</string>
    <!-- MonarchStepUpAuthDialog: the primary button of the passkey method. -->
    <string name="monarch_stepupauthdialog_passkey_button">Use passkey</string>
    <!-- MonarchStepUpAuthDialog: the line of the device method. -->
    <string name="monarch_stepupauthdialog_device_owner_description">Confirm with your fingerprint, face or screen lock.</string>
    <!-- MonarchStepUpAuthDialog: the primary button of the device method. -->
    <string name="monarch_stepupauthdialog_device_owner_button">Use screen lock</string>
    <!-- MonarchStepUpAuthDialog: the primary button of the password and code methods. -->
    <string name="monarch_stepupauthdialog_submit">Confirm</string>
    <!-- MonarchStepUpAuthDialog: the button that closes the dialog without confirming. -->
    <string name="monarch_stepupauthdialog_cancel">Cancel</string>
    <!-- MonarchStepUpAuthDialog: the button that starts password recovery. -->
    <string name="monarch_stepupauthdialog_forgot">Forgot your password?</string>
    <!-- MonarchStepUpAuthDialog: a failure when the app gives no message. -->
    <string name="monarch_stepupauthdialog_generic_error">That did not work. Try again.</string>
</resources>
