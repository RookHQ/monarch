<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What TalkBack says a double tap on a MonarchEditableCell does; %1$s is the cell's label, such as "Status for Acme". -->
    <string name="monarch_editablecell_edit">Edit %1$s</string>
    <!-- Button of a MonarchEditableCell text or number editor that saves the value. -->
    <string name="monarch_editablecell_save">Save</string>
    <!-- Button of a MonarchEditableCell that leaves editing without saving. -->
    <string name="monarch_editablecell_cancel">Cancel</string>
    <!-- Spoken name of the progress of a MonarchEditableCell while its value is saved. -->
    <string name="monarch_editablecell_saving">Saving</string>
    <!-- Error of a MonarchEditableCell number editor when the text is not a number. -->
    <string name="monarch_editablecell_invalid_number">Enter a number.</string>
    <!-- Error of a required MonarchEditableCell left empty. -->
    <string name="monarch_editablecell_required">Enter a value.</string>
    <!-- Error of a MonarchEditableCell below its minimum; %1$s is the formatted minimum. -->
    <string name="monarch_editablecell_below_min">Enter %1$s or more.</string>
    <!-- Error of a MonarchEditableCell above its maximum; %1$s is the formatted maximum. -->
    <string name="monarch_editablecell_above_max">Enter %1$s or less.</string>
    <!-- Menu item of a MonarchEditableCell select editor that empties the cell. -->
    <string name="monarch_editablecell_no_value">None</string>
    <!-- Error of a MonarchEditableCell when a save failed without a message of its own. -->
    <string name="monarch_editablecell_save_failed">Couldn\'t save. Try again.</string>
</resources>
