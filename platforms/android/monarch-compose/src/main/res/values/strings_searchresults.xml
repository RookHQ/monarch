<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Summary of MonarchSearchResults without a query, read when it changes. %1$s is the formatted number of results. -->
    <plurals name="monarch_searchresults_summary">
        <item quantity="one">%1$s result</item>
        <item quantity="other">%1$s results</item>
    </plurals>
    <!-- Summary of MonarchSearchResults with a query. %1$s is the formatted number of results, %2$s the query. -->
    <plurals name="monarch_searchresults_summary_query">
        <item quantity="one">%1$s result for “%2$s”</item>
        <item quantity="other">%1$s results for “%2$s”</item>
    </plurals>
    <!-- Summary of MonarchSearchResults while a search runs. -->
    <string name="monarch_searchresults_loading">Searching…</string>
    <!-- Title of the empty state of MonarchSearchResults without a query. -->
    <string name="monarch_searchresults_empty_title">No results</string>
    <!-- Title of the empty state of MonarchSearchResults with a query. %1$s is the query. -->
    <string name="monarch_searchresults_empty_title_query">No results for “%1$s”</string>
    <!-- Message of the empty state of MonarchSearchResults. -->
    <string name="monarch_searchresults_empty_message">Try other words, check the spelling, or remove a filter.</string>
    <!-- Title of the error state of MonarchSearchResults. -->
    <string name="monarch_searchresults_error_title">Search failed</string>
    <!-- Button of the error state of MonarchSearchResults that runs the search again. -->
    <string name="monarch_searchresults_retry">Try again</string>
    <!-- Button after a group of MonarchSearchResults that has more results than shown. %1$s is the formatted total, %2$s the group, such as Documents. -->
    <string name="monarch_searchresults_show_all">Show all %1$s in %2$s</string>
    <!-- What TalkBack reads for a group heading of MonarchSearchResults. %1$s is the group, %2$s the formatted total. -->
    <plurals name="monarch_searchresults_group_name">
        <item quantity="one">%1$s, %2$s result</item>
        <item quantity="other">%1$s, %2$s results</item>
    </plurals>
</resources>
