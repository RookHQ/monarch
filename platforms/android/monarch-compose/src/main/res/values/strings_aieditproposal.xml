<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiEditProposal: the title of the card when the app gives none. -->
    <string name="monarch_aieditproposal_title">Suggested edits</string>
    <!-- MonarchAiEditProposal: the provenance badge. -->
    <string name="monarch_aieditproposal_badge">AI generated</string>
    <!-- MonarchAiEditProposal: the state badge while the edits wait for a person. -->
    <string name="monarch_aieditproposal_state_proposed">Proposed</string>
    <!-- MonarchAiEditProposal: the state badge once the edits were applied. -->
    <string name="monarch_aieditproposal_state_applied">Applied</string>
    <!-- MonarchAiEditProposal: the state badge once the edits were rejected. -->
    <string name="monarch_aieditproposal_state_rejected">Rejected</string>
    <!-- MonarchAiEditProposal: the state badge once applied edits were undone. -->
    <string name="monarch_aieditproposal_state_reverted">Reverted</string>
    <!-- MonarchAiEditProposal: the decision shown on an accepted change. -->
    <string name="monarch_aieditproposal_hunk_accepted">Accepted</string>
    <!-- MonarchAiEditProposal: the decision shown on a rejected change. -->
    <string name="monarch_aieditproposal_hunk_rejected">Rejected</string>
    <!-- MonarchAiEditProposal: the count line while every change is undecided. -->
    <plurals name="monarch_aieditproposal_count">
        <item quantity="one">%d change</item>
        <item quantity="other">%d changes</item>
    </plurals>
    <!-- MonarchAiEditProposal: the count line once some are decided. %1$d is the number left, %2$d the total. -->
    <plurals name="monarch_aieditproposal_count_left">
        <item quantity="one">%1$d of %2$d change left</item>
        <item quantity="other">%1$d of %2$d changes left</item>
    </plurals>
    <!-- MonarchAiEditProposal: the name of a change without a label. %1$d is its position, %2$d the total. -->
    <string name="monarch_aieditproposal_hunk_name">Change %1$d of %2$d</string>
    <!-- MonarchAiEditProposal: the button that accepts every undecided change. -->
    <string name="monarch_aieditproposal_accept_all">Accept all</string>
    <!-- MonarchAiEditProposal: the button that rejects every undecided change. -->
    <string name="monarch_aieditproposal_reject_all">Reject all</string>
    <!-- MonarchAiEditProposal: the button that accepts one change. -->
    <string name="monarch_aieditproposal_accept">Accept</string>
    <!-- MonarchAiEditProposal: the button that rejects one change. -->
    <string name="monarch_aieditproposal_reject">Reject</string>
    <!-- MonarchAiEditProposal: the button that undoes applied edits. -->
    <string name="monarch_aieditproposal_revert">Revert</string>
    <!-- MonarchAiEditProposal: read before removed text. -->
    <string name="monarch_aieditproposal_deleted">Deleted:</string>
    <!-- MonarchAiEditProposal: read before added text. -->
    <string name="monarch_aieditproposal_inserted">Inserted:</string>
    <!-- MonarchAiEditProposal: shown after a change whose text is the same. -->
    <string name="monarch_aieditproposal_unchanged">No change</string>
    <!-- MonarchAiEditProposal: announced after one change is accepted. %d is the number left. -->
    <plurals name="monarch_aieditproposal_announce_accepted">
        <item quantity="one">Change accepted. %d left.</item>
        <item quantity="other">Change accepted. %d left.</item>
    </plurals>
    <!-- MonarchAiEditProposal: announced after one change is rejected. %d is the number left. -->
    <plurals name="monarch_aieditproposal_announce_rejected">
        <item quantity="one">Change rejected. %d left.</item>
        <item quantity="other">Change rejected. %d left.</item>
    </plurals>
    <!-- MonarchAiEditProposal: announced after the last change is accepted. -->
    <string name="monarch_aieditproposal_announce_accepted_last">Change accepted. No changes left.</string>
    <!-- MonarchAiEditProposal: announced after the last change is rejected. -->
    <string name="monarch_aieditproposal_announce_rejected_last">Change rejected. No changes left.</string>
    <!-- MonarchAiEditProposal: announced after Accept all. -->
    <string name="monarch_aieditproposal_announce_accepted_all">All changes accepted.</string>
    <!-- MonarchAiEditProposal: announced after Reject all. -->
    <string name="monarch_aieditproposal_announce_rejected_all">All changes rejected.</string>
    <!-- MonarchAiEditProposal: the line shown once the edits were applied. -->
    <string name="monarch_aieditproposal_read_only_applied">These edits were applied.</string>
    <!-- MonarchAiEditProposal: the line shown once the edits were rejected. -->
    <string name="monarch_aieditproposal_read_only_rejected">These edits were rejected.</string>
    <!-- MonarchAiEditProposal: the line shown once the edits were undone. -->
    <string name="monarch_aieditproposal_read_only_reverted">These edits were reverted.</string>
    <!-- MonarchAiEditProposal: the name of a per-change button for TalkBack. %1$s is the action, %2$s the change. -->
    <string name="monarch_aieditproposal_action">%1$s, %2$s</string>
</resources>
