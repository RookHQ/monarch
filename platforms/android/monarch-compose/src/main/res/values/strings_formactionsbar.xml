<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchFormActionsBar, the message shown and announced while the form has unsaved changes. -->
    <string name="monarch_formactionsbar_unsaved">You have unsaved changes</string>
    <!-- MonarchFormActionsBar, the label of the button that saves the form. -->
    <string name="monarch_formactionsbar_save">Save changes</string>
    <!-- MonarchFormActionsBar, the state announced on the save button while the save runs. -->
    <string name="monarch_formactionsbar_saving">Saving</string>
    <!-- MonarchFormActionsBar, the label of the button that reverts the form. -->
    <string name="monarch_formactionsbar_discard">Discard</string>
    <!-- MonarchFormActionsBar, the title of the dialog that confirms discarding. -->
    <string name="monarch_formactionsbar_discard_title">Discard unsaved changes?</string>
    <!-- MonarchFormActionsBar, the text of the dialog that confirms discarding. -->
    <string name="monarch_formactionsbar_discard_description">Your changes will be lost. This cannot be undone.</string>
    <!-- MonarchFormActionsBar, the button of the confirmation dialog that discards the changes. -->
    <string name="monarch_formactionsbar_discard_confirm">Discard changes</string>
    <!-- MonarchFormActionsBar, the button of the confirmation dialog that keeps the changes. -->
    <string name="monarch_formactionsbar_keep_editing">Keep editing</string>
</resources>
