<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of the message list of a MonarchAiThread. -->
    <string name="monarch_aithread_label">Conversation</string>
    <!-- Button of a MonarchAiThread that scrolls to the newest message. -->
    <string name="monarch_aithread_jump_to_latest">Jump to latest</string>
    <!-- Count on the jump button of a MonarchAiThread while messages arrived below. %1$d is their number. -->
    <plurals name="monarch_aithread_new_messages">
        <item quantity="one">%1$d new message</item>
        <item quantity="other">%1$d new messages</item>
    </plurals>
    <!-- Button above the messages of a MonarchAiThread that loads older messages. -->
    <string name="monarch_aithread_load_earlier">Load earlier messages</string>
    <!-- State of the load button of a MonarchAiThread while older messages load. -->
    <string name="monarch_aithread_loading_earlier">Loading earlier messages…</string>
    <!-- Label of the thinking indicator of a MonarchAiThread while a reply is submitted; also announced. -->
    <string name="monarch_aithread_thinking">Thinking…</string>
    <!-- Announced by a MonarchAiThread when a reply finishes. -->
    <string name="monarch_aithread_response_complete">Response complete</string>
    <!-- Announced by a MonarchAiThread when the person stops a reply. -->
    <string name="monarch_aithread_response_stopped">Response stopped</string>
    <!-- Announced by a MonarchAiThread for a conversation error that no message shows. %1$s is its message. -->
    <string name="monarch_aithread_error">Error: %1$s</string>
    <!-- Read by a MonarchAiThread in place of the contents of a code block in a reply. -->
    <string name="monarch_aithread_code_block">Code block</string>
    <!-- Day label of a MonarchAiThread above messages sent today. -->
    <string name="monarch_aithread_today">Today</string>
    <!-- Day label of a MonarchAiThread above messages sent yesterday. -->
    <string name="monarch_aithread_yesterday">Yesterday</string>
    <!-- Notice under a MonarchAiThread while the device is offline and nothing is queued. -->
    <string name="monarch_aithread_offline">You are offline. Messages you send will wait until you are back online.</string>
    <!-- Notice under a MonarchAiThread while offline with messages waiting. %1$d is their number. -->
    <plurals name="monarch_aithread_offline_queued">
        <item quantity="one">You are offline. %1$d message will send when you are back online.</item>
        <item quantity="other">You are offline. %1$d messages will send when you are back online.</item>
    </plurals>
    <!-- Notice under a MonarchAiThread once the connection is back and queued messages are sent. %1$d is their number. -->
    <plurals name="monarch_aithread_sending_queued">
        <item quantity="one">Back online. Sending %1$d queued message…</item>
        <item quantity="other">Back online. Sending %1$d queued messages…</item>
    </plurals>
    <!-- Notice under a MonarchAiThread while a running reply has sent nothing for a while. -->
    <string name="monarch_aithread_slow">This is taking longer than usual. Still working…</string>
</resources>
