<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchWeeklyHoursEditor: the heading of the editor. -->
    <string name="monarch_weeklyhourseditor_title">Weekly hours</string>
    <!-- MonarchWeeklyHoursEditor: shown for a day that is switched off. -->
    <string name="monarch_weeklyhourseditor_unavailable">Unavailable</string>
    <!-- MonarchWeeklyHoursEditor: the label of the menu with an interval's start time. -->
    <string name="monarch_weeklyhourseditor_start">Start</string>
    <!-- MonarchWeeklyHoursEditor: the label of the menu with an interval's end time. -->
    <string name="monarch_weeklyhourseditor_end">End</string>
    <!-- MonarchWeeklyHoursEditor: the visible text of the button that adds an interval to a day. -->
    <string name="monarch_weeklyhourseditor_add">Add interval</string>
    <!-- MonarchWeeklyHoursEditor: the TalkBack name of the add button. %1$s is the day, such as Monday. -->
    <string name="monarch_weeklyhourseditor_add_item">Add interval to %1$s</string>
    <!-- MonarchWeeklyHoursEditor: the visible text of the button that removes an interval, without an icon. -->
    <string name="monarch_weeklyhourseditor_remove">Remove</string>
    <!-- MonarchWeeklyHoursEditor: the TalkBack name of the remove button. %1$s is the day, %2$d the interval's position. -->
    <string name="monarch_weeklyhourseditor_remove_item">Remove %1$s interval %2$d</string>
    <!-- MonarchWeeklyHoursEditor: the visible text of the button that copies a day's hours to every day. -->
    <string name="monarch_weeklyhourseditor_copy_to_all">Copy to all</string>
    <!-- MonarchWeeklyHoursEditor: the TalkBack name of the copy button. %1$s is the day. -->
    <string name="monarch_weeklyhourseditor_copy_to_all_item">Copy to all days from %1$s</string>
    <!-- MonarchWeeklyHoursEditor: announced after a copy. %1$s is the day that was copied. -->
    <string name="monarch_weeklyhourseditor_copied">%1$s hours copied to every day.</string>
    <!-- MonarchWeeklyHoursEditor: one interval as text in the read-only view. %1$s is the start, %2$s the end. -->
    <string name="monarch_weeklyhourseditor_range">%1$s – %2$s</string>
    <!-- MonarchWeeklyHoursEditor: the end of the day on a 12-hour clock. -->
    <string name="monarch_weeklyhourseditor_midnight">Midnight</string>
    <!-- MonarchWeeklyHoursEditor: the message under a day with a time outside the day. -->
    <string name="monarch_weeklyhourseditor_range_error">Times must fall within the day</string>
    <!-- MonarchWeeklyHoursEditor: the message under a day with an interval that does not end after it starts. -->
    <string name="monarch_weeklyhourseditor_order_error">Each interval must end after it starts</string>
    <!-- MonarchWeeklyHoursEditor: the message under a day with overlapping intervals. -->
    <string name="monarch_weeklyhourseditor_overlap_error">Intervals must not overlap</string>
</resources>
