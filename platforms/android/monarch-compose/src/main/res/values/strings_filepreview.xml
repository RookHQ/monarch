<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchFilePreview, the spoken name of the preview. %1$s is the file name: "Preview of report.pdf". -->
    <string name="monarch_filepreview_preview_of">Preview of %1$s</string>
    <!-- MonarchFilePreview, shown when the type of the file cannot be previewed. -->
    <string name="monarch_filepreview_unavailable">There is no preview for this file type.</string>
    <!-- MonarchFilePreview, shown when the preview failed to load. -->
    <string name="monarch_filepreview_failed">The preview could not be loaded.</string>
    <!-- MonarchFilePreview, the label of the button that downloads or opens the file. -->
    <string name="monarch_filepreview_download">Download</string>
    <!-- MonarchFilePreview, the spoken name of the download button. %1$s is the file name. -->
    <string name="monarch_filepreview_download_name">Download %1$s</string>
    <!-- MonarchFilePreview, the spoken name of a page of a PDF. %1$d is the page number, %2$d the page count. -->
    <string name="monarch_filepreview_page">Page %1$d of %2$d</string>
</resources>
