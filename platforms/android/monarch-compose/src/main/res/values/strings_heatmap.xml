    <string name="monarch_heatmap_size">%1$s by %2$s</string>
    <!-- MonarchHeatmap, the sentence of the highest cell in the summary. %1$s the cell as read. -->
    <string name="monarch_heatmap_highest">Highest: %1$s</string>
    <!-- MonarchHeatmap, read for a cell and shown for the selected cell. %1$s row, %2$s column, %3$s value. -->
    <string name="monarch_heatmap_cell">%1$s, %2$s: %3$s</string>
    <!-- MonarchHeatmap, a value followed by its note. %1$s the value, %2$s the note. -->
    <string name="monarch_heatmap_with_note">%1$s, %2$s</string>
    <!-- MonarchHeatmap, the TalkBack action that selects a cell. -->
    <string name="monarch_heatmap_select">Select</string>
</resources>
