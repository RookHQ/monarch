<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchHeatmap, the table heading of the row names. -->
    <string name="monarch_heatmap_row_header">Row</string>
    <!-- MonarchHeatmap, shown before the lightest step of the legend. -->
    <string name="monarch_heatmap_less">Less</string>
    <!-- MonarchHeatmap, shown after the darkest step of the legend. -->
    <string name="monarch_heatmap_more">More</string>
    <!-- MonarchHeatmap, the text of a cell without a value, in the legend, the details and what TalkBack reads. -->
    <string name="monarch_heatmap_no_data">No data</string>
    <!-- MonarchHeatmap, the range of the lightest legend step. %1$s the upper bound. -->
    <string name="monarch_heatmap_range_below">Below %1$s</string>
    <!-- MonarchHeatmap, the range of the lightest legend step when every threshold is zero. %1$s zero. -->
    <string name="monarch_heatmap_above">Above %1$s</string>
    <!-- MonarchHeatmap, the range of a middle legend step. %1$s the lower bound, %2$s the upper bound. -->
    <string name="monarch_heatmap_range">%1$s to %2$s</string>
    <!-- MonarchHeatmap, the range of the darkest legend step. %1$s the lower bound. -->
    <string name="monarch_heatmap_range_above">%1$s or more</string>
    <!-- MonarchHeatmap, the number of rows in the summary read by TalkBack. -->
    <plurals name="monarch_heatmap_row_count">
        <item quantity="one">%1$d row</item>
        <item quantity="other">%1$d rows</item>
    </plurals>
    <!-- MonarchHeatmap, the number of columns in the summary read by TalkBack. -->
    <plurals name="monarch_heatmap_column_count">
        <item quantity="one">%1$d column</item>
        <item quantity="other">%1$d columns</item>
    </plurals>
