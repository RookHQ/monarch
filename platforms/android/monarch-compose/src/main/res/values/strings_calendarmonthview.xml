<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Added to what TalkBack reads for today's cell in a MonarchCalendarMonthView. -->
    <string name="monarch_calendarmonthview_today">Today</string>
    <!-- What TalkBack reads for a day of a MonarchCalendarMonthView. %1$s is the full date, %2$s the number of events. -->
    <string name="monarch_calendarmonthview_day">%1$s, %2$s</string>
    <!-- Number of events of a day in a MonarchCalendarMonthView, read by TalkBack with the date. -->
    <plurals name="monarch_calendarmonthview_count">
        <item quantity="one">%d event</item>
        <item quantity="other">%d events</item>
    </plurals>
    <!-- Overflow line in a wide day cell of a MonarchCalendarMonthView. %d is the number of events not listed. -->
    <plurals name="monarch_calendarmonthview_more">
        <item quantity="one">+%d more</item>
        <item quantity="other">+%d more</item>
    </plurals>
    <!-- Overflow mark after the dots of a narrow day cell of a MonarchCalendarMonthView. %d is the number of events without a dot. -->
    <string name="monarch_calendarmonthview_more_short">+%d</string>
    <!-- Shown under the selected day of a MonarchCalendarMonthView when it has no events. -->
    <string name="monarch_calendarmonthview_no_events">No events</string>
    <!-- Time of an all-day event in the selected day's list of a MonarchCalendarMonthView. -->
    <string name="monarch_calendarmonthview_all_day">All day</string>
    <!-- What TalkBack reads for the last day of an event that started on an earlier day. %1$s is the end time. -->
    <string name="monarch_calendarmonthview_until">until %1$s</string>
    <!-- What TalkBack reads for an event's start and end. %1$s is the start, %2$s the end. -->
    <string name="monarch_calendarmonthview_range">%1$s to %2$s</string>
    <!-- TalkBack action on an event in the selected day's list that moves it one day earlier. -->
    <string name="monarch_calendarmonthview_move_day_earlier">Move one day earlier</string>
    <!-- TalkBack action on an event in the selected day's list that moves it one day later. -->
    <string name="monarch_calendarmonthview_move_day_later">Move one day later</string>
    <!-- TalkBack action on an event in the selected day's list that moves it one week earlier. -->
    <string name="monarch_calendarmonthview_move_week_earlier">Move one week earlier</string>
    <!-- TalkBack action on an event in the selected day's list that moves it one week later. -->
    <string name="monarch_calendarmonthview_move_week_later">Move one week later</string>
</resources>
