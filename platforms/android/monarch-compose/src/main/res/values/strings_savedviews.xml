<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of the menu button of a MonarchSavedViews; its state is the selected view's name. -->
    <string name="monarch_savedviews_view">View</string>
    <!-- Text of the MonarchSavedViews button when no saved view is selected. -->
    <string name="monarch_savedviews_no_view">All items</string>
    <!-- Marker next to the view name when the list's filters differ from the saved view. -->
    <string name="monarch_savedviews_modified">Edited</string>
    <!-- Marker of a view shared with other people, in the MonarchSavedViews menu. -->
    <string name="monarch_savedviews_shared">Shared</string>
    <!-- Marker of the view that opens by default, in the MonarchSavedViews menu. -->
    <string name="monarch_savedviews_default_view">Default view</string>
    <!-- Menu heading above views without a group in a MonarchSavedViews menu. -->
    <string name="monarch_savedviews_views">Views</string>
    <!-- Menu item that saves the current filters over the selected view. %1$s is the view's name. -->
    <string name="monarch_savedviews_save_changes">Save changes to “%1$s”</string>
    <!-- Menu item that opens the dialog to save the current filters as a new view. -->
    <string name="monarch_savedviews_save_as_new">Save as new view…</string>
    <!-- Menu item that reapplies the selected view, dropping unsaved changes. -->
    <string name="monarch_savedviews_discard_changes">Discard changes</string>
    <!-- Menu item that opens the dialog to rename the selected view. -->
    <string name="monarch_savedviews_rename">Rename…</string>
    <!-- Menu item that makes the selected view open by default. -->
    <string name="monarch_savedviews_set_default">Set as default</string>
    <!-- Menu item that asks to delete the selected view. -->
    <string name="monarch_savedviews_delete">Delete view…</string>
    <!-- Title of the dialog that names a new saved view. -->
    <string name="monarch_savedviews_save_title">Save view</string>
    <!-- Title of the dialog that renames a saved view. -->
    <string name="monarch_savedviews_rename_title">Rename view</string>
    <!-- Label of the name field in the naming dialog of a MonarchSavedViews. -->
    <string name="monarch_savedviews_name">Name</string>
    <!-- Confirm button of the naming dialog of a MonarchSavedViews. -->
    <string name="monarch_savedviews_save">Save</string>
    <!-- Cancel button of the dialogs of a MonarchSavedViews. -->
    <string name="monarch_savedviews_cancel">Cancel</string>
    <!-- Error under the name field when the name is empty. -->
    <string name="monarch_savedviews_name_required">Enter a name.</string>
    <!-- Error under the name field when another view has the name. -->
    <string name="monarch_savedviews_name_taken">A view with this name already exists.</string>
    <!-- Error in the naming dialog when saving or renaming failed. -->
    <string name="monarch_savedviews_save_failed">The view could not be saved. Try again.</string>
    <!-- Title of the delete confirmation. %1$s is the view's name. -->
    <string name="monarch_savedviews_delete_title">Delete “%1$s”?</string>
    <!-- Message of the delete confirmation of a MonarchSavedViews. -->
    <string name="monarch_savedviews_delete_message">The view is removed for everyone who can see it. Items are not affected.</string>
    <!-- Confirm button of the delete confirmation of a MonarchSavedViews. -->
    <string name="monarch_savedviews_delete_confirm">Delete view</string>
    <!-- Error in the delete confirmation when deleting failed. -->
    <string name="monarch_savedviews_delete_failed">The view could not be deleted. Try again.</string>
</resources>
