<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the drag handle of a tile of a MonarchSortableGrid. %1$s is the item's label. -->
    <string name="monarch_sortablegrid_handle">Reorder %1$s</string>
    <!-- Announced when a drag starts in a MonarchSortableGrid: the item's label (1), its position (2) and the number of items (3). -->
    <string name="monarch_sortablegrid_picked_up">Picked up %1$s. Position %2$d of %3$d.</string>
    <!-- Announced after a move by an action or an arrow key in a MonarchSortableGrid: label (1), new position (2), number of items (3). -->
    <string name="monarch_sortablegrid_moved">%1$s moved to position %2$d of %3$d.</string>
    <!-- Announced when a drag ends in a MonarchSortableGrid: label (1), position (2), number of items (3). -->
    <string name="monarch_sortablegrid_dropped">%1$s dropped at position %2$d of %3$d.</string>
    <!-- Announced when a drag is cancelled in a MonarchSortableGrid: label (1), position (2), number of items (3). -->
    <string name="monarch_sortablegrid_cancelled">Reorder cancelled. %1$s returned to position %2$d of %3$d.</string>
</resources>
