<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchDnsRecordTable, the heading of the record type in a card and a table. -->
    <string name="monarch_dnsrecordtable_type">Type</string>
    <!-- MonarchDnsRecordTable, the heading of the record name in a card and a table. -->
    <string name="monarch_dnsrecordtable_name">Name</string>
    <!-- MonarchDnsRecordTable, the heading of the record value in a card and a table. -->
    <string name="monarch_dnsrecordtable_value">Value</string>
    <!-- MonarchDnsRecordTable, the heading of the record TTL (time to live) in a card and a table. -->
    <string name="monarch_dnsrecordtable_ttl">TTL</string>
    <!-- MonarchDnsRecordTable, the heading of the MX or SRV priority in a card and a table. -->
    <string name="monarch_dnsrecordtable_priority">Priority</string>
    <!-- MonarchDnsRecordTable, the heading of the table column that says whether public DNS shows a record. -->
    <string name="monarch_dnsrecordtable_status">Status</string>
    <!-- MonarchDnsRecordTable, the status of a record that public DNS already shows. -->
    <string name="monarch_dnsrecordtable_found">Found</string>
    <!-- MonarchDnsRecordTable, the status of a record that public DNS does not show yet. -->
    <string name="monarch_dnsrecordtable_waiting">Waiting</string>
    <!-- MonarchDnsRecordTable, the heading of a record that points the user's domain at the product. -->
    <string name="monarch_dnsrecordtable_purpose_routing">Points your address here</string>
    <!-- MonarchDnsRecordTable, the heading of a record that proves the user owns the domain; also used without a purpose. -->
    <string name="monarch_dnsrecordtable_purpose_verification">Proves you own the domain</string>
    <!-- MonarchDnsRecordTable, the heading of a record that allows the HTTPS certificate to be issued. -->
    <string name="monarch_dnsrecordtable_purpose_certificate">Allows the HTTPS certificate</string>
    <!-- MonarchDnsRecordTable, the spoken name of a record name and its copy button ("Copy name of the CNAME record"). %1$s is the record type. -->
    <string name="monarch_dnsrecordtable_copy_name">name of the %1$s record</string>
    <!-- MonarchDnsRecordTable, the spoken name of a record value and its copy button. %1$s is the record type, %2$s the name as shown. -->
    <string name="monarch_dnsrecordtable_copy_value">value of the %1$s record %2$s</string>
    <!-- MonarchDnsRecordTable, the line under a card whose name is shown relative to the zone. %1$s is the full record name. -->
    <string name="monarch_dnsrecordtable_full_name">Full name: %1$s</string>
    <!-- MonarchDnsRecordTable, the spoken name of the records. %1$s is the DNS zone, such as example.com. -->
    <string name="monarch_dnsrecordtable_label_zone">DNS records for %1$s</string>
    <!-- MonarchDnsRecordTable, the spoken name of the records when there is no zone. -->
    <string name="monarch_dnsrecordtable_label">DNS records</string>
    <!-- MonarchDnsRecordTable, announced when the number of records public DNS shows changes. %1$d is how many are found, %2$d how many were checked. -->
    <plurals name="monarch_dnsrecordtable_summary">
        <item quantity="one">%1$d of %2$d record found.</item>
        <item quantity="other">%1$d of %2$d records found.</item>
    </plurals>
</resources>
