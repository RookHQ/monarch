<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The spoken name of the full-screen MonarchLightbox, announced when it opens. -->
    <string name="monarch_lightbox_title">Media viewer</string>
    <!-- The MonarchLightbox button that shows the previous item. -->
    <string name="monarch_lightbox_previous">Previous</string>
    <!-- The MonarchLightbox button that shows the next item. -->
    <string name="monarch_lightbox_next">Next</string>
    <!-- The spoken name of the MonarchLightbox button that enlarges the image (it shows a plus sign). -->
    <string name="monarch_lightbox_zoom_in">Zoom in</string>
    <!-- The spoken name of the MonarchLightbox button that reduces the zoom (it shows a minus sign). -->
    <string name="monarch_lightbox_zoom_out">Zoom out</string>
    <!-- The spoken name of the MonarchLightbox button that shows the zoom level and returns to the fitted image. -->
    <string name="monarch_lightbox_reset_zoom">Reset zoom</string>
    <!-- The MonarchLightbox button that closes the viewer. -->
    <string name="monarch_lightbox_close">Close</string>
    <!-- The MonarchLightbox button that shares the current item. -->
    <string name="monarch_lightbox_share">Share</string>
    <!-- Where the current item of a MonarchLightbox sits: its number and the number of items. -->
    <string name="monarch_lightbox_position">%1$d of %2$d</string>
    <!-- Shown by a MonarchLightbox in place of an item that has no picture and no video. -->
    <string name="monarch_lightbox_unavailable">This file can’t be shown.</string>
</resources>
