<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchBarChart, the heading of the category column of the data table when the app gives no categoryTitle. -->
    <string name="monarch_barchart_category">Category</string>
    <!-- MonarchBarChart, the stack total: the table column, the inspection row and TalkBack. -->
    <string name="monarch_barchart_total">Total</string>
    <!-- MonarchBarChart, the spoken summary of a chart or a series without values. -->
    <string name="monarch_barchart_no_data">No data</string>
    <!-- MonarchBarChart, the drill-in button of the inspection row. -->
    <string name="monarch_barchart_details">Details</string>
    <!-- MonarchBarChart, the TalkBack action that opens one category: "Details, Feb". %1$s is the details word, %2$s the category. -->
    <string name="monarch_barchart_details_action">%1$s, %2$s</string>
    <!-- MonarchBarChart, the button that ends the inspection of a category. -->
    <string name="monarch_barchart_clear">Clear</string>
    <!-- MonarchBarChart, the state TalkBack reads on the highlighted category. -->
    <string name="monarch_barchart_highlighted">Highlighted</string>
    <!-- MonarchBarChart, the number of categories at the start of the spoken summary. -->
    <plurals name="monarch_barchart_categories">
        <item quantity="one">%d category</item>
        <item quantity="other">%d categories</item>
    </plurals>
    <!-- MonarchBarChart, the first and last category in the spoken summary: "Jan to Mar". -->
    <string name="monarch_barchart_range">%1$s to %2$s</string>
    <!-- MonarchBarChart, one series in the spoken summary: "Web: total 4,040, highest Feb, 1,450". %1$s series, %2$s total, %3$s category, %4$s highest value. -->
    <string name="monarch_barchart_series_summary">%1$s: total %2$s, highest %3$s, %4$s</string>
    <!-- MonarchBarChart, a series or a reference line with its value: "Web 1,200". %1$s name, %2$s value. -->
    <string name="monarch_barchart_value">%1$s %2$s</string>
    <!-- MonarchBarChart, one category as TalkBack and the inspection row read it: "Jan: Web 1,200, iOS 800". -->
    <string name="monarch_barchart_category_values">%1$s: %2$s</string>
</resources>
