<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchNotificationCenter. -->
    <string name="monarch_notificationcenter_title">Notifications</string>
    <!-- Tab of a MonarchNotificationCenter that shows every notification. -->
    <string name="monarch_notificationcenter_all">All</string>
    <!-- Tab of a MonarchNotificationCenter that shows unread notifications. -->
    <string name="monarch_notificationcenter_unread">Unread</string>
    <!-- What TalkBack reads for the Unread tab of a MonarchNotificationCenter. %1$d is the unread total. -->
    <plurals name="monarch_notificationcenter_unread_tab">
        <item quantity="one">Unread, %1$d unread</item>
        <item quantity="other">Unread, %1$d unread</item>
    </plurals>
    <!-- Button of a MonarchNotificationCenter that marks every notification read. -->
    <string name="monarch_notificationcenter_mark_all_read">Mark all as read</string>
    <!-- Swipe and TalkBack action that marks one notification of a MonarchNotificationCenter read. -->
    <string name="monarch_notificationcenter_mark_read">Mark as read</string>
    <!-- Read after the title of an unread notification in a MonarchNotificationCenter. -->
    <string name="monarch_notificationcenter_unread_item">Unread</string>
    <!-- Heading over today's notifications in a MonarchNotificationCenter. -->
    <string name="monarch_notificationcenter_today">Today</string>
    <!-- Heading over yesterday's notifications in a MonarchNotificationCenter. -->
    <string name="monarch_notificationcenter_yesterday">Yesterday</string>
    <!-- Title of an empty MonarchNotificationCenter. -->
    <string name="monarch_notificationcenter_empty_title">You\'re all caught up</string>
    <!-- Line under the title of an empty MonarchNotificationCenter. -->
    <string name="monarch_notificationcenter_empty_message">New notifications will show up here.</string>
    <!-- Title of the Unread tab of a MonarchNotificationCenter when nothing is unread. -->
    <string name="monarch_notificationcenter_empty_unread_title">No unread notifications</string>
    <!-- What TalkBack reads while a MonarchNotificationCenter loads for the first time. -->
    <string name="monarch_notificationcenter_loading">Loading notifications</string>
</resources>
