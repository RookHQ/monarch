    <string name="monarch_avatarupload_move_up">Move up</string>
    <!-- TalkBack action of the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_move_down">Move down</string>
    <!-- TalkBack action of the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_zoom_in">Zoom in</string>
    <!-- TalkBack action of the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_zoom_out">Zoom out</string>
    <!-- Button of a MonarchAvatarUpload that saves the crop. -->
    <string name="monarch_avatarupload_save">Save photo</string>
    <!-- Button of a MonarchAvatarUpload that leaves the crop without saving. -->
    <string name="monarch_avatarupload_cancel">Cancel</string>
    <!-- Message of a MonarchAvatarUpload when saving the crop failed. -->
    <string name="monarch_avatarupload_save_failed">The photo could not be saved. Try again.</string>
    <!-- Message of a MonarchAvatarUpload when the picked file cannot be read as an image. -->
    <string name="monarch_avatarupload_open_failed">The photo could not be opened.</string>
