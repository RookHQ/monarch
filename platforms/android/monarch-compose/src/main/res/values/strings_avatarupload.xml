<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button of a MonarchAvatarUpload that opens the photo picker when there is no picture. -->
    <string name="monarch_avatarupload_upload">Upload photo</string>
    <!-- Button of a MonarchAvatarUpload that opens the photo picker when there is a picture. -->
    <string name="monarch_avatarupload_change">Change photo</string>
    <!-- Button of a MonarchAvatarUpload that removes the picture. -->
    <string name="monarch_avatarupload_remove">Remove photo</string>
    <!-- TalkBack name of the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_crop_area">Photo position</string>
    <!-- Instructions under the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_crop_hint">Drag to move the photo. Pinch or use the slider to zoom.</string>
    <!-- Label of the zoom slider of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_zoom">Zoom</string>
    <!-- The zoom of a MonarchAvatarUpload as a percentage, read by TalkBack. -->
    <string name="monarch_avatarupload_zoom_value">%1$d%%</string>
    <!-- TalkBack action of the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_move_left">Move left</string>
    <!-- TalkBack action of the crop area of a MonarchAvatarUpload. -->
    <string name="monarch_avatarupload_move_right">Move right</string>
