<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Short visible text of a MonarchRecordingIndicator while recording. Not read by TalkBack, which reads monarch_recordingindicator_recording. -->
    <string name="monarch_recordingindicator_rec">REC</string>
    <!-- What TalkBack reads for a MonarchRecordingIndicator while recording. -->
    <string name="monarch_recordingindicator_recording">Recording</string>
    <!-- Visible text of a MonarchRecordingIndicator while recording is paused; TalkBack reads it after "Recording". -->
    <string name="monarch_recordingindicator_paused">Paused</string>
    <!-- What TalkBack reads for a paused MonarchRecordingIndicator. %1$s is the recording label, %2$s the paused label. -->
    <string name="monarch_recordingindicator_spoken_paused">%1$s, %2$s</string>
    <!-- Announced by TalkBack when a MonarchRecordingIndicator starts recording. -->
    <string name="monarch_recordingindicator_started">Recording started</string>
    <!-- Announced by TalkBack when a MonarchRecordingIndicator stops recording. -->
    <string name="monarch_recordingindicator_stopped">Recording stopped</string>
    <!-- Announced by TalkBack when a MonarchRecordingIndicator pauses. -->
    <string name="monarch_recordingindicator_paused_announcement">Recording paused</string>
    <!-- Announced by TalkBack when a MonarchRecordingIndicator resumes after a pause. -->
    <string name="monarch_recordingindicator_resumed">Recording resumed</string>
    <!-- Name of the stop button of a MonarchRecordingIndicator, read by TalkBack. -->
    <string name="monarch_recordingindicator_stop">Stop recording</string>
</resources>
