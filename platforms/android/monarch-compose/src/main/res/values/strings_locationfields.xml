<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the city field of MonarchLocationFields. -->
    <string name="monarch_locationfields_city">City</string>
    <!-- Label of the postal code field of MonarchLocationFields. -->
    <string name="monarch_locationfields_postal_code">Postal code</string>
    <!-- Help under the city search of MonarchLocationFields while no country is chosen. -->
    <string name="monarch_locationfields_choose_country_first">Choose a country first</string>
    <!-- Shown in the city list of MonarchLocationFields until enough letters are typed. %d is the minimum. -->
    <plurals name="monarch_locationfields_type_more">
        <item quantity="one">Type at least %d letter to search.</item>
        <item quantity="other">Type at least %d letters to search.</item>
    </plurals>
    <!-- Shown in the city list of MonarchLocationFields when no city matches. -->
    <string name="monarch_locationfields_no_match">No matches</string>
    <!-- Shown in the city list of MonarchLocationFields when the city search failed. -->
    <string name="monarch_locationfields_cities_failed">Couldn’t load cities. Type again to retry.</string>
    <!-- The row of the city list of MonarchLocationFields that keeps the typed city. %1$s is the typed text. -->
    <string name="monarch_locationfields_use_typed">Use “%1$s”</string>
</resources>
