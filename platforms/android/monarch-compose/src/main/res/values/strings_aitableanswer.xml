<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiTableAnswer: the provenance label above the title. -->
    <string name="monarch_aitableanswer_ai_table">AI table</string>
    <!-- MonarchAiTableAnswer: the row count under the title; %1$d is the number of rows. -->
    <plurals name="monarch_aitableanswer_row_count">
        <item quantity="one">%1$d row</item>
        <item quantity="other">%1$d rows</item>
    </plurals>
    <!-- MonarchAiTableAnswer: the button that copies the table as CSV. -->
    <string name="monarch_aitableanswer_copy_csv">Copy as CSV</string>
    <!-- MonarchAiTableAnswer: the copy button after a copy, where the app shows it. -->
    <string name="monarch_aitableanswer_copied">Copied</string>
    <!-- MonarchAiTableAnswer: the button that opens the table as an artifact. -->
    <string name="monarch_aitableanswer_open_as_artifact">Open as artifact</string>
    <!-- MonarchAiTableAnswer: announced after an ascending sort; %1$s is the column. -->
    <string name="monarch_aitableanswer_sorted_ascending">Sorted by %1$s, ascending.</string>
    <!-- MonarchAiTableAnswer: announced after a descending sort; %1$s is the column. -->
    <string name="monarch_aitableanswer_sorted_descending">Sorted by %1$s, descending.</string>
    <!-- MonarchAiTableAnswer: the state TalkBack reads for a header sorted ascending. -->
    <string name="monarch_aitableanswer_sort_ascending">Sorted ascending</string>
    <!-- MonarchAiTableAnswer: the state TalkBack reads for a header sorted descending. -->
    <string name="monarch_aitableanswer_sort_descending">Sorted descending</string>
    <!-- MonarchAiTableAnswer: read by TalkBack for an empty cell. -->
    <string name="monarch_aitableanswer_empty">Empty</string>
    <!-- MonarchAiTableAnswer: shown when there are no rows and none are coming. -->
    <string name="monarch_aitableanswer_no_rows">No rows.</string>
    <!-- MonarchAiTableAnswer: read by TalkBack for the placeholder row while rows stream in. -->
    <string name="monarch_aitableanswer_loading_rows">More rows are being generated</string>
    <!-- MonarchAiTableAnswer: announced by TalkBack when the rows have finished streaming. -->
    <string name="monarch_aitableanswer_complete">Table complete.</string>
    <!-- MonarchAiTableAnswer: the button that shows every row; %1$d is the number of rows. -->
    <plurals name="monarch_aitableanswer_show_all_rows">
        <item quantity="one">Show %1$d row</item>
        <item quantity="other">Show all %1$d rows</item>
    </plurals>
</resources>
