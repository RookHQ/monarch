<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiMultiAgentRoster: names the list of agents for TalkBack. -->
    <string name="monarch_aimultiagentroster_label">Agents</string>
    <!-- MonarchAiMultiAgentRoster: read after each agent's name, so it is never taken for a person. -->
    <string name="monarch_aimultiagentroster_agent_kind">AI agent</string>
    <!-- MonarchAiMultiAgentRoster: the idle state. -->
    <string name="monarch_aimultiagentroster_idle">Idle</string>
    <!-- MonarchAiMultiAgentRoster: the working state. -->
    <string name="monarch_aimultiagentroster_working">Working</string>
    <!-- MonarchAiMultiAgentRoster: the waiting state, when the agent needs a person. -->
    <string name="monarch_aimultiagentroster_waiting">Waiting for you</string>
    <!-- MonarchAiMultiAgentRoster: the error state. -->
    <string name="monarch_aimultiagentroster_error">Error</string>
    <!-- MonarchAiMultiAgentRoster: the first part of the summary line, the number of agents. -->
    <plurals name="monarch_aimultiagentroster_agents">
        <item quantity="one">%d agent</item>
        <item quantity="other">%d agents</item>
    </plurals>
    <!-- MonarchAiMultiAgentRoster: summary part, the number of agents working. -->
    <plurals name="monarch_aimultiagentroster_summary_working">
        <item quantity="one">%d working</item>
        <item quantity="other">%d working</item>
    </plurals>
    <!-- MonarchAiMultiAgentRoster: summary part, the number of agents waiting for a person. -->
    <plurals name="monarch_aimultiagentroster_summary_waiting">
        <item quantity="one">%d waiting for you</item>
        <item quantity="other">%d waiting for you</item>
    </plurals>
    <!-- MonarchAiMultiAgentRoster: summary part, the number of agents stopped with an error. -->
    <plurals name="monarch_aimultiagentroster_summary_error">
        <item quantity="one">%d with errors</item>
        <item quantity="other">%d with errors</item>
    </plurals>
    <!-- MonarchAiMultiAgentRoster: joins the parts of the summary line. -->
    <string name="monarch_aimultiagentroster_separator">" · "</string>
    <!-- MonarchAiMultiAgentRoster: announced when an agent's state changes. %1$s is the name, %2$s the state. -->
    <string name="monarch_aimultiagentroster_changed">%1$s: %2$s</string>
    <!-- MonarchAiMultiAgentRoster: shown when there are no agents. -->
    <string name="monarch_aimultiagentroster_empty">No agents are working on this.</string>
    <!-- MonarchAiMultiAgentRoster: a row read by TalkBack: %1$s the name with its kind, %2$s the role, task and state. -->
    <string name="monarch_aimultiagentroster_row">%1$s, %2$s</string>
    <!-- MonarchAiMultiAgentRoster: the name with its kind. %1$s is the name, %2$s the kind. -->
    <string name="monarch_aimultiagentroster_name_with_kind">%1$s (%2$s)</string>
    <!-- MonarchAiMultiAgentRoster: one hidden agent read on the +N tile. %1$s is the name, %2$s the state. -->
    <string name="monarch_aimultiagentroster_hidden">%1$s, %2$s</string>
    <!-- MonarchAiMultiAgentRoster: joins the role, task and state in a row read by TalkBack. -->
    <string name="monarch_aimultiagentroster_row_separator">", "</string>
    <!-- MonarchAiMultiAgentRoster: joins the hidden agents read on the +N tile. -->
    <string name="monarch_aimultiagentroster_hidden_separator">"; "</string>
    <!-- MonarchAiMultiAgentRoster: joins several state changes announced together. -->
    <string name="monarch_aimultiagentroster_changes_separator">". "</string>
</resources>
