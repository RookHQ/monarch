<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiModelPicker: the TalkBack name of the button and the heading of the sheet. -->
    <string name="monarch_aimodelpicker_label">Model</string>
    <!-- MonarchAiModelPicker: the button text when no model is selected. -->
    <string name="monarch_aimodelpicker_placeholder">Choose a model</string>
    <!-- MonarchAiModelPicker: the value of the button. %1$s is the model, %2$s its provider. -->
    <string name="monarch_aimodelpicker_value">%1$s, %2$s</string>
    <!-- MonarchAiModelPicker: the badge of a model that can see images. -->
    <string name="monarch_aimodelpicker_capability_vision">Vision</string>
    <!-- MonarchAiModelPicker: the badge of a model that can call tools. -->
    <string name="monarch_aimodelpicker_capability_tools">Tools</string>
    <!-- MonarchAiModelPicker: the badge of a model that reasons step by step. -->
    <string name="monarch_aimodelpicker_capability_reasoning">Reasoning</string>
    <!-- MonarchAiModelPicker: the badge of a model that can search the web. -->
    <string name="monarch_aimodelpicker_capability_web">Web</string>
    <!-- MonarchAiModelPicker: the context window. %1$s is a compact number, such as 200K. -->
    <string name="monarch_aimodelpicker_context">%1$s context</string>
    <!-- MonarchAiModelPicker: the speed of a fast model. -->
    <string name="monarch_aimodelpicker_speed_fast">Fast</string>
    <!-- MonarchAiModelPicker: the speed of a model between fast and slow. -->
    <string name="monarch_aimodelpicker_speed_balanced">Balanced</string>
    <!-- MonarchAiModelPicker: the speed of a slow model. -->
    <string name="monarch_aimodelpicker_speed_slow">Slower</string>
    <!-- MonarchAiModelPicker: read instead of $ for the lowest cost tier. -->
    <string name="monarch_aimodelpicker_cost_low">Cost: low</string>
    <!-- MonarchAiModelPicker: read instead of $$ for the middle cost tier. -->
    <string name="monarch_aimodelpicker_cost_medium">Cost: medium</string>
    <!-- MonarchAiModelPicker: read instead of $$$ for the highest cost tier. -->
    <string name="monarch_aimodelpicker_cost_high">Cost: high</string>
    <!-- MonarchAiModelPicker: the badge of a model that runs on the workspace's own configured key. -->
    <string name="monarch_aimodelpicker_own_key">Your key</string>
    <!-- MonarchAiModelPicker: the badge of a model whose provider key is missing. -->
    <string name="monarch_aimodelpicker_key_needed">Key needed</string>
    <!-- MonarchAiModelPicker: read on a model whose key is missing when choosing it adds the key. -->
    <string name="monarch_aimodelpicker_add_key_hint">Select to add an API key.</string>
    <!-- MonarchAiModelPicker: read on a model that cannot be chosen. -->
    <string name="monarch_aimodelpicker_unavailable">Unavailable</string>
    <!-- MonarchAiModelPicker: the button that closes the sheet. -->
    <string name="monarch_aimodelpicker_done">Done</string>
</resources>
