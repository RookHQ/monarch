<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiConnectorPicker: the heading. -->
    <string name="monarch_aiconnectorpicker_title">Connectors</string>
    <!-- MonarchAiConnectorPicker: the placeholder of the search field. -->
    <string name="monarch_aiconnectorpicker_search_prompt">Search connectors</string>
    <!-- MonarchAiConnectorPicker: the button that closes the picker. -->
    <string name="monarch_aiconnectorpicker_done">Done</string>
    <!-- MonarchAiConnectorPicker: the summary under the heading. %1$s connectors on, %2$s tools that ask first. -->
    <string name="monarch_aiconnectorpicker_summary">%1$s · %2$s</string>
    <!-- MonarchAiConnectorPicker: the first half of the summary. %1$d connectors on, %2$d connectors in all. -->
    <plurals name="monarch_aiconnectorpicker_connectors_on">
        <item quantity="one">%1$d of %2$d connector on</item>
        <item quantity="other">%1$d of %2$d connectors on</item>
    </plurals>
    <!-- MonarchAiConnectorPicker: the second half of the summary. %1$d is the number of tools. -->
    <plurals name="monarch_aiconnectorpicker_tools_ask">
        <item quantity="one">%1$d tool asks first</item>
        <item quantity="other">%1$d tools ask first</item>
    </plurals>
    <!-- MonarchAiConnectorPicker: announced when the search finds nothing. -->
    <string name="monarch_aiconnectorpicker_results_none">No connectors found</string>
    <!-- MonarchAiConnectorPicker: announced when the search changes. %1$d is the number found. -->
    <plurals name="monarch_aiconnectorpicker_results">
        <item quantity="one">%1$d connector found</item>
        <item quantity="other">%1$d connectors found</item>
    </plurals>
    <!-- MonarchAiConnectorPicker: the empty state of a search. %1$s is the search text. -->
    <string name="monarch_aiconnectorpicker_no_results">No connectors match “%1$s”.</string>
    <!-- MonarchAiConnectorPicker: the button of the empty state of a search. -->
    <string name="monarch_aiconnectorpicker_clear_search">Clear search</string>
    <!-- MonarchAiConnectorPicker: the empty state without connectors. -->
    <string name="monarch_aiconnectorpicker_empty">No connectors are available.</string>
    <!-- MonarchAiConnectorPicker: the status of a connected connector. -->
    <string name="monarch_aiconnectorpicker_status_connected">Connected</string>
    <!-- MonarchAiConnectorPicker: the status of a connector that needs sign-in. -->
    <string name="monarch_aiconnectorpicker_status_needs_sign_in">Sign-in needed</string>
    <!-- MonarchAiConnectorPicker: the status of a connector with a problem. -->
    <string name="monarch_aiconnectorpicker_status_error">Connection problem</string>
    <!-- MonarchAiConnectorPicker: the status of a connector that cannot be used. -->
    <string name="monarch_aiconnectorpicker_status_unavailable">Unavailable</string>
    <!-- MonarchAiConnectorPicker: the status of a connected connector with its account. %1$s is the account. -->
    <string name="monarch_aiconnectorpicker_account">Connected as %1$s</string>
    <!-- MonarchAiConnectorPicker: the spoken name of a connector's switch. %1$s is the connector. -->
    <string name="monarch_aiconnectorpicker_enable">Use %1$s in this conversation</string>
    <!-- MonarchAiConnectorPicker: why a connector that needs sign-in cannot be turned on. -->
    <string name="monarch_aiconnectorpicker_reason_needs_sign_in">Sign in before turning this on.</string>
    <!-- MonarchAiConnectorPicker: why a connector with a problem cannot be turned on. -->
    <string name="monarch_aiconnectorpicker_reason_error">Reconnect before turning this on.</string>
    <!-- MonarchAiConnectorPicker: why an unavailable connector cannot be turned on. -->
    <string name="monarch_aiconnectorpicker_reason_unavailable">This connector cannot be used right now.</string>
    <!-- MonarchAiConnectorPicker: the action of a connector that needs sign-in. -->
    <string name="monarch_aiconnectorpicker_sign_in">Sign in</string>
    <!-- MonarchAiConnectorPicker: the action of a connector with a problem. -->
    <string name="monarch_aiconnectorpicker_reconnect">Reconnect</string>
    <!-- MonarchAiConnectorPicker: the action that opens a connector's settings. -->
    <string name="monarch_aiconnectorpicker_manage">Manage</string>
    <!-- MonarchAiConnectorPicker: the spoken name of an action. %1$s is the action, %2$s the connector: "Sign in: Drive". -->
    <string name="monarch_aiconnectorpicker_action_label">%1$s: %2$s</string>
    <!-- MonarchAiConnectorPicker: the button that shows a connector's tools. %1$d is the number of tools. -->
    <plurals name="monarch_aiconnectorpicker_tools">
        <item quantity="one">%1$d tool</item>
        <item quantity="other">%1$d tools</item>
    </plurals>
    <!-- MonarchAiConnectorPicker: the spoken name of a tool's permission menu. %1$s is the tool. -->
    <string name="monarch_aiconnectorpicker_permission_label">Permission for %1$s</string>
    <!-- MonarchAiConnectorPicker: the permission that runs a tool without asking. -->
    <string name="monarch_aiconnectorpicker_permission_allow">Allow</string>
    <!-- MonarchAiConnectorPicker: the permission that asks each time. -->
    <string name="monarch_aiconnectorpicker_permission_ask">Ask first</string>
    <!-- MonarchAiConnectorPicker: the permission that never runs a tool. -->
    <string name="monarch_aiconnectorpicker_permission_never">Never</string>
    <!-- MonarchAiConnectorPicker: the risk badge of a tool that reads data. -->
    <string name="monarch_aiconnectorpicker_risk_read">Reads data</string>
    <!-- MonarchAiConnectorPicker: the risk badge of a tool that changes data. -->
    <string name="monarch_aiconnectorpicker_risk_write">Changes data</string>
    <!-- MonarchAiConnectorPicker: the risk badge of a tool that can delete data. -->
    <string name="monarch_aiconnectorpicker_risk_destructive">Can delete data</string>
    <!-- MonarchAiConnectorPicker: the line under a tool that can delete data and cannot be allowed. -->
    <string name="monarch_aiconnectorpicker_destructive_locked">Tools that can delete data cannot run without asking.</string>
</resources>
