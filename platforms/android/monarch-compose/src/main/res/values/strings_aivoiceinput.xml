<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiVoiceInput: the button that starts and stops dictation on each press. -->
    <string name="monarch_aivoiceinput_dictate">Dictate</string>
    <!-- MonarchAiVoiceInput: the button that listens while held. -->
    <string name="monarch_aivoiceinput_hold_to_talk">Hold to talk</string>
    <!-- MonarchAiVoiceInput: the TalkBack action of the hold-to-talk button, read after "Double-tap to". -->
    <string name="monarch_aivoiceinput_hold_hint">start or stop listening</string>
    <!-- MonarchAiVoiceInput: the status while waiting for the permission and the microphone. -->
    <string name="monarch_aivoiceinput_starting">Starting microphone…</string>
    <!-- MonarchAiVoiceInput: the status while listening, also announced. -->
    <string name="monarch_aivoiceinput_listening">Listening…</string>
    <!-- MonarchAiVoiceInput: announced when listening stops. -->
    <string name="monarch_aivoiceinput_stopped">Stopped listening.</string>
    <!-- MonarchAiVoiceInput: shown when microphone access is refused. -->
    <string name="monarch_aivoiceinput_denied">Microphone access is off. Turn it on in the app settings, then try again.</string>
    <!-- MonarchAiVoiceInput: shown when nothing was heard. -->
    <string name="monarch_aivoiceinput_no_speech">Nothing was heard. Try again and speak clearly.</string>
    <!-- MonarchAiVoiceInput: shown when there is no microphone. -->
    <string name="monarch_aivoiceinput_no_microphone">No microphone is available. Connect one and try again.</string>
    <!-- MonarchAiVoiceInput: shown when speech recognition is not available, for example without a network. -->
    <string name="monarch_aivoiceinput_unavailable">Dictation is not available right now. Try again later.</string>
    <!-- MonarchAiVoiceInput: shown for any other dictation failure. -->
    <string name="monarch_aivoiceinput_error">Dictation stopped unexpectedly. Try again.</string>
    <!-- MonarchAiVoiceInput: read before the live transcript. %1$s is the transcript: "Transcript: book a table". -->
    <string name="monarch_aivoiceinput_transcript">Transcript: %1$s</string>
    <!-- MonarchAiVoiceInput: the action that opens the app's settings page when microphone access is off. -->
    <string name="monarch_aivoiceinput_open_settings">Open settings</string>
</resources>
