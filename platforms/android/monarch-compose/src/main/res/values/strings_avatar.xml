<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What TalkBack reads for an avatar with a presence: the name, then the presence ("Ana Silva, Online"). -->
    <string name="monarch_avatar_with_status">%1$s, %2$s</string>
    <!-- What TalkBack reads for the tile that stands for the hidden avatars of a group. -->
    <plurals name="monarch_avatar_more">
        <item quantity="one">%1$d more</item>
        <item quantity="other">%1$d more</item>
    </plurals>
    <!-- The visible text of the tile that stands for the hidden avatars of a group. -->
    <string name="monarch_avatar_more_short">+%1$d</string>
</resources>
