<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Heading of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_title">Docs</string>
    <!-- Button of a MonarchLinkedDocsPanel that opens the menu of docs to link. -->
    <string name="monarch_linkeddocspanel_link_doc">Link doc</string>
    <!-- Button of a MonarchLinkedDocsPanel that opens the form to add an external link. -->
    <string name="monarch_linkeddocspanel_add_link">Add link</string>
    <!-- Last item of the doc menu of a MonarchLinkedDocsPanel, which creates a new doc. -->
    <string name="monarch_linkeddocspanel_new_doc">New doc</string>
    <!-- Placeholder of the search field in the doc menu of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_search_docs">Search docs</string>
    <!-- Shown in the doc menu of a MonarchLinkedDocsPanel when no doc matches. -->
    <string name="monarch_linkeddocspanel_no_docs">No docs match.</string>
    <!-- Shown in a MonarchLinkedDocsPanel without rows. -->
    <string name="monarch_linkeddocspanel_empty">Nothing linked yet. Link a spec, runbook or notes, or add a link to any page.</string>
    <!-- Shown in a read-only MonarchLinkedDocsPanel without rows. -->
    <string name="monarch_linkeddocspanel_empty_read_only">Nothing linked yet.</string>
    <!-- Name of the loading state of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_loading">Loading linked docs</string>
    <!-- Name of the group of Space filter chips of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_filter_by_space">Filter by Space</string>
    <!-- Name of the Space filter chip of a MonarchLinkedDocsPanel that shows every row. -->
    <string name="monarch_linkeddocspanel_all">All</string>
    <!-- Name of the Space filter chip of a MonarchLinkedDocsPanel for rows without a Space. -->
    <string name="monarch_linkeddocspanel_no_space">No Space</string>
    <!-- Text of a Space filter chip of a MonarchLinkedDocsPanel: the Space's name (1) and its number of rows (2). -->
    <string name="monarch_linkeddocspanel_chip">%1$s · %2$d</string>
    <!-- Note under the rows of a MonarchLinkedDocsPanel: how many rows the Space filter hides. -->
    <plurals name="monarch_linkeddocspanel_hidden_by_filter">
        <item quantity="one">%1$d more in another Space.</item>
        <item quantity="other">%1$d more in other Spaces.</item>
    </plurals>
    <!-- Button of a MonarchLinkedDocsPanel that clears the Space filter. -->
    <string name="monarch_linkeddocspanel_show_all">Show all</string>
    <!-- Spoken name of the unlink button of a row of a MonarchLinkedDocsPanel. %1$s is the row's title. -->
    <string name="monarch_linkeddocspanel_unlink">Unlink %1$s</string>
    <!-- Visible text of the unlink button of a row of a MonarchLinkedDocsPanel when the app gives no icon. -->
    <string name="monarch_linkeddocspanel_unlink_text">Unlink</string>
    <!-- Name of the tap action of a row of a MonarchLinkedDocsPanel, read by TalkBack as "Double-tap to open". -->
    <string name="monarch_linkeddocspanel_open">Open</string>
    <!-- Label of the address field of the add-link form of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_url_label">Link</string>
    <!-- Error under the address field of the add-link form of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_url_invalid">Enter a full web address that starts with https://</string>
    <!-- Label of the title field of the add-link form of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_title_label">Title (optional)</string>
    <!-- Submit button of the add-link form of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_add">Add</string>
    <!-- Cancel button of the add-link form of a MonarchLinkedDocsPanel. -->
    <string name="monarch_linkeddocspanel_cancel">Cancel</string>
</resources>
