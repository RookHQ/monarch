<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Read after the title of an unread MonarchInboxRow without a count. -->
    <string name="monarch_inboxrow_unread">Unread</string>
    <!-- Read after the title of an unread MonarchInboxRow with a count. %1$d is the count. -->
    <plurals name="monarch_inboxrow_unread_count">
        <item quantity="one">%1$d unread</item>
        <item quantity="other">%1$d unread</item>
    </plurals>
    <!-- Goes between the title, the unread state and the channel in what TalkBack reads for a MonarchInboxRow. -->
    <string name="monarch_inboxrow_separator">", "</string>
    <!-- Compact age of a MonarchInboxRow under a minute. -->
    <string name="monarch_inboxrow_age_now">now</string>
    <!-- Compact age of a MonarchInboxRow in minutes. %1$d is the number of minutes. -->
    <string name="monarch_inboxrow_age_minutes">%1$dm</string>
    <!-- Compact age of a MonarchInboxRow in hours. %1$d is the number of hours. -->
    <string name="monarch_inboxrow_age_hours">%1$dh</string>
    <!-- Compact age of a MonarchInboxRow in days. %1$d is the number of days. -->
    <string name="monarch_inboxrow_age_days">%1$dd</string>
    <!-- Compact age of a MonarchInboxRow in weeks. %1$d is the number of weeks. -->
    <string name="monarch_inboxrow_age_weeks">%1$dw</string>
    <!-- What a long press does on a selectable MonarchInboxRow; TalkBack reads it as the action. -->
    <string name="monarch_inboxrow_select">Select</string>
    <!-- Swipe and TalkBack action that marks an unread MonarchInboxRow as read. -->
    <string name="monarch_inboxrow_mark_read">Read</string>
    <!-- Swipe and TalkBack action that marks a read MonarchInboxRow as unread. -->
    <string name="monarch_inboxrow_mark_unread">Unread</string>
    <!-- Swipe and TalkBack action that archives the conversation of a MonarchInboxRow. -->
    <string name="monarch_inboxrow_archive">Archive</string>
    <!-- Swipe and TalkBack action that deletes the conversation of a MonarchInboxRow. -->
    <string name="monarch_inboxrow_delete">Delete</string>
</resources>
