<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchBacklogPlanner: the mark on a row whose item has no estimate. -->
    <string name="monarch_backlogplanner_unestimated">–</string>
    <!-- MonarchBacklogPlanner: what TalkBack reads for a row whose item has no estimate. -->
    <string name="monarch_backlogplanner_not_estimated">Not estimated</string>
    <!-- MonarchBacklogPlanner: the points of one item on its row. %1$d is the points. -->
    <string name="monarch_backlogplanner_points">%1$d pt</string>
    <!-- MonarchBacklogPlanner: the TalkBack name of a row's drag handle. %1$s is the item's name. -->
    <string name="monarch_backlogplanner_handle">Move %1$s</string>
    <!-- MonarchBacklogPlanner: the TalkBack name of a row's Move to button. %1$s is the item's name. -->
    <string name="monarch_backlogplanner_move_menu">Move %1$s to another bucket</string>
    <!-- MonarchBacklogPlanner: the visible text of a row's Move to button. -->
    <string name="monarch_backlogplanner_move">Move</string>
    <!-- MonarchBacklogPlanner: a choice of the Move to menu and a TalkBack action of a row. %1$s is a bucket's title. -->
    <string name="monarch_backlogplanner_move_to">Move to %1$s</string>
    <!-- MonarchBacklogPlanner: the text of a bucket with no items. -->
    <string name="monarch_backlogplanner_empty">Nothing here yet.</string>
    <!-- MonarchBacklogPlanner: the state TalkBack reads for a bucket whose items are shown. -->
    <string name="monarch_backlogplanner_expanded">Expanded</string>
    <!-- MonarchBacklogPlanner: the state TalkBack reads for a bucket whose items are hidden. -->
    <string name="monarch_backlogplanner_collapsed">Collapsed</string>
    <!-- MonarchBacklogPlanner: announced when a drag starts. %1$s item, %2$s bucket, %3$d position, %4$d items in the bucket. -->
    <string name="monarch_backlogplanner_picked_up">Picked up %1$s. %2$s, position %3$d of %4$d.</string>
    <!-- MonarchBacklogPlanner: announced after a move by a TalkBack action. %1$s item, %2$s bucket, %3$d position, %4$d items in the bucket. -->
    <string name="monarch_backlogplanner_moved">%1$s moved to %2$s, position %3$d of %4$d.</string>
    <!-- MonarchBacklogPlanner: announced when a drag ends or the menu moves an item. %1$s item, %2$s bucket, %3$d position, %4$d items in the bucket. -->
    <string name="monarch_backlogplanner_dropped">%1$s dropped in %2$s, position %3$d of %4$d.</string>
    <!-- MonarchBacklogPlanner: announced when a drag is cancelled. %1$s is the item's name. -->
    <string name="monarch_backlogplanner_cancelled">Move cancelled. %1$s returned to where it was.</string>
    <!-- MonarchBacklogPlanner: announced when saving a move failed. %1$s is the item's name. -->
    <string name="monarch_backlogplanner_failed">%1$s could not be moved. It is back where it was.</string>
    <!-- MonarchBacklogPlanner: the item count in a bucket's summary. %1$d is the count. -->
    <plurals name="monarch_backlogplanner_items">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>
    <!-- MonarchBacklogPlanner: the points total in a bucket's summary. %1$d is the total. -->
    <plurals name="monarch_backlogplanner_points_total">
        <item quantity="one">%1$d point</item>
        <item quantity="other">%1$d points</item>
    </plurals>
    <!-- MonarchBacklogPlanner: the number of items without an estimate in a bucket's summary. %1$d is the count. -->
    <plurals name="monarch_backlogplanner_unestimated_count">
        <item quantity="one">%1$d unestimated</item>
        <item quantity="other">%1$d unestimated</item>
    </plurals>
    <!-- MonarchBacklogPlanner: the capacity text of a bucket. %1$d is the planned points, %2$d the capacity. -->
    <plurals name="monarch_backlogplanner_capacity">
        <item quantity="one">%1$d of %2$d point</item>
        <item quantity="other">%1$d of %2$d points</item>
    </plurals>
    <!-- MonarchBacklogPlanner: the note of a bucket over capacity. %1$d is the excess in points. -->
    <plurals name="monarch_backlogplanner_over_capacity">
        <item quantity="one">Planned work is over capacity by %1$d point.</item>
        <item quantity="other">Planned work is over capacity by %1$d points.</item>
    </plurals>
</resources>
