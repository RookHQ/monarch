<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The label of a MonarchPhoneCountrySelect field and the title of its sheet. -->
    <string name="monarch_phonecountryselect_label">Country code</string>
    <!-- The heading over the suggested countries of a MonarchPhoneCountrySelect. -->
    <string name="monarch_phonecountryselect_suggested">Suggested</string>
    <!-- The heading over the other countries of a MonarchPhoneCountrySelect when some are suggested. -->
    <string name="monarch_phonecountryselect_all">All countries</string>
    <!-- Shown in a MonarchPhoneCountrySelect list when no country matches the search. -->
    <string name="monarch_phonecountryselect_empty">No matching country</string>
    <!-- A row of a MonarchPhoneCountrySelect. %1$s is the country's name, %2$s its calling code, such as +351. -->
    <string name="monarch_phonecountryselect_option">%1$s (%2$s)</string>
</resources>
