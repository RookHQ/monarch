<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Marker in the author line of a pinned MonarchPostCard. -->
    <string name="monarch_postcard_pinned">Pinned</string>
    <!-- Badge of a MonarchPostCard whose question has an accepted answer. -->
    <string name="monarch_postcard_answered">Answered</string>
    <!-- Reaction count of a MonarchPostCard. %1$s is the count, written in the locale's digits. -->
    <plurals name="monarch_postcard_reactions">
        <item quantity="one">%1$s reaction</item>
        <item quantity="other">%1$s reactions</item>
    </plurals>
    <!-- Comment count of a MonarchPostCard. %1$s is the count, written in the locale's digits. -->
    <plurals name="monarch_postcard_comments">
        <item quantity="one">%1$s comment</item>
        <item quantity="other">%1$s comments</item>
    </plurals>
</resources>
