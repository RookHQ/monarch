<resources>
    <!-- MonarchAiHandoff: read first, so the marker is known as a handoff. -->
    <string name="monarch_aihandoff_label">Handoff</string>
    <!-- MonarchAiHandoff: the sentence. %1$s is the agent that hands over, %2$s the agent or person that takes the work. -->
    <string name="monarch_aihandoff_handed_off">%1$s handed off to %2$s</string>
    <!-- MonarchAiHandoff: read after an agent's name, so it is never taken for a person. -->
    <string name="monarch_aihandoff_agent_kind">AI agent</string>
    <!-- MonarchAiHandoff: read before the reason. -->
    <string name="monarch_aihandoff_reason">Reason:</string>
</resources>
