<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchKanbanBoard: the TalkBack name of a card's drag handle. %1$s is the card's name. -->
    <string name="monarch_kanbanboard_handle">Move %1$s</string>
    <!-- MonarchKanbanBoard: the TalkBack name of a card's Move to button. %1$s is the card's name. -->
    <string name="monarch_kanbanboard_move_menu">Move %1$s to another column</string>
    <!-- MonarchKanbanBoard: the visible text of a card's Move to button. -->
    <string name="monarch_kanbanboard_move">Move</string>
    <!-- MonarchKanbanBoard: a choice of the Move to menu. %1$s is a column's title. -->
    <string name="monarch_kanbanboard_move_to">Move to %1$s</string>
    <!-- MonarchKanbanBoard: the visible count of a column without a limit. %1$d is the number of cards. -->
    <string name="monarch_kanbanboard_count">%1$d</string>
    <!-- MonarchKanbanBoard: the visible count of a column with a work-in-progress limit. %1$d cards, %2$d the limit. -->
    <string name="monarch_kanbanboard_count_limit">%1$d / %2$d</string>
    <!-- MonarchKanbanBoard: a column's count with its work-in-progress limit, for TalkBack. %1$s is the card count ("3 cards"), %2$d the limit. -->
    <string name="monarch_kanbanboard_limit">%1$s, limit %2$d</string>
    <!-- MonarchKanbanBoard: a column's count when it is at its limit. %1$s is the count with the limit. -->
    <string name="monarch_kanbanboard_at_limit">%1$s, at the limit</string>
    <!-- MonarchKanbanBoard: a column's count when it is over its limit. %1$s is the count with the limit. -->
    <string name="monarch_kanbanboard_over_limit">%1$s, over the limit</string>
    <!-- MonarchKanbanBoard: the text of a column with no cards. -->
    <string name="monarch_kanbanboard_empty">No cards</string>
    <!-- MonarchKanbanBoard: shown on a column that refuses the card being dragged. -->
    <string name="monarch_kanbanboard_blocked">Not allowed here</string>
    <!-- MonarchKanbanBoard: announced when a drag starts. %1$s card, %2$s column, %3$d position, %4$d cards in the column. -->
    <string name="monarch_kanbanboard_picked_up">Picked up %1$s. %2$s, position %3$d of %4$d.</string>
    <!-- MonarchKanbanBoard: announced after a move by a TalkBack action. %1$s card, %2$s column, %3$d position, %4$d cards in the column. -->
    <string name="monarch_kanbanboard_moved">%1$s: %2$s, position %3$d of %4$d.</string>
    <!-- MonarchKanbanBoard: announced when a drag ends or the menu moves a card. %1$s card, %2$s column, %3$d position, %4$d cards in the column. -->
    <string name="monarch_kanbanboard_dropped">%1$s dropped in %2$s, position %3$d of %4$d.</string>
    <!-- MonarchKanbanBoard: announced when a drag is cancelled. %1$s card, %2$s the column it is back in. -->
    <string name="monarch_kanbanboard_cancelled">Move cancelled. %1$s returned to %2$s.</string>
    <!-- MonarchKanbanBoard: announced when a card is dropped on a column that refuses it. %1$s card, %2$s column. -->
    <string name="monarch_kanbanboard_not_allowed">%1$s cannot move to %2$s.</string>
    <!-- MonarchKanbanBoard: announced when saving a move failed. %1$s card, %2$s the column it is back in. -->
    <string name="monarch_kanbanboard_failed">Could not move %1$s. It is back in %2$s.</string>
    <!-- MonarchKanbanBoard: the number of cards in a column, for TalkBack. %1$d is the count. -->
    <plurals name="monarch_kanbanboard_cards">
        <item quantity="one">%1$d card</item>
        <item quantity="other">%1$d cards</item>
    </plurals>
</resources>
