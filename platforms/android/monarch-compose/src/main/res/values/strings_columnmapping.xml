<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the list of a MonarchColumnMapping, read by TalkBack. -->
    <string name="monarch_columnmapping_label">Column mapping</string>
    <!-- Label of the field picker of one imported column in a MonarchColumnMapping. %1$s is the column header. -->
    <string name="monarch_columnmapping_field_for">Field for %1$s</string>
    <!-- Picker option of a MonarchColumnMapping that leaves the column out of the import. -->
    <string name="monarch_columnmapping_skip">Don’t import</string>
    <!-- Mark after a required field in the picker of a MonarchColumnMapping. -->
    <string name="monarch_columnmapping_required">required</string>
    <!-- A required field in the picker of a MonarchColumnMapping. %1$s is the field, %2$s the required mark. -->
    <string name="monarch_columnmapping_required_option">%1$s (%2$s)</string>
    <!-- Badge of a MonarchColumnMapping column set to an exact suggestion. -->
    <string name="monarch_columnmapping_exact_match">Matched</string>
    <!-- Badge of a MonarchColumnMapping column set to a close suggestion. -->
    <string name="monarch_columnmapping_suggested">Suggested</string>
    <!-- Shown by a MonarchColumnMapping for a column without example values. -->
    <string name="monarch_columnmapping_no_samples">No values</string>
    <!-- Count of a MonarchColumnMapping, announced when it changes. %1$d mapped columns, %2$d all columns; the
         quantity is the number of all columns. -->
    <plurals name="monarch_columnmapping_summary">
        <item quantity="one">%1$d of %2$d column mapped</item>
        <item quantity="other">%1$d of %2$d columns mapped</item>
    </plurals>
    <!-- Error of a MonarchColumnMapping. %1$s is the list of required fields no column is mapped to. -->
    <string name="monarch_columnmapping_missing">Map a column to: %1$s.</string>
    <!-- Error under a MonarchColumnMapping column. %1$s is the field, %2$s the other columns that chose it. -->
    <string name="monarch_columnmapping_duplicate">%1$s is also chosen for %2$s.</string>
    <!-- Button of a MonarchColumnMapping that sets every column to its suggestion. -->
    <string name="monarch_columnmapping_use_suggestions">Use suggestions</string>
    <!-- Button of a MonarchColumnMapping that leaves every column out. -->
    <string name="monarch_columnmapping_skip_all">Don’t import any</string>
    <!-- Name of a MonarchColumnMapping column whose header is blank. %1$d is its position from 1. -->
    <string name="monarch_columnmapping_position">#%1$d</string>
    <!-- Joins the fields and columns named in the errors of a MonarchColumnMapping. -->
    <string name="monarch_columnmapping_separator">", "</string>
    <!-- Caption above the name of the file's column on each row of a MonarchColumnMapping. -->
    <string name="monarch_columnmapping_column_in_file">Column in file</string>
    <!-- Caption above the example values of the file's column on each row of a MonarchColumnMapping. -->
    <string name="monarch_columnmapping_example_values">Example values</string>
    <!-- Caption above the field picker of each row of a MonarchColumnMapping. -->
    <string name="monarch_columnmapping_import_as">Import as</string>
</resources>
