<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Placeholder of the search field of a MonarchCombobox, and of its field while the menu is open and nothing is chosen. -->
    <string name="monarch_combobox_search">Search</string>
    <!-- Shown in a MonarchCombobox list while options load and none match yet. -->
    <string name="monarch_combobox_loading">Loading…</string>
    <!-- Shown in a MonarchCombobox list when no option matches the search. -->
    <string name="monarch_combobox_empty">No matches</string>
    <!-- The option of a MonarchCombobox that creates a new value from the typed text. %1$s is the typed text. -->
    <string name="monarch_combobox_create">Create “%1$s”</string>
    <!-- Shown under a MonarchCombobox list cut short. %1$d is the number shown, %2$d the number of matches. -->
    <string name="monarch_combobox_more">Showing %1$d of %2$d. Type to narrow the list.</string>
    <!-- The button that closes the MonarchCombobox sheet without choosing. -->
    <string name="monarch_combobox_cancel">Cancel</string>
    <!-- Spoken name of the button that clears the MonarchCombobox selection. -->
    <string name="monarch_combobox_clear">Clear</string>
    <!-- Shown in the MonarchCombobox list when the options could not be loaded and the app gave no message. -->
    <string name="monarch_combobox_failed">The options could not be loaded.</string>
    <!-- The button after the load error in the MonarchCombobox list that loads the options again. -->
    <string name="monarch_combobox_retry">Try again</string>
</resources>
