<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the button of a MonarchLoadMore. -->
    <string name="monarch_loadmore_load_more">Load more</string>
    <!-- State of the button of a MonarchLoadMore while a page loads. Read by TalkBack. -->
    <string name="monarch_loadmore_loading">Loading</string>
    <!-- Message of a MonarchLoadMore after a page failed to load. Also announced. -->
    <string name="monarch_loadmore_failed">Couldn\'t load more.</string>
    <!-- Label of the button of a MonarchLoadMore after a failure. -->
    <string name="monarch_loadmore_retry">Retry</string>
    <!-- Line at the end of a list with a MonarchLoadMore. Also announced. -->
    <string name="monarch_loadmore_end">That\'s everything</string>
    <!-- Count of a MonarchLoadMore when the total is known: the items on screen and the total. -->
    <plurals name="monarch_loadmore_count_of">
        <item quantity="one">Showing %1$d of %2$d item</item>
        <item quantity="other">Showing %1$d of %2$d items</item>
    </plurals>
    <!-- Count of a MonarchLoadMore when the total is not known: the items on screen. -->
    <plurals name="monarch_loadmore_count">
        <item quantity="one">Showing %1$d item</item>
        <item quantity="other">Showing %1$d items</item>
    </plurals>
    <!-- Announced by a MonarchLoadMore after a page loads: the number of items it added. -->
    <plurals name="monarch_loadmore_loaded">
        <item quantity="one">%1$d more item loaded.</item>
        <item quantity="other">%1$d more items loaded.</item>
    </plurals>
    <!-- How a MonarchLoadMore joins two announcements made at once. -->
    <string name="monarch_loadmore_announcement_separator">" "</string>
</resources>
