<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiContextChips: the name TalkBack reads for the group of chips. -->
    <string name="monarch_aicontextchips_label">Context</string>
    <!-- MonarchAiContextChips: the kind of an item, read before its name. -->
    <string name="monarch_aicontextchips_kind_file">File</string>
    <!-- MonarchAiContextChips: the kind of an item, read before its name. -->
    <string name="monarch_aicontextchips_kind_selection">Selection</string>
    <!-- MonarchAiContextChips: the kind of an item, read before its name. -->
    <string name="monarch_aicontextchips_kind_page">Page</string>
    <!-- MonarchAiContextChips: the kind of an item, read before its name. -->
    <string name="monarch_aicontextchips_kind_record">Record</string>
    <!-- MonarchAiContextChips: the kind of an item, read before its name. -->
    <string name="monarch_aicontextchips_kind_app">App</string>
    <!-- MonarchAiContextChips: the kind of an item, read before its name. -->
    <string name="monarch_aicontextchips_kind_person">Person</string>
    <!-- MonarchAiContextChips: the token count of one item, read by TalkBack. %1$s is the compact count. -->
    <plurals name="monarch_aicontextchips_tokens">
        <item quantity="one">%1$s token</item>
        <item quantity="other">%1$s tokens</item>
    </plurals>
    <!-- MonarchAiContextChips: the total after the chips. %1$s is the compact count. -->
    <plurals name="monarch_aicontextchips_total">
        <item quantity="one">≈ %1$s token in context</item>
        <item quantity="other">≈ %1$s tokens in context</item>
    </plurals>
    <!-- MonarchAiContextChips: the TalkBack action of a removable chip. %1$s is the item's name. -->
    <string name="monarch_aicontextchips_remove">Remove %1$s from context</string>
    <!-- MonarchAiContextChips: announced after a chip is removed. %1$s is the item's name. -->
    <string name="monarch_aicontextchips_removed">%1$s removed from context</string>
</resources>
