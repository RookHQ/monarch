<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchCalendarHeatmap, the table heading of the dates. -->
    <string name="monarch_calendarheatmap_date">Date</string>
    <!-- MonarchCalendarHeatmap, the table heading of the values. -->
    <string name="monarch_calendarheatmap_value">Value</string>
    <!-- MonarchCalendarHeatmap, the table heading of the notes. -->
    <string name="monarch_calendarheatmap_note">Note</string>
    <!-- MonarchCalendarHeatmap, read and written after the value of today. -->
    <string name="monarch_calendarheatmap_today">Today</string>
    <!-- MonarchCalendarHeatmap, read and written after the value of a non-working day. -->
    <string name="monarch_calendarheatmap_inactive">Non-working day</string>
