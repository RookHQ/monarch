<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchUsageMeter, the figures of a metered item. %1$s used, %2$s limit: "7,200 of 10,000". -->
    <string name="monarch_usagemeter_amount">%1$s of %2$s</string>
    <!-- MonarchUsageMeter, the share of the limit. %1$s is a percentage: "42% used". -->
    <string name="monarch_usagemeter_percent">%1$s used</string>
    <!-- MonarchUsageMeter, the level of an item at or above the warning share of its limit. -->
    <string name="monarch_usagemeter_near_limit">Near the limit</string>
    <!-- MonarchUsageMeter, the level of an item above its limit. -->
    <string name="monarch_usagemeter_over_limit">Over the limit</string>
    <!-- MonarchUsageMeter, the level and the share together. %1$s level, %2$s share: "Near the limit · 84% used". -->
    <string name="monarch_usagemeter_status">%1$s · %2$s</string>
    <!-- MonarchUsageMeter, when the quota resets. %1$s is a date. -->
    <string name="monarch_usagemeter_resets">Resets %1$s</string>
    <!-- MonarchUsageMeter, shown and read while the usage loads. -->
    <string name="monarch_usagemeter_loading">Loading usage</string>
    <!-- MonarchUsageMeter, the button under an error message. -->
    <string name="monarch_usagemeter_retry">Try again</string>
    <!-- MonarchUsageMeter, announced when an item reaches a threshold. %1$s item label, %2$s "Near the limit" or "Over the limit". -->
    <string name="monarch_usagemeter_threshold">%1$s: %2$s</string>
</resources>
