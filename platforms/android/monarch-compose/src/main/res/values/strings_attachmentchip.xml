<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the remove button of a MonarchAttachmentChip, with the file name. -->
    <string name="monarch_attachmentchip_remove">Remove %1$s</string>
    <!-- Spoken name of the retry button of a MonarchAttachmentChip, with the file name. -->
    <string name="monarch_attachmentchip_retry">Retry %1$s</string>
    <!-- Spoken name of the progress bar of a MonarchAttachmentChip, with the file name. -->
    <string name="monarch_attachmentchip_uploading_percent">Uploading %1$s</string>
    <string name="monarch_attachmentchip_uploading">Uploading %1$s</string>
    <!-- Shown by a MonarchAttachmentChip while the upload waits to start. -->
    <string name="monarch_attachmentchip_queued">Waiting</string>
    <!-- Shown and announced by a MonarchAttachmentChip when the upload failed and the app gives no reason. -->
    <string name="monarch_attachmentchip_failed">Upload failed</string>
    <!-- Shown by a MonarchAttachmentChip when the upload was cancelled. -->
    <string name="monarch_attachmentchip_cancelled">Cancelled</string>
    <!-- Visible word of the remove button of a MonarchAttachmentChip when the app gives no icon. -->
    <string name="monarch_attachmentchip_remove_text">Remove</string>
    <!-- Visible word of the retry button of a MonarchAttachmentChip when the app gives no icon. -->
    <string name="monarch_attachmentchip_retry_text">Retry</string>
</resources>
