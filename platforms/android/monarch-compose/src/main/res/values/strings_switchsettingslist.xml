<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The status of a row while its save runs, and the TalkBack name of its spinner. -->
    <string name="monarch_switchsettingslist_saving">Saving</string>
    <!-- The status of a row after a successful save; also announced. -->
    <string name="monarch_switchsettingslist_saved">Saved</string>
    <!-- The first sentence of a failed save; also announced. -->
    <string name="monarch_switchsettingslist_error">Couldn’t save.</string>
    <!-- A failed save with the reason: the first sentence, then the reason ("Couldn't save. No connection."). -->
    <string name="monarch_switchsettingslist_error_detail">%1$s %2$s</string>
    <!-- The visible text of the retry button of a failed save. -->
    <string name="monarch_switchsettingslist_retry">Retry</string>
    <!-- The TalkBack name of the retry button: the retry word, then the row label ("Retry Weekly summary"). -->
    <string name="monarch_switchsettingslist_retry_named">%1$s %2$s</string>
</resources>
