<resources>
    <!-- What TalkBack reads for the scroll area of a table in MonarchAiMarkdown. -->
    <string name="monarch_aimarkdown_table">Table</string>
    <!-- The heading of the footnotes listed at the end of MonarchAiMarkdown. -->
    <string name="monarch_aimarkdown_footnotes">Footnotes</string>
