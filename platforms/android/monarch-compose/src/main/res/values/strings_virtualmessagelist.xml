<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of a MonarchVirtualMessageList. -->
    <string name="monarch_virtualmessagelist_label">Messages</string>
    <!-- Divider above the first unread message of a MonarchVirtualMessageList. -->
    <string name="monarch_virtualmessagelist_new_messages">New messages</string>
    <!-- Day separator of a MonarchVirtualMessageList for messages sent today. -->
    <string name="monarch_virtualmessagelist_today">Today</string>
    <!-- Day separator of a MonarchVirtualMessageList for messages sent yesterday. -->
    <string name="monarch_virtualmessagelist_yesterday">Yesterday</string>
    <!-- Button of a MonarchVirtualMessageList that scrolls to the newest message. -->
    <string name="monarch_virtualmessagelist_jump_to_latest">Jump to latest</string>
    <!-- Button of a MonarchVirtualMessageList while new messages arrived below. %1$d is their number. -->
    <plurals name="monarch_virtualmessagelist_unseen">
        <item quantity="one">%1$d new message</item>
        <item quantity="other">%1$d new messages</item>
    </plurals>
    <!-- Announced when messages arrive in a MonarchVirtualMessageList. %1$d is their number. -->
    <plurals name="monarch_virtualmessagelist_arrived">
        <item quantity="one">%1$d new message</item>
        <item quantity="other">%1$d new messages</item>
    </plurals>
    <!-- Button at the top of a MonarchVirtualMessageList that loads older messages. -->
    <string name="monarch_virtualmessagelist_load_older">Load older messages</string>
    <!-- Shown at the top of a MonarchVirtualMessageList while older messages load. -->
    <string name="monarch_virtualmessagelist_loading_older">Loading older messages…</string>
    <!-- Shown at the top of a MonarchVirtualMessageList when older messages failed to load. -->
    <string name="monarch_virtualmessagelist_older_failed">Couldn’t load older messages.</string>
    <!-- Button at the top of a MonarchVirtualMessageList that retries loading older messages. -->
    <string name="monarch_virtualmessagelist_retry_older">Retry</string>
    <!-- TalkBack name of the placeholder of a MonarchVirtualMessageList while the first messages load. -->
    <string name="monarch_virtualmessagelist_loading">Loading messages</string>
</resources>
