    <string name="monarch_assigneepicker_assign_to_me">Assign to me</string>
    <!-- Placeholder of the search field in the MonarchAssigneePicker sheet. -->
    <string name="monarch_assigneepicker_search">Assign to…</string>
    <!-- The MonarchAssigneePicker field with several people assigned. %d is how many. -->
    <plurals name="monarch_assigneepicker_count">
        <item quantity="one">%d person</item>
        <item quantity="other">%d people</item>
    </plurals>
