<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Marker in the heading of today's day in a MonarchAgendaList, shown in a badge and read by TalkBack. -->
    <string name="monarch_agendalist_today">Today</string>
    <!-- Time of an all-day event in a MonarchAgendaList, and of a day a longer event covers whole. -->
    <string name="monarch_agendalist_all_day">All day</string>
    <!-- Number of events in a day heading of a MonarchAgendaList. -->
    <plurals name="monarch_agendalist_count">
        <item quantity="one">%d event</item>
        <item quantity="other">%d events</item>
    </plurals>
    <!-- Title of the empty state of a MonarchAgendaList when no day has events. -->
    <string name="monarch_agendalist_empty_title">Nothing scheduled</string>
    <!-- What TalkBack reads for the last day of an event that started on an earlier day. %1$s is the end time. -->
    <string name="monarch_agendalist_until">until %1$s</string>
    <!-- What TalkBack reads for an event's start and end in a MonarchAgendaList. %1$s is the start, %2$s the end. -->
    <string name="monarch_agendalist_range">%1$s to %2$s</string>
</resources>
