<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Visible text of a MonarchReadReceipt in the text and avatars displays. -->
    <string name="monarch_readreceipt_seen">Seen</string>
    <!-- Visible text of a MonarchReadReceipt in the count display. %1$d is the number of readers. -->
    <plurals name="monarch_readreceipt_seen_by_count">
        <item quantity="one">Seen by %1$d</item>
        <item quantity="other">Seen by %1$d</item>
    </plurals>
    <!-- What TalkBack reads for a MonarchReadReceipt. %1$s is the joined names of the readers. -->
    <string name="monarch_readreceipt_seen_by">Seen by %1$s</string>
    <!-- Goes between the names of the readers of a MonarchReadReceipt, except the last two. -->
    <string name="monarch_readreceipt_list_separator">", "</string>
    <!-- Joins the last two names of the readers of a MonarchReadReceipt. %1$s is the names before, %2$s the last name. -->
    <string name="monarch_readreceipt_list_last_pair">%1$s and %2$s</string>
</resources>
