<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the list of a MonarchSlashMenu, read by TalkBack. -->
    <string name="monarch_slashmenu_label">Insert block</string>
    <!-- Shown and announced by a MonarchSlashMenu when nothing matches. %1$s is what was typed, with the slash. -->
    <string name="monarch_slashmenu_empty">Nothing matches “%1$s”</string>
    <!-- Announced by a MonarchSlashMenu as its list changes. %1$d is the number of entries. -->
    <plurals name="monarch_slashmenu_count">
        <item quantity="one">%1$d option</item>
        <item quantity="other">%1$d options</item>
    </plurals>
</resources>
