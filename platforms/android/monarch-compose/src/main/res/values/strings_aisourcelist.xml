<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiSourceList: the heading of the list. -->
    <string name="monarch_aisourcelist_heading">Sources</string>
    <!-- MonarchAiSourceList: the heading of the sources the answer used; %1$d is their count. -->
    <string name="monarch_aisourcelist_used">Used (%1$d)</string>
    <!-- MonarchAiSourceList: the heading of the sources the assistant looked at but did not use; %1$d is their count. -->
    <string name="monarch_aisourcelist_considered">Considered (%1$d)</string>
    <!-- MonarchAiSourceList: the toggle that expands the list; %1$d is the number of sources. -->
    <plurals name="monarch_aisourcelist_show_all">
        <item quantity="one">Show %1$d source</item>
        <item quantity="other">Show all %1$d sources</item>
    </plurals>
    <!-- MonarchAiSourceList: the toggle that collapses the list. -->
    <string name="monarch_aisourcelist_show_fewer">Show fewer</string>
    <!-- MonarchAiSourceList: what TalkBack reads first for a source; %1$d is its number, %2$s its title. -->
    <string name="monarch_aisourcelist_source">Source %1$d: %2$s</string>
    <!-- MonarchAiSourceList: read by TalkBack as the tap action of a source: "double tap to open the source". -->
    <string name="monarch_aisourcelist_open_source">open the source</string>
    <!-- MonarchAiSourceList: the kind of a source that is a web page. -->
    <string name="monarch_aisourcelist_kind_web">Web page</string>
    <!-- MonarchAiSourceList: the kind of a source that is a document. -->
    <string name="monarch_aisourcelist_kind_doc">Document</string>
    <!-- MonarchAiSourceList: the kind of a source that is a record in a product. -->
    <string name="monarch_aisourcelist_kind_record">Record</string>
    <!-- MonarchAiSourceList: the kind of a source that is a file. -->
    <string name="monarch_aisourcelist_kind_file">File</string>
</resources>
