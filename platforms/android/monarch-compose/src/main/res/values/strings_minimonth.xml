<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the button of a MonarchMiniMonth that shows the previous month, read by TalkBack. -->
    <string name="monarch_minimonth_previous_month">Previous month</string>
    <!-- Name of the button of a MonarchMiniMonth that shows the next month, read by TalkBack. -->
    <string name="monarch_minimonth_next_month">Next month</string>
    <!-- Read by TalkBack before the date of today in a MonarchMiniMonth. -->
    <string name="monarch_minimonth_today">Today</string>
    <!-- Name of the week-number column of a MonarchMiniMonth, read by TalkBack. -->
    <string name="monarch_minimonth_week">Week</string>
    <!-- What TalkBack reads for a week number in a MonarchMiniMonth. %1$d is the ISO 8601 week number. -->
    <string name="monarch_minimonth_week_number">Week %1$d</string>
</resources>
