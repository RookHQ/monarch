<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TalkBack name of the lines of a MonarchDiffViewer: the name of the earlier side, then of the later side. -->
    <string name="monarch_diffviewer_caption">Changes from %1$s to %2$s</string>
    <!-- Name of the earlier side of a MonarchDiffViewer when the app gives none. -->
    <string name="monarch_diffviewer_before">Before</string>
    <!-- Name of the later side of a MonarchDiffViewer when the app gives none. -->
    <string name="monarch_diffviewer_after">After</string>
    <!-- TalkBack name of the layout switch of a MonarchDiffViewer. -->
    <string name="monarch_diffviewer_mode">Layout</string>
    <!-- Label of the one-column layout in the switch of a MonarchDiffViewer. -->
    <string name="monarch_diffviewer_unified">Unified</string>
    <!-- Label of the two-column layout in the switch of a MonarchDiffViewer. -->
    <string name="monarch_diffviewer_split">Side by side</string>
    <!-- Totals of a MonarchDiffViewer read by TalkBack: the added part, then the removed part. -->
    <string name="monarch_diffviewer_stats">%1$s, %2$s</string>
    <!-- The added part of the totals of a MonarchDiffViewer: the number of added lines. -->
    <plurals name="monarch_diffviewer_stats_added">
        <item quantity="one">%1$d added</item>
        <item quantity="other">%1$d added</item>
    </plurals>
    <!-- The removed part of the totals of a MonarchDiffViewer: the number of removed lines. -->
    <plurals name="monarch_diffviewer_stats_removed">
        <item quantity="one">%1$d removed</item>
        <item quantity="other">%1$d removed</item>
    </plurals>
    <!-- Read by TalkBack before an added line of a MonarchDiffViewer. -->
    <string name="monarch_diffviewer_added">Added</string>
    <!-- Read by TalkBack before a removed line of a MonarchDiffViewer. -->
    <string name="monarch_diffviewer_removed">Removed</string>
    <!-- Read by TalkBack for an empty line of a MonarchDiffViewer. -->
    <string name="monarch_diffviewer_blank_line">Blank line</string>
    <!-- Label of the button of a MonarchDiffViewer that shows a folded run of unchanged lines. -->
    <plurals name="monarch_diffviewer_expand">
        <item quantity="one">Show %1$d unchanged line</item>
        <item quantity="other">Show %1$d unchanged lines</item>
    </plurals>
    <!-- Label of the button of a MonarchDiffViewer that goes to the previous change. -->
    <string name="monarch_diffviewer_previous">Previous change</string>
    <!-- Label of the button of a MonarchDiffViewer that goes to the next change. -->
    <string name="monarch_diffviewer_next">Next change</string>
    <!-- Announced by a MonarchDiffViewer after previous or next: the change and the number of changes. -->
    <string name="monarch_diffviewer_position">Change %1$d of %2$d</string>
    <!-- Shown by a MonarchDiffViewer when the two texts are the same. -->
    <string name="monarch_diffviewer_no_changes">No changes.</string>
</resources>
