<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchTemplatePicker: the spoken name of the category filters. -->
    <string name="monarch_templatepicker_categories">Categories</string>
    <!-- MonarchTemplatePicker: the filter that shows every category. -->
    <string name="monarch_templatepicker_all_categories">All</string>
    <!-- MonarchTemplatePicker: the name of the blank card when the app gives none. -->
    <string name="monarch_templatepicker_blank">Blank</string>
    <!-- MonarchTemplatePicker: the placeholder of the search field. -->
    <string name="monarch_templatepicker_search">Search templates</string>
    <!-- MonarchTemplatePicker: the number of templates shown, announced when the filters change. -->
    <plurals name="monarch_templatepicker_results">
        <item quantity="one">%d template</item>
        <item quantity="other">%d templates</item>
    </plurals>
    <!-- MonarchTemplatePicker: shown when the search matches no template; %s is the search. -->
    <string name="monarch_templatepicker_no_results">No templates match “%s”.</string>
    <!-- MonarchTemplatePicker: shown when the chosen category has no templates. -->
    <string name="monarch_templatepicker_empty_category">No templates in this category.</string>
</resources>
