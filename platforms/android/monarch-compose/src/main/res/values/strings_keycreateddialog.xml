<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of a MonarchKeyCreatedDialog, which shows a newly created secret once. -->
    <string name="monarch_keycreateddialog_title">Copy your new key</string>
    <!-- What the value of a MonarchKeyCreatedDialog is when the app does not say: the field's label and part of the acknowledgement. -->
    <string name="monarch_keycreateddialog_label">API key</string>
    <!-- Title of the warning in a MonarchKeyCreatedDialog for a secret. -->
    <string name="monarch_keycreateddialog_secret_notice_title">Copy it now. It will not be shown again.</string>
    <!-- Message of the warning in a MonarchKeyCreatedDialog for a secret. -->
    <string name="monarch_keycreateddialog_secret_notice">Keep it in a secret manager or a server environment variable, never in source control. If you lose it, create a new one.</string>
    <!-- Title of the notice in a MonarchKeyCreatedDialog for a public value. -->
    <string name="monarch_keycreateddialog_public_notice_title">You can view this again later.</string>
    <!-- Message of the notice in a MonarchKeyCreatedDialog for a public value. -->
    <string name="monarch_keycreateddialog_public_notice">It is meant to be public, so you can copy it again from its details page.</string>
    <!-- Label of the acknowledgement checkbox of a MonarchKeyCreatedDialog. %1$s is what the value is, such as API key. -->
    <string name="monarch_keycreateddialog_acknowledge">I have saved this %1$s somewhere safe.</string>
    <!-- Shown and announced by a MonarchKeyCreatedDialog when Done is tapped before the acknowledgement is ticked. -->
    <string name="monarch_keycreateddialog_acknowledge_required">Confirm that you have saved it before you close this dialog.</string>
    <!-- The button that closes a MonarchKeyCreatedDialog. -->
    <string name="monarch_keycreateddialog_done">Done</string>
</resources>
