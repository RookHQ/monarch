<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiKnowledgeScope: the name TalkBack reads for the tree of sources. -->
    <string name="monarch_aiknowledgescope_label">Knowledge sources</string>
    <!-- MonarchAiKnowledgeScope: the visible name of a space source. -->
    <string name="monarch_aiknowledgescope_kind_space">Space</string>
    <!-- MonarchAiKnowledgeScope: the visible name of a document source. -->
    <string name="monarch_aiknowledgescope_kind_document">Document</string>
    <!-- MonarchAiKnowledgeScope: the visible name of an app source. -->
    <string name="monarch_aiknowledgescope_kind_app">App</string>
    <!-- MonarchAiKnowledgeScope: the spoken name of a source checkbox. %1$s is the source, %2$s its kind. -->
    <string name="monarch_aiknowledgescope_item">%1$s, %2$s</string>
    <!-- MonarchAiKnowledgeScope: the summary under the tree when nothing is selected. -->
    <string name="monarch_aiknowledgescope_summary_none">No sources selected</string>
    <!-- MonarchAiKnowledgeScope: the summary under the tree. %1$d is the number of selected sources. -->
    <plurals name="monarch_aiknowledgescope_summary">
        <item quantity="one">%1$d source selected</item>
        <item quantity="other">%1$d sources selected</item>
    </plurals>
    <!-- MonarchAiKnowledgeScope: shown when there are no sources. -->
    <string name="monarch_aiknowledgescope_empty">No sources available</string>
    <!-- MonarchAiKnowledgeScope: the spoken name of the button that opens a group. %1$s is the group. -->
    <string name="monarch_aiknowledgescope_expand">Show contents of %1$s</string>
    <!-- MonarchAiKnowledgeScope: the spoken name of the button that closes a group. %1$s is the group. -->
    <string name="monarch_aiknowledgescope_collapse">Hide contents of %1$s</string>
</resources>
