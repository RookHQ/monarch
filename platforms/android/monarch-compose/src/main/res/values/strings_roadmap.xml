<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of the chart and the list of a MonarchRoadmap, read by TalkBack. Replaced by MonarchGanttTimelineLabels.timeline. -->
    <string name="monarch_roadmap_timeline">Roadmap</string>
    <!-- Heading of the project-name column of a MonarchRoadmap chart. Replaced by MonarchGanttTimelineLabels.rowHeader. -->
    <string name="monarch_roadmap_row_header">Project</string>
    <!-- Health of a MonarchRoadmap project or group, written in its row heading. -->
    <string name="monarch_roadmap_on_track">On track</string>
    <!-- Health of a MonarchRoadmap project or group, written in its row heading. -->
    <string name="monarch_roadmap_at_risk">At risk</string>
    <!-- Health of a MonarchRoadmap project or group, written in its row heading. -->
    <string name="monarch_roadmap_off_track">Off track</string>
    <!-- Written in a MonarchRoadmap row heading when health is tracked but none was reported. -->
    <string name="monarch_roadmap_no_health">No health reported</string>
    <!-- Number of projects in a MonarchRoadmap group heading. %1$d is the count. -->
    <plurals name="monarch_roadmap_count">
        <item quantity="one">%1$d project</item>
        <item quantity="other">%1$d projects</item>
    </plurals>
    <!-- Joins two parts of the second line of a MonarchRoadmap row heading. %1$s and %2$s are the parts. -->
    <string name="monarch_roadmap_meta">%1$s · %2$s</string>
</resources>
