<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the loading state of a MonarchSectionCard, also read as the title's state while it loads. -->
    <string name="monarch_sectioncard_loading">Loading</string>
    <!-- Title of the empty state of a MonarchSectionCard. -->
    <string name="monarch_sectioncard_empty_title">Nothing here yet</string>
    <!-- Title of the error state of a MonarchSectionCard. -->
    <string name="monarch_sectioncard_error_title">This section didn’t load</string>
    <!-- State of the title of a collapsible MonarchSectionCard while its body shows. -->
    <string name="monarch_sectioncard_expanded">Expanded</string>
    <!-- State of the title of a collapsible MonarchSectionCard while its body is hidden. -->
    <string name="monarch_sectioncard_collapsed">Collapsed</string>
    <!-- Spoken name of the info tone of a MonarchSectionCard. -->
    <string name="monarch_sectioncard_tone_info">Information</string>
    <!-- Spoken name of the success tone of a MonarchSectionCard. -->
    <string name="monarch_sectioncard_tone_success">Success</string>
    <!-- Spoken name of the warning tone of a MonarchSectionCard. -->
    <string name="monarch_sectioncard_tone_warning">Warning</string>
    <!-- Spoken name of the danger tone of a MonarchSectionCard. "Danger", not the shared "Error", on purpose:
         the tone marks a destructive zone ("Danger zone"), not a failure. Not deprecated. -->
    <string name="monarch_sectioncard_tone_danger">Danger</string>
    <!-- Separates the parts of the state of a MonarchSectionCard title when they are spoken. -->
    <string name="monarch_sectioncard_state_separator">", "</string>
</resources>
