<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchJsonViewer, the spoken name of the JSON tree. -->
    <string name="monarch_jsonviewer_label">JSON</string>
    <!-- MonarchJsonViewer, the label of the search field. -->
    <string name="monarch_jsonviewer_search">Search keys and values</string>
    <!-- MonarchJsonViewer, the placeholder of the search field. -->
    <string name="monarch_jsonviewer_search_prompt">Search</string>
    <!-- MonarchJsonViewer, the spoken name of the button that clears the search field. -->
    <string name="monarch_jsonviewer_clear_search">Clear search</string>
    <!-- MonarchJsonViewer, shown when a search finds nothing. -->
    <string name="monarch_jsonviewer_no_matches">No matches</string>
    <!-- MonarchJsonViewer, the number of matches of a search. %1$s is the formatted count, with "+" when the search stopped early. -->
    <plurals name="monarch_jsonviewer_matches">
        <item quantity="one">%1$s match</item>
        <item quantity="other">%1$s matches</item>
    </plurals>
    <!-- MonarchJsonViewer, the button that closes every node back to the top level. -->
    <string name="monarch_jsonviewer_collapse_all">Collapse all</string>
    <!-- MonarchJsonViewer, the button that copies the path of the selected node, such as $.users[0].name. -->
    <string name="monarch_jsonviewer_copy_path">Copy path</string>
    <!-- MonarchJsonViewer, the button that copies the value of the selected node. -->
    <string name="monarch_jsonviewer_copy_value">Copy value</string>
    <!-- MonarchJsonViewer, spoken before the path of the selected node. -->
    <string name="monarch_jsonviewer_selected_path">Selected</string>
    <!-- MonarchJsonViewer, the summary of a collapsed object. %1$s is the formatted number of keys. -->
    <plurals name="monarch_jsonviewer_keys">
        <item quantity="one">%1$s key</item>
        <item quantity="other">%1$s keys</item>
    </plurals>
    <!-- MonarchJsonViewer, the summary of a collapsed array. %1$s is the formatted number of items. -->
    <plurals name="monarch_jsonviewer_items">
        <item quantity="one">%1$s item</item>
        <item quantity="other">%1$s items</item>
    </plurals>
    <!-- MonarchJsonViewer, the row that shows more children of a large object or array. %1$s is how many it adds, %2$s how many are hidden. -->
    <string name="monarch_jsonviewer_show_more">Show %1$s more (%2$s hidden)</string>
    <!-- MonarchJsonViewer, added after a string cut in the tree. %1$s is the formatted full length in characters. -->
    <string name="monarch_jsonviewer_truncated">… (%1$s characters)</string>
    <!-- MonarchJsonViewer, the spoken state of an open object or array. -->
    <string name="monarch_jsonviewer_expanded">Expanded</string>
    <!-- MonarchJsonViewer, the spoken state of a closed object or array. -->
    <string name="monarch_jsonviewer_collapsed">Collapsed</string>
</resources>
