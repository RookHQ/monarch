<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAppAccessPicker: the heading and the name of the group. -->
    <string name="monarch_appaccesspicker_label">App access</string>
    <!-- MonarchAppAccessPicker: the bulk button while not every app is selected. -->
    <string name="monarch_appaccesspicker_select_all">Select all</string>
    <!-- MonarchAppAccessPicker: the bulk button while every app is selected. -->
    <string name="monarch_appaccesspicker_clear_all">Clear all</string>
    <!-- MonarchAppAccessPicker: the selection count; %1$d is the number selected, %2$d the number of apps. -->
    <plurals name="monarch_appaccesspicker_count">
        <item quantity="one">%1$d of %2$d selected</item>
        <item quantity="other">%1$d of %2$d selected</item>
    </plurals>
    <!-- MonarchAppAccessPicker: read by TalkBack while the apps load. -->
    <string name="monarch_appaccesspicker_loading">Loading apps</string>
    <!-- MonarchAppAccessPicker: shown when there are no apps. -->
    <string name="monarch_appaccesspicker_empty">No apps are available yet.</string>
    <!-- MonarchAppAccessSummary: shown when nothing is granted. -->
    <string name="monarch_appaccesspicker_summary_none">No app access</string>
    <!-- MonarchAppAccessSummary: read after the shown names; %1$d is the hidden count, %2$s their names. -->
    <plurals name="monarch_appaccesspicker_summary_more">
        <item quantity="one">, and %1$d more: %2$s</item>
        <item quantity="other">, and %1$d more: %2$s</item>
    </plurals>
</resources>
