<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiActionLog: the TalkBack name of the list of entries. -->
    <string name="monarch_aiactionlog_label">AI activity</string>
    <!-- MonarchAiActionLog: the badge after an agent's name, so the actor is never taken for a person. -->
    <string name="monarch_aiactionlog_actor_kind">AI agent</string>
    <!-- MonarchAiActionLog: the visible text of an entry's undo button. -->
    <string name="monarch_aiactionlog_undo">Undo</string>
    <!-- MonarchAiActionLog: the TalkBack name of an undo button. %1$s is the entry as a sentence. -->
    <string name="monarch_aiactionlog_undo_label">Undo: %1$s</string>
    <!-- MonarchAiActionLog: added after the time of an entry that was undone. -->
    <string name="monarch_aiactionlog_undone">Undone</string>
    <!-- MonarchAiActionLog: announced after an undo. %1$s is the entry as a sentence. -->
    <string name="monarch_aiactionlog_undone_announcement">Undone: %1$s</string>
    <!-- MonarchAiActionLog: shown and announced when an undo fails. %1$s is the entry as a sentence. -->
    <string name="monarch_aiactionlog_undo_failed">Could not undo: %1$s</string>
    <!-- MonarchAiActionLog: the TalkBack action that opens an entry's target. %1$s is the target. -->
    <string name="monarch_aiactionlog_open_target">Open %1$s</string>
    <!-- MonarchAiActionLog: shown when the log has no entries. -->
    <string name="monarch_aiactionlog_empty">No AI activity yet.</string>
    <!-- MonarchAiActionLog: the button that shows more entries. %1$d is how many it adds. -->
    <plurals name="monarch_aiactionlog_show_more">
        <item quantity="one">Show %1$d more action</item>
        <item quantity="other">Show %1$d more actions</item>
    </plurals>
</resources>
