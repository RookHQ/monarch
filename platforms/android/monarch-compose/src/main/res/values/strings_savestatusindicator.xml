<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by a MonarchSaveStatusIndicator when edits are not saved yet. -->
    <string name="monarch_savestatusindicator_unsaved">Unsaved changes</string>
    <!-- Shown by a MonarchSaveStatusIndicator while a save runs. Announced only when asked. -->
    <string name="monarch_savestatusindicator_saving">Saving…</string>
    <!-- Shown and announced by a MonarchSaveStatusIndicator when a save finished. -->
    <string name="monarch_savestatusindicator_saved">Saved</string>
    <!-- Shown and announced by a MonarchSaveStatusIndicator when a save failed and the app gives no reason. -->
    <string name="monarch_savestatusindicator_error">Couldn\'t save</string>
    <!-- Label of the retry button of a MonarchSaveStatusIndicator in the error status. -->
    <string name="monarch_savestatusindicator_retry">Retry</string>
    <!-- How TalkBack joins the status and the time of a MonarchSaveStatusIndicator, which are shown with a middle dot. -->
    <string name="monarch_savestatusindicator_spoken_separator">", "</string>
</resources>
