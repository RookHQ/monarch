<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spoken name of the MonarchDocumentRelations list. -->
    <string name="monarch_documentrelations_label">Relations</string>
    <!-- The MonarchDocumentRelations button that opens the add sheet. -->
    <string name="monarch_documentrelations_add">Add relation</string>
    <!-- Title of the MonarchDocumentRelations add sheet. -->
    <string name="monarch_documentrelations_sheet_title">Add a relation</string>
    <!-- Description under the title of the MonarchDocumentRelations add sheet. -->
    <string name="monarch_documentrelations_sheet_description">Choose how this document connects to another one.</string>
    <!-- Label of the relation type picker in the MonarchDocumentRelations add sheet. -->
    <string name="monarch_documentrelations_type">Relation</string>
    <!-- Placeholder of the search field in the MonarchDocumentRelations add sheet. -->
    <string name="monarch_documentrelations_search">Search documents…</string>
    <!-- Heading of the results in the MonarchDocumentRelations add sheet. -->
    <string name="monarch_documentrelations_results">Matching documents</string>
    <!-- Shown in the MonarchDocumentRelations add sheet when no document matches. -->
    <string name="monarch_documentrelations_no_results">No matching documents.</string>
    <!-- The button that closes the MonarchDocumentRelations add sheet. -->
    <string name="monarch_documentrelations_cancel">Cancel</string>
    <!-- Visible text of a remove button of MonarchDocumentRelations when the app gives no icon. -->
    <string name="monarch_documentrelations_remove_text">Remove</string>
    <!-- Spoken name of a remove button of MonarchDocumentRelations. %1$s is the related document's title. -->
    <string name="monarch_documentrelations_remove">Remove relation to %1$s</string>
    <!-- Announced after a relation is added. %1$s is the related document's title. -->
    <string name="monarch_documentrelations_added">Relation to %1$s added</string>
    <!-- Announced after a relation is removed. %1$s is the related document's title. -->
    <string name="monarch_documentrelations_removed">Relation to %1$s removed</string>
    <!-- Shown when adding or removing a relation failed without a message of its own. -->
    <string name="monarch_documentrelations_failed">That didn\'t work. Try again.</string>
    <!-- Shown by MonarchDocumentRelations with showEmpty when there are no relations. -->
    <string name="monarch_documentrelations_none">No relations yet.</string>
    <!-- Spoken while a relation is added or removed. -->
    <string name="monarch_documentrelations_working">Working</string>
    <!-- Default relation type labels of MonarchDocumentRelations. -->
    <string name="monarch_documentrelations_type_related_to">Related to</string>
    <string name="monarch_documentrelations_type_parent_of">Parent of</string>
    <string name="monarch_documentrelations_type_child_of">Child of</string>
    <string name="monarch_documentrelations_type_supersedes">Supersedes</string>
    <string name="monarch_documentrelations_type_superseded_by">Superseded by</string>
    <string name="monarch_documentrelations_type_implements">Implements</string>
    <string name="monarch_documentrelations_type_specified_by">Specified by</string>
</resources>
