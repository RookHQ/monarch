<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What TalkBack reads for the trigger of a MonarchStatusPicker. %1$s is the current status, such as "In progress". -->
    <string name="monarch_statuspicker_trigger">Status: %1$s</string>
    <!-- Shown in a MonarchStatusPicker trigger when no status is selected. -->
    <string name="monarch_statuspicker_none">No status</string>
    <!-- Menu heading of the backlog statuses in a MonarchStatusPicker. -->
    <string name="monarch_statuspicker_backlog">Backlog</string>
    <!-- Menu heading of the statuses that are planned but not begun in a MonarchStatusPicker. -->
    <string name="monarch_statuspicker_unstarted">Not started</string>
    <!-- Menu heading of the statuses being worked on in a MonarchStatusPicker. -->
    <string name="monarch_statuspicker_started">In progress</string>
    <!-- Menu heading of the finished statuses in a MonarchStatusPicker. -->
    <string name="monarch_statuspicker_completed">Completed</string>
    <!-- Menu heading of the statuses stopped without finishing in a MonarchStatusPicker. -->
    <string name="monarch_statuspicker_cancelled">Cancelled</string>
</resources>
