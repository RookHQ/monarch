    <string name="monarch_aicomputerview_frame_unavailable">Screenshot unavailable</string>
    <!-- MonarchAiComputerView: shown in the screen box when the screenshot may show private information. -->
    <string name="monarch_aicomputerview_frame_hidden">Screenshot hidden: it may show private information</string>
    <!-- MonarchAiComputerView: text alternative of a browser screenshot without its own. -->
    <string name="monarch_aicomputerview_frame_alt_browser">Screenshot of the browser the assistant is using</string>
    <!-- MonarchAiComputerView: text alternative of a computer screenshot without its own. -->
    <string name="monarch_aicomputerview_frame_alt_computer">Screenshot of the computer the assistant is using</string>
    <!-- MonarchAiComputerView: text alternative of the live browser picture. -->
    <string name="monarch_aicomputerview_live_alt_browser">Live view of the browser the assistant is using</string>
    <!-- MonarchAiComputerView: text alternative of the live computer picture. -->
    <string name="monarch_aicomputerview_live_alt_computer">Live view of the computer the assistant is using</string>
