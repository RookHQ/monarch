    <string name="monarch_aicomputerview_address">Address</string>
    <!-- MonarchAiComputerView: the action of the screenshot, which opens it full screen to zoom. -->
    <string name="monarch_aicomputerview_view_larger">View larger</string>
    <!-- MonarchAiComputerView: announced for several new actions. %1$d is the count, %2$s the latest action. -->
    <plurals name="monarch_aicomputerview_announce_actions">
        <item quantity="one">%1$d new action: %2$s</item>
        <item quantity="other">%1$d new actions. Latest: %2$s</item>
    </plurals>
    <!-- MonarchAiComputerView: announced when the status changes. %1$s is the status. -->
    <string name="monarch_aicomputerview_announce_status">Assistant status: %1$s</string>
    <!-- MonarchAiComputerView: announced when the person takes control of the browser. -->
    <string name="monarch_aicomputerview_announce_taken_over_browser">You are in control of this browser. The assistant has stopped acting.</string>
    <!-- MonarchAiComputerView: announced when the person takes control of the computer. -->
    <string name="monarch_aicomputerview_announce_taken_over_computer">You are in control of this computer. The assistant has stopped acting.</string>
    <!-- MonarchAiComputerView: announced when the agent controls the browser again. -->
    <string name="monarch_aicomputerview_announce_released_browser">The assistant is in control of this browser again.</string>
    <!-- MonarchAiComputerView: announced when the agent controls the computer again. -->
    <string name="monarch_aicomputerview_announce_released_computer">The assistant is in control of this computer again.</string>
    <!-- MonarchAiComputerView: button that shows older actions. %1$d is how many. -->
    <plurals name="monarch_aicomputerview_show_earlier">
        <item quantity="one">Show %1$d earlier action</item>
        <item quantity="other">Show %1$d earlier actions</item>
    </plurals>
