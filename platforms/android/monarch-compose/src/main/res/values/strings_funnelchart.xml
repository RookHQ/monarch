    <string name="monarch_funnelchart_stage">Stage</string>
    <!-- MonarchFunnelChart, the table heading of the count column. -->
    <string name="monarch_funnelchart_value">Count</string>
    <!-- MonarchFunnelChart, the table heading of the share of the previous stage. -->
    <string name="monarch_funnelchart_from_previous">From previous</string>
    <!-- MonarchFunnelChart, the table heading of the share of the first stage. -->
    <string name="monarch_funnelchart_of_first">Of first</string>
