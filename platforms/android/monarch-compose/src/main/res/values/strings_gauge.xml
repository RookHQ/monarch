<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchGauge, the name TalkBack reads when the caller gives no label. -->
    <string name="monarch_gauge_name">Gauge</string>
    <!-- MonarchGauge, spoken value with a band. %1$s is the value, %2$s the band name: "72, At risk". -->
    <string name="monarch_gauge_value_band">%1$s, %2$s</string>
    <!-- MonarchGauge, spoken value without a band. %1$s value, %2$s start and %3$s end of the scale. -->
    <string name="monarch_gauge_value_range">%1$s (from %2$s to %3$s)</string>
    <!-- MonarchGauge, the target added to the spoken value. %1$s is the value text, %2$s the target. -->
    <string name="monarch_gauge_target">%1$s, Target %2$s</string>
    <!-- MonarchGauge, shown as a dash and spoken when there is no value. -->
    <string name="monarch_gauge_no_value">No data</string>
</resources>
