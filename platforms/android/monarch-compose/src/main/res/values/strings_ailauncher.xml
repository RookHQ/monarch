<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiLauncher: the TalkBack name of the button, and its visible label when shown. -->
    <string name="monarch_ailauncher_label">Assistant</string>
    <!-- MonarchAiLauncher: the state TalkBack reads while the assistant is open. -->
    <string name="monarch_ailauncher_open">Open</string>
    <!-- MonarchAiLauncher: the state TalkBack reads for the unread badge. -->
    <string name="monarch_ailauncher_unread">New messages</string>
    <!-- MonarchAiLauncher: the state TalkBack reads while the assistant is working. -->
    <string name="monarch_ailauncher_working">Working</string>
    <!-- MonarchAiLauncher: the state TalkBack reads for the count badge. %1$d is the number of unread messages. -->
    <plurals name="monarch_ailauncher_count">
        <item quantity="one">%1$d unread message</item>
        <item quantity="other">%1$d unread messages</item>
    </plurals>
</resources>
