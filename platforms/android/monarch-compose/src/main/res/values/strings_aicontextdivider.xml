<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiContextDivider: the label of a day divider for today. -->
    <string name="monarch_aicontextdivider_today">Today</string>
    <!-- MonarchAiContextDivider: the label of a day divider for yesterday. -->
    <string name="monarch_aicontextdivider_yesterday">Yesterday</string>
    <!-- MonarchAiContextDivider: the label of a context reset. -->
    <string name="monarch_aicontextdivider_context_reset">Context reset</string>
    <!-- MonarchAiContextDivider: the line under a context reset, also read by TalkBack. -->
    <string name="monarch_aicontextdivider_context_reset_description">The assistant does not see the messages above this line.</string>
    <!-- MonarchAiContextDivider: the label of a point where earlier messages were summarized. -->
    <string name="monarch_aicontextdivider_summarized">Earlier messages were summarized</string>
    <!-- MonarchAiContextDivider: the title of the disclosure that shows the summary. -->
    <string name="monarch_aicontextdivider_show_summary">Show summary</string>
    <!-- MonarchAiContextDivider: read by TalkBack before the summary, not shown. -->
    <string name="monarch_aicontextdivider_summary_prefix">AI-generated summary:</string>
    <!-- MonarchAiContextDivider: the button that shows the original messages. -->
    <string name="monarch_aicontextdivider_expand">Show earlier messages</string>
    <!-- MonarchAiContextDivider: what TalkBack reads for the summary: the prefix (1), then the summary (2). -->
    <string name="monarch_aicontextdivider_summary_read">%1$s %2$s</string>
    <!-- MonarchAiContextDivider: what TalkBack reads for a divider with a description: the label (1), then the description (2). -->
    <string name="monarch_aicontextdivider_described">%1$s. %2$s</string>
</resources>
