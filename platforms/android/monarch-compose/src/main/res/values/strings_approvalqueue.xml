<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchApprovalQueue: the TalkBack name of the list of requests waiting for the viewer's decision. -->
    <string name="monarch_approvalqueue_label">Requests waiting for you</string>
    <!-- MonarchApprovalQueue: the button and swipe action that approve one request. -->
    <string name="monarch_approvalqueue_approve">Approve</string>
    <!-- MonarchApprovalQueue: the button that sends one request back to the requester, not approved. -->
    <string name="monarch_approvalqueue_reject">Send back</string>
    <!-- MonarchApprovalQueue: the button and swipe action that open the full request. -->
    <string name="monarch_approvalqueue_review">Review</string>
    <!-- MonarchApprovalQueue: the TalkBack name of the approve button. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_approve_item">Approve request from %1$s</string>
    <!-- MonarchApprovalQueue: the TalkBack name of the send back button. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_reject_item">Send back request from %1$s</string>
    <!-- MonarchApprovalQueue: the TalkBack name of the review button. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_review_item">Review request from %1$s</string>
    <!-- MonarchApprovalQueue: the TalkBack name of a request's checkbox. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_select_item">Select request from %1$s</string>
    <!-- MonarchApprovalQueue: the checkbox that selects every request that can be decided. -->
    <string name="monarch_approvalqueue_select_all">Select all</string>
    <!-- MonarchApprovalQueue: the bulk action that approves every selected request. -->
    <string name="monarch_approvalqueue_approve_selected">Approve selected</string>
    <!-- MonarchApprovalQueue: the badge of a request that is past its deadline. -->
    <string name="monarch_approvalqueue_overdue">Past due</string>
    <!-- MonarchApprovalQueue: the placeholder of the search field. -->
    <string name="monarch_approvalqueue_search">Search by name</string>
    <!-- MonarchApprovalQueue: shown when no requests wait for the viewer. -->
    <string name="monarch_approvalqueue_empty_title">Nothing to review</string>
    <!-- MonarchApprovalQueue: explains the empty queue. -->
    <string name="monarch_approvalqueue_empty_description">Requests that need your decision show up here.</string>
    <!-- MonarchApprovalQueue: shown when the search hides every request. -->
    <string name="monarch_approvalqueue_no_matches_title">No requests match your search</string>
    <!-- MonarchApprovalQueue: the title of the dialog that sends a request back. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_reject_title">Send back the request from %1$s?</string>
    <!-- MonarchApprovalQueue: explains what sending back does, in its dialog. -->
    <string name="monarch_approvalqueue_reject_description">They will be told it was not approved and can change it and resubmit.</string>
    <!-- MonarchApprovalQueue: the label of the reason field when sending a request back. -->
    <string name="monarch_approvalqueue_reject_reason">Reason</string>
    <!-- MonarchApprovalQueue: the placeholder of the reason field. -->
    <string name="monarch_approvalqueue_reject_reason_prompt">Let them know what to change</string>
    <!-- MonarchApprovalQueue: the title of the bulk approval confirmation. %1$d is the number of requests. -->
    <plurals name="monarch_approvalqueue_bulk_title">
        <item quantity="one">Approve %1$d request?</item>
        <item quantity="other">Approve %1$d requests?</item>
    </plurals>
    <!-- MonarchApprovalQueue: explains bulk approval, in its confirmation. -->
    <string name="monarch_approvalqueue_bulk_description">Each request moves to its next step, or is approved if this was the last one.</string>
    <!-- MonarchApprovalQueue: the button that confirms bulk approval. -->
    <string name="monarch_approvalqueue_bulk_confirm">Approve all</string>
    <!-- MonarchApprovalQueue: the button that closes a dialog without acting. -->
    <string name="monarch_approvalqueue_cancel">Cancel</string>
    <!-- MonarchApprovalQueue: announced after a request is approved. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_approved">Approved the request from %1$s.</string>
    <!-- MonarchApprovalQueue: announced after a request is sent back. %1$s is the requester's name. -->
    <string name="monarch_approvalqueue_rejected">Sent back the request from %1$s.</string>
    <!-- MonarchApprovalQueue: announced after bulk approval. %1$d is the number of requests. -->
    <plurals name="monarch_approvalqueue_bulk_approved">
        <item quantity="one">Approved %1$d request.</item>
        <item quantity="other">Approved %1$d requests.</item>
    </plurals>
    <!-- MonarchApprovalQueue: shown on a request, or under Select all, when a decision failed, and announced. -->
    <string name="monarch_approvalqueue_failed">That did not work. Try again.</string>
</resources>
