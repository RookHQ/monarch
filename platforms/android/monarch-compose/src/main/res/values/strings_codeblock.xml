<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchCodeBlock, the label of the toggle in the header that wraps long lines. -->
    <string name="monarch_codeblock_wrap">Wrap lines</string>
    <!-- MonarchCodeBlock, read by TalkBack before an added line of a diff. -->
    <string name="monarch_codeblock_added">Added</string>
    <!-- MonarchCodeBlock, read by TalkBack before a removed line of a diff. -->
    <string name="monarch_codeblock_removed">Removed</string>
    <!-- MonarchCodeBlock, a diff line as TalkBack reads it: "Added: const port = 8080;". %1$s the word, %2$s the line. -->
    <string name="monarch_codeblock_diff_line">%1$s: %2$s</string>
    <!-- MonarchCodeBlock, the name of the code when it has a language but no title: "TypeScript code". %1$s the language. -->
    <string name="monarch_codeblock_language_code">%1$s code</string>
    <!-- MonarchCodeBlock, the name of the code when it has neither a title nor a language. -->
    <string name="monarch_codeblock_code">Code</string>
</resources>
