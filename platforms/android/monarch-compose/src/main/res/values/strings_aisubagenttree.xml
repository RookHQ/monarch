<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiSubagentTree: the spoken name of the tree. -->
    <string name="monarch_aisubagenttree_label">Agents</string>
    <!-- MonarchAiSubagentTree: the status of an agent that is running a step. -->
    <string name="monarch_aisubagenttree_status_working">Working</string>
    <!-- MonarchAiSubagentTree: the status of an agent that waits for a person's answer. -->
    <string name="monarch_aisubagenttree_status_needs_input">Needs input</string>
    <!-- MonarchAiSubagentTree: the status of an agent that has not started. -->
    <string name="monarch_aisubagenttree_status_waiting">Waiting</string>
    <!-- MonarchAiSubagentTree: the status of an agent that finished. -->
    <string name="monarch_aisubagenttree_status_done">Done</string>
    <!-- MonarchAiSubagentTree: the status of an agent that ended with an error. -->
    <string name="monarch_aisubagenttree_status_failed">Failed</string>
    <!-- MonarchAiSubagentTree: the status of an agent that was stopped. -->
    <string name="monarch_aisubagenttree_status_stopped">Stopped</string>
    <!-- MonarchAiSubagentTree: the total in the summary. %1$s is the count in the locale's digits. -->
    <plurals name="monarch_aisubagenttree_agent_count">
        <item quantity="one">%1$s agent</item>
        <item quantity="other">%1$s agents</item>
    </plurals>
    <!-- MonarchAiSubagentTree: summary part for working agents. %1$s is the count. -->
    <string name="monarch_aisubagenttree_count_working">%1$s working</string>
    <!-- MonarchAiSubagentTree: summary part for agents that need input. %1$s is the count. -->
    <plurals name="monarch_aisubagenttree_count_needs_input">
        <item quantity="one">%1$s needs you</item>
        <item quantity="other">%1$s need you</item>
    </plurals>
    <!-- MonarchAiSubagentTree: summary part for waiting agents. %1$s is the count. -->
    <string name="monarch_aisubagenttree_count_waiting">%1$s waiting</string>
    <!-- MonarchAiSubagentTree: summary part for finished agents. %1$s is the count. -->
    <string name="monarch_aisubagenttree_count_done">%1$s done</string>
    <!-- MonarchAiSubagentTree: summary part for failed agents. %1$s is the count. -->
    <string name="monarch_aisubagenttree_count_failed">%1$s failed</string>
    <!-- MonarchAiSubagentTree: summary part for stopped agents. %1$s is the count. -->
    <string name="monarch_aisubagenttree_count_stopped">%1$s stopped</string>
    <!-- MonarchAiSubagentTree: the summary. %1$s is the total, %2$s the parts per status. -->
    <string name="monarch_aisubagenttree_summary">%1$s: %2$s</string>
    <!-- MonarchAiSubagentTree: joins two parts of the summary. -->
    <string name="monarch_aisubagenttree_separator">", "</string>
    <!-- MonarchAiSubagentTree: shown instead of the tree when there are no agents. -->
    <string name="monarch_aisubagenttree_empty">No agents yet</string>
    <!-- MonarchAiSubagentTree: progress with a known plan. %1$s is the steps done, %2$s the total. -->
    <string name="monarch_aisubagenttree_steps_of">%1$s of %2$s steps</string>
    <!-- MonarchAiSubagentTree: progress without a known plan. %1$s is the steps done. -->
    <plurals name="monarch_aisubagenttree_steps">
        <item quantity="one">%1$s step</item>
        <item quantity="other">%1$s steps</item>
    </plurals>
    <!-- MonarchAiSubagentTree: the tool calls of an agent. %1$s is the count. -->
    <plurals name="monarch_aisubagenttree_tool_calls">
        <item quantity="one">%1$s tool call</item>
        <item quantity="other">%1$s tool calls</item>
    </plurals>
    <!-- MonarchAiSubagentTree: the start of an agent that has not ended. %1$s is the time. -->
    <string name="monarch_aisubagenttree_started">Started %1$s</string>
    <!-- MonarchAiSubagentTree: the start and end of an agent. %1$s is the start, %2$s the end. -->
    <string name="monarch_aisubagenttree_ran">%1$s to %2$s</string>
    <!-- MonarchAiSubagentTree: the spoken name of the selected agent's actions. %1$s is its name. -->
    <string name="monarch_aisubagenttree_actions_for">Actions for %1$s</string>
    <!-- MonarchAiSubagentTree: the button that stops the selected agent. -->
    <string name="monarch_aisubagenttree_stop">Stop</string>
    <!-- MonarchAiSubagentTree: the button that opens the selected agent, for example its transcript. -->
    <string name="monarch_aisubagenttree_open">Open</string>
    <!-- MonarchAiSubagentTree: the button that answers the selected agent. -->
    <string name="monarch_aisubagenttree_respond">Respond</string>
    <!-- MonarchAiSubagentTree: the button that shows the selected agent's part of the conversation. -->
    <string name="monarch_aisubagenttree_open_part">Show in conversation</string>
    <!-- MonarchAiSubagentTree: announced when an agent's status changes. %1$s is its name, %2$s the status. -->
    <string name="monarch_aisubagenttree_announce">%1$s: %2$s</string>
    <!-- MonarchAiSubagentTree: the spoken name of the button that opens an agent. %1$s is its name. -->
    <string name="monarch_aisubagenttree_expand">Expand %1$s</string>
    <!-- MonarchAiSubagentTree: the spoken name of the button that closes an agent. %1$s is its name. -->
    <string name="monarch_aisubagenttree_collapse">Collapse %1$s</string>
</resources>
