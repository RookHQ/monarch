<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Name of a MonarchShiftRoster read by TalkBack. -->
    <string name="monarch_shiftroster_roster">Shift roster</string>
    <!-- Header of the people column of a MonarchShiftRoster grid, and the name of its person tabs. -->
    <string name="monarch_shiftroster_person">Person</string>
    <!-- Name of the day tabs of a MonarchShiftRoster, read by TalkBack. -->
    <string name="monarch_shiftroster_day">Day</string>
    <!-- A day off in a MonarchShiftRoster cell and its menu. -->
    <string name="monarch_shiftroster_off">Off</string>
    <!-- A day with no assignment in a MonarchShiftRoster cell. -->
    <string name="monarch_shiftroster_unassigned">Not assigned</string>
    <!-- Menu item of a MonarchShiftRoster cell that removes the assignment. -->
    <string name="monarch_shiftroster_clear">Clear</string>
    <!-- Heading of the menu of a MonarchShiftRoster cell. %1$s is the person, %2$s the day. -->
    <string name="monarch_shiftroster_menu_title">%1$s, %2$s</string>
    <!-- What TalkBack reads for a MonarchShiftRoster cell. %1$s is the person, %2$s the day, %3$s the assignment. -->
    <string name="monarch_shiftroster_cell">%1$s, %2$s: %3$s</string>
    <!-- A shift's start and end as TalkBack reads them in a MonarchShiftRoster. %1$s is the start, %2$s the end. -->
    <string name="monarch_shiftroster_range">%1$s to %2$s</string>
    <!-- Added to a MonarchShiftRoster shift that ends the next day. -->
    <string name="monarch_shiftroster_overnight">overnight</string>
    <!-- Header of the hours column of a MonarchShiftRoster, and the name of a person's total. -->
    <string name="monarch_shiftroster_hours">Hours</string>
    <!-- A total of hours in a MonarchShiftRoster. %1$s is the number, rounded to one decimal. -->
    <string name="monarch_shiftroster_hours_value">%1$s h</string>
    <!-- Label of the working-count row of a MonarchShiftRoster grid. -->
    <string name="monarch_shiftroster_working">Working</string>
    <!-- Number of people working on a day of a MonarchShiftRoster. -->
    <plurals name="monarch_shiftroster_working_value">
        <item quantity="one">%d working</item>
        <item quantity="other">%d working</item>
    </plurals>
    <!-- Marker of today in a MonarchShiftRoster. -->
    <string name="monarch_shiftroster_today">Today</string>
    <!-- Title of the empty state of a MonarchShiftRoster with no people. -->
    <string name="monarch_shiftroster_empty_title">No one to schedule</string>
    <!-- Message of the empty state of a MonarchShiftRoster with no people. -->
    <string name="monarch_shiftroster_empty_description">People appear here with their shift for each day.</string>
    <!-- What TalkBack reads while a MonarchShiftRoster loads. -->
    <string name="monarch_shiftroster_loading">Loading roster</string>
</resources>
