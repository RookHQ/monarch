<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiInlineDiff: the spoken name of the whole diff; says the suggestions come from AI. -->
    <string name="monarch_aiinlinediff_label">AI suggested changes</string>
    <!-- MonarchAiInlineDiff: read before removed text. -->
    <string name="monarch_aiinlinediff_deleted">Deleted:</string>
    <!-- MonarchAiInlineDiff: read before added text. -->
    <string name="monarch_aiinlinediff_inserted">Inserted:</string>
    <!-- MonarchAiInlineDiff: the position of the active change in the bar and as the text's state. -->
    <string name="monarch_aiinlinediff_position">Change %1$d of %2$d</string>
    <!-- MonarchAiInlineDiff: the bar when there are no changes. -->
    <string name="monarch_aiinlinediff_none">No suggested changes</string>
    <!-- MonarchAiInlineDiff: the button and custom action that move to the previous change. -->
    <string name="monarch_aiinlinediff_previous">Previous</string>
    <!-- MonarchAiInlineDiff: the button and custom action that move to the next change. -->
    <string name="monarch_aiinlinediff_next">Next</string>
    <!-- MonarchAiInlineDiff: the visible text of the accept button. -->
    <string name="monarch_aiinlinediff_accept">Accept</string>
    <!-- MonarchAiInlineDiff: the visible text of the reject button. -->
    <string name="monarch_aiinlinediff_reject">Reject</string>
    <!-- MonarchAiInlineDiff: the spoken name of the accept button and custom action. -->
    <string name="monarch_aiinlinediff_accept_change">Accept change %1$d of %2$d</string>
    <!-- MonarchAiInlineDiff: the spoken name of the reject button and custom action. -->
    <string name="monarch_aiinlinediff_reject_change">Reject change %1$d of %2$d</string>
    <!-- MonarchAiInlineDiff: announced after accepting a change while others are left. -->
    <plurals name="monarch_aiinlinediff_announce_accepted">
        <item quantity="one">Change accepted. %d left.</item>
        <item quantity="other">Change accepted. %d left.</item>
    </plurals>
    <!-- MonarchAiInlineDiff: announced after rejecting a change while others are left. -->
    <plurals name="monarch_aiinlinediff_announce_rejected">
        <item quantity="one">Change rejected. %d left.</item>
        <item quantity="other">Change rejected. %d left.</item>
    </plurals>
    <!-- MonarchAiInlineDiff: announced after accepting the last change. -->
    <string name="monarch_aiinlinediff_announce_accepted_last">Change accepted. No changes left.</string>
    <!-- MonarchAiInlineDiff: announced after rejecting the last change. -->
    <string name="monarch_aiinlinediff_announce_rejected_last">Change rejected. No changes left.</string>
</resources>
