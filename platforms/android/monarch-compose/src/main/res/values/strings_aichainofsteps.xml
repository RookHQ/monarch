<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiChainOfSteps: the name TalkBack reads for the list of steps. -->
    <string name="monarch_aichainofsteps_label">Steps</string>
    <!-- MonarchAiChainOfSteps: the state of a step that has not started, read by TalkBack. -->
    <string name="monarch_aichainofsteps_state_todo">Not started</string>
    <!-- MonarchAiChainOfSteps: the state of the running step, read by TalkBack. -->
    <string name="monarch_aichainofsteps_state_active">In progress</string>
    <!-- MonarchAiChainOfSteps: the state of a finished step, read by TalkBack. -->
    <string name="monarch_aichainofsteps_state_done">Done</string>
    <!-- MonarchAiChainOfSteps: the state of a left-out step, shown under its label and read by TalkBack. -->
    <string name="monarch_aichainofsteps_state_skipped">Skipped</string>
    <!-- MonarchAiChainOfSteps: the state of a failed step, shown under its label and read by TalkBack. -->
    <string name="monarch_aichainofsteps_state_failed">Failed</string>
    <!-- MonarchAiChainOfSteps: the summary of the folded list when no step failed. %1$d is the number of steps. -->
    <plurals name="monarch_aichainofsteps_summary">
        <item quantity="one">%1$d step</item>
        <item quantity="other">%1$d steps</item>
    </plurals>
    <!-- MonarchAiChainOfSteps: the summary when steps failed. %1$d is the number of steps, %2$d the failed ones. -->
    <plurals name="monarch_aichainofsteps_summary_failed">
        <item quantity="one">%1$d step, %2$d failed</item>
        <item quantity="other">%1$d steps, %2$d failed</item>
    </plurals>
    <!-- MonarchAiChainOfSteps: announced when a step starts. %1$d is its position, %2$d the number of steps, %3$s its label. -->
    <string name="monarch_aichainofsteps_started">Step %1$d of %2$d: %3$s</string>
    <!-- MonarchAiChainOfSteps: announced when a step fails. %1$s is its label. -->
    <string name="monarch_aichainofsteps_failed_step">Step failed: %1$s</string>
    <!-- MonarchAiChainOfSteps: announced once when every step finished. %1$d is the number of steps. -->
    <plurals name="monarch_aichainofsteps_finished">
        <item quantity="one">Finished %1$d step</item>
        <item quantity="other">Finished %1$d steps</item>
    </plurals>
    <!-- MonarchAiChainOfSteps: announced once when every step finished and some failed. %1$d steps, %2$d failed. -->
    <plurals name="monarch_aichainofsteps_finished_failed">
        <item quantity="one">Finished %1$d step, %2$d failed</item>
        <item quantity="other">Finished %1$d steps, %2$d failed</item>
    </plurals>
</resources>
