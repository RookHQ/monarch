<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The placeholder and name of the search field of MonarchAiMemoryPanel. -->
    <string name="monarch_aimemorypanel_search">Search memories</string>
    <!-- The row of MonarchAiMemoryPanel that selects every memory shown. %d is how many are shown. -->
    <string name="monarch_aimemorypanel_select_all">Select all (%1$d)</string>
    <!-- The name of a group's checkbox in MonarchAiMemoryPanel. %1$s is the person, organization or project. -->
    <string name="monarch_aimemorypanel_select_group">Select all memories about %1$s</string>
    <!-- The name of a memory's checkbox in MonarchAiMemoryPanel. %1$s is the memory, shortened. -->
    <string name="monarch_aimemorypanel_select">Select memory: %1$s</string>
    <!-- The kind of a group in MonarchAiMemoryPanel: a person. -->
    <string name="monarch_aimemorypanel_kind_person">Person</string>
    <!-- The kind of a group in MonarchAiMemoryPanel: an organization. -->
    <string name="monarch_aimemorypanel_kind_organization">Organization</string>
    <!-- The kind of a group in MonarchAiMemoryPanel: a project. -->
    <string name="monarch_aimemorypanel_kind_project">Project</string>
    <!-- The kind of a group in MonarchAiMemoryPanel: anything else. -->
    <string name="monarch_aimemorypanel_kind_other">Other</string>
    <!-- How many memories a group of MonarchAiMemoryPanel has. -->
    <plurals name="monarch_aimemorypanel_count">
        <item quantity="one">%d memory</item>
        <item quantity="other">%d memories</item>
    </plurals>
    <!-- The line under a memory in MonarchAiMemoryPanel. %1$s is a date, such as Mar 10, 2026. -->
    <string name="monarch_aimemorypanel_updated">Updated %1$s</string>
    <!-- Shown by MonarchAiMemoryPanel when nothing is remembered. -->
    <string name="monarch_aimemorypanel_empty">Nothing is remembered yet.</string>
    <!-- Shown by MonarchAiMemoryPanel when the search matches nothing. %1$s is the search. -->
    <string name="monarch_aimemorypanel_no_matches">No memories match “%1$s”.</string>
    <!-- Announced by MonarchAiMemoryPanel after a search. -->
    <plurals name="monarch_aimemorypanel_matches">
        <item quantity="one">%d memory matches</item>
        <item quantity="other">%d memories match</item>
    </plurals>
    <!-- The bulk action of MonarchAiMemoryPanel that forgets the selected memories. -->
    <string name="monarch_aimemorypanel_forget">Forget</string>
    <!-- The title of the dialog that confirms forgetting selected memories in MonarchAiMemoryPanel. -->
    <plurals name="monarch_aimemorypanel_confirm_title">
        <item quantity="one">Forget %d memory?</item>
        <item quantity="other">Forget %d memories?</item>
    </plurals>
    <!-- The text of the dialog that confirms forgetting selected memories in MonarchAiMemoryPanel. -->
    <string name="monarch_aimemorypanel_confirm_message">The assistant will stop using them in future conversations. This can’t be undone.</string>
    <!-- The button that dismisses the confirmation dialog of MonarchAiMemoryPanel. -->
    <string name="monarch_aimemorypanel_cancel">Cancel</string>
    <!-- Announced by MonarchAiMemoryPanel after memories are forgotten. -->
    <plurals name="monarch_aimemorypanel_forgotten">
        <item quantity="one">Memory forgotten</item>
        <item quantity="other">%d memories forgotten</item>
    </plurals>
    <!-- Announced by MonarchAiMemoryPanel after a memory is edited. -->
    <string name="monarch_aimemorypanel_edited">Memory updated</string>
</resources>
