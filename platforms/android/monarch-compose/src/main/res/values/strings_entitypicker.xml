<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown in the MonarchEntityPicker field while nothing is chosen. -->
    <string name="monarch_entitypicker_select">Select…</string>
    <!-- Placeholder of the search field in the MonarchEntityPicker sheet. -->
    <string name="monarch_entitypicker_search">Search</string>
    <!-- The button that closes the single-choice MonarchEntityPicker sheet without choosing. -->
    <string name="monarch_entitypicker_cancel">Cancel</string>
    <!-- The button that closes the multiple-choice MonarchEntityPicker sheet. -->
    <string name="monarch_entitypicker_done">Done</string>
    <!-- Shown in the MonarchEntityPicker list while entities load or a search runs. -->
    <string name="monarch_entitypicker_loading">Loading…</string>
    <!-- Shown in the MonarchEntityPicker list when nothing matches. -->
    <string name="monarch_entitypicker_empty">No matches</string>
    <!-- Shown in the MonarchEntityPicker list while the search text is shorter than the minimum. %d is the minimum. -->
    <plurals name="monarch_entitypicker_too_short">
        <item quantity="one">Type at least %d character to search.</item>
        <item quantity="other">Type at least %d characters to search.</item>
    </plurals>
    <!-- Shown in the MonarchEntityPicker list when a search failed. -->
    <string name="monarch_entitypicker_failed">The results could not be loaded.</string>
    <!-- The row of the MonarchEntityPicker list that creates an entity from the typed text. %1$s is the typed text. -->
    <string name="monarch_entitypicker_create">Create “%1$s”</string>
    <!-- The MonarchEntityPicker field with several chosen: the first name and how many more. -->
    <string name="monarch_entitypicker_summary">%1$s +%2$d</string>
    <!-- Spoken name of the button that clears the MonarchEntityPicker selection. -->
    <string name="monarch_entitypicker_clear">Clear</string>
    <!-- Spoken value of the MonarchEntityPicker field while nothing is chosen. -->
    <string name="monarch_entitypicker_none">None</string>
</resources>
