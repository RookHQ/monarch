<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchTableBlock, the spoken name of a table that has no caption and no label. -->
    <string name="monarch_tableblock_region">Table</string>
    <!-- MonarchTableBlock, the label of the button that opens the editing menu of a table. -->
    <string name="monarch_tableblock_controls">Table</string>
    <!-- MonarchTableBlock, menu item: inserts an empty row below the current row. -->
    <string name="monarch_tableblock_add_row">Add row below</string>
    <!-- MonarchTableBlock, menu item: inserts an empty column after the current column. -->
    <string name="monarch_tableblock_add_column">Add column after</string>
    <!-- MonarchTableBlock, menu item: deletes the current row. -->
    <string name="monarch_tableblock_delete_row">Delete row</string>
    <!-- MonarchTableBlock, menu item: deletes the current column. -->
    <string name="monarch_tableblock_delete_column">Delete column</string>
    <!-- MonarchTableBlock, menu item with a check box: whether the first row holds column headers. -->
    <string name="monarch_tableblock_header_row">Header row</string>
    <!-- MonarchTableBlock, menu item: deletes the whole table. -->
    <string name="monarch_tableblock_delete_table">Delete table</string>
    <!-- MonarchTableBlock, read for a read-only cell that has no text. -->
    <string name="monarch_tableblock_empty_cell">Empty</string>
    <!-- MonarchTableBlock, the spoken position of an editable cell. %1$d is the row and %2$d the column, both counted from 1. -->
    <string name="monarch_tableblock_cell_position">Row %1$d, column %2$d</string>
</resources>
