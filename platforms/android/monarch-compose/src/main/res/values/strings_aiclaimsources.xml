<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiClaimSources: the heading. -->
    <string name="monarch_aiclaimsources_heading">Where this came from</string>
    <!-- MonarchAiClaimSources: the summary when there are no claims. -->
    <string name="monarch_aiclaimsources_summary_none">No claims</string>
    <!-- MonarchAiClaimSources: the summary; %1$d is the number of claims, %2$s the counts by support, "3 supported, 1 partly". -->
    <plurals name="monarch_aiclaimsources_summary">
        <item quantity="one">%1$d claim: %2$s</item>
        <item quantity="other">%1$d claims: %2$s</item>
    </plurals>
    <!-- MonarchAiClaimSources: a part of the summary; %d is the number of supported claims. -->
    <plurals name="monarch_aiclaimsources_summary_supported">
        <item quantity="one">%d supported</item>
        <item quantity="other">%d supported</item>
    </plurals>
    <!-- MonarchAiClaimSources: a part of the summary; %d is the number of partly supported claims. -->
    <plurals name="monarch_aiclaimsources_summary_partial">
        <item quantity="one">%d partly</item>
        <item quantity="other">%d partly</item>
    </plurals>
    <!-- MonarchAiClaimSources: a part of the summary; %d is the number of claims no source supports. -->
    <plurals name="monarch_aiclaimsources_summary_unsupported">
        <item quantity="one">%d without a source</item>
        <item quantity="other">%d without a source</item>
    </plurals>
    <!-- MonarchAiClaimSources: a part of the summary; %d is the number of claims whose sources disagree. -->
    <plurals name="monarch_aiclaimsources_summary_conflicting">
        <item quantity="one">%d with sources that disagree</item>
        <item quantity="other">%d with sources that disagree</item>
    </plurals>
    <!-- MonarchAiClaimSources: a part of the summary; %d is the number of claims not checked yet. -->
    <plurals name="monarch_aiclaimsources_summary_unchecked">
        <item quantity="one">%d not checked</item>
        <item quantity="other">%d not checked</item>
    </plurals>
    <!-- MonarchAiClaimSources: the separator between the parts of the summary. -->
    <string name="monarch_aiclaimsources_summary_separator">", "</string>
    <!-- MonarchAiClaimSources: the spoken name of the filter. -->
    <string name="monarch_aiclaimsources_filter_label">Show claims</string>
    <!-- MonarchAiClaimSources: the filter that shows every claim. -->
    <string name="monarch_aiclaimsources_all">All</string>
    <!-- MonarchAiClaimSources: the filter that shows the claims that are not fully supported. -->
    <string name="monarch_aiclaimsources_needs_checking">Needs checking</string>
    <!-- MonarchAiClaimSources: a filter with its count; %1$s is the filter, %2$d the count: "All 5". -->
    <string name="monarch_aiclaimsources_filter_count">%1$s %2$d</string>
    <!-- MonarchAiClaimSources: the support level of a supported claim. -->
    <string name="monarch_aiclaimsources_support_supported">Supported</string>
    <!-- MonarchAiClaimSources: the support level of a partly supported claim. -->
    <string name="monarch_aiclaimsources_support_partial">Partly supported</string>
    <!-- MonarchAiClaimSources: the support level of a claim no source supports. -->
    <string name="monarch_aiclaimsources_support_unsupported">No source supports this</string>
    <!-- MonarchAiClaimSources: the support level of a claim whose sources disagree. -->
    <string name="monarch_aiclaimsources_support_conflicting">Sources disagree</string>
    <!-- MonarchAiClaimSources: the support level of a claim not checked yet. -->
    <string name="monarch_aiclaimsources_support_unchecked">Not checked yet</string>
    <!-- MonarchAiClaimSources: the note at the top of an open, partly supported claim. -->
    <string name="monarch_aiclaimsources_note_partial">The sources back only part of this claim.</string>
    <!-- MonarchAiClaimSources: the note at the top of an open claim no source supports. -->
    <string name="monarch_aiclaimsources_note_unsupported">No source supports this claim. Check it yourself before you rely on it.</string>
    <!-- MonarchAiClaimSources: the note at the top of an open claim whose sources disagree. -->
    <string name="monarch_aiclaimsources_note_conflicting">Sources disagree about this claim. Read both sides before you rely on it.</string>
    <!-- MonarchAiClaimSources: the note at the top of an open claim not checked yet. -->
    <string name="monarch_aiclaimsources_note_unchecked">This claim has not been checked against the sources yet.</string>
    <!-- MonarchAiClaimSources: the number of passages of a claim with none. -->
    <string name="monarch_aiclaimsources_passages_none">No passages</string>
    <!-- MonarchAiClaimSources: the number of passages of a claim; %d is the number. -->
    <plurals name="monarch_aiclaimsources_passages">
        <item quantity="one">%d passage</item>
        <item quantity="other">%d passages</item>
    </plurals>
    <!-- MonarchAiClaimSources: the spoken name of a claim's passages; %s is the claim. -->
    <string name="monarch_aiclaimsources_evidence_label">Passages for: %s</string>
    <!-- MonarchAiClaimSources: the stance of a passage that backs its claim. -->
    <string name="monarch_aiclaimsources_stance_supports">Supports the claim</string>
    <!-- MonarchAiClaimSources: the stance of a passage that speaks against its claim. -->
    <string name="monarch_aiclaimsources_stance_contradicts">Contradicts the claim</string>
    <!-- MonarchAiClaimSources: the title of a passage whose source is not known. -->
    <string name="monarch_aiclaimsources_unknown_source">Unknown source</string>
    <!-- MonarchAiClaimSources: the publication date of a source; %s is the date, "Mar 4, 2026". -->
    <string name="monarch_aiclaimsources_published">Published %s</string>
    <!-- MonarchAiClaimSources: the kind of a web page source. -->
    <string name="monarch_aiclaimsources_kind_web">Web page</string>
    <!-- MonarchAiClaimSources: the kind of a document source. -->
    <string name="monarch_aiclaimsources_kind_doc">Document</string>
    <!-- MonarchAiClaimSources: the kind of a record source. -->
    <string name="monarch_aiclaimsources_kind_record">Record</string>
    <!-- MonarchAiClaimSources: the kind of a file source. -->
    <string name="monarch_aiclaimsources_kind_file">File</string>
    <!-- MonarchAiClaimSources: the button that opens a passage's source. -->
    <string name="monarch_aiclaimsources_open_source">Open source</string>
    <!-- MonarchAiClaimSources: tells apart the actions of each passage; %s is the source's title: "from Pricing". -->
    <string name="monarch_aiclaimsources_from_source">from %s</string>
    <!-- MonarchAiClaimSources: the spoken name of a passage action; %1$s is the action, %2$s "from Pricing". -->
    <string name="monarch_aiclaimsources_action_label">%1$s %2$s</string>
    <!-- MonarchAiClaimSources: the button that copies a passage. -->
    <string name="monarch_aiclaimsources_copy_quote">Copy quote</string>
    <!-- MonarchAiClaimSources: the copy button after a copy. -->
    <string name="monarch_aiclaimsources_copied">Copied</string>
    <!-- MonarchAiClaimSources: announced after a copy. -->
    <string name="monarch_aiclaimsources_copied_announcement">Quote copied to clipboard</string>
    <!-- MonarchAiClaimSources: the button that reports a problem with a claim. -->
    <string name="monarch_aiclaimsources_flag">Report a problem</string>
    <!-- MonarchAiClaimSources: the button that checks an unchecked claim again. -->
    <string name="monarch_aiclaimsources_verify">Check again</string>
    <!-- MonarchAiClaimSources: shown when there are no claims. -->
    <string name="monarch_aiclaimsources_empty">There are no claims to check.</string>
    <!-- MonarchAiClaimSources: shown when Needs checking has nothing to show. -->
    <string name="monarch_aiclaimsources_none_need_checking">Nothing needs checking: every claim is supported by a source.</string>
    <!-- MonarchAiClaimSources: shown in an open claim with no passages and no note. -->
    <string name="monarch_aiclaimsources_no_evidence">No passages were provided for this claim.</string>
    <!-- MonarchAiClaimSources: announced when the filter changes; %1$d is the shown count, %2$d the total. -->
    <plurals name="monarch_aiclaimsources_showing">
        <item quantity="one">Showing %1$d of %2$d claim</item>
        <item quantity="other">Showing %1$d of %2$d claims</item>
    </plurals>
    <!-- MonarchAiClaimSources: the state of an open claim. -->
    <string name="monarch_aiclaimsources_expanded">Expanded</string>
    <!-- MonarchAiClaimSources: the state of a closed claim. -->
    <string name="monarch_aiclaimsources_collapsed">Collapsed</string>
</resources>
