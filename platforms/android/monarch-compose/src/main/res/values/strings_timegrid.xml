<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the all-day row of a MonarchTimeGrid, and the time TalkBack reads for an all-day event. -->
    <string name="monarch_timegrid_all_day">All day</string>
    <!-- What TalkBack reads for an empty hour of a MonarchTimeGrid that creates an event. %1$s is the day and time. -->
    <string name="monarch_timegrid_create_event">Create event, %1$s</string>
    <!-- Added to today's day heading of a MonarchTimeGrid for TalkBack. -->
    <string name="monarch_timegrid_today">Today</string>
    <!-- Click label of a day heading of a MonarchTimeGrid that opens the day. %1$s is the day. -->
    <string name="monarch_timegrid_open_day">Open %1$s</string>
    <!-- What TalkBack reads for an event's start and end in a MonarchTimeGrid. %1$s is the start, %2$s the end. -->
    <string name="monarch_timegrid_range">%1$s to %2$s</string>
    <!-- What TalkBack reads on a later day of an event that started earlier, in a MonarchTimeGrid. %1$s is the end. -->
    <string name="monarch_timegrid_until">until %1$s</string>
    <!-- TalkBack action of a MonarchTimeGrid event that moves it earlier by the snap interval. -->
    <string name="monarch_timegrid_move_earlier">Move earlier</string>
    <!-- TalkBack action of a MonarchTimeGrid event that moves it later by the snap interval. -->
    <string name="monarch_timegrid_move_later">Move later</string>
    <!-- TalkBack action of a MonarchTimeGrid event that moves it to the previous day column. -->
    <string name="monarch_timegrid_move_previous_day">Move to previous day</string>
    <!-- TalkBack action of a MonarchTimeGrid event that moves it to the next day column. -->
    <string name="monarch_timegrid_move_next_day">Move to next day</string>
</resources>
