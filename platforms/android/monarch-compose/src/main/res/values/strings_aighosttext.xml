<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MonarchAiGhostText: announced when a suggestion appears. %1$s is the suggested text. -->
    <string name="monarch_aighosttext_announce">Suggestion: %1$s — use Accept suggestion, or press Tab on a keyboard.</string>
    <!-- MonarchAiGhostText: the title of the accept button and the name of the TalkBack action. -->
    <string name="monarch_aighosttext_accept">Accept suggestion</string>
    <!-- MonarchAiGhostText: the name of the TalkBack action that dismisses the suggestion. -->
    <string name="monarch_aighosttext_dismiss">Dismiss suggestion</string>
    <!-- MonarchAiGhostText: announced when the suggestion is accepted. -->
    <string name="monarch_aighosttext_accepted">Suggestion accepted.</string>
    <!-- MonarchAiGhostText: announced when the suggestion is dismissed. -->
    <string name="monarch_aighosttext_dismissed">Suggestion dismissed.</string>
</resources>
