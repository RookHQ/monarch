<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What TalkBack reads for a MonarchOrgChart as a whole. -->
    <string name="monarch_orgchart_label">Organization chart</string>
    <!-- Line on the card of an open position in a MonarchOrgChart. -->
    <string name="monarch_orgchart_vacant">Open position</string>
    <!-- What TalkBack adds for a card with a dashed border (a temporary or acting line) in a MonarchOrgChart. -->
    <string name="monarch_orgchart_dashed">Temporary reporting line</string>
    <!-- Line on a card in a MonarchOrgChart naming secondary managers. %1$s is their names, joined with commas. -->
    <string name="monarch_orgchart_also_reports_to">Also reports to %1$s</string>
    <!-- State of a manager in a MonarchOrgChart whose team is shown. -->
    <string name="monarch_orgchart_expanded">Team shown</string>
    <!-- State of a manager in a MonarchOrgChart whose team is hidden. -->
    <string name="monarch_orgchart_collapsed">Team hidden</string>
    <!-- State of a manager in a MonarchOrgChart whose team is being loaded. -->
    <string name="monarch_orgchart_loading">Loading team</string>
    <!-- Name of the button and TalkBack action that show a manager's team in a MonarchOrgChart. %1$s is the manager's name. -->
    <string name="monarch_orgchart_expand">Show team of %1$s</string>
    <!-- Name of the button and TalkBack action that hide a manager's team in a MonarchOrgChart. %1$s is the manager's name. -->
    <string name="monarch_orgchart_collapse">Hide team of %1$s</string>
    <!-- TalkBack action on a person in a MonarchOrgChart that asks the app where to move them. -->
    <string name="monarch_orgchart_move">Move</string>
    <!-- Visible hint above a MonarchOrgChart when people can be moved. -->
    <string name="monarch_orgchart_move_hint">Touch and hold a person, then drag them onto their new manager.</string>
    <!-- Announced when a team in a MonarchOrgChart fails to load. %1$s is the manager's name. -->
    <string name="monarch_orgchart_load_failed">Could not load the team of %1$s.</string>
    <!-- Name of the zoom-in button of a MonarchOrgChart. -->
    <string name="monarch_orgchart_zoom_in">Zoom in</string>
    <!-- Name of the zoom-out button of a MonarchOrgChart. -->
    <string name="monarch_orgchart_zoom_out">Zoom out</string>
    <!-- Name of the button that resets the zoom of a MonarchOrgChart. %1$s is the current level, such as "80%". -->
    <string name="monarch_orgchart_zoom_reset">Reset zoom, %1$s</string>
    <!-- Visible symbol on the zoom-in button of a MonarchOrgChart; TalkBack reads monarch_orgchart_zoom_in. -->
    <string name="monarch_orgchart_zoom_in_symbol" translatable="false">+</string>
    <!-- Visible symbol on the zoom-out button of a MonarchOrgChart; TalkBack reads monarch_orgchart_zoom_out. -->
    <string name="monarch_orgchart_zoom_out_symbol" translatable="false">−</string>
    <!-- Number of direct reports of a manager in a MonarchOrgChart. %1$d is the number. -->
    <plurals name="monarch_orgchart_reports">
        <item quantity="one">%1$d direct report</item>
        <item quantity="other">%1$d direct reports</item>
    </plurals>
</resources>
