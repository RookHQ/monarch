<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text of a MonarchDownloadReportButton that offers several formats. -->
    <string name="monarch_downloadreportbutton_label">Download</string>
    <!-- Text of a MonarchDownloadReportButton with one format. %1$s is the format, such as CSV. -->
    <string name="monarch_downloadreportbutton_single">Download %1$s</string>
    <!-- State and announcement of a MonarchDownloadReportButton while the file is prepared. %1$s is the format. -->
    <string name="monarch_downloadreportbutton_preparing">Preparing %1$s…</string>
    <!-- Announced by a MonarchDownloadReportButton when the file is saved. %1$s is the format. -->
    <string name="monarch_downloadreportbutton_downloaded">%1$s downloaded</string>
    <!-- Note under a MonarchDownloadReportButton when the file is prepared in the background. -->
    <string name="monarch_downloadreportbutton_queued">The file is being prepared. You can leave this screen; it will be ready to download shortly.</string>
    <!-- Failure shown by a MonarchDownloadReportButton. %1$s is the format. -->
    <string name="monarch_downloadreportbutton_error">The %1$s download failed.</string>
    <!-- TalkBack name of the progress bar of a MonarchDownloadReportButton. -->
    <string name="monarch_downloadreportbutton_progress">Download progress</string>
</resources>
