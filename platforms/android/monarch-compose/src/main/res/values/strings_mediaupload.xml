<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main text of the empty MonarchMediaUpload area when only images are taken. -->
    <string name="monarch_mediaupload_add_image">Add an image</string>
    <!-- Main text of the empty MonarchMediaUpload area when images and videos are taken. -->
    <string name="monarch_mediaupload_add_media">Add an image or video</string>
    <!-- Button of the empty MonarchMediaUpload area that opens the photo picker for images. -->
    <string name="monarch_mediaupload_choose_image">Choose image</string>
    <!-- Button of the empty MonarchMediaUpload area that opens the photo picker for images and videos. -->
    <string name="monarch_mediaupload_choose_media">Choose image or video</string>
    <!-- Hint of a MonarchMediaUpload about the images it takes. -->
    <string name="monarch_mediaupload_image_hint">PNG, JPG, GIF or WebP</string>
    <!-- Hint of a MonarchMediaUpload about the images it takes, with the largest size. %1$s is the size. -->
    <string name="monarch_mediaupload_image_hint_size">PNG, JPG, GIF or WebP up to %1$s</string>
    <!-- Hint of a MonarchMediaUpload about the videos it takes. -->
    <string name="monarch_mediaupload_video_hint">MP4, MOV or WebM</string>
    <!-- Hint about videos with the largest size. %1$s is the size. -->
    <string name="monarch_mediaupload_video_hint_size">MP4, MOV or WebM up to %1$s</string>
    <!-- Hint about videos with the longest length. %1$s is the length. -->
    <string name="monarch_mediaupload_video_hint_duration">MP4, MOV or WebM, %1$s at most</string>
    <!-- Hint about videos with the largest size and the longest length. %1$s is the size, %2$s the length. -->
    <string name="monarch_mediaupload_video_hint_both">MP4, MOV or WebM up to %1$s, %2$s at most</string>
    <!-- Refusal of a video where only images are taken. %1$s is the file name. -->
    <string name="monarch_mediaupload_video_not_allowed">%1$s is a video. Only images can be added here.</string>
    <!-- Refusal of a file over the size limit. %1$s is the file name, %2$s the limit. -->
    <string name="monarch_mediaupload_too_large">%1$s is larger than %2$s.</string>
    <!-- Refusal of a video over the length limit. %1$s is the file name, %2$s the limit. -->
    <string name="monarch_mediaupload_too_long">%1$s is longer than %2$s.</string>
    <!-- Refusal of a video whose length could not be read. %1$s is the file name. -->
    <string name="monarch_mediaupload_duration_unreadable">The length of %1$s could not be read.</string>
    <!-- Shown while a video's length is read. %1$s is the file name. -->
    <string name="monarch_mediaupload_checking">Checking %1$s…</string>
    <!-- Shown while a file uploads. %1$s is the file name. -->
    <string name="monarch_mediaupload_uploading">Uploading %1$s</string>
    <!-- Shown while a file uploads, with the progress. %1$s is the file name, %2$d the percentage. -->
    <string name="monarch_mediaupload_uploading_percent">Uploading %1$s · %2$d%%</string>
    <!-- Shown when an upload failed without a message of its own. -->
    <string name="monarch_mediaupload_upload_failed">The upload failed. Try again.</string>
    <!-- Button that cancels a MonarchMediaUpload upload. -->
    <string name="monarch_mediaupload_cancel">Cancel upload</string>
    <!-- Announced after an upload is cancelled. -->
    <string name="monarch_mediaupload_cancelled">Upload cancelled</string>
    <!-- Announced after an image is uploaded. -->
    <string name="monarch_mediaupload_image_uploaded">Image uploaded</string>
    <!-- Announced after a video is uploaded. -->
    <string name="monarch_mediaupload_video_uploaded">Video uploaded</string>
    <!-- Button that picks another image. -->
    <string name="monarch_mediaupload_replace_image">Replace image</string>
    <!-- Button that picks another video. -->
    <string name="monarch_mediaupload_replace_video">Replace video</string>
    <!-- Button that removes the image. -->
    <string name="monarch_mediaupload_remove_image">Remove image</string>
    <!-- Button that removes the video. -->
    <string name="monarch_mediaupload_remove_video">Remove video</string>
    <!-- Announced after the image is removed. -->
    <string name="monarch_mediaupload_image_removed">Image removed</string>
    <!-- Announced after the video is removed. -->
    <string name="monarch_mediaupload_video_removed">Video removed</string>
    <!-- Spoken name of the image preview. -->
    <string name="monarch_mediaupload_preview_image">Uploaded image</string>
    <!-- Spoken name of the video preview. -->
    <string name="monarch_mediaupload_preview_video">Uploaded video</string>
    <!-- Spoken name of the video preview when it plays the video. -->
    <string name="monarch_mediaupload_play">Play video</string>
    <!-- First line of the notice after an upload with warnings. -->
    <string name="monarch_mediaupload_warnings">Uploaded with warnings.</string>
    <!-- A length of a minute or more. %1$d is minutes, %2$02d seconds. -->
    <string name="monarch_mediaupload_duration_minutes">%1$d:%2$02d min</string>
    <!-- A length under a minute. %1$d is seconds. -->
    <string name="monarch_mediaupload_duration_seconds">%1$d s</string>
</resources>
