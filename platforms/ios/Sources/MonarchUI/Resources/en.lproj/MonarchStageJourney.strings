/* Read by VoiceOver for the strip that lists the stages of a pipeline. */
"monarch.stageJourney.stages" = "Stages";

/* The heading of the card for the current stage. %@ is the stage, such as "Examination". */
"monarch.stageJourney.now" = "Now: %@";

/* How long the item has been in the current stage. %@ is a relative time such as "3 days ago". */
"monarch.stageJourney.since" = "since %@";

/* Read by VoiceOver after a stage that is finished. */
"monarch.stageJourney.done" = "done";

/* Read by VoiceOver after the current stage. */
"monarch.stageJourney.current" = "current stage";

/* The outcome of a journey that ended well, read by VoiceOver. */
"monarch.stageJourney.success" = "Completed";

/* The outcome of a journey that ended early or badly, read by VoiceOver. */
"monarch.stageJourney.closed" = "Closed";

/* The heading above the buttons that move the item to another stage. */
"monarch.stageJourney.nextSteps" = "Next steps";

/* Read by VoiceOver for a button that moves the item. %@ is the target stage. */
"monarch.stageJourney.moveTo" = "Move to %@";

/* The title of the button that undoes the last move. %@ is the previous stage. */
"monarch.stageJourney.backTo" = "Back to %@";

/* Read by VoiceOver after a move that will ask for more details. */
"monarch.stageJourney.needsInput" = "asks for details";

/* Announced when the item moves to another stage. %@ is the new stage. */
"monarch.stageJourney.moved" = "Moved to %@";

/* Shown when a move fails without a reason. */
"monarch.stageJourney.failed" = "The move did not go through. Try again.";
