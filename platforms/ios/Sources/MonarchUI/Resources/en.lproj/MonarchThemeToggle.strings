/* Spoken name of the theme toggle, and the title of its menu. */
"monarch.themeToggle.title" = "Theme";

/* The choice that always uses the light theme. */
"monarch.themeToggle.light" = "Light";

/* The choice that always uses the dark theme. */
"monarch.themeToggle.dark" = "Dark";

/* The choice that follows the device's appearance setting. */
"monarch.themeToggle.system" = "System";
