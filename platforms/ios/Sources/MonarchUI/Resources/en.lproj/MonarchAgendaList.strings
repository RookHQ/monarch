/* The marker in the heading of today's events in an agenda. */
"monarch.agendaList.today" = "Today";

/* The time shown for an event that takes the whole day. */
"monarch.agendaList.allDay" = "All day";

/* The title shown when an agenda has no events. */
"monarch.agendaList.emptyTitle" = "Nothing scheduled";

/* The count in a day's heading when the day has one event. */
"monarch.agendaList.countOne" = "1 event";

/* The count in a day's heading. %@ is the number of events, already formatted. */
"monarch.agendaList.countOther" = "%@ events";

/* Read for an event that started on an earlier day. %@ is the time it ends. */
"monarch.agendaList.until" = "until %@";

/* Read for an event's time. The first %@ is the start, the second the end. */
"monarch.agendaList.range" = "%1$@ to %2$@";
