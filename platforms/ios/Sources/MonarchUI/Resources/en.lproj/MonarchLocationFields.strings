/* Label of the country field of an address. */
"monarch.locationFields.country" = "Country";

/* Label of the region field of an address when the country's own word for its regions is not known. */
"monarch.locationFields.region" = "State or region";

/* Label of the city field of an address. */
"monarch.locationFields.city" = "City";

/* Label of the postal code field of an address when the country's own word is not known. */
"monarch.locationFields.postalCode" = "Postal code";

/* The postal code field's label for an address in the United States. */
"monarch.locationFields.postalCode.US" = "ZIP code";

/* The postal code field's label for an address in the United Kingdom. */
"monarch.locationFields.postalCode.GB" = "Postcode";

/* The postal code field's label for an address in Australia. */
"monarch.locationFields.postalCode.AU" = "Postcode";

/* The postal code field's label for an address in India. */
"monarch.locationFields.postalCode.IN" = "PIN code";

/* Shown under the country field when the list of countries could not be loaded. */
"monarch.locationFields.countriesLoadFailed" = "Couldn’t load the countries.";

/* Shown in the city list when the city search failed. */
"monarch.locationFields.citiesLoadFailed" = "Couldn’t load the cities.";

/* Prompt of the region and city fields while no country is chosen. */
"monarch.locationFields.chooseCountryFirst" = "Choose a country first";

/* Shown in the city list until enough letters are typed. The number is the minimum count of letters. */
"monarch.locationFields.typeMore" = "Type at least %ld letters to search.";

/* Shown in the city list when no city matches the typed text. */
"monarch.locationFields.noMatch" = "No cities match";

/* Row in the city list that keeps the typed text as the city. The argument is the typed text. */
"monarch.locationFields.useTyped" = "Use “%@”";
