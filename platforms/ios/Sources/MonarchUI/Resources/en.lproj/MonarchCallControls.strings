/* Spoken name of the group of call controls. */
"monarch.callControls.toolbar" = "Call controls";

/* Name of the toggle that switches the microphone on and off. */
"monarch.callControls.microphone" = "Microphone";

/* Name of the toggle that switches the camera on and off. */
"monarch.callControls.camera" = "Camera";

/* Name of the toggle that starts and stops sharing the screen. */
"monarch.callControls.shareScreen" = "Share screen";

/* Name of the toggle that raises and lowers the hand. */
"monarch.callControls.raiseHand" = "Raise hand";

/* Name of the menu of reactions. */
"monarch.callControls.react" = "Send a reaction";

/* Spoken name of one reaction in the menu. %@ is the emoji. */
"monarch.callControls.reactWith" = "React %@";

/* Name of the menu with more options. */
"monarch.callControls.more" = "More options";

/* Title of the layout choice in the More menu. */
"monarch.callControls.layout" = "Layout";

/* Layout that picks grid or speaker by itself. */
"monarch.callControls.layout.automatic" = "Automatic";

/* Layout that shows every participant in a grid. */
"monarch.callControls.layout.grid" = "Grid";

/* Layout that shows the person speaking large. */
"monarch.callControls.layout.speaker" = "Speaker";

/* Toggle in the More menu that turns video off to save data. */
"monarch.callControls.lowData" = "Low data mode (audio only)";

/* Item in the More menu that opens the device settings. */
"monarch.callControls.devices" = "Devices";

/* Item in the More menu that opens the connection details. */
"monarch.callControls.stats" = "Connection and data use";

/* Item in the More menu that continues the call in picture in picture. */
"monarch.callControls.pictureInPicture" = "Picture in picture";

/* Button that leaves the call. */
"monarch.callControls.leave" = "Leave call";
