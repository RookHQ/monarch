/* The number of selected items, shown in the bulk action bar and announced. %lld is the count. */
"monarch.bulkActionBar.selected" = "%lld selected";

/* The number of selected items out of the total. %1$lld is the count, %2$lld the total. */
"monarch.bulkActionBar.selectedOfTotal" = "%1$lld of %2$lld selected";

/* Announced when the selection is emptied and the bulk action bar closes. */
"monarch.bulkActionBar.cleared" = "Selection cleared";

/* The button that empties the selection. */
"monarch.bulkActionBar.clear" = "Clear selection";

/* The button that opens the menu of actions that do not fit in the bar. */
"monarch.bulkActionBar.more" = "More";

/* The spoken name of the bar of actions for the selected items. */
"monarch.bulkActionBar.bar" = "Bulk actions";
