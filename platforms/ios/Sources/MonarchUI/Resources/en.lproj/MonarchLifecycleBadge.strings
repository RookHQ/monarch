/* The label of a lifecycle badge for something that is announced and not yet available. */
"monarch.lifecycleBadge.planned" = "Planned";

/* The label of a lifecycle badge for something that can be tried and may still change. */
"monarch.lifecycleBadge.preview" = "Preview";

/* The label of a lifecycle badge for something that is released and supported. */
"monarch.lifecycleBadge.stable" = "Stable";

/* The label of a lifecycle badge for something that still works and will be removed. */
"monarch.lifecycleBadge.deprecated" = "Deprecated";
