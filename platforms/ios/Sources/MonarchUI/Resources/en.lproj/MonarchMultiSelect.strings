/* The button of a multi-select field when nothing is chosen yet. It opens the list. */
"monarch.multiSelect.select" = "Select…";

/* The button of a multi-select field when some values are chosen. It opens the list. */
"monarch.multiSelect.change" = "Edit selection";

/* The button that closes the list of a multi-select field. */
"monarch.multiSelect.done" = "Done";

/* The count under a multi-select field with a limit. The first %lld is the number chosen, the second the most allowed. */
"monarch.multiSelect.count" = "%1$lld of %2$lld selected";
