/* Title of the DNS step of a custom domain connection once the record is found. */
"monarch.domainProgress.dnsTitleDone" = "DNS record found";

/* Title of the DNS step while the product waits for a record that proves the user owns the domain. */
"monarch.domainProgress.dnsTitleOwnership" = "Ownership record needed";

/* Title of the DNS step while the product waits for the routing record. */
"monarch.domainProgress.dnsTitleWaiting" = "Waiting for your DNS record";

/* Detail of the DNS step once the record is found. */
"monarch.domainProgress.dnsDetailDone" = "Your domain points here.";

/* Detail of the DNS step while the record is not found. */
"monarch.domainProgress.dnsDetailWaiting" = "Add the record shown below at your DNS provider.";

/* Title of the HTTPS certificate step once the certificate is issued. */
"monarch.domainProgress.certificateTitleDone" = "HTTPS certificate issued";

/* Title of the HTTPS certificate step before it is issued. */
"monarch.domainProgress.certificateTitle" = "HTTPS certificate";

/* Detail of the HTTPS certificate step once it is issued. */
"monarch.domainProgress.certificateDetailDone" = "Secure connection works.";

/* Detail of the HTTPS certificate step before DNS is found. */
"monarch.domainProgress.certificateDetailTodo" = "Starts automatically once DNS is found.";

/* Detail of the HTTPS certificate step while it is being issued. */
"monarch.domainProgress.certificateDetailCurrent" = "Being issued now, usually 1 to 5 minutes.";

/* Title of the last step of a custom domain connection. */
"monarch.domainProgress.liveTitle" = "Live";

/* Detail of the live step once the site loads. %@ is the host name. */
"monarch.domainProgress.liveDetailDone" = "Your site loads on %@.";

/* Detail of the live step while the product checks the site. %@ is the host name. */
"monarch.domainProgress.liveDetailCurrent" = "Checking that your site loads on %@.";

/* Detail of the live step before it starts. %@ is the host name. */
"monarch.domainProgress.liveDetailTodo" = "We load %@ over HTTPS before calling it live.";

/* The spoken state of a finished step. */
"monarch.domainProgress.stateDone" = "done";

/* The spoken state of the step in progress. */
"monarch.domainProgress.stateCurrent" = "in progress";

/* The spoken state of a step with a problem. */
"monarch.domainProgress.stateError" = "needs attention";

/* The spoken state of a step that has not started. */
"monarch.domainProgress.stateTodo" = "not started";

/* The spoken name of the list of steps. %@ is the host name. */
"monarch.domainProgress.listLabel" = "Progress for %@";

/* Announced when the active step changes. The numbers are the position and the count of steps, then the step title and its state. */
"monarch.domainProgress.announcement" = "Step %1$ld of %2$ld: %3$@, %4$@.";

/* What public DNS shows for the host. The first %@ is the host, the second what was found, such as "CNAME → domains.example.net". */
"monarch.domainProgress.dnsSeen" = "Public DNS for %1$@ shows %2$@.";

/* Used in place of the DNS records when public DNS shows none. */
"monarch.domainProgress.noRecord" = "no record yet";

/* Shown while the product keeps checking a domain on its own. */
"monarch.domainProgress.rechecking" = "We keep checking automatically, even after you close this page.";

/* Shown while the product keeps checking a domain and will email the user. */
"monarch.domainProgress.recheckingEmail" = "We keep checking automatically, even after you close this page, and email you when it is live.";

/* Shown while the product keeps checking a domain and will notify the user in the app. */
"monarch.domainProgress.recheckingInApp" = "We keep checking automatically, even after you close this page, and notify you here when it is live.";

/* When the product last checked the domain. %@ is a relative time, such as "2 minutes ago". */
"monarch.domainProgress.checked" = "Checked %@.";
