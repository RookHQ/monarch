/* Row of an assignee picker that clears the assignee, and the field's text while nobody is assigned. */
"monarch.assigneePicker.unassigned" = "Unassigned";

/* Button under an assignee picker that assigns the signed-in person. */
"monarch.assigneePicker.assignToMe" = "Assign to me";

/* Placeholder of the search field in an assignee picker. */
"monarch.assigneePicker.search" = "Assign to…";

/* The signed-in person's name in an assignee picker. The argument is their name. */
"monarch.assigneePicker.you" = "%@ (you)";

/* Announced after the signed-in person assigned themselves with Assign to me. */
"monarch.assigneePicker.assigned" = "Assigned to you";
