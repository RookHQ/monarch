/* The button that sends a message. */
"monarch.messageComposer.send" = "Send";

/* The button that saves an edited message. */
"monarch.messageComposer.save" = "Save";

/* The send button while the message is being sent. */
"monarch.messageComposer.sending" = "Sending…";

/* The button that stops editing a message. */
"monarch.messageComposer.cancel" = "Cancel";

/* The button that attaches files to a message. */
"monarch.messageComposer.attach" = "Attach files";

/* The button that opens the emoji picker. */
"monarch.messageComposer.emoji" = "Add emoji";

/* The name of the control that switches between message types, such as reply and internal note. */
"monarch.messageComposer.modes" = "Message type";

/* Shown above the text while answering a message. %@ is the author of that message. */
"monarch.messageComposer.replyingTo" = "Replying to %@";

/* The button that removes the reply context. */
"monarch.messageComposer.dismissReply" = "Stop replying";

/* Shown above the text while editing a message. */
"monarch.messageComposer.editing" = "Editing message";

/* Read by VoiceOver for the character count. %ld is the number of characters left. */
"monarch.messageComposer.remaining" = "%ld characters left";

/* Read by VoiceOver for the character count over the limit. %ld is the number of characters too many. */
"monarch.messageComposer.overLimit" = "%ld characters over the limit";

/* Shown under the composer while the draft is being saved. */
"monarch.messageComposer.draftSaving" = "Saving draft…";

/* Shown under the composer after the draft was saved. */
"monarch.messageComposer.draftSaved" = "Draft saved";

/* Shown under the composer when the draft could not be saved. */
"monarch.messageComposer.draftError" = "Draft not saved";
"monarch.messageComposer.sendFailed" = "Message not sent. Try again.";

/* The name of the formatting tool that writes bold markup. */
"monarch.messageComposer.format.bold" = "Bold";

/* The name of the formatting tool that writes italic markup. */
"monarch.messageComposer.format.italic" = "Italic";

/* The name of the formatting tool that writes strikethrough markup. */
"monarch.messageComposer.format.strikethrough" = "Strikethrough";

/* The name of the formatting tool that writes code markup. */
"monarch.messageComposer.format.code" = "Code";

/* The name of the formatting tool that writes bulleted list markup. */
"monarch.messageComposer.format.bulletList" = "Bulleted list";

/* The name of the formatting tool that writes numbered list markup. */
"monarch.messageComposer.format.numberedList" = "Numbered list";

/* The name of the formatting tool that writes link markup. */
"monarch.messageComposer.format.link" = "Link";

/* The name of the formatting tool that writes quote markup. */
"monarch.messageComposer.format.quote" = "Quote";

/* The name of the formatting tool that writes code block markup. */
"monarch.messageComposer.format.codeBlock" = "Code block";
