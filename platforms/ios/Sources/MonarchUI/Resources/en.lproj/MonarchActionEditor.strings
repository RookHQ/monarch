/* The spoken name of the list of actions a rule runs. */
"monarch.actionEditor.label" = "Actions";

/* The visible title of an action. %ld is its position. */
"monarch.actionEditor.action" = "Action %ld";

/* The label of the menu that chooses what an action does. */
"monarch.actionEditor.type" = "Action";

/* The spoken name of the button that removes an action. %ld is its position. */
"monarch.actionEditor.remove" = "Remove action %ld";

/* The button that adds an action. */
"monarch.actionEditor.add" = "Add action";

/* Shown when a rule has no actions. */
"monarch.actionEditor.empty" = "No actions yet.";

/* The empty choice of an optional menu. */
"monarch.actionEditor.choose" = "Choose…";

/* The problem of a required input left empty. %@ is the input's label. */
"monarch.actionEditor.required" = "Fill in “%@”.";

/* The problem of a number outside the range of its input. %@ is the input's label. */
"monarch.actionEditor.outOfRange" = "“%@” is out of range.";

/* A stored action type that is no longer offered. %@ is the type's id. */
"monarch.actionEditor.unknownType" = "%@ (not available)";

/* The warning on an action whose type is turned off. */
"monarch.actionEditor.unavailable" = "This action cannot run right now.";

/* Shown instead of the add button when the list is full. %ld is the most actions allowed. */
"monarch.actionEditor.maxReached" = "You can add up to %ld actions.";

/* The spoken name of the menu that moves an action. %ld is its position. */
"monarch.actionEditor.reorder" = "Reorder action %ld";

/* Moves an action one place earlier. */
"monarch.actionEditor.moveUp" = "Move up";

/* Moves an action one place later. */
"monarch.actionEditor.moveDown" = "Move down";

/* Announced after an action moves. %ld is its new position. */
"monarch.actionEditor.moved" = "Moved to position %ld.";

/* The text of a multiple-choice input. %ld is how many choices are checked. */
"monarch.actionEditor.chosen" = "%ld chosen";
