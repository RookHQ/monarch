/* Explanation of the AI safety notice when a safety system did not answer the request. */
"monarch.aiSafetyNotice.message.blocked" = "It may go against the content guidelines. You can rephrase it and try again.";

/* Title of the AI safety notice when the answer was changed before it was shown. */
