/* Shown in the empty prompt. */
"monarch.aiPromptInput.placeholder" = "Send a message…";

/* Button that sends the prompt. */
"monarch.aiPromptInput.send" = "Send";

/* Button that stops the running response. */
"monarch.aiPromptInput.stop" = "Stop";

/* Button that opens the app's file or photo picker. */
"monarch.aiPromptInput.attach" = "Attach files";

/* Shown inside the prompt while files are dragged over it. */
"monarch.aiPromptInput.dropHint" = "Drop files to attach";

/* The visible character counter. The first %ld is the count, the second the limit. */
"monarch.aiPromptInput.counter" = "%ld / %ld";

/* Read by VoiceOver for the counter. The first %ld is the count, the second the limit. */
"monarch.aiPromptInput.counterLabel" = "%ld of %ld characters";

/* Announced when one character is left. */
"monarch.aiPromptInput.counterWarningOne" = "1 character left";

/* Announced near the limit. %ld is the number of characters left. */
"monarch.aiPromptInput.counterWarning" = "%ld characters left";

/* Announced and read when the text is one character over the limit. */
"monarch.aiPromptInput.counterOverOne" = "1 character over the limit";

/* Announced and read when the text is over the limit. %ld is the number of characters over. */
"monarch.aiPromptInput.counterOver" = "%ld characters over the limit";

/* The estimated size of the prompt. %ld is the number of tokens. */
"monarch.aiPromptInput.tokens" = "≈ %ld tokens";
