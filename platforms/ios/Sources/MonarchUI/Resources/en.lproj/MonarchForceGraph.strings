/* The button that zooms in on a force graph. */
"monarch.forceGraph.zoomIn" = "Zoom in";
/* The button that zooms out of a force graph. */
"monarch.forceGraph.zoomOut" = "Zoom out";
/* The button that resets the zoom, the pan and moved nodes of a force graph. */
"monarch.forceGraph.resetView" = "Reset view";
/* The heading of the node column in a force graph's data table. */
"monarch.forceGraph.node" = "Node";
/* The heading of the group column in a force graph's data table, and the label of a selected node's group. */
"monarch.forceGraph.group" = "Group";
/* The heading of the links column in a force graph's data table, and the label of a selected node's number of links. */
"monarch.forceGraph.connections" = "Connections";
/* The group of a force graph node that has none. */
"monarch.forceGraph.noGroup" = "No group";
/* The spoken name of the legend of a force graph's link kinds. */
"monarch.forceGraph.edgeLegend" = "Link types";
/* One node of a force graph. %1$@ is the count. */
"monarch.forceGraph.nodeCountOne" = "%1$@ node";
/* Several nodes of a force graph. %1$@ is the count. */
"monarch.forceGraph.nodeCount" = "%1$@ nodes";
/* One link of a force graph. %1$@ is the count. */
"monarch.forceGraph.linkCountOne" = "%1$@ link";
/* Several links of a force graph. %1$@ is the count. */
"monarch.forceGraph.linkCount" = "%1$@ links";
/* One group of a force graph. %1$@ is the count. */
"monarch.forceGraph.groupCountOne" = "%1$@ group";
/* Several groups of a force graph. %1$@ is the count. */
"monarch.forceGraph.groupCount" = "%1$@ groups";
/* One link of a force graph node. %1$@ is the count. */
"monarch.forceGraph.connectionCountOne" = "%1$@ connection";
/* Several links of a force graph node. %1$@ is the count. */
"monarch.forceGraph.connectionCount" = "%1$@ connections";
/* The size of a force graph in its spoken summary. %1$@ is the nodes, %2$@ the links, each with its noun. */
"monarch.forceGraph.size" = "%1$@ and %2$@";
/* Follows the size of a force graph in its summary. %1$@ is the groups with their noun. */
"monarch.forceGraph.inGroups" = "in %1$@";
/* The node with the most links, in a force graph's summary. %1$@ is its name, %2$@ its number of links. */
"monarch.forceGraph.mostConnected" = "Most connected: %1$@ (%2$@).";
/* Spoken for a force graph node. %1$@ is its name, %2$@ its group, %3$@ its number of links with their noun. */
"monarch.forceGraph.describe" = "%1$@, %2$@. %3$@";
/* A line of details under a force graph for the selected node. %1$@ is a name such as Group, %2$@ its value. */
"monarch.forceGraph.detail" = "%1$@: %2$@";
