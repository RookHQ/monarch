/* The origin label of an insight produced by an AI model. */
"monarch.aiInsightCallout.ai" = "AI insight";

/* The origin label of an insight raised by a fixed rule written by people. */
"monarch.aiInsightCallout.rule" = "Rule-based";

/* The title of the disclosure that shows the data behind an insight. */
"monarch.aiInsightCallout.evidence" = "Show evidence";

/* Read by VoiceOver as the name of the button that removes the insight. */
"monarch.aiInsightCallout.dismiss" = "Dismiss insight";

/* How VoiceOver reads an insight's title after its tone. %1$@ is the tone (such as Warning), %2$@ is the title. */
"monarch.aiInsightCallout.titled" = "%1$@: %2$@";
