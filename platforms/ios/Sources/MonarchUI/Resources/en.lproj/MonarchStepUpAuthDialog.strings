/* The line under the title. Also the reason the system shows with Face ID. */
"monarch.stepUpAuthDialog.description" = "This action needs you to confirm your identity again.";

/* The spoken name of the picker that chooses how to confirm. */
"monarch.stepUpAuthDialog.methodPicker" = "Verification method";

