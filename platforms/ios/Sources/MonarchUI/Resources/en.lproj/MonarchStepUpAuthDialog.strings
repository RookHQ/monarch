/* The label of the authenticator code field. */
"monarch.stepUpAuthDialog.codeLabel" = "Authentication code";

/* The help under the authenticator code field. */
"monarch.stepUpAuthDialog.codeHelper" = "Enter the 6-digit code from your authenticator app.";

