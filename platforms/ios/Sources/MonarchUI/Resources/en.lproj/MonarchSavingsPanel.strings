/* The title of the savings panel. */
"monarch.savingsPanel.title" = "Savings";

/* The start of the headline for one unused item. %lld is the count. */
"monarch.savingsPanel.unused.one" = "%lld unused item";

/* The start of the headline for several unused items. %lld is the count. */
"monarch.savingsPanel.unused.other" = "%lld unused items";

/* The part of the headline with the renewal cost, starting with a space. %@ is the formatted cost, such as "$1,200.00 + €300.00". */
"monarch.savingsPanel.cost" = " cost %@ to renew";

/* The part of the headline with one unpriced item, starting with a space. %lld is the count. */
"monarch.savingsPanel.withoutPrice.one" = " (%lld without a price)";

/* The part of the headline with several unpriced items, starting with a space. %lld is the count. */
"monarch.savingsPanel.withoutPrice.other" = " (%lld without a price)";

/* The end of the headline. */
"monarch.savingsPanel.end" = ".";

/* The spoken name of the groups of unused items. */
"monarch.savingsPanel.categories" = "Unused by reason";

/* Read before the counts of decisions. */
"monarch.savingsPanel.decisions" = "Decisions";

/* What letting the marked items lapse would save. %@ is the formatted amount. */
"monarch.savingsPanel.potentialSavings" = "Letting the marked items lapse saves %@.";

/* The spoken name of the list of unused items. */
"monarch.savingsPanel.items" = "Unused items";

/* After a shortened list of items. %lld is how many are not shown. */
"monarch.savingsPanel.more" = "and %lld more";

/* Shown for an item without a price. */
"monarch.savingsPanel.unpriced" = "No price";

/* The title of the empty state. */
"monarch.savingsPanel.emptyTitle" = "Nothing unused";

/* The message of the empty state. */
"monarch.savingsPanel.emptyMessage" = "Everything renewing is in use.";

/* The title of the error state. */
"monarch.savingsPanel.errorTitle" = "Savings could not be loaded";

/* Read while the savings load. */
"monarch.savingsPanel.loading" = "Loading savings";
