/* The title of the banner shown while the email address is not verified. */
"monarch.emailVerificationBanner.title" = "Verify your email address";

/* The message of the email verification banner. %@ is the email address. */
"monarch.emailVerificationBanner.message" = "We sent a verification link to %@. Open it to confirm the address belongs to you.";

/* The button that sends the verification email again. */
"monarch.emailVerificationBanner.resend" = "Resend email";

/* The resend button while waiting before another send. %ld is the number of seconds left. */
"monarch.emailVerificationBanner.resendIn" = "Resend in %lds";

/* Shown and announced after the verification email was sent again. */
"monarch.emailVerificationBanner.sent" = "Verification email sent";

/* The button that lets the person change the address. */
"monarch.emailVerificationBanner.changeEmail" = "Change email";

/* The spoken name of the button that closes the banner. */
"monarch.emailVerificationBanner.dismiss" = "Dismiss";

/* Shown when sending the verification email failed without a reason. */
"monarch.emailVerificationBanner.error" = "Couldn’t send the email. Try again.";
