/* Read by VoiceOver as the name of the list of everything the assistant remembers. */
"monarch.aiMemoryPanel.label" = "Memories";

/* The prompt of the search field of the memory panel. */
"monarch.aiMemoryPanel.search" = "Search memories";

/* The toolbar button of the memory panel that starts selecting memories. */
"monarch.aiMemoryPanel.select" = "Select";

/* The toolbar button of the memory panel that stops selecting memories. */
"monarch.aiMemoryPanel.done" = "Done";

/* The toolbar button of the memory panel that selects every memory shown. %d is how many are shown. */
"monarch.aiMemoryPanel.selectAll" = "Select all (%d)";

/* The toolbar button of the memory panel that clears the selection when every memory shown is selected. */
"monarch.aiMemoryPanel.deselectAll" = "Deselect all";

/* The kind of a group in the memory panel: a person. */
"monarch.aiMemoryPanel.kind.person" = "Person";

/* The kind of a group in the memory panel: an organization. */
"monarch.aiMemoryPanel.kind.organization" = "Organization";

/* The kind of a group in the memory panel: a project. */
"monarch.aiMemoryPanel.kind.project" = "Project";

/* The kind of a group in the memory panel: anything else. */
"monarch.aiMemoryPanel.kind.other" = "Other";

/* How many memories a group of the memory panel has, for one memory. */
"monarch.aiMemoryPanel.count.one" = "%d memory";

/* How many memories a group of the memory panel has, for several memories. */
"monarch.aiMemoryPanel.count.other" = "%d memories";

/* The line under a memory in the memory panel. %@ is a date, such as Mar 10, 2026. */
"monarch.aiMemoryPanel.updated" = "Updated %@";

/* Shown by the memory panel when nothing is remembered. */
"monarch.aiMemoryPanel.empty" = "Nothing is remembered yet.";

/* Shown by the memory panel when the search matches nothing. %@ is the search. */
"monarch.aiMemoryPanel.noMatches" = "No memories match “%@”.";

/* Announced by the memory panel after a search, for one match. */
"monarch.aiMemoryPanel.matches.one" = "%d memory matches";

/* Announced by the memory panel after a search, for several or no matches. */
"monarch.aiMemoryPanel.matches.other" = "%d memories match";

/* The command of the memory panel that forgets memories. */
"monarch.aiMemoryPanel.forget" = "Forget";

/* The disabled bulk command of the memory panel in selection mode, before any memory is selected. */
"monarch.aiMemoryPanel.forgetSelected" = "Forget selected";

/* The title of the dialog that confirms forgetting selected memories, for one memory. */
"monarch.aiMemoryPanel.confirmTitle.one" = "Forget %d memory?";

/* The title of the dialog that confirms forgetting selected memories, for several memories. */
"monarch.aiMemoryPanel.confirmTitle.other" = "Forget %d memories?";

/* The text of the dialog that confirms forgetting selected memories. */
"monarch.aiMemoryPanel.confirmMessage" = "The assistant will stop using them in future conversations. This can’t be undone.";

/* The button that dismisses the confirmation dialog of the memory panel. */
"monarch.aiMemoryPanel.cancel" = "Cancel";

/* Announced by the memory panel after one memory is forgotten. */
"monarch.aiMemoryPanel.forgotten.one" = "Memory forgotten";

/* Announced by the memory panel after several memories are forgotten. %d is how many. */
"monarch.aiMemoryPanel.forgotten.other" = "%d memories forgotten";

/* Announced by the memory panel after a memory is edited. */
"monarch.aiMemoryPanel.edited" = "Memory updated";
