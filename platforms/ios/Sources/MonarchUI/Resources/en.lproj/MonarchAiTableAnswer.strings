/* Label above a table an AI produced, saying where it came from. */
"monarch.aiTableAnswer.aiTable" = "AI table";

/* Row count of an AI table with one row. */
"monarch.aiTableAnswer.rowCount.one" = "1 row";

/* Row count of an AI table. %d is the number of rows. */
"monarch.aiTableAnswer.rowCount.other" = "%d rows";

/* Button that copies an AI table as comma-separated values. */
"monarch.aiTableAnswer.copyCSV" = "Copy as CSV";

/* Title of the copy button after the table was copied. */
"monarch.aiTableAnswer.copied" = "Copied";

/* Button that opens an AI table as an artifact. */
"monarch.aiTableAnswer.openAsArtifact" = "Open as artifact";

/* Announced after a table is sorted. %@ is the column name. */
"monarch.aiTableAnswer.sorted.ascending" = "Sorted by %@, ascending.";

/* Announced after a table is sorted. %@ is the column name. */
"monarch.aiTableAnswer.sorted.descending" = "Sorted by %@, descending.";

/* Spoken value of a column header the table is sorted by, ascending. */
"monarch.aiTableAnswer.sortValue.ascending" = "Sorted ascending";

/* Spoken value of a column header the table is sorted by, descending. */
"monarch.aiTableAnswer.sortValue.descending" = "Sorted descending";

/* Read for an empty cell of an AI table. */
"monarch.aiTableAnswer.empty" = "Empty";

/* Shown when an AI table has no rows. */
"monarch.aiTableAnswer.noRows" = "No rows.";

/* Read for the placeholder row while an AI table's rows stream in. */
"monarch.aiTableAnswer.loadingRows" = "More rows are being generated";

/* Announced when an AI table has finished streaming. */
"monarch.aiTableAnswer.complete" = "Table complete.";

/* Button under a long AI table that shows every row. %d is the number of rows. */
"monarch.aiTableAnswer.showAllRows" = "Show all %d rows";
