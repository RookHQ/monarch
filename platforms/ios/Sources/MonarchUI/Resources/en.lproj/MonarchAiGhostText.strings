/* Announced when an inline suggestion appears in a text field. %@ is the suggested text. */
"monarch.aiGhostText.announce" = "Suggestion: %@. Use Accept suggestion to take it.";

/* Hint of a text field while an inline suggestion is showing after the cursor. */
"monarch.aiGhostText.instruction" = "A suggestion is showing after the cursor. Tap it, use the Accept suggestion button, or press Tab on a keyboard to accept it. Press Escape to dismiss it.";

/* Title of the button, and name of the VoiceOver action, that accepts the inline suggestion. */
"monarch.aiGhostText.accept" = "Accept suggestion";

/* Name of the VoiceOver action that dismisses the inline suggestion. */
"monarch.aiGhostText.dismiss" = "Dismiss suggestion";

/* Announced when the inline suggestion is accepted. */
"monarch.aiGhostText.accepted" = "Suggestion accepted.";

/* Announced when the inline suggestion is dismissed. */
"monarch.aiGhostText.dismissed" = "Suggestion dismissed.";
