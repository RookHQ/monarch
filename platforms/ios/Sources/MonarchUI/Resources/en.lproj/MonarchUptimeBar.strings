/* The name of an uptime period in which everything worked. */
"monarch.uptimeBar.status.operational" = "Operational";
/* The name of an uptime period in which the service was slower or less reliable than usual. */
"monarch.uptimeBar.status.degraded" = "Degraded";
/* The name of an uptime period in which part of the service was down. */
"monarch.uptimeBar.status.partial" = "Partial outage";
/* The name of an uptime period in which the service was down. */
"monarch.uptimeBar.status.down" = "Down";
/* The name of an uptime period with planned maintenance. */
"monarch.uptimeBar.status.maintenance" = "Maintenance";
/* The name of an uptime period in which nothing was measured. */
"monarch.uptimeBar.status.noData" = "No data";
/* The name of the share of checks that passed, before a percentage. */
"monarch.uptimeBar.uptime" = "Uptime";
/* The overall uptime under an uptime bar. %@ is the percentage, such as 99.95%. */
"monarch.uptimeBar.overall" = "%@ uptime";
/* The name of the period axis in VoiceOver's chart details of an uptime bar. */
"monarch.uptimeBar.period" = "Period";
/* The name of the state axis in VoiceOver's chart details of an uptime bar. */
"monarch.uptimeBar.status" = "Status";
/* Spoken name of the legend of an uptime bar. */
"monarch.uptimeBar.legend" = "Legend";
/* The start of the spoken summary of an uptime bar. %@ is the number of periods. */
"monarch.uptimeBar.periods" = "Periods: %@";
