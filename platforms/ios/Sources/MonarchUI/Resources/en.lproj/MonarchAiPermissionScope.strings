/* Read by VoiceOver as the name of the list of apps an AI agent may access. */
"monarch.aiPermissionScope.label" = "What the AI can access";

/* The access of an app the AI agent cannot see. */
"monarch.aiPermissionScope.access.none" = "No access";

/* The access of an app the AI agent may read but not change. */
"monarch.aiPermissionScope.access.read" = "Can read";

/* The access of an app the AI agent may read and edit. */
"monarch.aiPermissionScope.access.write" = "Can read and edit";

/* The short name of no access on the segmented control. */
"monarch.aiPermissionScope.option.none" = "None";

/* The short name of read access on the segmented control. */
"monarch.aiPermissionScope.option.read" = "Read";

/* The short name of read and edit access on the segmented control. */
"monarch.aiPermissionScope.option.write" = "Write";

/* Read by VoiceOver as the name of a row's access control. %@ is the app's name. */
"monarch.aiPermissionScope.control" = "Access to %@";

/* The title of the button that opens the full permission settings. */
"monarch.aiPermissionScope.manage" = "Manage permissions";

/* Shown when the AI agent has access to no app. */
"monarch.aiPermissionScope.empty" = "The AI has no access to any app.";
