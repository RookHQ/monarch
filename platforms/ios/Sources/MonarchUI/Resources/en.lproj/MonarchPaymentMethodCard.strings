/* The name of a saved card. %1$@ is the card network, %2$@ the last four digits. */
"monarch.paymentMethodCard.name" = "%1$@ ending in %2$@";

/* The expiry line of a card. %@ is the expiry date as MM/YY. */
"monarch.paymentMethodCard.expires" = "Expires %@";

/* The expiry line of a card that has expired. %@ is the expiry date as MM/YY. */
"monarch.paymentMethodCard.expiredOn" = "Expired %@";

/* Badge on the payment method that is charged by default. */
"monarch.paymentMethodCard.defaultBadge" = "Default";

/* Badge on a card that expires this month or next. */
"monarch.paymentMethodCard.expiringBadge" = "Expires soon";

/* Badge on a card that has expired. */
"monarch.paymentMethodCard.expiredBadge" = "Expired";

/* Button that makes the card the default payment method. */
"monarch.paymentMethodCard.makeDefault" = "Make default";

/* Button that removes the card, after a confirmation. */
"monarch.paymentMethodCard.remove" = "Remove";

/* Spoken name of an action button. %1$@ is the button title, %2$@ the card name. */
"monarch.paymentMethodCard.actionLabel" = "%1$@, %2$@";

/* Title of the confirmation before a card is removed. %@ is the card name. */
"monarch.paymentMethodCard.removeTitle" = "Remove %@?";

/* Message of the confirmation before a card is removed. */
"monarch.paymentMethodCard.removeMessage" = "It will no longer be charged. To use it again, add it as a new payment method.";

/* The confirming button of the removal confirmation. */
"monarch.paymentMethodCard.removeConfirm" = "Remove card";

/* The cancelling button of the removal confirmation. */
"monarch.paymentMethodCard.cancel" = "Cancel";

/* Shown when making the card the default or removing it failed and the error has no description. */
"monarch.paymentMethodCard.failed" = "That did not work. Try again.";

/* Display name of the Visa card network. */
"monarch.paymentMethodCard.brand.visa" = "Visa";

/* Display name of the Mastercard card network. */
"monarch.paymentMethodCard.brand.mastercard" = "Mastercard";

/* Display name of the American Express card network. */
"monarch.paymentMethodCard.brand.amex" = "American Express";

/* Display name of the RuPay card network. */
"monarch.paymentMethodCard.brand.rupay" = "RuPay";

/* Display name of the Discover card network. */
"monarch.paymentMethodCard.brand.discover" = "Discover";

/* Display name of the Diners Club card network. */
"monarch.paymentMethodCard.brand.diners" = "Diners Club";

/* Display name of the JCB card network. */
"monarch.paymentMethodCard.brand.jcb" = "JCB";

/* Display name of the UnionPay card network. */
"monarch.paymentMethodCard.brand.unionpay" = "UnionPay";

/* Display name of the Maestro card network. */
"monarch.paymentMethodCard.brand.maestro" = "Maestro";
