/* Placeholder of an empty duration field. Shows the format the field reads. */
"monarch.durationInput.prompt" = "e.g. 1h 30m";
/* Shown under a duration field when the text cannot be read as a duration. */
"monarch.durationInput.invalid" = "Use a duration like 1h 30m, 90m or 1.5h.";
/* Shown when a duration is outside the allowed range. %1$@ is the shortest and %2$@ the longest allowed duration, already formatted. */
"monarch.durationInput.between" = "Enter between %1$@ and %2$@.";
/* Shown when a duration is shorter than allowed. %@ is the shortest allowed duration, already formatted. */
"monarch.durationInput.atLeast" = "Enter at least %@.";
/* Shown when a duration is longer than allowed. %@ is the longest allowed duration, already formatted. */
"monarch.durationInput.atMost" = "Enter at most %@.";
/* Spoken as the hint of a duration field that has an error. %@ is the error message. */
"monarch.durationInput.error" = "Error: %@";
