/* Spoken name of the toolbar of text formatting controls. */
"monarch.editorToolbar.toolbar" = "Formatting";

/* Menu that chooses body text or a heading level. */
"monarch.editorToolbar.textStyle" = "Text style";

/* Button that undoes the last change in the editor. */
"monarch.editorToolbar.undo" = "Undo";

/* Button that redoes the last undone change in the editor. */
"monarch.editorToolbar.redo" = "Redo";

/* Text style for body text. */
"monarch.editorToolbar.paragraph" = "Text";

/* Text style for a heading. %d is the heading level. */
"monarch.editorToolbar.heading" = "Heading %d";

/* Toggle for bold text. */
"monarch.editorToolbar.bold" = "Bold";

/* Toggle for italic text. */
"monarch.editorToolbar.italic" = "Italic";

/* Toggle for struck-through text. */
"monarch.editorToolbar.strikethrough" = "Strikethrough";

/* Toggle for inline code. */
"monarch.editorToolbar.code" = "Inline code";

/* Toggle for a link. */
"monarch.editorToolbar.link" = "Link";

/* Toggle for a bulleted list. */
"monarch.editorToolbar.bulletList" = "Bulleted list";

/* Toggle for a numbered list. */
"monarch.editorToolbar.orderedList" = "Numbered list";

/* Toggle for a checklist. */
"monarch.editorToolbar.taskList" = "Checklist";

/* Toggle for a quote. */
"monarch.editorToolbar.blockquote" = "Quote";

/* Toggle for a code block. */
"monarch.editorToolbar.codeBlock" = "Code block";

/* Title of the form that adds or edits a link. */
"monarch.editorToolbar.linkTitle" = "Link";

/* Field label and placeholder for the address of a link. */
"monarch.editorToolbar.linkAddress" = "Link address";

/* Button that applies the link address. */
"monarch.editorToolbar.linkApply" = "Apply";

/* Button that removes the link from the selected text. */
"monarch.editorToolbar.linkRemove" = "Remove link";

/* Button that closes the link form without changes. */
"monarch.editorToolbar.linkCancel" = "Cancel";

/* Help under the link form, also shown when the address is not valid. */
"monarch.editorToolbar.linkHelp" = "Enter a web address (https://…) or an email address.";
