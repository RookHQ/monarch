/* The spoken name of the controls that step through the versions of an AI-made document. */
"monarch.aiArtifactVersions.label" = "Versions";

/* The version shown. The first %ld is its number, the second how many versions there are. */
"monarch.aiArtifactVersions.position" = "Version %1$ld of %2$ld";

/* The spoken name of the button that shows the version before. */
"monarch.aiArtifactVersions.previous" = "Previous version";

/* The spoken name of the button that shows the version after. */
"monarch.aiArtifactVersions.next" = "Next version";

/* The spoken name of the menu that jumps to any version. */
"monarch.aiArtifactVersions.select" = "Choose a version";

/* The short name of a version in the menu, such as "v3". %ld is its number. */
"monarch.aiArtifactVersions.versionTag" = "v%ld";

/* The name of a version above the list of changes, such as "Version 3". %ld is its number. */
"monarch.aiArtifactVersions.versionName" = "Version %ld";

/* The toggle that shows what changed since the version before. */
"monarch.aiArtifactVersions.compare" = "Compare with previous";

/* Announced when another version is shown. The first %ld is its number, the second how many versions there are. */
"monarch.aiArtifactVersions.announce" = "Showing version %1$ld of %2$ld";
