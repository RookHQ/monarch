/* Added to the spoken name of today's date in a month calendar. */
"monarch.calendarMonthView.today" = "today";
/* Button that lists the events of a day that do not fit. %@ is the number of hidden events. */
"monarch.calendarMonthView.more" = "+%@ more";
/* Spoken count of a day with one event. */
"monarch.calendarMonthView.count.one" = "1 event";
/* Spoken count of a day with no events or several. %@ is the number. */
"monarch.calendarMonthView.count.other" = "%@ events";
/* VoiceOver action on an event that moves it to the day before. */
"monarch.calendarMonthView.moveDayEarlier" = "Move one day earlier";
/* VoiceOver action on an event that moves it to the next day. */
"monarch.calendarMonthView.moveDayLater" = "Move one day later";
/* VoiceOver action on an event that moves it to the same weekday a week before. */
"monarch.calendarMonthView.moveWeekEarlier" = "Move one week earlier";
/* VoiceOver action on an event that moves it to the same weekday a week later. */
"monarch.calendarMonthView.moveWeekLater" = "Move one week later";
