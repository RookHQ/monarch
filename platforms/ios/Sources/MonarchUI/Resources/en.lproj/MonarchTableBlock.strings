/* Spoken name of a table that has no caption and no label. */
"monarch.tableBlock.region" = "Table";
/* Title of the menu with the editing controls of a table. */
"monarch.tableBlock.controls" = "Table";
/* Menu item: inserts an empty row below the current row. */
"monarch.tableBlock.addRow" = "Add row below";
/* Menu item: inserts an empty column after the current column. */
"monarch.tableBlock.addColumn" = "Add column after";
/* Menu item: deletes the current row. */
"monarch.tableBlock.deleteRow" = "Delete row";
/* Menu item: deletes the current column. */
"monarch.tableBlock.deleteColumn" = "Delete column";
/* Menu item with a check mark: whether the first row holds column headers. */
"monarch.tableBlock.headerRow" = "Header row";
/* Menu item: deletes the whole table. */
"monarch.tableBlock.deleteTable" = "Delete table";
/* Spoken for a table cell that has no text. */
"monarch.tableBlock.emptyCell" = "Empty";
/* Spoken position of a table cell. %1$@ is the row number and %2$@ the column number, both counted from 1. */
"monarch.tableBlock.cellPosition" = "Row %1$@, column %2$@";
