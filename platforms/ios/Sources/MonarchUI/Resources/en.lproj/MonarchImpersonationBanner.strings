/* The main line of the banner shown while acting as another person. %@ is that person's name. */
"monarch.impersonationBanner.viewingAs" = "You are viewing as %@";

/* Before the time the session as another person started, as in "Started 5 minutes ago". */
"monarch.impersonationBanner.started" = "Started";

/* Before the reason the session as another person was started. */
"monarch.impersonationBanner.reason" = "Reason:";

/* The button that ends the session as another person. */
"monarch.impersonationBanner.stop" = "Stop";

/* The spoken name of the stop button. %@ is the person's name. */
"monarch.impersonationBanner.stopLabel" = "Stop viewing as %@";

/* Shown when ending the session failed without a reason. */
"monarch.impersonationBanner.stopError" = "Couldn’t stop. Try again.";
