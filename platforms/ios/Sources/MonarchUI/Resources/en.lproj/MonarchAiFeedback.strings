/* Spoken name of the thumbs and title of the feedback sheet. */
"monarch.aiFeedback.group" = "Rate this response";

/* Spoken name of the thumbs up button. */
"monarch.aiFeedback.good" = "Good response";

/* Spoken name of the thumbs down button. */
"monarch.aiFeedback.bad" = "Bad response";

/* Question above the reasons after a thumbs down. */
"monarch.aiFeedback.reasonsDown" = "What went wrong?";

/* Question above the reasons after a thumbs up. */
"monarch.aiFeedback.reasonsUp" = "What went well?";

/* Label of the optional comment field. */
"monarch.aiFeedback.comment" = "Tell us more (optional)";

/* Placeholder of the comment field. */
"monarch.aiFeedback.commentPlaceholder" = "What would have made it better?";

/* Button that sends the reasons and the comment. */
"monarch.aiFeedback.submit" = "Send feedback";

/* Button that closes the sheet and keeps the rating. */
"monarch.aiFeedback.cancel" = "Cancel";

/* Shown and announced after the feedback was sent. */
"monarch.aiFeedback.thanks" = "Thanks for your feedback.";

/* Shown and announced when the feedback could not be sent. */
"monarch.aiFeedback.error" = "Your feedback could not be sent. Try again.";

/* Default reason after a thumbs down: the answer was wrong. */
"monarch.aiFeedback.reason.inaccurate" = "Inaccurate";

/* Default reason after a thumbs down: the answer did not help. */
"monarch.aiFeedback.reason.not-helpful" = "Not helpful";

/* Default reason after a thumbs down: the answer left things out. */
"monarch.aiFeedback.reason.incomplete" = "Incomplete";

/* Default reason after a thumbs down: the answer was hard to read. */
"monarch.aiFeedback.reason.hard-to-follow" = "Hard to follow";

/* Default reason after a thumbs down: the answer was harmful. */
"monarch.aiFeedback.reason.unsafe" = "Harmful or unsafe";
