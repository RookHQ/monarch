/* The spoken name of embedded content from a site. %@ is the site's name, for example YouTube. */
"monarch.embedBlock.frameTitle" = "%@ content";

/* The button that loads embedded content from a site. %@ is the site's name, for example YouTube. */
"monarch.embedBlock.load" = "Load %@ content";

/* Shown instead of an embed when the link is not a web address that can be shown. */
"monarch.embedBlock.invalid" = "This link can’t be shown.";
