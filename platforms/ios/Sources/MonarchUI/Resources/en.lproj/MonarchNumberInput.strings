/* Shown when the number is outside the allowed range. %1$@ is the smallest and %2$@ the largest allowed number, already formatted. */
"monarch.numberInput.range" = "Enter a number from %1$@ to %2$@.";
/* Shown when the number is below the smallest allowed number. %@ is that number, already formatted. */
"monarch.numberInput.atLeast" = "Enter %@ or more.";
/* Shown when the number is above the largest allowed number. %@ is that number, already formatted. */
"monarch.numberInput.atMost" = "Enter %@ or less.";
/* Spoken as the hint of a number input that has an error. %@ is the error message. */
"monarch.numberInput.error" = "Error: %@";

/* The spoken name of the + button. %@ is the field's label, such as "Quantity". */
"monarch.numberInput.increment" = "Increase %@";

/* The spoken name of the − button. %@ is the field's label, such as "Quantity". */
"monarch.numberInput.decrement" = "Decrease %@";
