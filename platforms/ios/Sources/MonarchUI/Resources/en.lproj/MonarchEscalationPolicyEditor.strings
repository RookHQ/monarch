/* Spoken name of the list of escalation levels. */
"monarch.escalationPolicyEditor.label" = "Escalation levels";

/* Title of an escalation level. %ld is its position. */
"monarch.escalationPolicyEditor.level" = "Level %ld";

/* Label of the delay before a level fires. */
"monarch.escalationPolicyEditor.after" = "After";

/* Label of the targets a level notifies. */
"monarch.escalationPolicyEditor.notify" = "Notify";

/* Summary of a level. %1$@ is the delay, %2$@ the names notified. */
"monarch.escalationPolicyEditor.summary" = "After %1$@, notify %2$@";

/* Names in the summary of a level that notifies nobody. */
"monarch.escalationPolicyEditor.nobody" = "nobody yet";

/* Spoken name of the button that removes a level. %ld is its position. */
"monarch.escalationPolicyEditor.remove" = "Remove level %ld";

/* Button that adds a level. */
"monarch.escalationPolicyEditor.add" = "Add level";

/* Warning when there is nothing to notify. */
"monarch.escalationPolicyEditor.noTargets" = "There is nothing to notify yet. Add a channel or a person first, or this policy cannot reach anyone.";

/* Problem of a level that notifies nobody. */
"monarch.escalationPolicyEditor.problem.targets" = "Choose at least one target. A level that notifies nobody does nothing.";

/* Problem of a level that is not later than the one before. */
"monarch.escalationPolicyEditor.problem.order" = "This level must come later than the one before it.";

/* Shown instead of the add button when the policy is full. %ld is the most levels. */
"monarch.escalationPolicyEditor.maxReached" = "A policy can have up to %ld levels.";
