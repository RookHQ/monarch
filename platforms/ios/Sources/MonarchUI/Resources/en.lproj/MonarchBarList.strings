/* Spoken by VoiceOver for a row of a bar list that has no value. */
"monarch.barList.missing" = "No value";
/* Shown when a bar list has no rows. */
"monarch.barList.empty" = "No data yet";
/* Shown beside the spinner while a bar list is loading. */
"monarch.barList.loading" = "Loading";
/* The footer of a bar list that shows only its first rows. %1$@ is the number shown, %2$@ is the total. */
"monarch.barList.overflow" = "Top %1$@ of %2$@";
