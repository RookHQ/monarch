/* Name of the button that opens and closes the AI assistant. */
"monarch.aiLauncher.label" = "Assistant";

/* Spoken as the value of the assistant button while the assistant is open. */
"monarch.aiLauncher.open" = "Open";

/* Spoken as the value of the assistant button when it shows the unread dot. */
"monarch.aiLauncher.unread" = "New messages";

/* Spoken as the value of the assistant button while the assistant is working. */
"monarch.aiLauncher.working" = "Working";

/* Spoken as the value of the assistant button when there is exactly one unread message. */
"monarch.aiLauncher.countOne" = "1 unread message";

/* Spoken as the value of the assistant button. %d is the number of unread messages, two or more. */
"monarch.aiLauncher.countOther" = "%d unread messages";
