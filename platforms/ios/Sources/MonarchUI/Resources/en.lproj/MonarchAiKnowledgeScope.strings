/* Spoken name of the tree of sources an AI assistant may ground its answers in. */
"monarch.aiKnowledgeScope.label" = "Knowledge sources";

/* Name of a knowledge source that is a space holding documents. */
"monarch.aiKnowledgeScope.kind.space" = "Space";

/* Name of a knowledge source that is a single document. */
"monarch.aiKnowledgeScope.kind.document" = "Document";

/* Name of a knowledge source that is a connected app. */
"monarch.aiKnowledgeScope.kind.app" = "App";

/* Spoken name of one source. %1$@ is its name, %2$@ its kind, for example Space. */
"monarch.aiKnowledgeScope.itemLabel" = "%1$@, %2$@";

/* Summary under the tree when nothing is selected. */
"monarch.aiKnowledgeScope.summary.none" = "No sources selected";

/* Summary under the tree when one source is selected. */
"monarch.aiKnowledgeScope.summary.one" = "1 source selected";

/* Summary under the tree. %d is the number of selected sources. */
"monarch.aiKnowledgeScope.summary" = "%d sources selected";

/* Shown when there are no sources to choose from. */
"monarch.aiKnowledgeScope.empty" = "No sources available";

/* Spoken name of the button that shows what a group holds. %@ is the group's name. */
"monarch.aiKnowledgeScope.expand" = "Show contents of %@";

/* Spoken name of the button that hides what a group holds. %@ is the group's name. */
"monarch.aiKnowledgeScope.collapse" = "Hide contents of %@";
