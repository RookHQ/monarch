/* The heading of the weekly hours editor. */
"monarch.weeklyHoursEditor.title" = "Weekly hours";

/* Shown under a day that is switched off. */
"monarch.weeklyHoursEditor.unavailable" = "Unavailable";

/* The spoken name of an interval's start time menu. */
"monarch.weeklyHoursEditor.start" = "Start";

/* The spoken name of an interval's end time menu. */
"monarch.weeklyHoursEditor.end" = "End";

/* The spoken name of one interval. %1$@ is the weekday, %2$ld its position in the day. */
"monarch.weeklyHoursEditor.interval" = "%1$@ interval %2$ld";

/* The title of a day's button that adds an interval. */
"monarch.weeklyHoursEditor.add" = "Add interval";

/* The spoken name of a day's add button. %@ is the weekday. */
"monarch.weeklyHoursEditor.addItem" = "Add interval to %@";

/* The title of an interval's remove button, shown as an icon. */
"monarch.weeklyHoursEditor.remove" = "Remove";

/* The spoken name of an interval's remove button. %1$@ is the weekday, %2$ld the interval's position. */
"monarch.weeklyHoursEditor.removeItem" = "Remove %1$@ interval %2$ld";

/* The title of a day's button that copies its hours to every day. */
"monarch.weeklyHoursEditor.copyToAll" = "Copy to all";

/* The spoken name of a day's copy button. %@ is the weekday. */
"monarch.weeklyHoursEditor.copyToAllItem" = "Copy to all days from %@";

/* Announced after a day's hours are copied. %@ is the weekday. */
"monarch.weeklyHoursEditor.copied" = "%@ hours copied to every day.";

/* One interval as text. %1$@ is the start time, %2$@ the end time. */
"monarch.weeklyHoursEditor.range" = "%1$@ – %2$@";

/* The end of the day on a 12-hour clock. */
"monarch.weeklyHoursEditor.midnight" = "Midnight";

/* The message under a day with a time outside the day. */
"monarch.weeklyHoursEditor.rangeError" = "Times must fall within the day";

/* The message under a day with an interval that ends before it starts. */
"monarch.weeklyHoursEditor.orderError" = "Each interval must end after it starts";

/* The message under a day with overlapping intervals. */
"monarch.weeklyHoursEditor.overlapError" = "Intervals must not overlap";
