/* The heading of the date column in the data table of a calendar heatmap. */
"monarch.calendarHeatmap.date" = "Date";
/* The heading of the value column in the data table of a calendar heatmap, and the name of its data series for VoiceOver. */
"monarch.calendarHeatmap.value" = "Value";
/* The heading of the note column in the data table of a calendar heatmap. */
"monarch.calendarHeatmap.note" = "Note";
/* Read by VoiceOver after the value of the day that is today in a calendar heatmap. */
"monarch.calendarHeatmap.today" = "Today";
/* One day in the spoken summary of a calendar heatmap. %1$@ is the count. */
"monarch.calendarHeatmap.dayCountOne" = "%1$@ day";
/* Several days in the spoken summary of a calendar heatmap. %1$@ is the count. */
"monarch.calendarHeatmap.dayCount" = "%1$@ days";
/* The spoken summary of a calendar heatmap. %1$@ is the number of days with its noun, %2$@ the first day, %3$@ the last day and %4$@ the total of the values. */
"monarch.calendarHeatmap.summary" = "%1$@ from %2$@ to %3$@. Total %4$@";
/* The highest day in the spoken summary of a calendar heatmap. %1$@ is the day and its value. */
"monarch.calendarHeatmap.highest" = "Highest: %1$@";
