/* Shown instead of the legend of a stacked proportion bar when every value is 0. */
"monarch.stackedProportionBar.empty" = "No data yet";
/* A legend entry's value followed by its share of the whole. %1$@ is the value, %2$@ is the share, such as 34%. */
"monarch.stackedProportionBar.valueAndShare" = "%1$@ · %2$@";
/* A share smaller than the smallest that can be written. %@ is that smallest share, such as 1%. */
"monarch.stackedProportionBar.lessThan" = "<%@";
/* A share larger than the largest below the whole. %@ is that share, such as 99%. */
"monarch.stackedProportionBar.moreThan" = ">%@";
