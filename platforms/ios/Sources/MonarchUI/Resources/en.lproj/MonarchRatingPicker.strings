/* The spoken value of a rating. The first %@ is the chosen number, the second the highest number on the scale. */
"monarch.ratingPicker.value" = "%1$@ of %2$@";

/* The spoken value of a rating whose number has a label. The first %@ is the chosen number, the second the highest number on the scale, the third the label. */
"monarch.ratingPicker.valueWithLabel" = "%1$@ of %2$@, %3$@";

/* The spoken value of a rating picker while nothing is chosen. */
"monarch.ratingPicker.none" = "No rating";

/* The name of the VoiceOver action that removes the rating. */
"monarch.ratingPicker.clear" = "Clear rating";
