/* The spoken name of a diff. %1$@ is the name of the earlier version, %2$@ the later one. */
"monarch.diffViewer.caption" = "Changes from %1$@ to %2$@";

/* The default name of the earlier of two compared texts. */
"monarch.diffViewer.before" = "Before";

/* The default name of the later of two compared texts. */
"monarch.diffViewer.after" = "After";

/* The spoken name of the switch between the unified and side by side layouts of a diff. */
"monarch.diffViewer.mode" = "Layout";

/* The diff layout with one column. */
"monarch.diffViewer.unified" = "Unified";

/* The diff layout with the two texts in two columns. */
"monarch.diffViewer.split" = "Side by side";

/* The spoken totals of a diff. %1$lld is the number of added lines, %2$lld the removed lines. */
"monarch.diffViewer.stats" = "%1$lld added, %2$lld removed";

/* Read before a line that was added. */
"monarch.diffViewer.added" = "Added";

/* Read before a line that was removed. */
"monarch.diffViewer.removed" = "Removed";

/* Read by VoiceOver for an empty line of a diff. */
"monarch.diffViewer.blankLine" = "Blank line";

/* The button that shows one folded unchanged line. %lld is 1. */
"monarch.diffViewer.expandOne" = "Show %lld unchanged line";

/* The button that shows a folded run of unchanged lines. %lld is the number of lines. */
"monarch.diffViewer.expand" = "Show %lld unchanged lines";

/* The button that moves to the previous change of a diff. */
"monarch.diffViewer.previous" = "Previous change";

/* The button that moves to the next change of a diff. */
"monarch.diffViewer.next" = "Next change";

/* Announced when moving between changes. %1$lld is the change, %2$lld the number of changes. */
"monarch.diffViewer.position" = "Change %1$lld of %2$lld";

/* Shown when the two compared texts are the same. */
"monarch.diffViewer.noChanges" = "No changes.";
