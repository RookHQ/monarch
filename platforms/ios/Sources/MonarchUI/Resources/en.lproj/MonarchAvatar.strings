/* The spoken name of an avatar that shows a presence. %1$@ is the person's name, %2$@ the presence, such as "Online". */
"monarch.avatar.withStatus" = "%1$@, %2$@";

/* The spoken name of the tile at the end of an avatar group that stands for the avatars not shown. %ld is their number. */
"monarch.avatar.more" = "%ld more";

/* The visible text of the tile at the end of an avatar group. %ld is the number of avatars not shown. */
"monarch.avatar.moreShort" = "+%ld";
