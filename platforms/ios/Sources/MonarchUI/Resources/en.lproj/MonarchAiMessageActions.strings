/* Name of the row of actions under an assistant message. */
"monarch.aiMessageActions.toolbar" = "Message actions";

/* Button that copies the message text. */
"monarch.aiMessageActions.copy" = "Copy";

/* The copy button for two seconds after a copy. */
"monarch.aiMessageActions.copied" = "Copied";

/* Button that asks the assistant for a new answer. */
"monarch.aiMessageActions.regenerate" = "Regenerate";

/* Button that edits the message. */
"monarch.aiMessageActions.edit" = "Edit";

/* Thumbs up for an answer. */
"monarch.aiMessageActions.good" = "Good response";

/* Thumbs down for an answer. */
"monarch.aiMessageActions.bad" = "Bad response";

/* Button that opens the share sheet with the message text. */
"monarch.aiMessageActions.share" = "Share";

/* Button that starts reading the message aloud. */
"monarch.aiMessageActions.readAloud" = "Read aloud";

/* The read aloud button while the message is being read. */
"monarch.aiMessageActions.stopReading" = "Stop reading";

/* Menu with the actions that do not fit in the row and any extra actions. */
"monarch.aiMessageActions.more" = "More actions";
