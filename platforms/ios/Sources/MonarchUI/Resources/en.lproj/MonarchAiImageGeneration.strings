/* Read by VoiceOver as the name of the group of images generated by AI. */
"monarch.aiImageGeneration.label" = "AI generated images";

/* The status line while images are generating and nothing is ready. */
"monarch.aiImageGeneration.pending" = "Generating images…";

/* The status line while images are generating. %@ is a percentage such as 40%. */
"monarch.aiImageGeneration.pendingProgress" = "Generating images… %@";

/* The status line while low-quality previews are refined. */
"monarch.aiImageGeneration.progressive" = "Refining images…";

/* The status line while previews are refined. %@ is a percentage such as 80%. */
"monarch.aiImageGeneration.progressiveProgress" = "Refining images… %@";

/* The status line when exactly one image was generated. */
"monarch.aiImageGeneration.doneOne" = "1 image generated";

/* The status line when several images were generated. %d is the number. */
"monarch.aiImageGeneration.doneOther" = "%d images generated";

/* The message when image generation failed. */
"monarch.aiImageGeneration.error" = "The images could not be generated.";

/* Announced by VoiceOver when exactly one image has been generated. */
"monarch.aiImageGeneration.announceDoneOne" = "1 image generated.";

/* Announced by VoiceOver when several images have been generated. %d is the number. */
"monarch.aiImageGeneration.announceDoneOther" = "%d images generated.";

/* The title of the button that starts image generation again after a failure. */
"monarch.aiImageGeneration.retry" = "Try again";

/* Read by VoiceOver for an image whose alt text is still empty. %d is its position. */
"monarch.aiImageGeneration.imageName" = "Generated image %d";

/* Shown in place of an image that is missing after generation or cannot be loaded. */
"monarch.aiImageGeneration.unavailable" = "Preview unavailable";

/* The label of the alt text field under an image. %d is its position. */
"monarch.aiImageGeneration.altLabel" = "Alt text for image %d";

/* The error under an empty alt text field. */
"monarch.aiImageGeneration.altRequired" = "Describe the image for people who cannot see it.";

/* The title of the button that chooses an image. */
"monarch.aiImageGeneration.select" = "Use image";

/* Read by VoiceOver as the name of the button that chooses an image. %d is its position. */
"monarch.aiImageGeneration.selectName" = "Use image %d";

/* The mark on the chosen image. */
"monarch.aiImageGeneration.selected" = "Selected";

/* The title of the button that asks for more images like one. */
"monarch.aiImageGeneration.variations" = "More like this";

/* Read by VoiceOver as the name of the button that asks for more images like one. %d is its position. */
"monarch.aiImageGeneration.variationsName" = "More like this, image %d";
