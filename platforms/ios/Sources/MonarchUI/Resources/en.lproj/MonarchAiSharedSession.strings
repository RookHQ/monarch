/* Spoken name of the presence and turn-taking bar of a shared AI conversation. */
"monarch.aiSharedSession.label" = "Shared session";

/* Title of the list of everyone in the session. */
"monarch.aiSharedSession.listTitle" = "In this session";

/* Heading of the people in the list. */
"monarch.aiSharedSession.people" = "People";

/* Heading of the AI agents in the list. */
"monarch.aiSharedSession.agents" = "Agents";

/* Said for an agent where a person would have a role. */
"monarch.aiSharedSession.agentKind" = "AI agent";

/* Used when the answering agent is not in the session. */
"monarch.aiSharedSession.assistant" = "Assistant";

/* Used when the person who asked is not in the session. */
"monarch.aiSharedSession.someone" = "Someone";

/* Status line when nothing is happening. */
"monarch.aiSharedSession.quiet" = "No requests in progress";

/* Spoken name of the list of waiting requests. */
"monarch.aiSharedSession.queueTitle" = "Waiting requests";

/* Button that withdraws your own waiting request. */
"monarch.aiSharedSession.withdraw" = "Withdraw";

/* Button that removes someone's waiting request. For owners. */
"monarch.aiSharedSession.remove" = "Remove";

/* Button that moves a waiting request earlier. For owners. */
"monarch.aiSharedSession.moveUp" = "Move up";

/* Button that moves a waiting request later. For owners. */
"monarch.aiSharedSession.moveDown" = "Move down";

/* Button that opens the product's invite flow. */
"monarch.aiSharedSession.invite" = "Invite";

/* Toggle that follows another person's view. */
"monarch.aiSharedSession.follow" = "Follow";

/* Notice shown to a viewer. */
"monarch.aiSharedSession.viewerNotice" = "You can watch but not send";

/* Button with which a viewer asks to send requests. */
"monarch.aiSharedSession.requestAccess" = "Request access";

/* Shown in place of the request access button once access was requested. */
"monarch.aiSharedSession.accessRequested" = "Access requested";

/* Button that closes the list of participants. */
"monarch.aiSharedSession.done" = "Done";

/* Separates the clauses of the status line. */
"monarch.aiSharedSession.separator" = " · ";

/* Role of a person who manages the queue. */
"monarch.aiSharedSession.role.owner" = "Owner";

/* Role of a person who sends requests. */
"monarch.aiSharedSession.role.editor" = "Editor";

/* Role of a person who only watches. */
"monarch.aiSharedSession.role.viewer" = "Viewer";

/* Presence of a participant who is here and engaged. */
"monarch.aiSharedSession.presence.active" = "Active";

/* Presence of a participant who is here but quiet. */
"monarch.aiSharedSession.presence.idle" = "Idle";

/* Presence of a participant who stepped away. */
"monarch.aiSharedSession.presence.away" = "Away";

/* Activity of a participant who is typing. */
"monarch.aiSharedSession.activity.typing" = "Typing";

/* Activity of a participant who is speaking. */
"monarch.aiSharedSession.activity.speaking" = "Speaking";

/* Activity of a participant who is reviewing. */
"monarch.aiSharedSession.activity.reviewing" = "Reviewing";

/* Status clause when one person is typing. %@ is the name. */
"monarch.aiSharedSession.activityLine.typingOne" = "%@ is typing…";

/* Status clause when several people are typing. %@ is the names or "3 people". */
"monarch.aiSharedSession.activityLine.typing" = "%@ are typing…";

/* Status clause when one person is speaking. %@ is the name. */
"monarch.aiSharedSession.activityLine.speakingOne" = "%@ is speaking";

/* Status clause when several people are speaking. %@ is the names or "3 people". */
"monarch.aiSharedSession.activityLine.speaking" = "%@ are speaking";

/* Status clause when one person is reviewing. %@ is the name. */
"monarch.aiSharedSession.activityLine.reviewingOne" = "%@ is reviewing";

/* Status clause when several people are reviewing. %@ is the names or "3 people". */
"monarch.aiSharedSession.activityLine.reviewing" = "%@ are reviewing";

/* Stands in for the names when one person shares an activity. %lld is 1. */
"monarch.aiSharedSession.severalOne" = "%lld person";

/* Stands in for the names when more than two people share an activity. %lld is the count. */
"monarch.aiSharedSession.several" = "%lld people";

/* One person, in the name of the avatar stack. %lld is 1. */
"monarch.aiSharedSession.peopleCountOne" = "%lld person";

/* People, in the name of the avatar stack. %lld is the count. */
"monarch.aiSharedSession.peopleCount" = "%lld people";

/* One agent, in the name of the avatar stack. %lld is 1. */
"monarch.aiSharedSession.agentCountOne" = "%lld agent";

/* Agents, in the name of the avatar stack. %lld is the count. */
"monarch.aiSharedSession.agentCount" = "%lld agents";

/* Name of the avatar stack with people and agents. %1$@ is "3 people", %2$@ is "1 agent". */
"monarch.aiSharedSession.hereBoth" = "%1$@ and %2$@ here";

/* Name of the avatar stack with one kind of participant. %@ is "3 people" or "2 agents". */
"monarch.aiSharedSession.here" = "%@ here";

/* Hint of the avatar stack with one participant. %lld is 1. */
"monarch.aiSharedSession.showAllOne" = "Shows the %lld participant.";

/* Hint of the avatar stack. %lld is the number of participants. */
"monarch.aiSharedSession.showAll" = "Shows all %lld participants.";

/* Marks your own name. %@ is your name. */
"monarch.aiSharedSession.nameWithYou" = "%@ (you)";

/* Status clause while an agent answers someone else's request. %1$@ is the agent, %2$@ the person who asked. */
"monarch.aiSharedSession.answering" = "%1$@ is answering %2$@’s request";

/* Status clause while an agent answers your request. %@ is the agent. */
"monarch.aiSharedSession.answeringYou" = "%@ is answering your request";

/* A status clause followed by the request's description. %1$@ is the clause, %2$@ the description. */
"monarch.aiSharedSession.withLabel" = "%1$@: %2$@";

/* Status clause with one waiting request. %lld is 1. */
"monarch.aiSharedSession.queueCountOne" = "%lld request waiting";

/* Status clause with waiting requests. %lld is the count. */
"monarch.aiSharedSession.queueCount" = "%lld requests waiting";

/* Button that shows or hides the queue. %lld is the number of waiting requests. */
"monarch.aiSharedSession.queueToggle" = "Queue (%lld)";

/* Spoken name of a queue button. %1$@ is the action, %2$lld the position, %3$@ the person who asked. */
"monarch.aiSharedSession.requestAction" = "%1$@: request %2$lld, from %3$@";

/* Announced after a request moved. %1$@ is the person who asked, %2$lld the new position, %3$lld the total. */
"monarch.aiSharedSession.moved" = "%1$@’s request moved to position %2$lld of %3$lld";

/* Spoken name of a follow toggle. %@ is the person's name. */
"monarch.aiSharedSession.followLabel" = "Follow %@";
