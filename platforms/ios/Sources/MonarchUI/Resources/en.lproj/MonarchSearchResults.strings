/* Summary of search results for one result, without a query. %lld is 1. */
"monarch.searchResults.count.one" = "%lld result";

/* Summary of search results, without a query. Also read after a group heading. %lld is the number of results. */
"monarch.searchResults.count.other" = "%lld results";

/* Summary of search results for one result. %1$lld is 1, %2$@ is what the person searched for. */
"monarch.searchResults.countForQuery.one" = "%1$lld result for “%2$@”";

/* Summary of search results. %1$lld is the number of results, %2$@ is what the person searched for. */
"monarch.searchResults.countForQuery.other" = "%1$lld results for “%2$@”";

/* Summary while a search runs. */
"monarch.searchResults.loading" = "Searching…";

/* Title of the empty state when nothing was searched for. */
"monarch.searchResults.emptyTitle" = "No results";

/* Title of the empty state. %@ is what the person searched for. */
"monarch.searchResults.emptyTitleForQuery" = "No results for “%@”";

/* Message of the empty state. */
"monarch.searchResults.emptyMessage" = "Try other words, check the spelling, or remove a filter.";

/* Title of the error state when the search failed. */
"monarch.searchResults.errorTitle" = "Search failed";

/* Button after a group that has more matches than it shows. %1$lld is the total, %2$@ the group's heading. */
"monarch.searchResults.showAll" = "Show all %1$lld in %2$@";

/* Button after results without a heading that has more matches than it shows. %lld is the total. */
"monarch.searchResults.showAllUngrouped" = "Show all %lld";
