/* The item count in a bucket header, for one. %ld is the count. */
"monarch.backlogPlanner.items.one" = "%ld item";

/* The item count in a bucket header. %ld is the count. */
"monarch.backlogPlanner.items.other" = "%ld items";

/* The point total in a bucket header, for one. %ld is the total. */
"monarch.backlogPlanner.points.one" = "%ld point";

/* The point total in a bucket header. %ld is the total. */
"monarch.backlogPlanner.points.other" = "%ld points";

/* The number of items without an estimate in a bucket header. %ld is the number. */
"monarch.backlogPlanner.unestimated" = "%ld unestimated";

/* The capacity meter text. %1$ld is the planned points, %2$ld the capacity. */
"monarch.backlogPlanner.capacity" = "%1$ld of %2$ld points";

/* The spoken name of the capacity meter. */
"monarch.backlogPlanner.capacityLabel" = "Capacity";

/* The note when a bucket is over capacity by one point. %ld is 1. */
"monarch.backlogPlanner.overCapacity.one" = "Planned work is over capacity by %ld point.";

/* The note when a bucket is over capacity. %ld is the points over. */
"monarch.backlogPlanner.overCapacity.other" = "Planned work is over capacity by %ld points.";

/* The points shown on a row. %ld is the estimate. */
"monarch.backlogPlanner.rowPoints" = "%ld pt";

/* The points shown on a row with no estimate. */
"monarch.backlogPlanner.rowUnestimated" = "–";

/* The spoken points of a row with no estimate. */
"monarch.backlogPlanner.notEstimated" = "Not estimated";

/* The spoken points of a row. %ld is the estimate. */
"monarch.backlogPlanner.rowPointsSpoken" = "%ld points";

/* The spoken name of a row's move menu. %@ is the item. */
"monarch.backlogPlanner.moveMenu" = "Move %@ to…";

/* The heading of the buckets in the move menu. */
"monarch.backlogPlanner.moveTo" = "Move to";

/* The menu item and VoiceOver action that moves an item one place up. */
"monarch.backlogPlanner.moveUp" = "Move up";

/* The menu item and VoiceOver action that moves an item one place down. */
"monarch.backlogPlanner.moveDown" = "Move down";

/* The VoiceOver action that moves an item to another bucket. %@ is the bucket. */
"monarch.backlogPlanner.moveToBucket" = "Move to %@";

/* Shown in a bucket with no items. */
"monarch.backlogPlanner.empty" = "Nothing here yet.";

/* Announced after a move. %1$@ is the item, %2$@ the bucket, %3$ld the position and %4$ld the count. */
"monarch.backlogPlanner.moved" = "%1$@ moved to %2$@, position %3$ld of %4$ld.";

/* The spoken state of an open bucket. */
"monarch.backlogPlanner.expanded" = "Expanded";

/* The spoken state of a closed bucket. */
"monarch.backlogPlanner.collapsed" = "Collapsed";

/* The spoken hint of a bucket heading. */
"monarch.backlogPlanner.toggleHint" = "Shows or hides the items.";
