/* The title of the version history panel. */
"monarch.versionHistoryPanel.title" = "History";

/* The button that closes the version history panel. */
"monarch.versionHistoryPanel.close" = "Close";

/* The spoken name of the field where a version is named before saving. */
"monarch.versionHistoryPanel.noteLabel" = "Version name";

/* The placeholder of the field where a version is named before saving. */
"monarch.versionHistoryPanel.notePlaceholder" = "Name this version (optional)";

/* The button that saves the current content as a version. */
"monarch.versionHistoryPanel.save" = "Save version";

/* Announced after a version is saved. */
"monarch.versionHistoryPanel.saved" = "Version saved";

/* Shown when saving a version fails. */
"monarch.versionHistoryPanel.saveFailed" = "The version could not be saved. Try again.";

/* Shown when there are no versions. */
"monarch.versionHistoryPanel.empty" = "No versions yet. Save one to mark this moment.";

/* Marks the version that matches the content now. */
"monarch.versionHistoryPanel.current" = "Current";

/* Shown after the author of a version saved automatically. */
"monarch.versionHistoryPanel.automatic" = "auto";

/* The heading of the list of versions. */
"monarch.versionHistoryPanel.versions" = "Versions";

/* The tab that shows what changed between a version and now. */
"monarch.versionHistoryPanel.changes" = "Changes";

/* The tab that shows the whole text of a version. */
"monarch.versionHistoryPanel.fullText" = "Full text";

/* The name of the content now, in the comparison with a version. */
"monarch.versionHistoryPanel.now" = "Now";

/* Shown when a version has no changes compared with now. */
"monarch.versionHistoryPanel.identical" = "This version is identical to the current one.";

/* The button that replaces the content with the version. */
"monarch.versionHistoryPanel.restore" = "Restore this version";

/* The title of the confirmation before restoring a version. */
"monarch.versionHistoryPanel.restoreTitle" = "Restore this version?";

/* The message of the confirmation before restoring a version. */
"monarch.versionHistoryPanel.restoreDescription" = "The current content is replaced with this version.";

/* The button in the confirmation that restores the version. */
"monarch.versionHistoryPanel.restoreConfirm" = "Restore";

/* Announced after a version is restored. */
"monarch.versionHistoryPanel.restored" = "Version restored";

/* Shown when restoring a version fails. */
"monarch.versionHistoryPanel.restoreFailed" = "The version could not be restored. Try again.";

/* The spoken name of the placeholder shown while versions or their text load. */
"monarch.versionHistoryPanel.loading" = "Loading";

/* The name of the control that switches between the changes and the full text. */
"monarch.versionHistoryPanel.view" = "View";
