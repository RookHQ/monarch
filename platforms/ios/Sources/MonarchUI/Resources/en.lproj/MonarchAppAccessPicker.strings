/* Label of the list of apps a member can be given access to. */
"monarch.appAccessPicker.label" = "App access";

/* Button that selects every app in the app access list. */
"monarch.appAccessPicker.selectAll" = "Select all";

/* Button that clears every app in the app access list. */
"monarch.appAccessPicker.clearAll" = "Clear all";

/* Count above the app access list. %1$lld is the number selected, %2$lld the number of apps. */
"monarch.appAccessPicker.count" = "%1$lld of %2$lld selected";

/* Read by VoiceOver while the app access list loads. */
"monarch.appAccessPicker.loading" = "Loading apps";

/* Shown when there are no apps to grant. */
"monarch.appAccessPicker.empty" = "No apps are available yet.";

/* Summary of a member's apps when they have none. */
"monarch.appAccessPicker.none" = "No app access";

/* Visible count of the apps a summary does not name. %lld is the number. */
"monarch.appAccessPicker.moreCount" = "+%lld";

/* Spoken end of an app summary. %1$lld is the number of apps not shown, %2$@ their names. */
"monarch.appAccessPicker.more" = "and %1$lld more: %2$@";
