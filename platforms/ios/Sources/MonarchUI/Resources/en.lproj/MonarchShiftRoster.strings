/* The name of a shift roster, read by VoiceOver. */
"monarch.shiftRoster.roster" = "Shift roster";

/* The header of the people column of a shift roster grid, and the name of its person tabs. */
"monarch.shiftRoster.person" = "Person";

/* The name of the day tabs of a shift roster, read by VoiceOver. */
"monarch.shiftRoster.day" = "Day";

/* A day off in a shift roster cell and its menu. */
"monarch.shiftRoster.off" = "Off";

/* A day with no assignment in a shift roster cell. */
"monarch.shiftRoster.unassigned" = "Not assigned";

/* The menu item of a shift roster cell that removes the assignment. */
"monarch.shiftRoster.clear" = "Clear";

/* The heading of the menu of a shift roster cell. The first %@ is the person, the second the day. */
"monarch.shiftRoster.menuTitle" = "%1$@, %2$@";

/* What VoiceOver reads for a shift roster cell. %1$@ is the person, %2$@ the day, %3$@ the assignment. */
"monarch.shiftRoster.cell" = "%1$@, %2$@: %3$@";

/* A shift's start and end as VoiceOver reads them. The first %@ is the start, the second the end. */
"monarch.shiftRoster.range" = "%1$@ to %2$@";

/* Added to a shift that ends the next day. */
"monarch.shiftRoster.overnight" = "overnight";

/* The header of the hours column of a shift roster, and the name of a person's total. */
"monarch.shiftRoster.hours" = "Hours";

/* A total of hours in a shift roster. %@ is the number, rounded to one decimal. */
"monarch.shiftRoster.hoursValue" = "%@ h";

/* The label of the working-count row of a shift roster grid. */
"monarch.shiftRoster.working" = "Working";

/* The number working on a day of a shift roster, when it is one. */
"monarch.shiftRoster.workingOne" = "1 working";

/* The number working on a day of a shift roster. %@ is the number, already formatted. */
"monarch.shiftRoster.workingOther" = "%@ working";

/* The marker of today in a shift roster. */
"monarch.shiftRoster.today" = "Today";

/* The title of the empty state of a shift roster with no people. */
"monarch.shiftRoster.emptyTitle" = "No one to schedule";

/* The message of the empty state of a shift roster with no people. */
"monarch.shiftRoster.emptyDescription" = "People appear here with their shift for each day.";

/* What VoiceOver reads while a shift roster loads. */
"monarch.shiftRoster.loading" = "Loading roster";
