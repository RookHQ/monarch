/* Shown in a slot picker before a day is chosen. */
"monarch.slotPicker.chooseDay" = "Choose a day to see available times.";

/* Shown when the chosen day has no open times. */
"monarch.slotPicker.empty" = "No times are available on this day. Try another day.";

/* Announced while the times of a day load. */
"monarch.slotPicker.loading" = "Loading available times";

/* Announced when a day has no open times. %@ is the day. */
"monarch.slotPicker.loadedNone" = "No times available on %@";

/* Announced when a day has one open time. %@ is the day. */
"monarch.slotPicker.loadedOne" = "1 time on %@";

/* Announced when a day has open times. %1$ld is their number, %2$@ the day. */
"monarch.slotPicker.loadedOther" = "%1$ld times on %2$@";

/* Name of the group of times. %@ is the day. */
"monarch.slotPicker.times" = "Available times on %@";

/* Under a time with limited places. %ld is the number of places. */
"monarch.slotPicker.seatsLeft" = "%ld left";

/* Label of the time zone picker of a slot picker. */
"monarch.slotPicker.timeZone" = "Time zone";

/* Note under the times when the zone cannot be changed. %@ is the zone's name. */
"monarch.slotPicker.shownIn" = "Times shown in %@";

/* Note when the business works in another zone. %@ is that zone's name. */
"monarch.slotPicker.convertedFrom" = "Times are converted from %@.";

/* Warning when the selected time is not one of the day's open times. %@ is the time. */
"monarch.slotPicker.notOpen" = "%@ is not an open time on this day.";

/* Button that asks for a time outside the open ones. */
"monarch.slotPicker.chooseOutside" = "Choose another time";

/* Retry button when the times could not be loaded. */
"monarch.slotPicker.retry" = "Try again";
