/* The name of the notifications button, and its visible title in the row variant. */
"monarch.notificationsBell.title" = "Notifications";

/* Spoken as the value of the notifications button. %@ is the number of unread notifications. */
"monarch.notificationsBell.unread" = "%@ unread";

/* The text of the count badge when there are more unread notifications than it shows. %@ is the largest number shown. */
"monarch.notificationsBell.overflow" = "%@+";
