/* Spoken name of the table of subscriptions. */
"monarch.subscriptionsTable.caption" = "Subscriptions";
/* Column heading: the subscription's name and plan. */
"monarch.subscriptionsTable.subscription" = "Subscription";
/* Column heading: the customer a subscription belongs to. */
"monarch.subscriptionsTable.customer" = "Customer";
/* Column heading: the subscription's status. */
"monarch.subscriptionsTable.status" = "Status";
/* Column heading: the price per billing period. */
"monarch.subscriptionsTable.price" = "Price";
/* Column heading: the price normalised to one month (monthly recurring revenue). */
"monarch.subscriptionsTable.monthly" = "Monthly";
/* Column heading: the next renewal or end date. */
"monarch.subscriptionsTable.renewal" = "Renewal";
/* Shown in place of the plan when a subscription has a custom price. */
"monarch.subscriptionsTable.customPrice" = "Custom price";
/* Before the plan name when there are several seats or units. %d is the number. */
"monarch.subscriptionsTable.quantity" = "%d ×";
/* A billing period of one day. */
"monarch.subscriptionsTable.interval.day" = "day";
/* A billing period of one week. */
"monarch.subscriptionsTable.interval.week" = "week";
/* A billing period of one month. */
"monarch.subscriptionsTable.interval.month" = "month";
/* A billing period of one year. */
"monarch.subscriptionsTable.interval.year" = "year";
/* A billing period of several days. %d is the number. */
"monarch.subscriptionsTable.intervals.day" = "%d days";
/* A billing period of several weeks. %d is the number. */
"monarch.subscriptionsTable.intervals.week" = "%d weeks";
/* A billing period of several months. %d is the number. */
"monarch.subscriptionsTable.intervals.month" = "%d months";
/* A billing period of several years. %d is the number. */
"monarch.subscriptionsTable.intervals.year" = "%d years";
/* A billing period of three months. */
"monarch.subscriptionsTable.quarter" = "quarter";
/* A charge that does not recur. */
"monarch.subscriptionsTable.oneTime" = "one time";
/* After a price. %@ is the billing period, such as month. */
"monarch.subscriptionsTable.priceSuffix" = "/ %@";
/* Spoken price of a recurring charge. %1$@ is the amount, %2$@ the billing period. */
"monarch.subscriptionsTable.spokenPrice" = "%1$@ per %2$@";
/* Spoken price of a one-time charge. %@ is the amount. */
"monarch.subscriptionsTable.spokenOneTimePrice" = "%@, one time";
/* Under the name: a scheduled cancellation. %@ is the date. */
"monarch.subscriptionsTable.cancels" = "cancels %@";
/* Under the name: a scheduled plan or price change. %@ is the date. */
"monarch.subscriptionsTable.changes" = "changes %@";
/* The next renewal. %@ is the date. */
"monarch.subscriptionsTable.renews" = "Renews %@";
/* The date a subscription ends without renewing. %@ is the date. */
"monarch.subscriptionsTable.ends" = "Ends %@";
/* A subscription with no end date. */
"monarch.subscriptionsTable.evergreen" = "Evergreen";
/* An active subscription whose monthly amount could not be converted to the reporting currency. */
"monarch.subscriptionsTable.notConverted" = "Not converted";
/* Explains Not converted. */
"monarch.subscriptionsTable.notConvertedHint" = "No exchange rate is available, so this is left out of the monthly total.";
/* Shown in place of a missing value, such as a customer. */
"monarch.subscriptionsTable.noValue" = "—";
/* The title shown when there are no subscriptions. */
"monarch.subscriptionsTable.emptyTitle" = "No subscriptions";
/* The message shown when there are no subscriptions. */
"monarch.subscriptionsTable.emptyMessage" = "Subscriptions appear here once they are created.";
/* Subscription status: not yet started. */
"monarch.subscriptionsTable.status.draft" = "Draft";
/* Subscription status: in a trial period. */
"monarch.subscriptionsTable.status.trial" = "Trial";
/* Subscription status: running and paid. */
"monarch.subscriptionsTable.status.active" = "Active";
/* Subscription status: a payment has failed and is overdue. */
"monarch.subscriptionsTable.status.past_due" = "Past due";
/* Subscription status: temporarily stopped. */
"monarch.subscriptionsTable.status.paused" = "Paused";
/* Subscription status: cancelled. */
"monarch.subscriptionsTable.status.cancelled" = "Cancelled";
/* Subscription status: ended at the end of its term. */
"monarch.subscriptionsTable.status.expired" = "Expired";
