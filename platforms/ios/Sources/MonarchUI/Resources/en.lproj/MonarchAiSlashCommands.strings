/* The spoken name of the list of slash commands of an assistant prompt. */
"monarch.aiSlashCommands.label" = "Commands";

/* Shown when no command matches. %@ is what was typed, with the slash. */
"monarch.aiSlashCommands.empty" = "No commands match “%@”";

/* Announced when one command matches. */
"monarch.aiSlashCommands.countOne" = "1 command";

/* Announced when commands match. %ld is their number. */
"monarch.aiSlashCommands.countOther" = "%ld commands";
