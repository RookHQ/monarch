/* Read after an AI agent's name, so the avatar is never taken for a person. */
"monarch.aiAgentAvatar.kind" = "AI agent";

/* State of an agent that is not doing anything. */
"monarch.aiAgentAvatar.state.idle" = "Idle";

/* State of an agent that is working on a task. */
"monarch.aiAgentAvatar.state.working" = "Working";

/* State of an agent that needs a person: an approval or an answer. */
"monarch.aiAgentAvatar.state.waiting" = "Waiting for you";

/* State of an agent that stopped with an error. */
"monarch.aiAgentAvatar.state.error" = "Error";

/* Spoken name of an idle agent's avatar. %1$@ is the agent's name, %2$@ the kind ("AI agent"). */
"monarch.aiAgentAvatar.label" = "%1$@, %2$@";

/* Spoken name of an agent's avatar with its state. %1$@ is the agent's name, %2$@ the kind ("AI agent"), %3$@ the state, such as "Working". */
"monarch.aiAgentAvatar.labelWithState" = "%1$@, %2$@, %3$@";
