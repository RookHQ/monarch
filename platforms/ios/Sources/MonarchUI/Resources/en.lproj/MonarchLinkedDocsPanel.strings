/* The title of the panel of docs and links attached to a record. */
"monarch.linkedDocsPanel.title" = "Docs";

/* The menu item, and the title of the picker, that links an existing doc. */
"monarch.linkedDocsPanel.linkDoc" = "Link doc";

/* The menu item, and the title of the form, that adds a link to a web page. */
"monarch.linkedDocsPanel.addLink" = "Add link";

/* The button in the doc picker that creates a new doc. */
"monarch.linkedDocsPanel.newDoc" = "New doc";

/* The search prompt of the doc picker. */
"monarch.linkedDocsPanel.searchDocs" = "Search docs";

/* Shown in the doc picker when no doc matches. */
"monarch.linkedDocsPanel.noDocs" = "No docs match";

/* Shown when nothing is linked and the person can link something. */
"monarch.linkedDocsPanel.empty" = "Nothing linked yet. Link a spec, runbook or notes, or add a link to any page.";

/* Shown when nothing is linked in a read-only panel. */
"monarch.linkedDocsPanel.emptyReadOnly" = "Nothing linked yet.";

/* Read while the linked docs load. */
"monarch.linkedDocsPanel.loading" = "Loading linked docs";

/* The name of the menu that links a doc or adds a link. */
"monarch.linkedDocsPanel.add" = "Add";

/* The name of the picker that filters the docs by space. */
"monarch.linkedDocsPanel.filterBySpace" = "Filter by space";

/* The filter option that shows docs from every space. */
"monarch.linkedDocsPanel.all" = "All";

/* The filter option for docs and links that are in no space. */
"monarch.linkedDocsPanel.noSpace" = "No Space";

/* Shown when the filter hides one row. %lld is the count. */
"monarch.linkedDocsPanel.hiddenByFilter.one" = "%lld more in other spaces.";

/* Shown when the filter hides several rows. %lld is the count. */
"monarch.linkedDocsPanel.hiddenByFilter.other" = "%lld more in other spaces.";

/* The button that clears the space filter. */
"monarch.linkedDocsPanel.showAll" = "Show all";

/* The spoken name of the button that unlinks a row. %@ is the row's title. */
"monarch.linkedDocsPanel.unlink" = "Unlink %@";

/* Shown and announced when unlinking fails. */
"monarch.linkedDocsPanel.unlinkFailed" = "That didn’t unlink. Try again.";

/* Shown and announced when linking fails. */
"monarch.linkedDocsPanel.linkFailed" = "That didn’t link. Try again.";

/* The label of the web address field in the add link form. */
"monarch.linkedDocsPanel.urlLabel" = "Link";

/* Shown under the web address field when the address is not a full http or https address. */
"monarch.linkedDocsPanel.urlInvalid" = "Enter a full web address that starts with https://";

/* The label of the optional title field in the add link form. */
"monarch.linkedDocsPanel.titleLabel" = "Title (optional)";

/* The button that adds the link in the add link form. */
"monarch.linkedDocsPanel.confirmAdd" = "Add";

/* The button that closes the doc picker or the add link form. */
"monarch.linkedDocsPanel.cancel" = "Cancel";
