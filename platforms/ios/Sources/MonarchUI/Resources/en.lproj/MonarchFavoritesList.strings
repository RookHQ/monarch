/* Heading of the list of pinned destinations. */
"monarch.favoritesList.title" = "Favorites";

/* Visible title of the button that starts editing the favorites. */
"monarch.favoritesList.edit" = "Edit";

/* Spoken name of the button that starts editing the favorites. */
"monarch.favoritesList.editLabel" = "Edit favorites";

/* Button that stops editing the favorites. */
"monarch.favoritesList.done" = "Done";

/* Announced after a favorite is removed. %@ is its name. */
"monarch.favoritesList.removed" = "%@ removed from favorites.";

/* Accessibility action that moves a favorite one place up. */
"monarch.favoritesList.moveUp" = "Move up";

/* Accessibility action that moves a favorite one place down. */
"monarch.favoritesList.moveDown" = "Move down";
