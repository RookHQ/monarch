/* Title of the row that opens the system colour picker for any colour. */
"monarch.colorPicker.custom" = "Custom colour";
/* Shown in place of the hex value while no colour is selected. */
"monarch.colorPicker.empty" = "No colour selected";
/* Spoken name of a preset colour. %1$@ is the name of the colour and %2$@ its hex value. */
"monarch.colorPicker.swatchLabel" = "%1$@, %2$@";
/* Name of the default preset #64748b. */
"monarch.colorPicker.swatch.slate" = "Slate";
/* Name of the default preset #dc2626. */
"monarch.colorPicker.swatch.red" = "Red";
/* Name of the default preset #ea580c. */
"monarch.colorPicker.swatch.orange" = "Orange";
/* Name of the default preset #ca8a04. */
"monarch.colorPicker.swatch.yellow" = "Yellow";
/* Name of the default preset #16a34a. */
"monarch.colorPicker.swatch.green" = "Green";
/* Name of the default preset #0d9488. */
"monarch.colorPicker.swatch.teal" = "Teal";
/* Name of the default preset #2563eb. */
"monarch.colorPicker.swatch.blue" = "Blue";
/* Name of the default preset #4f46e5. */
"monarch.colorPicker.swatch.indigo" = "Indigo";
/* Name of the default preset #9333ea. */
"monarch.colorPicker.swatch.purple" = "Purple";
/* Name of the default preset #db2777. */
"monarch.colorPicker.swatch.pink" = "Pink";

/* The line under the custom colour row; the argument is the hex value or the empty text. */
"monarch.colorPicker.selected" = "Selected: %@";
