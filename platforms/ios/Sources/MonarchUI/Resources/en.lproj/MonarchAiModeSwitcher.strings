/* The name of the choice of how the assistant works. Read by VoiceOver as the name of the segmented control. */
"monarch.aiModeSwitcher.label" = "Mode";

/* The name of the built-in mode in which the assistant only answers. */
"monarch.aiModeSwitcher.ask" = "Ask";

/* What the Ask mode does, shown under the switcher. */
"monarch.aiModeSwitcher.askDetail" = "Answers questions. Changes nothing.";

/* The name of the built-in mode in which the assistant proposes edits. */
"monarch.aiModeSwitcher.edit" = "Edit";

/* What the Edit mode does, shown under the switcher. */
"monarch.aiModeSwitcher.editDetail" = "Proposes edits you review before they apply.";

/* The name of the built-in mode in which the assistant works through steps and uses tools. */
