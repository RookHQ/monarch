/* The spoken name of a table that compares plans feature by feature. */
"monarch.pricingTable.caption" = "Plan comparison";
/* Spoken for a check in a plan comparison: the plan includes the feature. */
"monarch.pricingTable.included" = "Included";
/* Spoken for a dash in a plan comparison: the plan does not include the feature. */
"monarch.pricingTable.notIncluded" = "Not included";
/* The badge on the plan the customer has now. */
"monarch.pricingTable.currentPlan" = "Current plan";
/* The name of the control that switches prices between billing periods, such as monthly and yearly. */
"monarch.pricingTable.billingPeriod" = "Billing period";
/* The name of the control that chooses which plan is shown, one plan at a time. */
"monarch.pricingTable.plan" = "Plan";
