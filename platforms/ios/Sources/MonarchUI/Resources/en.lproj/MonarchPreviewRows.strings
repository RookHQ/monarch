/* The spoken name of the tabs that filter the rows of an import preview by result. */
"monarch.previewRows.filter" = "Show rows";

/* The filter tab that shows every row of an import preview. */
"monarch.previewRows.all" = "All";

/* The result of a row that will be imported as it is. */
"monarch.previewRows.ready" = "Ready";

/* The result of a row that will be imported with warnings. */
"monarch.previewRows.warning" = "Warning";

/* The result of a row that will be skipped because of errors. */
"monarch.previewRows.error" = "Error";

/* The result of a row that matches a record that already exists. */
"monarch.previewRows.duplicate" = "Duplicate";

/* The title of one row of an import preview. %lld is the row number in the file. */
"monarch.previewRows.row" = "Row %lld";

/* Read by VoiceOver for a cell with no value, which is drawn as a dash. */
"monarch.previewRows.emptyValue" = "Empty";

/* The title shown when an import file has no data rows. */
"monarch.previewRows.emptyTitle" = "No rows to preview";

/* The message shown when an import file has no data rows. */
"monarch.previewRows.emptyDescription" = "The file has a header row but no data rows.";

/* The title shown when the chosen filter matches no row. */
"monarch.previewRows.filteredTitle" = "No rows with this result";

/* The label of the cell that shows the result (ready, warning, error, duplicate) of one row of an import preview. */
"monarch.previewRows.result" = "Result";

/* The label of the cell that lists the errors and warnings of one row of an import preview. */
"monarch.previewRows.issues" = "Issues";
