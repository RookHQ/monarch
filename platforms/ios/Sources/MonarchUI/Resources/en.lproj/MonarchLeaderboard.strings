/* The tag after the viewer's own name in a ranking. */
"monarch.leaderboard.you" = "(you)";

/* Shown when a ranking has no entries. */
"monarch.leaderboard.empty" = "Nothing to rank yet";

/* The spoken name of the placeholder rows while a ranking loads. */
"monarch.leaderboard.loading" = "Loading ranking";

/* The number of ranked entries that are not shown. %lld is the count. */
"monarch.leaderboard.more" = "%lld more";

/* Spoken before an entry's name. %lld is its rank, from 1. */
"monarch.leaderboard.rank" = "Rank %lld:";
