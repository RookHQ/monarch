/* The title of the card that lists invitations not accepted yet. */
"monarch.pendingInvitesList.title" = "Pending invitations";

/* The spoken name of the list of invitations. */
"monarch.pendingInvitesList.listLabel" = "Pending invitations";

/* Before the name of the person who sent an invitation, such as "Invited by Sam Rivera". */
"monarch.pendingInvitesList.invitedBy" = "Invited by";

/* Before the time an invitation was sent, such as "Sent 2 days ago". */
"monarch.pendingInvitesList.sent" = "Sent";

/* Before the time an invitation stops working, such as "Expires in 5 days". */
"monarch.pendingInvitesList.expires" = "Expires";

/* The badge on an invitation that has expired. */
"monarch.pendingInvitesList.expired" = "Expired";

/* The button that copies an invitation link. */
"monarch.pendingInvitesList.copyLink" = "Copy link";

/* Added to the spoken name of the copy button. %@ is the email address. */
"monarch.pendingInvitesList.copyTarget" = "for %@";

/* Announced after an invitation was revoked. %@ is the email address. */
"monarch.pendingInvitesList.revoked" = "Invitation to %@ revoked";

/* Read while the invitations load. */
"monarch.pendingInvitesList.loading" = "Loading invitations";

/* The title of the empty state. */
"monarch.pendingInvitesList.emptyTitle" = "No pending invitations";

/* The title of the error state when the invitations did not load. */
"monarch.pendingInvitesList.resend" = "Resend";
"monarch.pendingInvitesList.revoke" = "Revoke";
"monarch.pendingInvitesList.errorTitle" = "Couldn’t load invitations";
