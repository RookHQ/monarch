/* Title above the steps an AI assistant proposes before it acts. */
"monarch.aiPlan.title" = "Proposed plan";

/* Explanation while the plan waits for the person's decision. */
"monarch.aiPlan.description" = "The assistant will take these steps after you approve. Nothing runs until then.";

/* Added to the explanation while the person can change the plan. */
"monarch.aiPlan.editHint" = "You can edit, reorder, add or remove steps first.";

/* Shown and announced once the person approves the plan. */
"monarch.aiPlan.approvedNotice" = "Plan approved. The assistant is working through it.";

/* Shown and announced once the person rejects the plan. */
"monarch.aiPlan.rejectedNotice" = "Plan rejected. The assistant will not take these steps.";

/* Spoken name of a step's text. %d is its position. */
"monarch.aiPlan.stepLabel" = "Step %d";

/* Placeholder of a step with no text. */
"monarch.aiPlan.stepPlaceholder" = "Describe this step";

/* Name of a step with no text in spoken names. %d is its position. */
"monarch.aiPlan.untitledStep" = "step %d";

/* Spoken name of a step's drag handle. %@ is what the step does. */
"monarch.aiPlan.reorder" = "Reorder %@";

/* Announced after a step moves. %1$@ is what the step does, %2$d its new position, %3$d the number of steps. */
"monarch.aiPlan.moved" = "%1$@, position %2$d of %3$d";

/* Spoken name of a step's remove button. %@ is what the step does. */
"monarch.aiPlan.remove" = "Remove %@";

/* Announced after a step is removed. %@ is what the step did. */
"monarch.aiPlan.removed" = "Removed %@";

/* Button that adds a step at the end of the plan. */
"monarch.aiPlan.addStep" = "Add step";

/* Button that approves the plan. */
"monarch.aiPlan.approve" = "Approve plan";

/* Button that rejects the plan. */
"monarch.aiPlan.reject" = "Reject";

/* Shown when the approve button is unavailable because every step is empty. */
"monarch.aiPlan.emptyPlan" = "Add at least one step to approve the plan.";
