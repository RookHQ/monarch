/* Spoken before the summary of an AI assistant's reasoning, naming the region. */
"monarch.aiReasoning.prefix" = "Assistant reasoning";

/* Summary while the assistant is still reasoning. */
"monarch.aiReasoning.thinking" = "Thinking…";

/* Summary once the assistant has finished reasoning. %@ is the duration, for example 12s. */
"monarch.aiReasoning.thoughtFor" = "Thought for %@";

/* Summary once the assistant has finished reasoning, when the duration is not known. */
"monarch.aiReasoning.thought" = "Thought";

/* Summary of reasoning whose text is not shown. */
"monarch.aiReasoning.reasoningHidden" = "Reasoning hidden";
