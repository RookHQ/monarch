/* Title of the button when several formats are offered in a menu. */
"monarch.downloadReportButton.label" = "Download";

/* Title of the button when one format is offered. %@ is the format, such as CSV. */
"monarch.downloadReportButton.single" = "Download %@";

/* Announced and read while the file is prepared. %@ is the format. */
"monarch.downloadReportButton.preparing" = "Preparing %@…";

/* Announced when the file is saved. %@ is the format. */
"monarch.downloadReportButton.downloaded" = "%@ downloaded";

/* Shown when the file is prepared in the background. */
"monarch.downloadReportButton.queued" = "The file is being prepared. You can leave this screen; it will be ready to download shortly.";

/* Shown when the download failed. %@ is the format. */
"monarch.downloadReportButton.error" = "The %@ download failed.";

/* Spoken name of the progress bar. */
"monarch.downloadReportButton.progress" = "Download progress";

/* Name of the comma-separated values format offered by default. */
"monarch.downloadReportButton.csv" = "CSV";
