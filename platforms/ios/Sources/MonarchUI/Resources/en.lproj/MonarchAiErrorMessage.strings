/* Description of the failure card when the service is rate limited or overloaded. */
"monarch.aiErrorMessage.message.rateLimit" = "The assistant is handling a lot of requests. Wait a moment, then try again.";

/* Description of the failure card when the conversation no longer fits the model's context. */
"monarch.aiErrorMessage.message.contextOverflow" = "The assistant can’t take in any more of this conversation. Start a new conversation, or summarize this one and continue from the summary.";

/* Description of the failure card when a safety filter blocked the request. */
"monarch.aiErrorMessage.message.safetyBlock" = "This request was blocked by a safety filter. Rephrase your message and send it again.";

/* Description of the failure card when the service could not be reached. */
"monarch.aiErrorMessage.message.network" = "The assistant couldn’t be reached. Check your connection and try again.";

/* Description of the failure card when a tool the assistant used failed. */
"monarch.aiErrorMessage.message.toolFailure" = "The assistant couldn’t finish because a tool it used failed. Try again, or ask in a different way.";

