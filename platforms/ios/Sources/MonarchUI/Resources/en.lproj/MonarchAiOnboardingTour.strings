/* Small label above each step of the introduction to AI features. */
"monarch.aiOnboardingTour.eyebrow" = "AI";

/* Position of the current step. The first %d is the step, the second the number of steps. */
"monarch.aiOnboardingTour.stepOf" = "Step %1$d of %2$d";

/* Button that goes to the previous step. */
"monarch.aiOnboardingTour.back" = "Back";

/* Button that goes to the next step. */
"monarch.aiOnboardingTour.next" = "Next";

/* Button on the last step that finishes the introduction. */
"monarch.aiOnboardingTour.finish" = "Got it";

/* Read by VoiceOver as the name of the close button, which skips the introduction. */
"monarch.aiOnboardingTour.skip" = "Skip introduction";

/* Button on every step that turns AI features off. */
"monarch.aiOnboardingTour.disable" = "Turn off AI";
