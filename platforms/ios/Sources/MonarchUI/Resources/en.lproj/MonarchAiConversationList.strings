/* Read by VoiceOver as the name of the list of past AI conversations. */
"monarch.aiConversationList.label" = "Conversation history";

/* Heading of the group of pinned conversations. */
"monarch.aiConversationList.group.pinned" = "Pinned";

/* Heading of the group of conversations changed today. */
"monarch.aiConversationList.group.today" = "Today";

/* Heading of the group of conversations changed in the 7 days before today. */
"monarch.aiConversationList.group.previous7Days" = "Previous 7 days";

/* Heading of the group of conversations changed earlier. */
"monarch.aiConversationList.group.older" = "Older";

/* Title shown for a conversation that has no title yet. */
"monarch.aiConversationList.untitled" = "New conversation";

/* Button that starts a new conversation. */
"monarch.aiConversationList.newConversation" = "New conversation";

/* Prompt of the field that searches the conversations. */
"monarch.aiConversationList.search" = "Search";

/* Shown when there are no conversations. */
"monarch.aiConversationList.empty" = "No conversations yet";

/* Shown when the search matches no conversation. %@ is the search text. */
"monarch.aiConversationList.noResults" = "No conversations match “%@”";

/* Announced by VoiceOver when the search matches exactly one conversation. */
"monarch.aiConversationList.results.one" = "1 conversation";

/* Announced by VoiceOver with the number of conversations the search matches. %d is the number. */
"monarch.aiConversationList.results.other" = "%d conversations";

/* Command that renames a conversation. */
"monarch.aiConversationList.rename" = "Rename";

/* Command that pins a conversation to the top. */
"monarch.aiConversationList.pin" = "Pin";

/* Command that unpins a conversation. */
"monarch.aiConversationList.unpin" = "Unpin";

/* Command that deletes a conversation, after a confirmation. */
"monarch.aiConversationList.delete" = "Delete";

/* Title of the dialog that renames a conversation. */
"monarch.aiConversationList.renameTitle" = "Rename conversation";

/* Name of the field in the rename dialog. */
"monarch.aiConversationList.renameField" = "Conversation title";

/* Button that saves the new title. */
"monarch.aiConversationList.save" = "Save";

/* Button that closes a dialog without changing anything. */
"monarch.aiConversationList.cancel" = "Cancel";

/* Title of the delete confirmation. %@ is the conversation's title. */
"monarch.aiConversationList.deleteTitle" = "Delete “%@”?";

/* Message of the delete confirmation. */
"monarch.aiConversationList.deleteMessage" = "The conversation and its messages will be deleted. This can’t be undone.";

/* Destructive button of the delete confirmation. */
"monarch.aiConversationList.deleteConfirm" = "Delete conversation";

/* Button that shows one more conversation of a long history. */
"monarch.aiConversationList.showMore.one" = "Show 1 more conversation";

/* Button that shows more conversations of a long history. %d is how many it adds. */
"monarch.aiConversationList.showMore.other" = "Show %d more conversations";
