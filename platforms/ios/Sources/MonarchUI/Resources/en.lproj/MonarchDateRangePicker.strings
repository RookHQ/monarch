/* The label of the first date of a date range. */
"monarch.dateRangePicker.start" = "Start";

/* The label of the last date of a date range. */
"monarch.dateRangePicker.end" = "End";

/* The button shown when no date range is chosen yet. */
"monarch.dateRangePicker.chooseDates" = "Choose dates";

/* The button that clears a date range. */
"monarch.dateRangePicker.clear" = "Clear dates";

/* The button that opens quick picks such as "Last 7 days". */
"monarch.dateRangePicker.presets" = "Quick picks";

/* The error shown when the first or last day of a range is a day that cannot be chosen. */
"monarch.dateRangePicker.unavailable" = "That date is not available.";

/* The length of a date range of one day. */
"monarch.dateRangePicker.dayCountOne" = "1 day";

/* The length of a date range. %@ is the number of days, already formatted. */
"monarch.dateRangePicker.dayCountOther" = "%@ days";

/* The button that closes the sheet that chooses the days. */
"monarch.dateRangePicker.done" = "Done";
