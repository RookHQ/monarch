/* The spoken name of a citation marker. %1$d is the source number, %2$@ the source title, as in "Source 1: Quarterly report". */
"monarch.aiCitation.marker" = "Source %1$d: %2$@";

/* The heading of the card that a citation marker opens. %d is the source number. */
"monarch.aiCitation.card" = "Source %d";

/* The button in the card that opens the source inside the app. */
"monarch.aiCitation.open" = "Open source";

/* The link in the card that opens the source's web address. */
"monarch.aiCitation.visit" = "Visit page";

/* The kind of a source that is a web page. */
"monarch.aiCitation.kind.web" = "Web page";

/* The kind of a source that is a document. */
"monarch.aiCitation.kind.doc" = "Document";

/* The kind of a source that is a record in a product. */
"monarch.aiCitation.kind.record" = "Record";

/* The kind of a source that is a file. */
"monarch.aiCitation.kind.file" = "File";
