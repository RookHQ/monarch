/* The heading of the list of changes between two versions of a timesheet. */
"monarch.timesheetDiff.title" = "What changed";

/* The kind of a time entry that is new in this version. */
"monarch.timesheetDiff.added" = "Added";

/* The kind of a time entry that is no longer in this version. */
"monarch.timesheetDiff.removed" = "Removed";

/* The kind of a time entry whose values changed. %@ is a list of fields such as "time, project". */
"monarch.timesheetDiff.changed" = "Changed %@";

/* Separates the field names in the list of changed fields. */
"monarch.timesheetDiff.fieldSeparator" = ", ";

/* The name of the date field of a time entry, in "Changed date". */
"monarch.timesheetDiff.field.date" = "date";

/* The name of the duration field of a time entry, in "Changed time". */
"monarch.timesheetDiff.field.minutes" = "time";

/* The name of the project field of a time entry, in "Changed project". */
"monarch.timesheetDiff.field.project" = "project";

/* The name of the activity field of a time entry, in "Changed activity". */
"monarch.timesheetDiff.field.activity" = "activity";

/* The name of the task field of a time entry, in "Changed task". */
"monarch.timesheetDiff.field.task" = "task";

/* The name of the billable flag of a time entry, in "Changed billable". */
"monarch.timesheetDiff.field.billable" = "billable";

/* The name of the note of a time entry, in "Changed note". */
"monarch.timesheetDiff.field.note" = "note";

/* The name of the start time of a time entry, in "Changed start". */
"monarch.timesheetDiff.field.start" = "start";

/* The name of the end time of a time entry, in "Changed end". */
"monarch.timesheetDiff.field.end" = "end";

/* Read by VoiceOver before the old values of a changed time entry. */
"monarch.timesheetDiff.before" = "Before";

/* Read by VoiceOver before the new values of a changed time entry. */
"monarch.timesheetDiff.after" = "After";

/* Shown for a time entry without a project. */
"monarch.timesheetDiff.noProject" = "No project";

/* Shown for a time entry that is not billable. */
"monarch.timesheetDiff.nonBillable" = "non-billable";

/* Shown when two versions of a timesheet are the same. */
"monarch.timesheetDiff.noChanges" = "No changes.";

/* The total change of time. %@ is a signed duration such as "+1h 30m". */
"monarch.timesheetDiff.total" = "Total %@";

/* The total and billable change of time. Both %@ are signed durations such as "+1h 30m". */
"monarch.timesheetDiff.totalBillable" = "Total %1$@ · billable %2$@";

/* Read by VoiceOver for time gained. %@ is a duration in words such as "1 hour, 30 minutes". */
"monarch.timesheetDiff.increase" = "plus %@";

/* Read by VoiceOver for time lost. %@ is a duration in words such as "45 minutes". */
"monarch.timesheetDiff.decrease" = "minus %@";

/* Read by VoiceOver when the time did not change. */
"monarch.timesheetDiff.unchanged" = "no change in time";
