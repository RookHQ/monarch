/* The visible line that says who is sharing a screen. %@ is the name of the person. */
"monarch.screenShareView.presenting" = "%@ is presenting";

/* The visible line when the person using the app is the one sharing. */
"monarch.screenShareView.youArePresenting" = "You are presenting";

/* The spoken name of the shared screen. %@ is the name of the person sharing. */
"monarch.screenShareView.region" = "Screen shared by %@";

/* The spoken name of the group of zoom and window controls. */
"monarch.screenShareView.controls" = "Shared screen controls";

/* Shown while the shared screen has not arrived yet. */
"monarch.screenShareView.waiting" = "Waiting for the shared screen…";

/* Shown instead of the picture to the person who is sharing. */
"monarch.screenShareView.localPreviewHidden" = "Your screen is being shared. The preview is hidden to avoid a mirror effect.";

/* The title of the button that shows the sharer their own picture. */
"monarch.screenShareView.showPreview" = "Show preview";

/* The title of the button that fits the whole shared screen in the view. */
"monarch.screenShareView.fit" = "Fit to view";

/* The spoken name of the button that zooms in. */
"monarch.screenShareView.zoomIn" = "Zoom in";

/* The spoken name of the button that zooms out. */
"monarch.screenShareView.zoomOut" = "Zoom out";

/* The spoken name of the button that starts picture in picture. */
"monarch.screenShareView.pictureInPicture" = "Picture in picture";

/* The spoken name of the button that ends picture in picture. */
"monarch.screenShareView.exitPictureInPicture" = "Exit picture in picture";

/* The spoken name of the button that shows the shared screen full screen. */
"monarch.screenShareView.fullScreen" = "Full screen";

/* The spoken name of the button that leaves full screen. */
"monarch.screenShareView.exitFullScreen" = "Exit full screen";

/* The title of the button that stops sharing the screen. */
"monarch.screenShareView.stopSharing" = "Stop sharing";
