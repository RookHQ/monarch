/* Spoken name of the model button and title of the list of models. */
"monarch.aiModelPicker.label" = "Model";

/* Text of the model button when no model is selected. */
"monarch.aiModelPicker.placeholder" = "Choose a model";

/* Badge of a model that runs on the workspace's own configured provider key. */
"monarch.aiModelPicker.ownKey" = "Your key";

/* Badge of a model that needs a provider key that is not set up. */
"monarch.aiModelPicker.keyNeeded" = "Key needed";

/* Spoken hint of a model whose key is missing, when choosing it leads to adding the key. */
"monarch.aiModelPicker.addKeyHint" = "Select to add an API key.";

/* Spoken on a model that cannot be chosen. */
"monarch.aiModelPicker.unavailable" = "Unavailable";

/* Button that closes the list of models. */
"monarch.aiModelPicker.done" = "Done";

/* Separates the parts of a model's details line, such as "200K context · Fast". */
"monarch.aiModelPicker.separator" = " · ";

/* Capability badge: the model reads images. */
"monarch.aiModelPicker.capability.vision" = "Vision";

/* Capability badge: the model calls tools. */
"monarch.aiModelPicker.capability.tools" = "Tools";

/* Capability badge: the model reasons before answering. */
"monarch.aiModelPicker.capability.reasoning" = "Reasoning";

/* Capability badge: the model searches the web. */
"monarch.aiModelPicker.capability.web" = "Web";

/* Relative speed of a model: quick. */
"monarch.aiModelPicker.speed.fast" = "Fast";

/* Relative speed of a model: in between. */
"monarch.aiModelPicker.speed.balanced" = "Balanced";

/* Relative speed of a model: takes longer. */
"monarch.aiModelPicker.speed.slow" = "Slower";

/* Spoken cost of the cheapest tier, shown as $. */
"monarch.aiModelPicker.cost.1" = "Cost: low";

/* Spoken cost of the middle tier, shown as $$. */
"monarch.aiModelPicker.cost.2" = "Cost: medium";

/* Spoken cost of the most expensive tier, shown as $$$. */
"monarch.aiModelPicker.cost.3" = "Cost: high";

/* Size of a model's context window. %@ is a compact number such as "200K". */
"monarch.aiModelPicker.context" = "%@ context";
