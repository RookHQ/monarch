/* Read before the title of a banner about a change an AI made. */
"monarch.aiUndoBanner.aiPrefix" = "AI change:";

/* Button that reverts a change an AI made. */
"monarch.aiUndoBanner.undo" = "Undo";

/* Link to the audit log entry of a change an AI made. */
"monarch.aiUndoBanner.audit" = "View in audit log";

/* Spoken name of the button that closes the banner about an AI change. */
"monarch.aiUndoBanner.dismiss" = "Dismiss";

/* Title of the disclosure that lists the fields an AI changed. %d is how many. */
"monarch.aiUndoBanner.showChanges" = "Show %d changes";

/* What VoiceOver reads for one field an AI changed. %1$@ is the field, %2$@ the old value, %3$@ the new value. */
"monarch.aiUndoBanner.change" = "%1$@ changed from %2$@ to %3$@";

/* Shown and announced after a change an AI made was reverted. */
"monarch.aiUndoBanner.undone" = "Changes undone";

/* Shown and announced when reverting a change an AI made failed. */
"monarch.aiUndoBanner.undoFailed" = "Couldn’t undo. Try again.";

/* Shown and announced when the time to undo a change an AI made has run out. */
"monarch.aiUndoBanner.expired" = "Undo is no longer available.";
