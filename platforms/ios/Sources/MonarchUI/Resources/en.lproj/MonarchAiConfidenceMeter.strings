/* The label of low AI confidence. It tells people to verify the value. */
"monarch.aiConfidenceMeter.low" = "Needs check";

/* The label of medium AI confidence. */
"monarch.aiConfidenceMeter.medium" = "Medium confidence";

/* The label of high AI confidence. */
"monarch.aiConfidenceMeter.high" = "High confidence";

/* The spoken name of the confidence bar. */
"monarch.aiConfidenceMeter.name" = "Confidence";

/* The spoken value of a confidence meter. The first %@ is the band label, the second the percentage. */
"monarch.aiConfidenceMeter.valueText" = "%1$@, %2$@ confidence";
