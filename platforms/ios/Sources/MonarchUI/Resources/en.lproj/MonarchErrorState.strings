/* The title of the button that tries again to load a region that failed. */
"monarch.errorState.retry" = "Try again";

/* Spoken as the value of the retry button while a retry is in progress. */
"monarch.errorState.retrying" = "Retrying";

/* The text before the id of the failed request, which the person can quote to support. */
"monarch.errorState.requestID" = "Request ID";
