/* Heading over the countries a calling-code picker suggests first, such as the person's own country. */
"monarch.phoneCountrySelect.suggested" = "Suggested";

/* Heading over every other country in a calling-code picker that has suggestions. */
"monarch.phoneCountrySelect.all" = "All countries";

/* Shown in a calling-code picker when no country matches the search. */
"monarch.phoneCountrySelect.empty" = "No matching country";

/* A row of a calling-code picker. %1$@ is the country name, %2$@ the calling code, such as +351. */
"monarch.phoneCountrySelect.option" = "%1$@ (%2$@)";
