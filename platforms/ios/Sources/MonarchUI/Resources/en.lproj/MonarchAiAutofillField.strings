/* Badge of a form field that AI filled and nobody has checked yet. */
"monarch.aiAutofillField.badge.suggested" = "AI suggested";

/* Badge of a form field whose AI value the person accepted. */
"monarch.aiAutofillField.badge.accepted" = "AI filled";

/* Badge of a form field whose AI value the person changed. */
"monarch.aiAutofillField.badge.edited" = "Edited by you";

/* Badge of a form field whose AI value the person cleared. Not shown; kept for completeness. */
"monarch.aiAutofillField.badge.cleared" = "Cleared";

/* Button that accepts the value AI put in a field. */
"monarch.aiAutofillField.accept" = "Accept";

/* Button that removes the value AI put in a field. */
"monarch.aiAutofillField.clear" = "Clear";

/* Spoken name of the accept button. %@ is the field's name, such as "Company". */
"monarch.aiAutofillField.acceptField" = "Accept suggested %@";

/* Spoken name of the clear button. %@ is the field's name, such as "Company". */
"monarch.aiAutofillField.clearField" = "Clear suggested %@";

/* Where the AI value came from. %@ is the source, such as a document name. */
"monarch.aiAutofillField.source" = "From %@";

/* Shown once the person edited the field. %@ is the value AI suggested. */
"monarch.aiAutofillField.original" = "AI suggested: %@";

/* Announced after the person accepts the value AI suggested. */
"monarch.aiAutofillField.accepted" = "Suggestion accepted";

/* Announced after the person clears the value AI suggested. */
"monarch.aiAutofillField.cleared" = "Suggestion cleared";
