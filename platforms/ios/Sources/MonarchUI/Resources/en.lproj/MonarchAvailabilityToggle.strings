/* The spoken name of the switch that makes a person available for automatic assignment. */
"monarch.availabilityToggle.label" = "Available for new work";

/* The status word shown when the switch is on. */
"monarch.availabilityToggle.available" = "Available";

/* The status word shown when the switch is off. */
"monarch.availabilityToggle.away" = "Away";

/* The explanation shown when the switch is on. */
"monarch.availabilityToggle.availableHint" = "Automatic assignment can give you new work.";

/* The explanation shown when the switch is off. */
"monarch.availabilityToggle.awayHint" = "Automatic assignment skips you. You can still work on what you have.";

/* Spoken at the start of the hint while a change to the switch is being saved. */
"monarch.availabilityToggle.pending" = "Saving";
