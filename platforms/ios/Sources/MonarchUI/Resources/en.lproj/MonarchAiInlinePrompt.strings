/* The title of the sheet that asks AI about the selected text, and the text-menu item that opens it. */
"monarch.aiInlinePrompt.label" = "Ask AI";

/* The placeholder of the prompt field in the Ask AI sheet. */
"monarch.aiInlinePrompt.placeholder" = "Ask AI to edit or write…";

/* The spoken name of the prompt field in the Ask AI sheet. */
"monarch.aiInlinePrompt.inputLabel" = "Prompt";

/* The button that sends the prompt in the Ask AI sheet. */
"monarch.aiInlinePrompt.submit" = "Send";

/* The label above the excerpt of the selected text in the Ask AI sheet. */
"monarch.aiInlinePrompt.context" = "Selection";

/* The spoken name of the group of quick prompts in the Ask AI sheet. */
"monarch.aiInlinePrompt.suggestions" = "Suggestions";

/* Shown and announced while the prompt is being sent. */
"monarch.aiInlinePrompt.pending" = "Sending…";

/* The button that closes the Ask AI sheet without sending. */
"monarch.aiInlinePrompt.cancel" = "Cancel";

/* The keyboard hint under the field of the inline card. */
"monarch.aiInlinePrompt.keyboardHint" = "Enter to send · Shift+Enter for a new line · Esc to close";
