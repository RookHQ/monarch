/* The spoken name of the button that switches Space, and the title of its sheet. A Space is a department-like part of a workspace. */
"monarch.spaceSwitcher.label" = "Space";

/* The choice that shows every Space of the workspace. */
"monarch.spaceSwitcher.all" = "All spaces";

/* The button text when no Space is chosen yet. */
"monarch.spaceSwitcher.placeholder" = "Choose a Space";

/* The prompt of the search field in the Space list. */
"monarch.spaceSwitcher.search" = "Search spaces...";

/* Shown when no Space matches the search. */
"monarch.spaceSwitcher.empty" = "No spaces match.";

/* Shown while the Spaces load. */
"monarch.spaceSwitcher.loading" = "Loading spaces";

/* The action that creates a new Space. */
"monarch.spaceSwitcher.create" = "New Space";

/* The link that opens the page where Spaces are managed. */
"monarch.spaceSwitcher.manage" = "Manage Spaces";

/* The button that closes the Space list without choosing. */
"monarch.spaceSwitcher.cancel" = "Cancel";
