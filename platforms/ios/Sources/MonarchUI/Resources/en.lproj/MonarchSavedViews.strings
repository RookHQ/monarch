/* The spoken name of the menu button that switches between saved views of a list. */
"monarch.savedViews.view" = "View";

/* The menu button's text when no saved view is selected. */
"monarch.savedViews.noView" = "All items";

/* Marker next to the view's name when the filters or sort differ from the saved view. */
"monarch.savedViews.modified" = "Edited";

/* Marker of a saved view that other people can see. */
"monarch.savedViews.shared" = "Shared";

/* Marker of the saved view that opens by default. */
"monarch.savedViews.isDefault" = "Default view";

/* The heading above saved views that have no group. */
"monarch.savedViews.views" = "Views";

/* Menu item that saves the current filters into the selected view. %@ is the view's name. */
"monarch.savedViews.saveChanges" = "Save changes to “%@”";

/* Menu item that saves the current filters as a new view. */
"monarch.savedViews.saveAsNew" = "Save as new view…";

/* Menu item that throws away the changes and reapplies the selected view. */
"monarch.savedViews.discardChanges" = "Discard changes";

/* Menu item that renames the selected view. */
"monarch.savedViews.rename" = "Rename…";

/* Menu item that makes the selected view open by default. */
"monarch.savedViews.setDefault" = "Set as default";

/* Menu item that deletes the selected view. */
"monarch.savedViews.delete" = "Delete view…";

/* The title of the alert that names a new view. */
"monarch.savedViews.saveTitle" = "Save view";

/* The title of the alert that renames a view. */
"monarch.savedViews.renameTitle" = "Rename view";

/* The placeholder of the field for a view's name. */
"monarch.savedViews.name" = "Name";

/* The button that saves the name. */
"monarch.savedViews.save" = "Save";

/* The button that closes an alert without changing anything. */
"monarch.savedViews.cancel" = "Cancel";

/* Shown when the name of a view is empty. */
"monarch.savedViews.nameRequired" = "Enter a name.";

/* Shown when another view already has the name. */
"monarch.savedViews.nameTaken" = "A view with this name already exists.";

/* The title of the alert that deletes a view. %@ is the view's name. */
"monarch.savedViews.deleteTitle" = "Delete “%@”?";

/* The message of the alert that deletes a view. */
"monarch.savedViews.deleteMessage" = "The view is removed for everyone who can see it. Items are not affected.";

/* The destructive button of the alert that deletes a view. */
"monarch.savedViews.deleteConfirm" = "Delete view";
