/* Spoken as the hint of text that can be edited in place. */
"monarch.inlineEditText.edit" = "Edit";
/* Title of the button that saves the edited text. */
"monarch.inlineEditText.save" = "Save";
/* Title of the button that leaves the editor without saving. */
"monarch.inlineEditText.cancel" = "Cancel";
/* Spoken as the value of the save button while the save is in progress. */
"monarch.inlineEditText.saving" = "Saving";
/* Shown when saving failed and the error has no message of its own. */
"monarch.inlineEditText.saveFailed" = "Couldn’t save. Try again.";
/* Spoken as the hint of the field while it has an error. %@ is the error message. */
"monarch.inlineEditText.error" = "Error: %@";
