/* The spoken name of the JSON tree. */
"monarch.jsonViewer.label" = "JSON";

/* The spoken name of the search field of the JSON viewer. */
"monarch.jsonViewer.search" = "Search keys and values";

/* The placeholder of the search field of the JSON viewer. */
"monarch.jsonViewer.searchPrompt" = "Search";

/* The spoken name of the button that clears the search field of the JSON viewer. */
"monarch.jsonViewer.clearSearch" = "Clear search";

/* Shown when a search of the JSON viewer finds nothing. */
"monarch.jsonViewer.noMatches" = "No matches";

/* The number of matches of a search. %@ is the formatted count. */
"monarch.jsonViewer.oneMatch" = "%@ match";

/* The number of matches of a search. %@ is the formatted count, with "+" when the search stopped early. */
"monarch.jsonViewer.matches" = "%@ matches";

/* The button that closes every node back to the top level. */
"monarch.jsonViewer.collapseAll" = "Collapse all";

/* The button that copies the path of the selected node, such as $.users[0].name. */
"monarch.jsonViewer.copyPath" = "Copy path";

/* The button that copies the value of the selected node. */
"monarch.jsonViewer.copyValue" = "Copy value";

/* Spoken before the path of the selected node. */
"monarch.jsonViewer.selectedPath" = "Selected";

/* Summary of a collapsed object with one key. */
"monarch.jsonViewer.oneKey" = "1 key";

/* Summary of a collapsed object. %@ is the formatted number of keys. */
"monarch.jsonViewer.keys" = "%@ keys";

/* Summary of a collapsed array with one item. */
"monarch.jsonViewer.oneItem" = "1 item";

/* Summary of a collapsed array. %@ is the formatted number of items. */
"monarch.jsonViewer.items" = "%@ items";

/* The row that shows more children of a large object or array. The first %@ is how many it adds, the second how many are hidden. */
"monarch.jsonViewer.showMore" = "Show %1$@ more (%2$@ hidden)";

/* Added after a string cut in the JSON viewer. %@ is the formatted full length in characters. */
"monarch.jsonViewer.truncated" = "… (%@ characters)";

/* The spoken state of an open object or array. */
"monarch.jsonViewer.expanded" = "expanded";

/* The spoken state of a closed object or array. */
"monarch.jsonViewer.collapsed" = "collapsed";
