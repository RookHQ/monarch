/* Heading and spoken name of the trace of one AI agent run. */
"monarch.aiAgentRunTimeline.label" = "Agent run";

/* Spoken name of the switch between the timeline and the table. */
"monarch.aiAgentRunTimeline.modeLabel" = "View";

/* The view with bars on a time axis. */
"monarch.aiAgentRunTimeline.mode.timeline" = "Timeline";

/* The view with rows and columns. */
"monarch.aiAgentRunTimeline.mode.table" = "Table";

/* Kind of an event: a call to a model. */
"monarch.aiAgentRunTimeline.kind.model" = "Model";

/* Kind of an event: a call to a tool. */
"monarch.aiAgentRunTimeline.kind.tool" = "Tool";

/* Kind of an event: one agent hands the work to another. */
"monarch.aiAgentRunTimeline.kind.handoff" = "Hand-off";

/* Kind of an event: an error. */
"monarch.aiAgentRunTimeline.kind.error" = "Error";

/* Spoken name of the list of events. */
"monarch.aiAgentRunTimeline.events" = "Run events";

/* Name of the total time of the run. */
"monarch.aiAgentRunTimeline.totalDuration" = "Total time";

/* Name of the number of input tokens. */
"monarch.aiAgentRunTimeline.inputTokens" = "Input tokens";

/* Name of the number of output tokens. */
"monarch.aiAgentRunTimeline.outputTokens" = "Output tokens";

/* Name of the cost. */
"monarch.aiAgentRunTimeline.cost" = "Cost";

/* Name of the time an event started, from the start of the run. */
"monarch.aiAgentRunTimeline.start" = "Start";

/* Name of the time an event took. */
"monarch.aiAgentRunTimeline.duration" = "Duration";

/* Table column with the name of each event. */
"monarch.aiAgentRunTimeline.eventColumn" = "Event";

/* Table column with the kind of each event. */
"monarch.aiAgentRunTimeline.kindColumn" = "Kind";

/* Shown instead of a duration while an event has not ended. */
"monarch.aiAgentRunTimeline.running" = "Running";

/* Shown when the run has no events yet. */
"monarch.aiAgentRunTimeline.empty" = "No events yet";

/* Shown for a value that is not known. */
"monarch.aiAgentRunTimeline.notAvailable" = "–";

/* Button in an open event that shows the part of the conversation it produced. */
"monarch.aiAgentRunTimeline.openPart" = "Show in conversation";

/* A duration under one second. %@ is the number of milliseconds. */
"monarch.aiAgentRunTimeline.milliseconds" = "%@ ms";

/* A duration under one minute. %@ is the number of seconds. */
"monarch.aiAgentRunTimeline.seconds" = "%@ s";

/* A duration in whole minutes. %@ is the number of minutes. */
"monarch.aiAgentRunTimeline.minutes" = "%@ min";

/* A duration in minutes and seconds. %1$@ is the minutes, %2$@ the seconds. */
"monarch.aiAgentRunTimeline.minutesSeconds" = "%1$@ min %2$@ s";

/* The time an event started after the start of the run. %@ is a duration, such as "1.2 s". */
"monarch.aiAgentRunTimeline.offset" = "+%@";

/* A name and its value read together, such as "Total time, 4.2 s". %1$@ is the name, %2$@ the value. */
"monarch.aiAgentRunTimeline.fact" = "%1$@, %2$@";
