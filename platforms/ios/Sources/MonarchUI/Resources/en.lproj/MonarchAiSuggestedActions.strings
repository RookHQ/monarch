/* Heading of the list of suggested next steps. */
"monarch.aiSuggestedActions.title" = "Suggested actions";

/* Origin of suggestions an AI model made. */
"monarch.aiSuggestedActions.origin.ai" = "Suggested by AI";

/* Origin of suggestions that product rules made. */
"monarch.aiSuggestedActions.origin.rule" = "Rule-based";

/* Button that runs a suggested action. */
"monarch.aiSuggestedActions.run" = "Run";

/* Read by VoiceOver for the run button. %@ is the action. */
"monarch.aiSuggestedActions.runAction" = "Run “%@”";

/* The run button while the action runs. */
"monarch.aiSuggestedActions.running" = "Running…";

/* Shown in place of the run button after the action ran. */
"monarch.aiSuggestedActions.done" = "Done";

/* Shown under an action whose run failed. */
"monarch.aiSuggestedActions.failed" = "That didn’t work. Try again.";

/* Read by VoiceOver for the dismiss button. %@ is the action. */
"monarch.aiSuggestedActions.dismiss" = "Dismiss “%@”";

/* Tag of an action that is confirmed before it runs. */
"monarch.aiSuggestedActions.needsApproval" = "Needs approval";

/* Tag of an action of medium risk. */
"monarch.aiSuggestedActions.risk.medium" = "Medium risk";

/* Tag of an action of high risk. */
"monarch.aiSuggestedActions.risk.high" = "High risk";

/* Tag of an action that cannot be undone. */
"monarch.aiSuggestedActions.risk.destructive" = "Destructive";

/* Title of the approval dialog. %@ is the action. */
"monarch.aiSuggestedActions.approvalTitle" = "Run “%@”?";

/* Text of the approval dialog when the action has no description. */
"monarch.aiSuggestedActions.approvalDescription" = "Check what this action will do before it runs.";

/* Confirm button of the approval dialog. */
"monarch.aiSuggestedActions.approve" = "Run action";

/* Cancel button of the approval dialog. */
"monarch.aiSuggestedActions.cancel" = "Cancel";

/* Announced when an action finished. %@ is the action. */
"monarch.aiSuggestedActions.doneAnnouncement" = "“%@” done.";

/* Shown when there are no suggestions. */
"monarch.aiSuggestedActions.empty" = "No suggestions right now.";
