/* Shown as the title of a conversation with an AI assistant that has no title yet. */
"monarch.aiConversationHeader.untitled" = "New conversation";

/* The menu item that renames a conversation, and the title of the rename prompt. */
"monarch.aiConversationHeader.rename" = "Rename conversation";

/* The placeholder and spoken name of the field that holds the conversation title. */
"monarch.aiConversationHeader.titleLabel" = "Conversation title";

/* The button that saves a new conversation title. */
"monarch.aiConversationHeader.save" = "Save";

/* The button that closes the rename prompt without saving. */
"monarch.aiConversationHeader.cancel" = "Cancel";

/* Shown in place of the title while the AI generates one. */
"monarch.aiConversationHeader.naming" = "Naming conversation…";

/* Read before the name of the AI assistant answering in the conversation. */
"monarch.aiConversationHeader.agentPrefix" = "AI assistant";

/* Read before the name of the AI model in use. */
"monarch.aiConversationHeader.modelPrefix" = "Model";

/* Shown in the rename prompt and announced when the new title could not be saved. */
"monarch.aiConversationHeader.renameFailed" = "Couldn’t rename. Try again.";

/* The VoiceOver hint of the conversation title when it opens a menu of actions. */
"monarch.aiConversationHeader.menuHint" = "Shows conversation actions";
