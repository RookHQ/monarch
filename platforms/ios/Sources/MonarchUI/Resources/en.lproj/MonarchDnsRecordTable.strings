/* The heading of the record type in a DNS record card and table. */
"monarch.dnsRecordTable.type" = "Type";

/* The heading of the record name in a DNS record card and table. */
"monarch.dnsRecordTable.name" = "Name";

/* The heading of the record value in a DNS record card and table. */
"monarch.dnsRecordTable.value" = "Value";

/* The heading of the record TTL (time to live) in a DNS record card and table. */
"monarch.dnsRecordTable.ttl" = "TTL";

/* The heading of the MX or SRV priority in a DNS record card and table. */
"monarch.dnsRecordTable.priority" = "Priority";

/* The heading of the column that says whether public DNS shows a record. */
"monarch.dnsRecordTable.status" = "Status";

/* The status of a DNS record that public DNS already shows. */
"monarch.dnsRecordTable.found" = "Found";

/* The status of a DNS record that public DNS does not show yet. */
"monarch.dnsRecordTable.waiting" = "Waiting";

/* The heading of a record that points the user's domain at the product. */
"monarch.dnsRecordTable.purposeRouting" = "Points your address here";

/* The heading of a record that proves the user owns the domain. Also used when no purpose is given. */
"monarch.dnsRecordTable.purposeVerification" = "Proves you own the domain";

/* The heading of a record that allows the HTTPS certificate to be issued. */
"monarch.dnsRecordTable.purposeCertificate" = "Allows the HTTPS certificate";

/* The spoken name of the record name and its copy button ("Copy name of the CNAME record"). %@ is the record type. */
"monarch.dnsRecordTable.copyName" = "name of the %@ record";

/* The spoken name of the record value and its copy button. The first %@ is the record type, the second the name as shown. */
"monarch.dnsRecordTable.copyValue" = "value of the %1$@ record %2$@";

/* Shown under a card whose name is shown relative to the zone. %@ is the full record name. */
"monarch.dnsRecordTable.fullName" = "Full name: %@";

/* The spoken name of the list of records. %@ is the DNS zone, such as example.com. */
"monarch.dnsRecordTable.labelZone" = "DNS records for %@";

/* The spoken name of the list of records when there is no zone. */
"monarch.dnsRecordTable.label" = "DNS records";

/* Announced when the number of records that public DNS shows changes. The first number is how many are found, the second how many were checked. */
"monarch.dnsRecordTable.summary" = "%1$ld of %2$ld records found.";
