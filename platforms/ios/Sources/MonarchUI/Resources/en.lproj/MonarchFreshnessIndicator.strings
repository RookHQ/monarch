/* The age of a data set. %@ is a relative time such as "3 minutes ago". */
"monarch.freshnessIndicator.updated" = "Updated %@";

/* Shown when a data set has never been updated. */
"monarch.freshnessIndicator.never" = "Never updated";

/* Shown while the freshness of a data set is being read. */
"monarch.freshnessIndicator.checking" = "Checking…";

/* Shown after the update time when the data is older than its stale limit. */
"monarch.freshnessIndicator.stale" = "Out of date";

/* Shown after the update time when the data is older than its expired limit. */
"monarch.freshnessIndicator.expired" = "Very out of date";

/* Shown when the freshness could not be read and the app gave no reason. */
"monarch.freshnessIndicator.error" = "Status unavailable";

/* The title of the button that refreshes a data set. */
"monarch.freshnessIndicator.refresh" = "Refresh";

/* The title of the refresh button while the refresh runs. */
"monarch.freshnessIndicator.refreshing" = "Refreshing…";

/* Announced when a refresh finishes. */
"monarch.freshnessIndicator.refreshed" = "Refreshed.";

/* Announced when a refresh fails. */
"monarch.freshnessIndicator.refreshFailed" = "Refresh failed.";
