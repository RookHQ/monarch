/* The label of the field that chooses the microphone of a call. */
"monarch.devicePicker.microphone" = "Microphone";
/* The label of the field that chooses the camera of a call. */
"monarch.devicePicker.camera" = "Camera";
/* The label of the row that chooses where call audio plays. */
"monarch.devicePicker.speaker" = "Speaker";
/* The option that lets the system choose the device. */
"monarch.devicePicker.systemDefault" = "System default";
/* A microphone that has no name. %@ is its position in the list. */
"monarch.devicePicker.unnamedMicrophone" = "Microphone %@";
/* A camera that has no name. %@ is its position in the list. */
"monarch.devicePicker.unnamedCamera" = "Camera %@";
/* A notice shown before the app has asked for camera and microphone access. */
"monarch.devicePicker.notDetermined" = "Allow camera and microphone access to see device names.";
/* The button that asks for camera and microphone access. */
"monarch.devicePicker.allowAccess" = "Allow access";
/* A notice shown when camera or microphone access is refused. */
"monarch.devicePicker.denied" = "Camera or microphone access is off. Turn it on in Settings, then try again.";
/* The button that opens the app's page in Settings. */
"monarch.devicePicker.openSettings" = "Open Settings";
/* A notice shown when there is no camera or microphone to choose. */
"monarch.devicePicker.unavailable" = "No camera or microphone was found.";
