/* The spoken name of the list of a document's relations to other documents. */
"monarch.documentRelations.label" = "Relations";

/* The button that adds a relation to another document. */
"monarch.documentRelations.add" = "Add relation";

/* The title of the sheet that adds a relation. */
"monarch.documentRelations.sheetTitle" = "Add a relation";

/* The explanation under the relation type picker in the add sheet. */
"monarch.documentRelations.sheetDescription" = "Choose how this document connects to another one.";

/* The picker of the kind of relation, such as Parent of. */
"monarch.documentRelations.type" = "Relation";

/* The prompt of the search field that finds a document to link. */
"monarch.documentRelations.search" = "Search documents…";

/* The heading of the documents that match the search. */
"monarch.documentRelations.results" = "Matching documents";

/* Shown when no document matches the search. */
"monarch.documentRelations.noResults" = "No matching documents.";

/* Closes the add sheet without adding a relation. */
"monarch.documentRelations.cancel" = "Cancel";

/* Shown when adding or removing a relation failed. */
"monarch.documentRelations.failed" = "That didn’t work. Try again.";

/* Shown when a document has no relations. */
"monarch.documentRelations.none" = "No relations yet.";

/* A relation type: this document is related to the other one. */
"monarch.documentRelations.relatedTo" = "Related to";

/* A relation type: this document is the parent of the other one. */
"monarch.documentRelations.parentOf" = "Parent of";

/* A relation type: this document is a child of the other one. */
"monarch.documentRelations.childOf" = "Child of";

/* A relation type: this document replaces the other one. */
"monarch.documentRelations.supersedes" = "Supersedes";

/* A relation type: this document is replaced by the other one. */
"monarch.documentRelations.supersededBy" = "Superseded by";

/* A relation type: this document implements the other one, such as a specification. */
"monarch.documentRelations.implements" = "Implements";

/* A relation type: this document is specified by the other one. */
"monarch.documentRelations.specifiedBy" = "Specified by";

/* The button that removes a relation. %@ is the other document's title. */
"monarch.documentRelations.remove" = "Remove relation to %@";

/* Announced after a relation is added. %@ is the other document's title. */
"monarch.documentRelations.added" = "Relation to %@ added";

/* Announced after a relation is removed. %@ is the other document's title. */
"monarch.documentRelations.removed" = "Relation to %@ removed";
