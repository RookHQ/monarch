/* The default heading of the consent history. */
"monarch.consentHistory.title" = "Consent history";

/* The default title of the button that downloads the consent history. */
"monarch.consentHistory.export" = "Download history";

/* A consent decision that allowed every optional category. */
"monarch.consentHistory.method.acceptAll" = "Accepted all";

/* A consent decision that refused every optional category. */
"monarch.consentHistory.method.rejectAll" = "Rejected all";

/* A consent decision made category by category. */
"monarch.consentHistory.method.custom" = "Custom choice";

/* A consent decision made by the browser's Global Privacy Control signal. */
"monarch.consentHistory.method.globalPrivacyControl" = "Browser privacy signal";

/* A notice that was acknowledged where no choice is required. */
"monarch.consentHistory.method.acknowledged" = "Acknowledged";

/* A consent that was withdrawn. */
"monarch.consentHistory.method.withdrawn" = "Withdrew consent";

/* The opt-in regime: consent asked before optional storage is used. */
"monarch.consentHistory.regime.optIn" = "Asked before use (opt-in)";

/* The opt-out regime: optional storage runs until the person refuses. */
"monarch.consentHistory.regime.optOut" = "Could refuse (opt-out)";

/* The notice regime: only a notice is required. */
"monarch.consentHistory.regime.notice" = "Notice only";

/* The name of the line that says how a decision was made. */
"monarch.consentHistory.methodTitle" = "Choice";

/* The name of the line with the policy version the person saw. */
"monarch.consentHistory.policyVersionTitle" = "Policy version";

/* The name of the line with the rules that applied. */
"monarch.consentHistory.regimeTitle" = "Rules applied";

/* The name of the list of categories of one decision. */
"monarch.consentHistory.categoriesTitle" = "Categories";

/* After a category that was allowed. */
"monarch.consentHistory.allowed" = "Allowed";

/* After a category that was refused. */
"monarch.consentHistory.denied" = "Not allowed";

/* Extra line when a browser privacy signal was present but the decision was made another way. */
"monarch.consentHistory.signalPresent" = "Browser privacy signal present";

/* The title shown when no consent decisions are recorded. */
"monarch.consentHistory.emptyTitle" = "No consent choices recorded";

/* The message shown when no consent decisions are recorded. */
"monarch.consentHistory.emptyMessage" = "Choices about cookies and similar storage will appear here once they are made.";

/* Shown when downloading the consent history fails. */
"monarch.consentHistory.exportFailed" = "The download did not start. Try again.";

/* The label of the date of a record. */
"monarch.consentHistory.dateTitle" = "Date";
