/* Navigation title of the list of saved AI prompts. */
"monarch.aiPromptTemplatePicker.title" = "Prompt templates";

/* Prompt of the field that searches the prompt templates. */
"monarch.aiPromptTemplatePicker.search" = "Search templates";

/* Name of the filter that picks a category of templates. */
"monarch.aiPromptTemplatePicker.category" = "Category";

/* Entry of the category filter that shows every template. */
"monarch.aiPromptTemplatePicker.allCategories" = "All";

/* Heading of the template text on the template's page. */
"monarch.aiPromptTemplatePicker.template" = "Template";

/* Heading of the filled-in prompt on the template's page. */
"monarch.aiPromptTemplatePicker.preview" = "Prompt preview";

/* Button that puts the filled-in prompt into the message field. */
"monarch.aiPromptTemplatePicker.use" = "Use template";

/* Button that closes the template picker. */
"monarch.aiPromptTemplatePicker.cancel" = "Cancel";

/* Note after the label of a field that may be left empty. */
"monarch.aiPromptTemplatePicker.optional" = "Optional";

/* Error under an empty required field. %@ is the field's label in lower case. */
"monarch.aiPromptTemplatePicker.missing" = "Enter %@.";

/* Shown when there are no templates. */
"monarch.aiPromptTemplatePicker.empty" = "No templates yet";

/* Shown when the search matches no template. %@ is the search text. */
"monarch.aiPromptTemplatePicker.noResults" = "No templates match “%@”";

/* Button under the list of templates that opens the chosen one. */
"monarch.aiPromptTemplatePicker.next" = "Continue";

/* Hint under the list of templates until one is chosen. */
"monarch.aiPromptTemplatePicker.pickFirst" = "Choose a template to continue.";
