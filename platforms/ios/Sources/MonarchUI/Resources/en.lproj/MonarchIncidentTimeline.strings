/* The spoken name of the list of updates posted during one incident. */
"monarch.incidentTimeline.list" = "Incident updates";

/* A tag on an incident update the system posted, not a person. */
"monarch.incidentTimeline.automated" = "Automated";

/* Shown when an incident has no updates yet. */
"monarch.incidentTimeline.empty" = "No updates posted yet";

/* The incident stage while the cause is not known yet. */
"monarch.incidentTimeline.investigating" = "Investigating";

/* The incident stage once the cause is known. */
"monarch.incidentTimeline.identified" = "Identified";

/* The incident stage while a fix is being watched. */
"monarch.incidentTimeline.monitoring" = "Monitoring";

/* The incident stage once the incident is over. */
"monarch.incidentTimeline.resolved" = "Resolved";
