/* The spoken name of the list of suggestions for an @mention. */
"monarch.mentionPicker.label" = "Suggestions";

/* The heading of the people in the list of mention suggestions. */
"monarch.mentionPicker.people" = "People";

/* The heading of the channels in the list of mention suggestions. */
"monarch.mentionPicker.channels" = "Channels";

/* Read while mention suggestions are being searched. */
"monarch.mentionPicker.loading" = "Searching…";

/* Shown when no person or channel matches a mention. */
"monarch.mentionPicker.empty" = "No matches";

/* Shown when mention suggestions could not be loaded. */
"monarch.mentionPicker.error" = "Couldn’t load suggestions.";

/* Announced when one mention suggestion is found. */
"monarch.mentionPicker.countOne" = "1 suggestion";

/* Announced when mention suggestions are found. %ld is their number. */
"monarch.mentionPicker.countOther" = "%ld suggestions";
