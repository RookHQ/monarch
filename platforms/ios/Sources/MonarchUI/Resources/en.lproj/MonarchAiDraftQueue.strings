/* Read by VoiceOver as the name of the queue of AI-written drafts when it has no title. */
"monarch.aiDraftQueue.label" = "Drafts to review";

/* Progress of the review. The first %d is the number reviewed, the second the number of drafts. */
"monarch.aiDraftQueue.progress" = "%1$d of %2$d reviewed";

/* Shown when there are no drafts. */
"monarch.aiDraftQueue.empty" = "No drafts to review";

/* Status of a draft that waits for a decision. */
"monarch.aiDraftQueue.status.draft" = "Needs review";

/* Status of a draft that is being written again. */
"monarch.aiDraftQueue.status.regenerating" = "Writing";

/* Status of an approved draft. */
"monarch.aiDraftQueue.status.approved" = "Approved";

/* Status of a sent draft. */
"monarch.aiDraftQueue.status.sent" = "Sent";

/* Status of a skipped draft. */
"monarch.aiDraftQueue.status.skipped" = "Skipped";

/* Shown instead of the text while a draft is being written again. */
"monarch.aiDraftQueue.writing" = "AI is still writing…";

/* Read by VoiceOver before the text of each draft. */
"monarch.aiDraftQueue.aiDraft" = "AI draft";

/* Heading of what the draft answers or is based on. */
"monarch.aiDraftQueue.context" = "Context";

/* Button that approves a draft. */
"monarch.aiDraftQueue.approve" = "Approve";

/* Button that sends an approved draft. */
"monarch.aiDraftQueue.send" = "Send";

/* Button that edits a draft. */
"monarch.aiDraftQueue.edit" = "Edit";

/* Button that asks for a new version of a draft. */
"monarch.aiDraftQueue.regenerate" = "Regenerate";

/* Button that skips a draft without sending it. */
"monarch.aiDraftQueue.skip" = "Skip";

/* Button that saves an edited draft. */
"monarch.aiDraftQueue.save" = "Save";

/* Button that closes the editor without saving. */
"monarch.aiDraftQueue.cancel" = "Cancel";

/* Read by VoiceOver as the name of the editor. %@ is the draft's title. */
"monarch.aiDraftQueue.editField" = "Edit draft: %@";

/* Announced when a draft is ready for review again. %@ is the draft's title. */
"monarch.aiDraftQueue.announceReady" = "New draft ready: %@";

/* Announced when a draft's status changes. The first %@ is the status, the second the draft's title. */
"monarch.aiDraftQueue.announce" = "%1$@: %2$@";
