/* The spoken name of the grid that holds a dashboard's widgets. */
"monarch.dashboardGrid.label" = "Dashboard";

/* The hint on a widget's arrange bar while the dashboard is being rearranged. */
"monarch.dashboardGrid.dragHint" = "Touch and hold, then drag to move.";

/* The button that moves a widget one place earlier. %@ is the widget's name. */
"monarch.dashboardGrid.moveEarlier" = "Move %@ earlier";

/* The button that moves a widget one place later. %@ is the widget's name. */
"monarch.dashboardGrid.moveLater" = "Move %@ later";

/* Announced after a widget is moved with a button. %1$@ is its name, %2$lld its new position from 1, %3$lld the number of widgets. */
"monarch.dashboardGrid.moved" = "%1$@ moved to position %2$lld of %3$lld.";

/* Announced after a widget is dropped. %1$@ is its name, %2$lld its new position from 1, %3$lld the number of widgets. */
"monarch.dashboardGrid.dropped" = "%1$@ dropped at position %2$lld of %3$lld.";
