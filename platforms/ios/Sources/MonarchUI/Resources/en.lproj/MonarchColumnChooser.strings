/* The title of the panel that shows, hides and orders a table's columns. */
"monarch.columnChooser.title" = "Columns";

/* The count under the title. %1$lld is the number of columns shown, %2$lld the number of columns. */
"monarch.columnChooser.shownCount" = "%1$lld of %2$lld shown";

/* The prompt of the field that finds a column by name. */
"monarch.columnChooser.search" = "Find a column";

/* Shown when no column matches the search. */
"monarch.columnChooser.noMatches" = "No columns match.";

/* The accessibility action that moves a column one place up. %@ is the column's name. */
"monarch.columnChooser.moveUp" = "Move %@ up";

/* The accessibility action that moves a column one place down. %@ is the column's name. */
"monarch.columnChooser.moveDown" = "Move %@ down";

/* Announced after a column is moved. %1$@ is its name, %2$lld its new position from 1, %3$lld the number of columns. */
"monarch.columnChooser.moved" = "%1$@ moved to position %2$lld of %3$lld.";

/* The note under a column that cannot be hidden. */
"monarch.columnChooser.required" = "Always shown";

/* The button that shows every column. */
"monarch.columnChooser.showAll" = "Show all";

/* The button that puts the columns back to the app's default. */
"monarch.columnChooser.reset" = "Reset";

/* The name of the button that clears the column search. */
"monarch.columnChooser.clearSearch" = "Clear search";
