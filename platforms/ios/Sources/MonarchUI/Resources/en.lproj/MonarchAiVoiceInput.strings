/* Title of the dictation button that starts and stops on each press. */
"monarch.aiVoiceInput.dictate" = "Dictate";

/* Title of the dictation button that listens while held. */
"monarch.aiVoiceInput.holdToTalk" = "Hold to talk";

/* Spoken hint of the hold-to-talk button for VoiceOver users, who cannot hold it. */
"monarch.aiVoiceInput.holdHint" = "Double-tap to start listening, and again to stop.";

/* Status while waiting for permission and the microphone. */
"monarch.aiVoiceInput.starting" = "Starting microphone…";

/* Status while listening, also announced. */
"monarch.aiVoiceInput.listening" = "Listening…";

/* Announced when listening stops. */
"monarch.aiVoiceInput.stopped" = "Stopped listening.";

/* Shown when microphone or speech recognition access is off. */
"monarch.aiVoiceInput.denied" = "Microphone or speech recognition access is off. Turn it on in Settings, then try again.";

/* Shown when nothing was heard. */
"monarch.aiVoiceInput.noSpeech" = "Nothing was heard. Try again and speak clearly.";

/* Shown when there is no microphone. */
"monarch.aiVoiceInput.noMicrophone" = "No microphone is available. Connect one and try again.";

/* Shown when speech recognition is not available, for example without a network. */
"monarch.aiVoiceInput.unavailable" = "Dictation isn’t available right now. Try again later.";

/* Shown for any other dictation failure. */
"monarch.aiVoiceInput.error" = "Dictation stopped unexpectedly. Try again.";

/* Read before the live transcript, as in "Transcript: book a table". */
"monarch.aiVoiceInput.transcript" = "Transcript";

/* Action that opens the app's page in Settings when access is off. */
"monarch.aiVoiceInput.openSettings" = "Open Settings";
