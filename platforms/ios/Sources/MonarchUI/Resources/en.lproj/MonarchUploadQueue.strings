/* The heading of the list of uploads. */
"monarch.uploadQueue.title" = "Uploads";

/* The status of an upload that is waiting to start. */
"monarch.uploadQueue.queued" = "Waiting";

/* The status of an upload whose progress is unknown. */
"monarch.uploadQueue.uploading" = "Uploading…";

/* The status of an upload in progress. %@ is the percentage, such as "40%". */
"monarch.uploadQueue.uploadingPercent" = "Uploading… %@";

/* The status of a finished upload. */
"monarch.uploadQueue.done" = "Uploaded";

/* The status of a failed upload, when the app gives no reason. */
"monarch.uploadQueue.failed" = "Upload failed";

/* The status of a cancelled upload. */
"monarch.uploadQueue.cancelled" = "Cancelled";

/* The title of the button that retries an upload. */
"monarch.uploadQueue.retry" = "Retry";

/* The spoken name of the retry button. %@ is the file name. */
"monarch.uploadQueue.retryLabel" = "Retry upload of %@";

/* The spoken name of the button that cancels an upload. %@ is the file name. */
"monarch.uploadQueue.cancel" = "Cancel upload of %@";

/* The spoken name of the button that removes a finished upload from the list. %@ is the file name. */
"monarch.uploadQueue.remove" = "Remove %@ from the list";

/* The title of the button that removes every finished upload from the list. */
"monarch.uploadQueue.clearFinished" = "Clear finished";

/* The spoken name of an upload's progress bar. %@ is the file name. */
"monarch.uploadQueue.progressLabel" = "Upload progress of %@";

/* The spoken name of the progress bar of all uploads. */
"monarch.uploadQueue.totalLabel" = "Total upload progress";

/* Added to the summary when uploads were cancelled. %lld is the number. */
"monarch.uploadQueue.summaryCancelled" = "%lld cancelled";

/* Announced when an upload finishes. %@ is the file name. */
"monarch.uploadQueue.announceDone" = "%@ uploaded.";

/* Announced when an upload fails. %@ is the file name. */
"monarch.uploadQueue.announceFailed" = "%@ failed.";

/* Announced when an upload fails. %1$@ is the file name, %2$@ the reason. */
"monarch.uploadQueue.announceFailedReason" = "%1$@ failed: %2$@.";

/* Announced when the last of several uploads ends and none failed. %lld is the number uploaded. */
"monarch.uploadQueue.announceFinished" = "All uploads finished: %lld uploaded.";

/* Announced when the last of several uploads ends with failures. %1$lld uploaded, %2$lld failed. */
"monarch.uploadQueue.announceFinishedFailed" = "Uploads finished: %1$lld uploaded, %2$lld failed.";
