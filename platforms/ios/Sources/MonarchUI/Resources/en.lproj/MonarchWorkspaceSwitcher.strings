/* The spoken name of the button that switches workspace, and the title of its list. */
"monarch.workspaceSwitcher.label" = "Workspace";

/* The button text when no workspace is chosen. */
"monarch.workspaceSwitcher.placeholder" = "Choose a workspace";

/* The prompt of the search field in the workspace list. */
"monarch.workspaceSwitcher.search" = "Search workspaces";

/* Shown when no workspace matches the search. */
"monarch.workspaceSwitcher.empty" = "No workspaces match.";

/* Shown while the workspaces load. */
"monarch.workspaceSwitcher.loading" = "Loading workspaces";

/* The action that creates a new workspace. */
"monarch.workspaceSwitcher.create" = "Create workspace";

/* The link that opens the page listing every workspace. */
"monarch.workspaceSwitcher.manage" = "All workspaces";

/* The button that closes the workspace list without choosing. */
"monarch.workspaceSwitcher.cancel" = "Cancel";
