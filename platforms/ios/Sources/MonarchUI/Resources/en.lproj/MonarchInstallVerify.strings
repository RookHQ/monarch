/* The heading over the snippets. */
"monarch.installVerify.installHeading" = "Install";

/* The heading over the status of the install. */
"monarch.installVerify.verifyHeading" = "Verify";

/* The spoken name of the strip of snippet tabs. */
"monarch.installVerify.platforms" = "Platform";

/* The button that opens the share sheet with instructions for a developer. */
"monarch.installVerify.shareInstructions" = "Copy instructions for your developer";
"monarch.installVerify.emailDeveloper" = "Email them";

/* The subject of the shared instructions, used by Mail. */
"monarch.installVerify.shareSubject" = "Install instructions";

/* The status title while waiting for the first report. */
"monarch.installVerify.waitingTitle" = "Waiting for your site…";

/* The status text while waiting, naming the sites. %@ is the list of sites. */
"monarch.installVerify.waitingBody" = "Add the snippet and open any page of %@. This updates by itself.";

/* The status text while waiting when no site is known. */
"monarch.installVerify.waitingBodyNoTargets" = "Add the snippet and open any page of your site. This updates by itself.";

/* The status title once the code reported. %@ is the list of sites. */
"monarch.installVerify.connectedOn" = "Connected on %@";

/* The status title once the code reported, when no site is named. */
"monarch.installVerify.connected" = "Connected";

/* The status text once the code reported. */
"monarch.installVerify.connectedBody" = "The snippet loaded there. Try it out to see it working end to end.";

/* The status title when the product cannot check the install. */
"monarch.installVerify.unavailableTitle" = "Live verification isn’t available";

/* The status text when the product cannot check the install. */
"monarch.installVerify.unavailableBody" = "Open a page where you added the snippet and check that it appears.";

/* The spoken name of the list of sites. */
"monarch.installVerify.targets" = "Websites";

/* When a site last reported. %@ is a relative time such as "5 minutes ago". */
"monarch.installVerify.seen" = "seen %@";

/* Shown for a site that has not reported. */
"monarch.installVerify.notSeen" = "not seen yet";

/* The spoken state of a site that reported. */
"monarch.installVerify.seenState" = "Seen";

/* The spoken state of a site that has not reported. */
"monarch.installVerify.notSeenState" = "Not seen";

/* The button that opens a page where the install can be tried. */
"monarch.installVerify.openTest" = "Open a test page";

/* The spoken hint of the test page button. */
"monarch.installVerify.openTestHint" = "Opens in Safari.";
