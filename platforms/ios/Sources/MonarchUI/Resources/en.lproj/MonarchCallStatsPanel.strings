/* The heading of a call's connection panel, above the data the call has used. */
"monarch.callStatsPanel.dataUsed" = "Data used this call";
/* The data a call has used. %1$@ is the total, such as 15 MB; %2$@ is the upload rate and %3$@ the download rate, such as 420 kbps. */
"monarch.callStatsPanel.usageSummary" = "%1$@ total · up %2$@ · down %3$@";
/* A note in a call's connection panel while low data mode is on. */
"monarch.callStatsPanel.lowData" = "Low data mode is on: audio only.";
/* Spoken name of the list of each person's connection in a call. */
"monarch.callStatsPanel.connections" = "Connection to each person";
/* The label of the round-trip time to a person in a call. */
"monarch.callStatsPanel.roundTrip" = "Round trip";
/* The label of the packet loss on a person's connection in a call. */
"monarch.callStatsPanel.loss" = "Loss";
/* Shown in a call's connection panel when no one else has joined. */
"monarch.callStatsPanel.noPeers" = "No one else is connected yet.";
/* The grade of a good connection to a person in a call. */
"monarch.callStatsPanel.quality.good" = "Good connection";
/* The grade of an unstable connection to a person in a call. */
"monarch.callStatsPanel.quality.fair" = "Unstable connection";
/* The grade of a poor connection to a person in a call. */
"monarch.callStatsPanel.quality.poor" = "Poor connection";
/* Shown instead of a connection grade or a number that has not been measured yet. */
"monarch.callStatsPanel.quality.unknown" = "Not measured yet";
/* A data rate in bits per second. %@ is the number. */
"monarch.callStatsPanel.bps" = "%@ bps";
/* A data rate in kilobits per second. %@ is the number. */
"monarch.callStatsPanel.kbps" = "%@ kbps";
/* A data rate in megabits per second. %@ is the number. */
"monarch.callStatsPanel.mbps" = "%@ Mbps";

/* The Person column heading of the connections table. */
"monarch.callStatsPanel.person" = "Person";

/* The Link column heading of the connections table. */
"monarch.callStatsPanel.link" = "Link";
