/* The name of the line of work left each day, in the legend, the popover and the data table of a burndown chart. */
"monarch.burndownChart.remaining" = "Remaining";
/* The name of the straight line from the starting work to zero on the last day. */
"monarch.burndownChart.ideal" = "Ideal";
/* The name of the line of total committed work. */
"monarch.burndownChart.scope" = "Scope";
/* The heading of the day column of the data table. */
"monarch.burndownChart.day" = "Day";
/* The label above the dashed line that marks today. */
"monarch.burndownChart.today" = "Today";
/* The heading of the column of scope changes in the data table, and the popover footer. */
"monarch.burndownChart.scopeChange" = "Scope change";
/* Work added to the scope that day. %@ is the amount. */
"monarch.burndownChart.change.added" = "+%@";
/* Work removed from the scope that day. %@ is the amount. */
"monarch.burndownChart.change.removed" = "−%@";
/* Where the sprint stands. %1$@ is the latest day with data, %2$@ the work left, %3$@ the ideal for that day. */
"monarch.burndownChart.status" = "%1$@: %2$@ remaining, ideal %3$@";
/* Appended to the status when less work is left than the ideal. %@ is the difference. */
"monarch.burndownChart.ahead" = "%@ ahead of ideal";
/* Appended to the status when more work is left than the ideal. %@ is the difference. */
"monarch.burndownChart.behind" = "%@ behind ideal";
/* Appended to the status when the work left equals the ideal. */
"monarch.burndownChart.onTrack" = "on the ideal line";
/* The scope sentence. %1$@ is the latest scope, %2$@ the work added and %3$@ the work removed since the start. */
"monarch.burndownChart.scopeSummary" = "Scope %1$@, %2$@ added and %3$@ removed since the start";
/* The summary when no day has a remaining value yet. */
"monarch.burndownChart.notStarted" = "Not started";
