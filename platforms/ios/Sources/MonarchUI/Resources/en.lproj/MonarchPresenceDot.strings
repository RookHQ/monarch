/* Presence: the person is available now. */
"monarch.presenceDot.online" = "Online";

/* Presence: the person is signed in but not active. */
"monarch.presenceDot.away" = "Away";

/* Presence: the person is in a call or a meeting. */
"monarch.presenceDot.busy" = "Busy";

/* Presence: the person does not want notifications. */
"monarch.presenceDot.doNotDisturb" = "Do not disturb";

/* Presence: the person is not signed in. */
"monarch.presenceDot.offline" = "Offline";

/* A presence joined with the person's own status message. The first %@ is the presence, the second the message. */
"monarch.presenceDot.withStatus" = "%1$@ · %2$@";
