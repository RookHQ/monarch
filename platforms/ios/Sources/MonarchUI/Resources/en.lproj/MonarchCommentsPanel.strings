/* The navigation title of the comments panel of a document. */
"monarch.commentsPanel.title" = "Comments";

/* The button that closes the comments panel. */
"monarch.commentsPanel.close" = "Close";

/* The name of the control that switches between open and resolved comment threads. */
"monarch.commentsPanel.filter" = "Show";

/* The segment that lists comment threads that are not resolved. */
"monarch.commentsPanel.open" = "Open";

/* The segment that lists resolved comment threads. */
"monarch.commentsPanel.resolved" = "Resolved";

/* Spoken while the comment threads load. */
"monarch.commentsPanel.loading" = "Loading comments";

/* The title shown when no comment thread is open. */
"monarch.commentsPanel.emptyOpen" = "No open comments";

/* The title shown when no comment thread is resolved. */
"monarch.commentsPanel.emptyResolved" = "No resolved comments";

/* The hint under the empty title when no comment thread is open. */
"monarch.commentsPanel.emptyHint" = "Select text to start a discussion.";

/* The number of comments in one thread. %lld is 1. */
"monarch.commentsPanel.commentCount.one" = "%lld comment";

/* The number of comments in one thread. %lld is the count. */
"monarch.commentsPanel.commentCount.other" = "%lld comments";
