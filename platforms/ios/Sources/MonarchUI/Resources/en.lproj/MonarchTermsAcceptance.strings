/* Label of the checkbox that accepts the terms. %@ is the list of document titles, such as "Terms of Service and Privacy Policy". */
"monarch.termsAcceptance.label" = "I agree to the %@";

/* Error shown under the terms checkbox when the person continues without ticking it. */
"monarch.termsAcceptance.requiredMessage" = "Accept the terms to continue";

/* Hint read by VoiceOver on a terms checkbox that must be ticked. */
"monarch.termsAcceptance.requiredHint" = "Required";
