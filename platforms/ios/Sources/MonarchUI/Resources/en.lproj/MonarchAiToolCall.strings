/* State of a tool call: it waits for a person to approve it. */
"monarch.aiToolCall.state.pending-approval" = "Waiting for approval";

/* State of a tool call: it waits for the app to run the tool and return the result. */
"monarch.aiToolCall.state.awaiting-result" = "Waiting for result";

/* State of a tool call: the tool is running. */
"monarch.aiToolCall.state.running" = "Running";

/* State of a tool call: the tool finished. */
"monarch.aiToolCall.state.succeeded" = "Done";

/* State of a tool call: the tool failed. */
"monarch.aiToolCall.state.failed" = "Failed";

/* State of a tool call: a person or a policy said no. */
"monarch.aiToolCall.state.denied" = "Denied";

/* State of a tool call: the reply stopped before the tool finished. */
"monarch.aiToolCall.state.cancelled" = "Cancelled";

/* Heading above the arguments of a tool call. */
"monarch.aiToolCall.input" = "Input";

/* Heading above the result of a tool call. */
"monarch.aiToolCall.output" = "Output";

/* Read before the error text of a failed tool call. */
"monarch.aiToolCall.error" = "Error";

/* Names the tool in the details of a tool call. */
"monarch.aiToolCall.tool" = "Tool";

/* Shown in the details when a tool call has no input and no output yet. */
"monarch.aiToolCall.empty" = "No details yet.";

/* Button that shows the rest of a long input or output. */
"monarch.aiToolCall.showMore" = "Show all";

/* How long a tool call took, under a minute. %@ is the number of seconds, such as 0.4 or 12. */
"monarch.aiToolCall.seconds" = "%@s";

/* How long a tool call took, a minute or more. %1$@ is the minutes, %2$@ the seconds with two digits. */
"monarch.aiToolCall.minutesSeconds" = "%1$@m %2$@s";

/* Announced when a tool call changes state. %1$@ is the tool, %2$@ the new state. */
"monarch.aiToolCall.stateChanged" = "%1$@: %2$@";

/* Says how much of a long value is shown. %1$@ is the characters shown, %2$@ the total. */
"monarch.aiToolCall.truncated" = "Showing %1$@ of %2$@ characters";

/* The tool line in the details. %1$@ is the word "Tool", %2$@ the tool's name. */
"monarch.aiToolCall.toolLine" = "%1$@: %2$@";

/* The error line as it is read. %1$@ is the word "Error", %2$@ the message. */
"monarch.aiToolCall.errorLine" = "%1$@: %2$@";
