/* The spoken name of a call stage that has no title. */
"monarch.callStage.region" = "Call";
/* The spoken name of the running call timer on a call stage. */
"monarch.callStage.duration" = "Call duration";
/* Shown on a call stage while you are the only person in the call. */
"monarch.callStage.waiting" = "Waiting for others…";
/* The number of people in a call, you included. %@ is the number. */
"monarch.callStage.inCall" = "%@ in call";
/* A badge on a call stage while video is off to save data. */
"monarch.callStage.lowData" = "Low data";
/* A notice on a call stage while the connection recovers. */
"monarch.callStage.reconnecting" = "You’re offline. Trying to reconnect…";
/* A hint on a call stage when you talk while your microphone is muted. */
"monarch.callStage.mutedHint" = "You’re muted. Turn on your microphone to talk.";
/* The button on a call stage that continues the call in picture in picture. */
"monarch.callStage.pictureInPicture" = "Picture in picture";
/* The button on a call stage that docks the call in a corner. */
"monarch.callStage.shrink" = "Shrink call to the corner";
/* The button on a docked call that returns it to the full stage. */
"monarch.callStage.expand" = "Expand call";
/* The button on a docked call that minimizes it. */
"monarch.callStage.minimize" = "Minimize call";
