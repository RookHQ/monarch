/* The status of a calendar event that was accepted. */
"monarch.eventChip.status.confirmed" = "Confirmed";

/* The status of a calendar event that is not yet accepted. Shown in upper case on the chip and spoken after the title and time. */
"monarch.eventChip.status.tentative" = "Tentative";

/* The status of a calendar event that was called off. Shown in upper case on the chip and spoken after the title and time. */
"monarch.eventChip.status.cancelled" = "Cancelled";

/* The status of a calendar event the person turned down. Shown in upper case on the chip and spoken after the title and time. */
"monarch.eventChip.status.declined" = "Declined";
