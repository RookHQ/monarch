/* The default label of a type-to-confirm input. %@ is the exact text the person must type. */
"monarch.typeToConfirmInput.label" = "Type “%@” to confirm";

/* The default error of a type-to-confirm input while the typed text does not match. */
"monarch.typeToConfirmInput.mismatch" = "The text does not match.";

/* Announced by VoiceOver when the typed text starts to match the phrase. */
"monarch.typeToConfirmInput.matches" = "Text matches";
