/* Spoken name of the switcher between versions of a message. */
"monarch.aiMessageBranch.label" = "Versions";

/* Spoken name of the button that shows the previous version of a message. */
"monarch.aiMessageBranch.previous" = "Previous version";

/* Spoken name of the button that shows the next version of a message. */
"monarch.aiMessageBranch.next" = "Next version";

/* Visible position between the buttons. %1$d is the version shown, counted from 1; %2$d is how many exist. */
"monarch.aiMessageBranch.position" = "%1$d / %2$d";

/* Spoken position, and announced after switching. %1$d is the version shown, counted from 1; %2$d is how many exist. */
"monarch.aiMessageBranch.announcement" = "Version %1$d of %2$d";
