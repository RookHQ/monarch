/* Spoken name of a tile's drag handle. %@ is the name of the item. */
"monarch.sortableGrid.handle" = "Reorder %@";

/* Announced after a tile is moved with an accessibility action. %1$@ is the item, %2$d its new position, %3$d the number of items. */
"monarch.sortableGrid.moved" = "%1$@ moved to position %2$d of %3$d.";

/* Announced after a tile is dropped. %1$@ is the item, %2$d its new position, %3$d the number of items. */
"monarch.sortableGrid.dropped" = "%1$@ dropped at position %2$d of %3$d.";
