/* Spoken name of the list of steps an AI assistant works through. */
"monarch.aiChainOfSteps.label" = "Steps";

/* State of a step that has not started. */
"monarch.aiChainOfSteps.state.todo" = "Not started";

/* State of the step that is running now. */
"monarch.aiChainOfSteps.state.active" = "In progress";

/* State of a finished step. */
"monarch.aiChainOfSteps.state.done" = "Done";

/* State of a step that was left out. */
"monarch.aiChainOfSteps.state.skipped" = "Skipped";

/* State of a step that failed. */
"monarch.aiChainOfSteps.state.failed" = "Failed";

/* Summary of the folded list when it has one step. */
"monarch.aiChainOfSteps.summary.one" = "1 step";

/* Summary of the folded list when it has one step, which failed. */
"monarch.aiChainOfSteps.summary.oneFailed" = "1 step, 1 failed";

/* Summary of the folded list. %d is the number of steps. */
"monarch.aiChainOfSteps.summary" = "%d steps";

/* Summary of the folded list with failures. %1$d is the number of steps, %2$d the number that failed. */
"monarch.aiChainOfSteps.summary.failed" = "%1$d steps, %2$d failed";

/* Announced when a step starts. %1$d is its position, %2$d the number of steps, %3$@ what the step does. */
"monarch.aiChainOfSteps.started" = "Step %1$d of %2$d: %3$@";

/* Announced when a step fails. %@ is what the step does. */
"monarch.aiChainOfSteps.failedStep" = "Step failed: %@";

/* Announced when every step has finished. %d is the number of steps. */
"monarch.aiChainOfSteps.finished" = "Finished %d steps";

/* Announced when every step has finished and some failed. %1$d is the number of steps, %2$d the number that failed. */
"monarch.aiChainOfSteps.finished.failed" = "Finished %1$d steps, %2$d failed";
