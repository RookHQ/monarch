/* The heading of the first column of the permission grid. */
"monarch.permissionMatrix.permissionHeader" = "Permission";

/* The spoken name of the role picker in the compact layout. */
"monarch.permissionMatrix.rolePicker" = "Role";

/* The spoken name of one cell. The first %1$@ is the permission, the second %2$@ the role, as in "Invite members for Admin". */
"monarch.permissionMatrix.cellLabel" = "%1$@ for %2$@";

/* Read for a granted permission when the matrix is read only. */
"monarch.permissionMatrix.allowed" = "Allowed";

/* Read for a permission that is not granted when the matrix is read only. */
"monarch.permissionMatrix.notAllowed" = "Not allowed";

/* The reason shown for a cell that cannot be changed, when the app gives none. */
"monarch.permissionMatrix.locked" = "This can’t be changed";
