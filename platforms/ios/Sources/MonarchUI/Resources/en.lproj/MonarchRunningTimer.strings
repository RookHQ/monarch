/* The button of the timer panel that starts a timer. */
"monarch.runningTimer.start" = "Start timer";

/* The button of the timer panel that stops the timer and logs the time. */
"monarch.runningTimer.stop" = "Stop";

/* Read by VoiceOver for the stop button of the compact timer indicator. */
"monarch.runningTimer.stopAndLog" = "Stop timer and log time";

/* Read by VoiceOver for the menu button of the compact timer indicator. */
"monarch.runningTimer.moreActions" = "More timer actions";

/* The action that throws the running time away. */
"monarch.runningTimer.discard" = "Discard without logging";

/* The title of the confirmation before the running time is thrown away. */
"monarch.runningTimer.discardTitle" = "Discard the running timer?";

/* The message of the confirmation before the running time is thrown away. */
"monarch.runningTimer.discardMessage" = "The tracked time will not be saved.";

/* The confirming button of the discard confirmation. */
"monarch.runningTimer.discardConfirm" = "Discard";

/* The action that stops the timer at an earlier time the user enters. */
"monarch.runningTimer.stoppedEarlier" = "I stopped earlier";

/* The title of the sheet that asks when the user stopped working. */
"monarch.runningTimer.stoppedEarlierTitle" = "When did you stop?";

/* The explanation in the sheet that asks when the user stopped working. */
"monarch.runningTimer.stoppedEarlierMessage" = "The time between the start and the moment you enter is saved. It cannot be in the future or before the timer started.";

/* The label of the date and time picker for the moment the user stopped. */
"monarch.runningTimer.stoppedAt" = "I stopped at";

/* When the timer started. %@ is a date and time such as "14 Nov 2026 at 09:00". */
"monarch.runningTimer.started" = "Started %@";

/* How much work will be saved. %@ is a duration such as "2h 05m". */
"monarch.runningTimer.workDuration" = "That is %@ of work.";

/* The button that saves the time entered in the sheet. */
"monarch.runningTimer.save" = "Save this time";

/* The button that closes a confirmation or the sheet without a change. */
"monarch.runningTimer.cancel" = "Cancel";

/* The error when the entered stop time is in the future. */
"monarch.runningTimer.stoppedAtFuture" = "The time cannot be in the future.";

/* The error when the entered stop time is less than a minute after the start. */
"monarch.runningTimer.stoppedAtTooEarly" = "It must be at least a minute after the timer started.";

/* Shown when starting, stopping or discarding fails without a reason. */
"monarch.runningTimer.failed" = "That did not work. Try again.";

/* The state of a running timer, read by VoiceOver and announced when it starts. */
"monarch.runningTimer.running" = "Timer running";

/* The state of a stopped timer, read by VoiceOver and announced when it stops. */
"monarch.runningTimer.stopped" = "Timer stopped";

/* The label of the compact indicator when the app gives none. */
"monarch.runningTimer.defaultLabel" = "Timer";

/* The warning when a timer has run for a long time. %@ is a duration such as "12h". */
"monarch.runningTimer.longRunning" = "This timer has been running for over %@. If you forgot to stop it, enter the time you finished or discard it and add the time by hand.";

/* The VoiceOver hint of the compact indicator when it opens the item being timed. */
"monarch.runningTimer.openHint" = "Opens what is being timed.";
