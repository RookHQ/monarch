/* The accessibility action that moves an item one place earlier in a vertical order. */
"monarch.dragHandle.moveUp" = "Move up";

/* The accessibility action that moves an item one place later in a vertical order. */
"monarch.dragHandle.moveDown" = "Move down";

/* The accessibility action that moves an item one place earlier in a horizontal order. */
"monarch.dragHandle.moveBackward" = "Move backward";

/* The accessibility action that moves an item one place later in a horizontal order. */
"monarch.dragHandle.moveForward" = "Move forward";

/* Spoken as the value of a drag handle while its item is picked up. */
"monarch.dragHandle.grabbed" = "Picked up";

/* Spoken as the value of a drag handle just after its item is dropped. */
"monarch.dragHandle.dropped" = "Dropped";
