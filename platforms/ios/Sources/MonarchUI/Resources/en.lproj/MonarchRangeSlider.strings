/* Added to the label of a range slider to name its lower thumb, as in "Price, Minimum". */
"monarch.rangeSlider.minimum" = "Minimum";

/* Added to the label of a range slider to name its upper thumb, as in "Price, Maximum". */
"monarch.rangeSlider.maximum" = "Maximum";

/* The spoken name of one thumb of a range slider. %1$@ is the slider's label, %2$@ is "Minimum" or "Maximum". */
"monarch.rangeSlider.thumb" = "%1$@, %2$@";

/* The range shown next to a range slider. %1$@ is the lower value, %2$@ the upper value. */
"monarch.rangeSlider.range" = "%1$@ – %2$@";
