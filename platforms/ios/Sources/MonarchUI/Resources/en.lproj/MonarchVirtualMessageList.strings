/* The spoken name of a list of messages in a conversation. */
"monarch.virtualMessageList.list" = "Messages";

/* The divider above the first unread message of a conversation. */
"monarch.virtualMessageList.newMessages" = "New messages";

/* The separator above the messages sent today. */
"monarch.virtualMessageList.today" = "Today";

/* The separator above the messages sent yesterday. */
"monarch.virtualMessageList.yesterday" = "Yesterday";

/* The button that scrolls to the newest message. */
"monarch.virtualMessageList.jumpToLatest" = "Jump to latest";

/* The jump button, and the announcement, when one new message arrived. %lld is 1. */
"monarch.virtualMessageList.newCount.one" = "%lld new message";

/* The jump button, and the announcement, when new messages arrived. %lld is the count. */
"monarch.virtualMessageList.newCount.other" = "%lld new messages";

/* The button at the top of a conversation that loads older messages. */
"monarch.virtualMessageList.loadOlder" = "Load older messages";

/* The load button while older messages load. */
"monarch.virtualMessageList.loadingOlder" = "Loading older messages…";

/* Shown and announced when older messages failed to load. */
"monarch.virtualMessageList.olderFailed" = "Couldn’t load older messages.";

/* Spoken while the first messages of a conversation load. */
"monarch.virtualMessageList.loading" = "Loading messages";
