/* Shown when a scope selector has no groups of scopes. */
"monarch.scopeSelector.empty" = "There are no scopes to choose from.";

/* A group's summary while its scopes (permissions) load. */
"monarch.scopeSelector.loading" = "Loading scopes…";

/* A group's summary when it offers no scopes. */
"monarch.scopeSelector.noScopes" = "No scopes available.";

/* A group's summary. %1$ld is how many scopes are selected, %2$ld how many the group has. */
"monarch.scopeSelector.count" = "%1$ld of %2$ld scopes";

/* The checkbox that selects every scope of a group. */
"monarch.scopeSelector.selectAll" = "Select all";

/* The button that clears every scope of a group once all are selected. */
"monarch.scopeSelector.clearAll" = "Clear all";

/* The button that shows more groups. %1$ld is how many it shows, %2$ld how many are hidden. */
"monarch.scopeSelector.showMore" = "Show %1$ld more of %2$ld";
