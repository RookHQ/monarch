/* The question asked when the person tries to leave a screen with changes that are not saved. */
"monarch.unsavedChangesGuard.title" = "Discard unsaved changes?";

/* Under the question: what happens if the person leaves now. */
"monarch.unsavedChangesGuard.message" = "Your changes have not been saved. If you leave now, they will be lost.";

/* The button that closes the question and stays on the screen. */
"monarch.unsavedChangesGuard.keepEditing" = "Keep editing";

/* The destructive button that leaves the screen and throws the changes away. */
"monarch.unsavedChangesGuard.discard" = "Discard changes";

/* The button that saves the changes and then leaves the screen. */
"monarch.unsavedChangesGuard.save" = "Save and leave";

/* Shown when saving failed and the app gave no reason. */
"monarch.unsavedChangesGuard.saveFailed" = "Your changes could not be saved. Try again.";

/* The back button shown instead of the system one while there are unsaved changes. */
"monarch.unsavedChangesGuard.back" = "Back";

/* Shown and announced while the changes are being saved. */
"monarch.unsavedChangesGuard.saving" = "Saving";
