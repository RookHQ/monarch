/* The length of the text in a rich-text editor when it is one character. */
"monarch.richTextEditor.countOne" = "1 character";

/* The length of the text in a rich-text editor. %ld is the number of characters. */
"monarch.richTextEditor.countOther" = "%ld characters";

/* The visible length of the text against its limit. The first %ld is the length, the second the limit. */
"monarch.richTextEditor.countOfLimit" = "%1$ld / %2$ld";

/* Read when one character is left before the limit of a rich-text editor. */
"monarch.richTextEditor.remainingOne" = "1 character left";

/* Read with the characters left before the limit of a rich-text editor. %ld is their number. */
"monarch.richTextEditor.remainingOther" = "%ld characters left";

/* Read when the text of a rich-text editor is one character over its limit. */
"monarch.richTextEditor.overOne" = "1 character over the limit";

/* Read when the text of a rich-text editor is over its limit. %ld is the number of extra characters. */
"monarch.richTextEditor.overOther" = "%ld characters over the limit";
