/* The label of the row of all-day events in a day or week grid, and the time read for an all-day event. */
"monarch.timeGrid.allDay" = "All day";

/* Added to the spoken heading of today's column. */
"monarch.timeGrid.today" = "Today";

/* The spoken name of an empty hour that creates an event when activated. %@ is the day and time. */
"monarch.timeGrid.createEvent" = "Create event, %@";

/* The hint of a day heading that opens the day view. %@ is the day. */
"monarch.timeGrid.openDay" = "Opens %@";

/* VoiceOver action that moves an event earlier by one step. */
"monarch.timeGrid.moveEarlier" = "Move earlier";

/* VoiceOver action that moves an event later by one step. */
"monarch.timeGrid.moveLater" = "Move later";

/* VoiceOver action that moves an event to the previous day column. */
"monarch.timeGrid.moveToPreviousDay" = "Move to previous day";

/* VoiceOver action that moves an event to the next day column. */
"monarch.timeGrid.moveToNextDay" = "Move to next day";
