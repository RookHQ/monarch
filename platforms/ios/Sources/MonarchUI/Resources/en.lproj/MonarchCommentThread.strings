/* The spoken name of a comment thread. %@ is the name of the person who started it. */
"monarch.commentThread.thread" = "Thread started by %@";

/* The spoken name of the passage a comment thread is about. */
"monarch.commentThread.quote" = "Quoted text";

/* The button that shows one folded earlier reply. %lld is 1. */
"monarch.commentThread.showEarlier.one" = "Show %lld earlier reply";

/* The button that shows folded earlier replies. %lld is the count. */
"monarch.commentThread.showEarlier.other" = "Show %lld earlier replies";

/* Announced when one folded reply is shown. %lld is 1. */
"monarch.commentThread.earlierShown.one" = "%lld earlier reply shown";

/* Announced when folded replies are shown. %lld is the count. */
"monarch.commentThread.earlierShown.other" = "%lld earlier replies shown";

/* The spoken name of the reply field of a comment thread. */
"monarch.commentThread.reply" = "Reply";

/* The placeholder of the reply field of a comment thread. */
"monarch.commentThread.replyPlaceholder" = "Reply…";

/* The button that posts a reply to a comment thread. */
"monarch.commentThread.send" = "Send reply";

/* The button that marks a comment thread as resolved. */
"monarch.commentThread.resolve" = "Resolve";

/* The button that opens a resolved comment thread again. */
"monarch.commentThread.reopen" = "Reopen";

/* The badge and spoken state of a resolved comment thread. */
"monarch.commentThread.resolved" = "Resolved";

/* Shown instead of the reply field while a comment thread is resolved. */
"monarch.commentThread.resolvedHint" = "This thread is resolved. Reopen it to reply.";

/* Announced after a comment thread is resolved. */
"monarch.commentThread.resolvedNotice" = "Thread resolved";

/* Announced after a comment thread is reopened. */
"monarch.commentThread.reopenedNotice" = "Thread reopened";

/* Announced after a reply is posted. */
"monarch.commentThread.sentNotice" = "Reply sent";

/* Shown and announced when replying, resolving or deleting fails. */
"monarch.commentThread.actionFailed" = "That didn’t work. Try again.";

/* The item of a comment's menu that deletes it. */
"monarch.commentThread.delete" = "Delete comment";

/* The title of the confirmation before a comment is deleted. */
"monarch.commentThread.deleteTitle" = "Delete this comment?";

/* The message of the confirmation before a comment is deleted. */
"monarch.commentThread.deleteMessage" = "It is removed for everyone. This can’t be undone.";

/* The button that closes the delete confirmation without deleting. */
"monarch.commentThread.cancel" = "Cancel";
