/* The button that closes the assistant panel. */
"monarch.aiAssistantPanel.close" = "Close assistant";

/* The spoken name of the text field where the person writes to the assistant. */
"monarch.aiAssistantPanel.inputLabel" = "Message the assistant";

/* The spoken name of the chips that show what the assistant can see on the current screen. */
"monarch.aiAssistantPanel.context" = "Context";

/* The greeting shown while the conversation is empty. */
"monarch.aiAssistantPanel.welcome" = "How can I help?";

/* The spoken name of the suggested first prompts. */
"monarch.aiAssistantPanel.starters" = "Suggested prompts";

/* The name of the assistant when the app gives no agent. */
"monarch.aiAssistantPanel.assistant" = "Assistant";

/* The button that folds the assistant panel to its header. */
"monarch.aiAssistantPanel.collapse" = "Collapse assistant";

/* The button that opens a folded assistant panel again. */
"monarch.aiAssistantPanel.expand" = "Expand assistant";
