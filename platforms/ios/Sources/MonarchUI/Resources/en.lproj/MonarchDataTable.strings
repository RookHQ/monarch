/* The checkbox that selects every row of a table. */
"monarch.dataTable.selectAll" = "Select all rows";

/* The checkbox that selects one row. %@ is the row's name. */
"monarch.dataTable.selectRow" = "Select %@";

/* The number of selected rows. %lld is the count. */
"monarch.dataTable.selectedCount" = "%lld selected";

/* The menu of actions on one row. %@ is the row's name. */
"monarch.dataTable.rowActions" = "Actions for %@";

/* The header of the column that holds each row's actions menu. */
"monarch.dataTable.actionsHeader" = "Actions";

/* The hint read on a row that opens its details. */
"monarch.dataTable.openHint" = "Opens the details";

/* The menu that chooses the column a list of records is sorted by. */
"monarch.dataTable.sort" = "Sort";

/* Read after the name of the column the rows are sorted by, smallest first. */
"monarch.dataTable.sortedAscending" = "sorted ascending";

/* Read after the name of the column the rows are sorted by, largest first. */
"monarch.dataTable.sortedDescending" = "sorted descending";

/* Read for a cell with no value. */
"monarch.dataTable.noValue" = "No value";

/* The spoken name of the placeholder while the rows of a table load. */
"monarch.dataTable.loading" = "Loading rows";

/* The title shown when a table has no rows. */
"monarch.dataTable.emptyTitle" = "Nothing here yet";

/* The message under the title when a table has no rows. */
"monarch.dataTable.emptyMessage" = "Rows appear here once they are added.";

/* The title shown when the table's filters match no rows. */
"monarch.dataTable.filteredTitle" = "No rows match these filters";

/* The message shown when the table's filters match no rows. */
"monarch.dataTable.filteredMessage" = "Try removing a filter or searching for something else.";

/* The title shown when the rows of a table failed to load. */
"monarch.dataTable.errorTitle" = "These rows could not be loaded";
