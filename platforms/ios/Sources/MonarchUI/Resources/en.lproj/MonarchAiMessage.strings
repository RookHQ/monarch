/* Read by VoiceOver as the name of an assistant message. */
"monarch.aiMessage.assistantSaid" = "Assistant said";

/* Read by VoiceOver as the name of the person's own message. */
"monarch.aiMessage.youSaid" = "You said";

/* Read by VoiceOver as the name of a system or tool message. */
"monarch.aiMessage.systemSaid" = "System message";

/* The name in the header of an assistant message that has no agent. */
"monarch.aiMessage.assistant" = "Assistant";

/* The line under a message written while offline. */
"monarch.aiMessage.queued" = "Queued. It will send when you are back online.";

/* Button that cancels a message queued while offline. */
"monarch.aiMessage.cancelQueued" = "Cancel";

/* Button that resumes a reply whose connection dropped. */
"monarch.aiMessage.resume" = "Resume";

/* Name of the steps of a plan inside a reply. */
"monarch.aiMessage.plan" = "Plan";

/* Notice under a reply that hit the output limit. */
"monarch.aiMessage.finish.length" = "This answer was cut short because it reached the length limit.";

/* Notice under a reply that a safety filter stopped. */
"monarch.aiMessage.finish.contentFilter" = "This answer was stopped by a safety filter.";

/* Notice under a reply the model declined to give. */
"monarch.aiMessage.finish.refusal" = "The assistant declined to answer this.";
