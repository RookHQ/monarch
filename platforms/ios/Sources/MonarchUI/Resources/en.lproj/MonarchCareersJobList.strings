/* The title of a list of open roles. */
"monarch.careersJobList.title" = "Open roles";

/* The count beside the title when there is one role. */
"monarch.careersJobList.countOne" = "1 position";

/* The count beside the title when there are several roles. %d is the number. */
"monarch.careersJobList.countOther" = "%d positions";

/* Shown when there are no open roles. */
"monarch.careersJobList.empty" = "No open roles right now. Check back soon.";

/* The hint of a role card, which opens its details. */
"monarch.careersJobList.viewDetails" = "View details";

/* The heading of a role's responsibilities. */
"monarch.careersJobList.responsibilities" = "What you’ll do";

/* The heading of a role's qualifications. */
"monarch.careersJobList.qualifications" = "What we’re looking for";

/* The heading of the skills a role needs. */
"monarch.careersJobList.mustHave" = "Must-have skills";

/* The heading of skills that help. */
"monarch.careersJobList.niceToHave" = "Nice to have";

/* The heading of a role's benefits. */
"monarch.careersJobList.benefits" = "Benefits";

/* The button that opens the application page. */
"monarch.careersJobList.apply" = "Apply now";

/* The button that writes an application email when a role has no application page. */
"monarch.careersJobList.applyByEmail" = "Apply by email";

/* The link that writes an application email beside the apply button. */
"monarch.careersJobList.emailInstead" = "Email instead";

/* The button that closes a role's details. */
"monarch.careersJobList.close" = "Close";

/* The subject of an application email. %@ is the role's title. */
"monarch.careersJobList.emailSubject" = "Application: %@";

/* The line above the apply actions. %@ is the employer. */
"monarch.careersJobList.applyingTo" = "Applying to %@";
