/* The title of the notifications panel. */
"monarch.notificationCenter.title" = "Notifications";

/* The tab that shows every notification. */
"monarch.notificationCenter.all" = "All";

/* The tab that shows unread notifications. */
"monarch.notificationCenter.unread" = "Unread";

/* The accessible name of the tabs that filter notifications. */
"monarch.notificationCenter.filter" = "Show";

/* The button that marks every notification as read. */
"monarch.notificationCenter.markAllRead" = "Mark all as read";

/* The swipe action that marks one notification as read. */
"monarch.notificationCenter.markRead" = "Mark as read";

/* Read by VoiceOver after the title of an unread notification. */
"monarch.notificationCenter.unreadItem" = "Unread";

/* The heading of the notifications from today. */
"monarch.notificationCenter.today" = "Today";

/* The heading of the notifications from yesterday. */
"monarch.notificationCenter.yesterday" = "Yesterday";

/* The title shown when there are no notifications. */
"monarch.notificationCenter.emptyTitle" = "You’re all caught up";

/* The text shown when there are no notifications. */
"monarch.notificationCenter.emptyMessage" = "New activity will appear here.";

/* The title shown in the Unread tab when everything is read. */
"monarch.notificationCenter.emptyUnreadTitle" = "No unread notifications";

/* Read by VoiceOver while the first notifications load. */
"monarch.notificationCenter.loading" = "Loading notifications";

/* The button that closes the notifications panel. */
"monarch.notificationCenter.done" = "Done";
