/* The short visible text of the recording indicator while recording. Not read by VoiceOver. */
"monarch.recordingIndicator.rec" = "REC";

/* The spoken name of the recording indicator. */
"monarch.recordingIndicator.recording" = "Recording";

/* The visible and spoken text of the recording indicator while recording is paused. */
"monarch.recordingIndicator.paused" = "Paused";

/* Announced when recording starts. */
"monarch.recordingIndicator.started" = "Recording started";

/* Announced when recording stops. */
"monarch.recordingIndicator.stopped" = "Recording stopped";

/* Announced when recording is paused. */
"monarch.recordingIndicator.pausedAnnouncement" = "Recording paused";

/* Announced when recording resumes. */
"monarch.recordingIndicator.resumed" = "Recording resumed";

/* The spoken name of the button that stops recording. */
"monarch.recordingIndicator.stop" = "Stop recording";
