/* VoiceOver hint of the row with the signed-in person's name and status. */
"monarch.myStatus.hint" = "Opens your status and settings";

/* Shown under the person's name when they have no custom status. */
"monarch.myStatus.setStatus" = "Set a status";

/* Spoken value of the status row. %1$@ is the presence, such as "Online"; %2$@ the line under the name, such as "On holiday" or "Set a status". */
"monarch.myStatus.value" = "%1$@, %2$@";
