/* The header of the people column of a team calendar. */
"monarch.teamCalendar.person" = "Person";

/* The name of a team calendar grid, read by VoiceOver. %@ is the range, such as "November 2026". */
"monarch.teamCalendar.grid" = "Team calendar, %@";

/* Read by VoiceOver with today's date in a team calendar. */
"monarch.teamCalendar.today" = "Today";

/* Read with a holiday's day and shown when the day is tapped in a team calendar. %@ is the holiday's name. */
"monarch.teamCalendar.holiday" = "Holiday: %@";

/* Read for a bar of a team calendar that spans several days. The first %@ is the first day, the second the last. */
"monarch.teamCalendar.range" = "%1$@ to %2$@";

/* Read for a half day in the first half in a team calendar. */
"monarch.teamCalendar.firstHalf" = "first half";

/* Read for a half day in the second half in a team calendar. */
"monarch.teamCalendar.secondHalf" = "second half";

/* Read for an entry of a team calendar that waits for approval. */
"monarch.teamCalendar.pending" = "pending";

/* The title of the empty state of a team calendar without members. */
"monarch.teamCalendar.emptyTitle" = "Nobody to show";

/* The message of the empty state of a team calendar without members. */
"monarch.teamCalendar.emptyMessage" = "People and their time away appear here.";

/* The line under the grid of a team calendar that explains how it is drawn. */
"monarch.teamCalendar.legend" = "Shaded columns are weekends and holidays. Half bars are half days; faded bars are waiting for approval.";

/* Read by VoiceOver while a team calendar shows its placeholder. */
"monarch.teamCalendar.loading" = "Loading team calendar";
