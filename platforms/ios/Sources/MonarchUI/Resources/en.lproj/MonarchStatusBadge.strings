/* A service that works normally. */
"monarch.statusBadge.operational" = "Operational";

/* A service that works but slowly or with errors. */
"monarch.statusBadge.degraded" = "Degraded";

/* A service that is down for some people or some features. */
"monarch.statusBadge.partial" = "Partial outage";

/* A service that does not work. */
"monarch.statusBadge.down" = "Down";

/* A service that is down for planned maintenance. */
"monarch.statusBadge.maintenance" = "Maintenance";

/* A status that is not known. */
"monarch.statusBadge.unknown" = "Unknown";

/* The generic success status. */
"monarch.statusBadge.success" = "Success";

/* The generic warning status. */
"monarch.statusBadge.warning" = "Warning";

/* The generic danger status, for something that failed. */
"monarch.statusBadge.danger" = "Error";

/* The generic information status. */
"monarch.statusBadge.info" = "Info";

/* The generic status with no particular meaning. */
"monarch.statusBadge.neutral" = "Neutral";
