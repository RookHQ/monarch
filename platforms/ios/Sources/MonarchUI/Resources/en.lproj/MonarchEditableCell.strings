/* Spoken as the hint of an editable cell in view mode. */
"monarch.editableCell.edit" = "Edit";
/* Spoken as the value of the cell while its new value is being saved. */
"monarch.editableCell.saving" = "Saving";
/* Name of the button that leaves the cell editor without saving. */
"monarch.editableCell.cancel" = "Cancel";
/* Name of the button that saves the cell editor. */
"monarch.editableCell.save" = "Save";
/* Shown when the text typed in a number cell is not a number. */
"monarch.editableCell.invalidNumber" = "Enter a number.";
/* Shown when a cell that must have a value is left empty. */
"monarch.editableCell.required" = "Enter a value.";
/* Shown when a value is below the lowest allowed. %@ is the lowest value. */
"monarch.editableCell.belowMinimum" = "Enter %@ or more.";
/* Shown when a value is above the highest allowed. %@ is the highest value. */
"monarch.editableCell.aboveMaximum" = "Enter %@ or less.";
/* The choice that clears a select cell, and the text of an empty date cell. */
"monarch.editableCell.noValue" = "None";
/* Shown when saving failed and the error has no message of its own. */
"monarch.editableCell.saveFailed" = "Couldn’t save. Try again.";
/* Spoken as the hint of the editor while it has an error. %@ is the error message. */
"monarch.editableCell.error" = "Error: %@";
