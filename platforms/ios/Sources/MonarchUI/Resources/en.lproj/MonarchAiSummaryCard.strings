/* The provenance label above the title of an AI summary card. */
"monarch.aiSummaryCard.aiSummary" = "AI summary";

/* The button of an AI summary card that asks for a new summary. */
"monarch.aiSummaryCard.refresh" = "Refresh";

/* The age of the summary on an AI summary card. %@ is a relative time, such as 3 hours ago, or a date read by VoiceOver. */
"monarch.aiSummaryCard.generated" = "Generated %@";

/* Shown and announced while an AI summary card writes its summary. */
"monarch.aiSummaryCard.generating" = "Generating summary…";

/* Announced when an AI summary card finishes writing its summary. */
"monarch.aiSummaryCard.updated" = "Summary updated.";

/* The warning on an AI summary card whose data changed since the summary was written. */
"monarch.aiSummaryCard.stale" = "The data changed since this summary was written. Refresh to update it.";

/* The error title of an AI summary card whose summary could not be generated. */
"monarch.aiSummaryCard.error" = "The summary couldn’t be generated.";

/* Shown on an AI summary card with no summary and nothing generating. */
"monarch.aiSummaryCard.empty" = "No summary yet.";

/* The heading of the sources of an AI summary card. */
"monarch.aiSummaryCard.sources" = "Sources";
