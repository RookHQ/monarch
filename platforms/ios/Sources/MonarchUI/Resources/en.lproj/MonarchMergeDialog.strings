/* The title of the dialog that merges duplicate records into one. */
"monarch.mergeDialog.title" = "Merge records";

/* The explanation under the title of the merge dialog. */
"monarch.mergeDialog.description" = "Choose the record to keep and which value to keep for each field. The other records are merged into it.";

/* The heading of the choice of the record that survives a merge. */
"monarch.mergeDialog.keep" = "Record to keep";

/* A badge on the record that survives a merge. */
"monarch.mergeDialog.kept" = "Kept";

/* The heading of the choices of field values to keep. */
"monarch.mergeDialog.values" = "Values to keep";

/* The source of a value in the merge dialog. %@ is the record's title. */
"monarch.mergeDialog.from" = "from %@";

/* The heading of fields that have the same value in every record. */
"monarch.mergeDialog.same" = "Same in every record";

/* Shown in place of a field value that is empty. */
"monarch.mergeDialog.empty" = "Empty";

/* The heading of the list of what else happens when records are merged. */
"monarch.mergeDialog.consequences" = "What happens";

/* The button that merges the records. %lld is the number of records. */
"monarch.mergeDialog.confirm" = "Merge %lld records";

/* The button that closes the merge dialog without merging. */
"monarch.mergeDialog.cancel" = "Cancel";

/* Shown when the merge failed and the app gave no reason. */
"monarch.mergeDialog.error" = "The records could not be merged. Nothing was changed.";
