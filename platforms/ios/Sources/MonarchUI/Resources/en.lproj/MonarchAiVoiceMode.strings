/* Spoken name of the voice conversation surface. %@ is the assistant's name. */
"monarch.aiVoiceMode.label" = "Voice conversation with %@";

/* Name used for the assistant when the app gives none. */
"monarch.aiVoiceMode.assistant" = "Assistant";

/* Speaker name on the person's own captions. */
"monarch.aiVoiceMode.you" = "You";

/* State text while the call is being set up. */
"monarch.aiVoiceMode.state.connecting" = "Connecting…";

/* State text while the assistant hears the person. */
"monarch.aiVoiceMode.state.listening" = "Listening…";

/* State text while the assistant prepares a reply. */
"monarch.aiVoiceMode.state.thinking" = "Thinking…";

/* State text while the assistant talks. */
"monarch.aiVoiceMode.state.speaking" = "Speaking…";

/* State text while the person's microphone is off. */
"monarch.aiVoiceMode.state.muted" = "Muted";

/* State text while a dropped connection is restored. */
"monarch.aiVoiceMode.state.reconnecting" = "Reconnecting…";

/* State text once the call is over. */
"monarch.aiVoiceMode.state.ended" = "Conversation ended";

/* State text when the call failed. */
"monarch.aiVoiceMode.state.error" = "Something went wrong";

/* Shown beside the state when the microphone is muted while the assistant thinks or speaks. */
"monarch.aiVoiceMode.microphoneMuted" = "Your microphone is muted";

/* Toggle that mutes the person's microphone. */
"monarch.aiVoiceMode.mute" = "Mute";

/* Button that stops the assistant's reply. */
"monarch.aiVoiceMode.interrupt" = "Interrupt";

/* Toggle that shows or hides the captions. */
"monarch.aiVoiceMode.captions" = "Captions";

/* Button that ends the call. */
"monarch.aiVoiceMode.end" = "End";

/* Button that starts a new call after one ended. */
"monarch.aiVoiceMode.restart" = "Start again";

/* Button that tries again after a failure. */
"monarch.aiVoiceMode.retry" = "Retry";

/* Shown in the captions before anyone has spoken. */
"monarch.aiVoiceMode.captionsEmpty" = "Captions appear here as you talk.";

/* Read before the running time of the call, as in "Call time: 4:05". */
"monarch.aiVoiceMode.elapsed" = "Call time";

/* Duration of an ended call. %@ is the formatted time, such as 4:05. */
"monarch.aiVoiceMode.lasted" = "Lasted %@";

/* Error text when the app gives none. */
"monarch.aiVoiceMode.errorFallback" = "The voice conversation stopped unexpectedly.";
