/* Status of a long-running AI task that is working. */
"monarch.aiTaskProgress.status.running" = "Running";

/* Status of a long-running AI task that is stopped for now. */
"monarch.aiTaskProgress.status.paused" = "Paused";

/* Status of a long-running AI task that finished. */
"monarch.aiTaskProgress.status.done" = "Done";

/* Status of a long-running AI task that stopped with an error. */
"monarch.aiTaskProgress.status.failed" = "Failed";

/* Status of a long-running AI task that the person stopped. */
"monarch.aiTaskProgress.status.cancelled" = "Cancelled";

/* Spoken name of the task's progress bar. %@ is the task title. */
"monarch.aiTaskProgress.progressLabel" = "%@ progress";

/* How much of the task is complete. %d is a percentage. */
"monarch.aiTaskProgress.progressValue" = "%d%% complete";

/* When the task started. %@ is a relative time, for example 5 minutes ago. */
"monarch.aiTaskProgress.started" = "Started %@";

/* Time left when the estimate is under a minute. */
"monarch.aiTaskProgress.eta.underMinute" = "Less than a minute left";

/* Time left when the estimate is about one minute. */
"monarch.aiTaskProgress.eta.oneMinute" = "About 1 minute left";

/* Time left in minutes. %d is the number of minutes. */
"monarch.aiTaskProgress.eta.minutes" = "About %d minutes left";

/* Time left in hours. %@ is the number of hours, for example 1.5. */
"monarch.aiTaskProgress.eta.hours" = "About %@ hours left";

/* Button that stops the task. */
"monarch.aiTaskProgress.cancel" = "Cancel";

/* Spoken name of the button that docks the task out of the way. */
"monarch.aiTaskProgress.minimize" = "Minimize";

/* Toggle that asks to be notified when the task finishes. */
"monarch.aiTaskProgress.notify" = "Notify me when done";

/* Announced when the task's status changes. %1$@ is the task title, %2$@ the status. */
"monarch.aiTaskProgress.announce" = "%1$@: %2$@";
