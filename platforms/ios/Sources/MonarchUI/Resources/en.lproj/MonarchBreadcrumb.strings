/* The spoken name of a breadcrumb trail, which shows where a screen sits in a hierarchy. */
"monarch.breadcrumb.label" = "Breadcrumb";

/* The spoken name of the button that opens the levels hidden in the middle of a long breadcrumb. %@ is the number of levels. */
"monarch.breadcrumb.more" = "Show %@ more levels";

/* Read after the last level of a breadcrumb, which is the screen the person is on. */
"monarch.breadcrumb.current" = "Current page";
