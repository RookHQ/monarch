/* The spoken form of an error message, read before the message. %@ is the message. */
"monarch.internal.error" = "Error: %@";

/* A duration under an hour, such as "45m". %ld is the minutes. */
"monarch.internal.duration.minutes" = "%ldm";

/* A duration of hours and minutes, such as "2h 05m". %1$ld is the hours, %2$@ the minutes as two digits. */
"monarch.internal.duration.hoursMinutes" = "%1$ldh %2$@m";

/* A duration of whole days, such as "3d". %ld is the days. */
"monarch.internal.duration.days" = "%ldd";

/* A duration of days and hours, such as "3d 4h". %1$ld is the days, %2$ld the hours. */
"monarch.internal.duration.daysHours" = "%1$ldd %2$ldh";

/* An elapsed time under a second. %@ is the formatted milliseconds. */
"monarch.internal.elapsed.milliseconds" = "%@ ms";

/* An elapsed time under a minute. %@ is the formatted seconds. */
"monarch.internal.elapsed.seconds" = "%@ s";

/* An elapsed time in whole minutes. %@ is the formatted minutes. */
"monarch.internal.elapsed.minutes" = "%@ min";

/* An elapsed time in minutes and seconds. %1$@ is the minutes, %2$@ the seconds. */
"monarch.internal.elapsed.minutesSeconds" = "%1$@ min %2$@ s";
