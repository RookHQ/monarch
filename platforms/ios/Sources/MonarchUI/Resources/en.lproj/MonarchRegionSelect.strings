/* Prompt of a region picker while no country is chosen. */
"monarch.regionSelect.chooseCountryFirst" = "Choose a country first";

/* Prompt of a region picker with a list while nothing is chosen. */
"monarch.regionSelect.choose" = "Choose";

/* Prompt of the text field a region picker shows for a country without a list of regions. */
"monarch.regionSelect.textEntry" = "Type the region";

/* Shown in a region picker when no region matches the search. */
"monarch.regionSelect.empty" = "No regions match";

/* Shown under a region picker when its list of regions could not be loaded. */
"monarch.regionSelect.loadFailed" = "Couldn’t load the regions.";

/* The word for the first-level regions of the United States, used as a field label. */
"monarch.regionSelect.label.US" = "State";

/* The word for the first-level regions of Canada, used as a field label. */
"monarch.regionSelect.label.CA" = "Province";

/* The word for the first-level regions of Australia, used as a field label. */
"monarch.regionSelect.label.AU" = "State or territory";

/* The word for the nations of the United Kingdom, used as a field label. */
"monarch.regionSelect.label.GB" = "Nation";

/* The word for the first-level regions of India, used as a field label. */
"monarch.regionSelect.label.IN" = "State or union territory";
