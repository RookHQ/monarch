/* Label above a structured answer written by AI, saying where it came from. */
"monarch.aiStructuredAnswer.aiAnswer" = "AI answer";

/* Read by VoiceOver for a field of an AI answer that has not arrived yet. */
"monarch.aiStructuredAnswer.pending" = "Still generating";

/* Read by VoiceOver for a field of an AI answer that has no value. */
"monarch.aiStructuredAnswer.empty" = "Not provided";

/* Announced by VoiceOver when a structured AI answer has finished arriving. */
"monarch.aiStructuredAnswer.complete" = "Response complete.";
