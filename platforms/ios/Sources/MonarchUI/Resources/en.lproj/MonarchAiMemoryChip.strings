/* Visible prefix of a memory chip when the assistant used a memory it had. */
"monarch.aiMemoryChip.prefix.read" = "Used memory:";

/* Visible prefix of a memory chip when the assistant saved or updated a memory. */
"monarch.aiMemoryChip.prefix.write" = "Remembered:";

/* Visible prefix of a memory chip when the assistant forgot a memory. */
"monarch.aiMemoryChip.prefix.forget" = "Forgotten:";

/* Read by VoiceOver as the name of a memory's options menu. %@ is a shortened copy of the memory text. */
"monarch.aiMemoryChip.options" = "Options for memory: %@";

/* Menu command that edits a memory. */
"monarch.aiMemoryChip.edit" = "Edit";

/* Menu command that removes a memory. */
"monarch.aiMemoryChip.forget" = "Forget";

/* Title of the dialog that edits a memory. */
"monarch.aiMemoryChip.editTitle" = "Edit memory";

/* Name of the text field in the dialog that edits a memory. */
"monarch.aiMemoryChip.editField" = "Memory";

/* Button that saves an edited memory. */
"monarch.aiMemoryChip.save" = "Save";

/* Button that closes the edit dialog without saving. */
"monarch.aiMemoryChip.cancel" = "Cancel";
