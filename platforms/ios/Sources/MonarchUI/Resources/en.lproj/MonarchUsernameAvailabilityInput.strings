/* Shown under a username field while its availability is being checked. */
"monarch.usernameAvailabilityInput.checking" = "Checking availability…";

/* Shown under a username field, and announced, when the name can be used. */
"monarch.usernameAvailabilityInput.valid" = "Available";

/* Shown under a username field, and announced, when the name cannot be used. */
"monarch.usernameAvailabilityInput.invalid" = "Not available";

/* Shown under a username field, and announced, when the availability check itself failed. */
"monarch.usernameAvailabilityInput.error" = "Couldn’t check availability.";

/* The title of the button that runs a failed availability check again. */
"monarch.usernameAvailabilityInput.retry" = "Try again";
