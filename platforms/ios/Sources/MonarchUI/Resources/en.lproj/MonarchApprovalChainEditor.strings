/* Heading of the steps of an approval chain. */
"monarch.approvalChainEditor.legend" = "Steps, in order";

/* Title of a step of an approval chain. %ld is its position. */
"monarch.approvalChainEditor.step" = "Step %ld";

/* Label of the menu that chooses who approves a step. */
"monarch.approvalChainEditor.approver" = "Approver";

/* Label of the menu that chooses the role or person of a step, when the approver type names none. */
"monarch.approvalChainEditor.target" = "Choose";

/* The empty choice of the role or person menu. */
"monarch.approvalChainEditor.targetPlaceholder" = "Choose…";

/* Label of the optional name of a step. */
"monarch.approvalChainEditor.label" = "Label (optional)";

/* Placeholder of the optional name of a step. */
"monarch.approvalChainEditor.labelPlaceholder" = "e.g. Finance check";

/* Button that adds a step. */
"monarch.approvalChainEditor.addStep" = "Add step";

/* Spoken name of the button that removes a step. %ld is its position. */
"monarch.approvalChainEditor.removeStep" = "Remove step %ld";

/* Error under the role or person menu when nothing is chosen. */
"monarch.approvalChainEditor.targetRequired" = "Choose who decides this step.";

/* Shown instead of the add button when the chain is full. %ld is the most steps. */
"monarch.approvalChainEditor.maxReached" = "A chain can have up to %ld steps.";

/* Spoken name of the menu that moves a step. %ld is its position. */
"monarch.approvalChainEditor.reorder" = "Reorder step %ld";

/* Moves a step one place earlier. */
"monarch.approvalChainEditor.moveUp" = "Move up";

/* Moves a step one place later. */
"monarch.approvalChainEditor.moveDown" = "Move down";

/* Announced after a step moves. %ld is its new position. */
"monarch.approvalChainEditor.moved" = "Moved to position %ld.";
