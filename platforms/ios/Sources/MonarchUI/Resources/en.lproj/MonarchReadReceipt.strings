/* The visible text of a read receipt under a message that the other people have read. */
"monarch.readReceipt.seen" = "Seen";

/* The visible text of a read receipt in a group. %ld is the number of people who have read the message. */
"monarch.readReceipt.seenByCount" = "Seen by %ld";

/* The full sentence of a read receipt, read by VoiceOver and shown on hover. %@ is the list of names, such as "Ana, Ben and Chen". */
"monarch.readReceipt.seenBy" = "Seen by %@";
