/* The spoken name of a stack of avatars of the people here now, with one person. */
"monarch.presenceAvatars.labelOne" = "1 person here";

/* The spoken name of a stack of avatars of the people here now. %ld is the number of people. */
"monarch.presenceAvatars.labelOther" = "%ld people here";

/* The spoken hint of a stack of avatars that opens the list of everyone here. */
"monarch.presenceAvatars.showAll" = "Shows everyone here";

/* The title of the list of everyone here now. */
"monarch.presenceAvatars.list" = "Everyone here";

/* The button that closes the list of everyone here. */
"monarch.presenceAvatars.done" = "Done";

/* The spoken status of one person, read after their name. %1$@ is the presence, such as "Online", %2$@ the activity, such as "Editing". */
"monarch.presenceAvatars.status" = "%1$@, %2$@";

/* The second line of a person in the list of everyone here. %1$@ is the presence, such as "Online", %2$@ the activity, such as "Editing". */
"monarch.presenceAvatars.detail" = "%1$@ · %2$@";
