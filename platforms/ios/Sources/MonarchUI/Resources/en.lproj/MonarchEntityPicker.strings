/* The field of an entity picker when nothing is chosen yet. */
"monarch.entityPicker.select" = "Select…";

/* The placeholder of the search field at the top of the entity picker list. */
"monarch.entityPicker.search" = "Search...";

/* The button that closes the entity picker list without choosing. */
"monarch.entityPicker.cancel" = "Cancel";

/* The button that closes the entity picker list when several entities can be chosen. */
"monarch.entityPicker.done" = "Done";

/* Shown in the entity picker list while results load. */
"monarch.entityPicker.loading" = "Loading…";

/* Shown in the entity picker list when nothing matches the search. */
"monarch.entityPicker.empty" = "No matches";

/* Shown until the search is long enough. %lld is the number of characters needed. */
"monarch.entityPicker.tooShort" = "Type at least %lld characters to search.";

/* Shown when the results could not be loaded. A retry button follows. */
"monarch.entityPicker.failed" = "The results could not be loaded.";

/* The row that creates a new entity from the typed text. %@ is the typed text. */
"monarch.entityPicker.create" = "Create “%@”";

/* The field when several entities are chosen. %1$@ is the first name, %2$lld how many more. */
"monarch.entityPicker.summary" = "%1$@ +%2$lld";

/* The spoken name of the button that clears the chosen entity. */
"monarch.entityPicker.clear" = "Clear";

/* The spoken value of the field when nothing is chosen. */
"monarch.entityPicker.noSelection" = "None";
