/* The name of your own tile in a call. %@ is your name. */
"monarch.callTile.you" = "%@ (you)";

/* Read by VoiceOver when a participant's microphone is off. */
"monarch.callTile.muted" = "Muted";

/* Read by VoiceOver when a participant's tile shows a shared screen. */
"monarch.callTile.sharingScreen" = "Sharing screen";

/* The badge on the tile of a participant who raised a hand. */
"monarch.callTile.handRaised" = "Hand raised";

/* Read by VoiceOver while a participant is speaking. */
"monarch.callTile.speaking" = "Speaking";

/* The button that pins a participant to the main spot. %@ is the participant's name. */
"monarch.callTile.pin" = "Pin %@";

/* The button that unpins a participant. %@ is the participant's name. */
"monarch.callTile.unpin" = "Unpin %@";

/* The button that shows a participant full screen. %@ is the participant's name. */
"monarch.callTile.fullScreen" = "Show %@ full screen";

/* Announced when a participant sends a reaction. %1$@ is the name, %2$@ the emoji. */
"monarch.callTile.reacted" = "%1$@ reacted %2$@";

/* The connection quality of a participant with a good connection. */
"monarch.callTile.qualityGood" = "Good connection";

/* The connection quality of a participant with an unstable connection. */
"monarch.callTile.qualityFair" = "Unstable connection";

/* The connection quality of a participant with a poor connection. */
"monarch.callTile.qualityPoor" = "Poor connection";
