/* Heading of the context window meter, and the name VoiceOver reads for its bar. */
"monarch.aiContextWindowMeter.label" = "Context window";

/* Summary of the context window. The first %@ is the tokens used, the second the window size, the third the percentage. */
"monarch.aiContextWindowMeter.amount" = "%1$@ of %2$@ tokens (%3$@)";

/* Wraps the summary when the token count is an estimate. %@ is the summary. */
"monarch.aiContextWindowMeter.approximate" = "About %@";

/* Read by VoiceOver as the name of the list of what fills the context window. */
"monarch.aiContextWindowMeter.legend" = "What fills the context window";

/* Legend entry for tokens that no named part covers. */
"monarch.aiContextWindowMeter.other" = "Other";

/* The amount of one legend entry. %@ is the formatted token count. */
"monarch.aiContextWindowMeter.tokens" = "%@ tokens";

/* Notice shown when the conversation nears the context limit. */
"monarch.aiContextWindowMeter.warning" = "The conversation is nearly at its context limit. Earlier messages may be left out.";

/* Notice shown when the context window is full. */
"monarch.aiContextWindowMeter.full" = "The context window is full. Earlier messages are being left out.";

/* Button that asks for earlier messages to be summarized to free room. */
"monarch.aiContextWindowMeter.summarize" = "Summarize earlier messages";

/* Read by VoiceOver as the hint of the compact meter, which opens the details. */
"monarch.aiContextWindowMeter.showDetails" = "Shows what fills the context window";
