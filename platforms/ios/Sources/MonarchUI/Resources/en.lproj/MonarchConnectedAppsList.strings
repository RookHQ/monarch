/* Title of the list of apps the person signed in to with their account. */
"monarch.connectedAppsList.title" = "Connected apps";

/* Line under the title of the connected apps list. */
"monarch.connectedAppsList.description" = "Apps you signed in to with your account, and what they can see.";

/* Badge on an app the identity provider has reviewed. */
"monarch.connectedAppsList.verified" = "Verified";

/* Badge on an app that is suspended and cannot use its access. */
"monarch.connectedAppsList.suspended" = "Suspended";

/* When the app was connected. %@ is a relative time such as "3 days ago". */
"monarch.connectedAppsList.connected" = "Connected %@";

/* When the app last used its access. %@ is a relative time such as "yesterday". */
"monarch.connectedAppsList.lastUsed" = "Last used %@";

/* The workspace an app's access belongs to. %@ is the workspace name. */
"monarch.connectedAppsList.workspace" = "Workspace: %@";

/* Spoken name of the list of what an app can see or do. %@ is the app name. */
"monarch.connectedAppsList.scopes" = "What %@ can access";

/* Button that removes an app's access to the account. */
"monarch.connectedAppsList.revoke" = "Remove access";

/* Spoken name of the button that removes an app's access. %@ is the app name. */
"monarch.connectedAppsList.revokeLabel" = "Remove access for %@";

/* Title of the confirmation before an app's access is removed. %@ is the app name. */
"monarch.connectedAppsList.confirmTitle" = "Remove access for %@?";

/* Message of the confirmation before an app's access is removed. */
"monarch.connectedAppsList.confirmMessage" = "You’ll be signed out of this app and it won’t see your information any more. You can sign in to it again later.";

/* Button that closes the confirmation without removing access. */
"monarch.connectedAppsList.cancel" = "Cancel";

/* Announced after an app's access is removed. %@ is the app name. */
"monarch.connectedAppsList.revoked" = "Removed access for %@";

/* Read while the connected apps are loading. */
"monarch.connectedAppsList.loading" = "Loading connected apps";

/* Title shown when no app is connected. */
"monarch.connectedAppsList.emptyTitle" = "No connected apps";

/* Message shown when no app is connected. */
"monarch.connectedAppsList.emptyMessage" = "When you sign in to an app with your account, it shows up here.";

/* Title shown when the connected apps could not be loaded. */
"monarch.connectedAppsList.errorTitle" = "Couldn’t load your connected apps";
