/* The marker of a post pinned to the top of its list. */
"monarch.postCard.pinned" = "Pinned";

/* The badge of a question that has an accepted answer. */
"monarch.postCard.answered" = "Answered";

/* The spoken reaction count of a post with one reaction. */
"monarch.postCard.reactionsOne" = "1 reaction";

/* The spoken reaction count of a post. %ld is the number of reactions. */
"monarch.postCard.reactionsOther" = "%ld reactions";

/* The spoken comment count of a post with one comment. */
"monarch.postCard.commentsOne" = "1 comment";

/* The spoken comment count of a post. %ld is the number of comments. */
"monarch.postCard.commentsOther" = "%ld comments";
