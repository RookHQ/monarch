/* Spoken name of the tree of AI agents in a run. */
"monarch.aiSubagentTree.label" = "Agents";

/* Shown instead of the tree when a run has no agents. */
"monarch.aiSubagentTree.empty" = "No agents yet";

/* Button that stops the selected agent. */
"monarch.aiSubagentTree.stop" = "Stop";

/* Button that opens the selected agent, for example its transcript. */
"monarch.aiSubagentTree.open" = "Open";

/* Button that answers the selected agent's question. */
"monarch.aiSubagentTree.respond" = "Respond";

/* Button that shows the part of the conversation that started the selected agent. */
"monarch.aiSubagentTree.openPart" = "Show in conversation";

/* Status of an agent: working on its task. */
"monarch.aiSubagentTree.status.working" = "Working";

/* Status of an agent: it asked a person something. */
"monarch.aiSubagentTree.status.needs-input" = "Needs input";

/* Status of an agent: not started yet. */
"monarch.aiSubagentTree.status.waiting" = "Waiting";

/* Status of an agent: finished. */
"monarch.aiSubagentTree.status.done" = "Done";

/* Status of an agent: ended with an error. */
"monarch.aiSubagentTree.status.failed" = "Failed";

/* Status of an agent: stopped before it finished. */
"monarch.aiSubagentTree.status.stopped" = "Stopped";

/* Total in the header, one agent. %@ is the formatted count. */
"monarch.aiSubagentTree.agentCount.one" = "%@ agent";

/* Total in the header, several agents. %@ is the formatted count. */
"monarch.aiSubagentTree.agentCount.other" = "%@ agents";

/* Header breakdown, working agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.working.one" = "%@ working";

/* Header breakdown, working agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.working.other" = "%@ working";

/* Header breakdown, agents that need the person. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.needs-input.one" = "%@ needs you";

/* Header breakdown, agents that need the person. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.needs-input.other" = "%@ need you";

/* Header breakdown, waiting agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.waiting.one" = "%@ waiting";

/* Header breakdown, waiting agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.waiting.other" = "%@ waiting";

/* Header breakdown, finished agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.done.one" = "%@ done";

/* Header breakdown, finished agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.done.other" = "%@ done";

/* Header breakdown, failed agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.failed.one" = "%@ failed";

/* Header breakdown, failed agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.failed.other" = "%@ failed";

/* Header breakdown, stopped agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.stopped.one" = "%@ stopped";

/* Header breakdown, stopped agents. %@ is the formatted count. */
"monarch.aiSubagentTree.statusCount.stopped.other" = "%@ stopped";

/* The header. %1$@ is the total ("4 agents"), %2$@ the breakdown ("2 working, 1 done"). */
"monarch.aiSubagentTree.summary" = "%1$@: %2$@";

/* Progress with a known plan. %1$@ is the steps done, %2$@ the total. */
"monarch.aiSubagentTree.stepsOf" = "%1$@ of %2$@ steps";

/* Progress without a known plan, one step. %@ is the formatted count. */
"monarch.aiSubagentTree.steps.one" = "%@ step";

/* Progress without a known plan, several steps. %@ is the formatted count. */
"monarch.aiSubagentTree.steps.other" = "%@ steps";

/* One tool call. %@ is the formatted count. */
"monarch.aiSubagentTree.toolCalls.one" = "%@ tool call";

/* Several tool calls. %@ is the formatted count. */
"monarch.aiSubagentTree.toolCalls.other" = "%@ tool calls";

/* Start time of an agent that has not ended. %@ is the time. */
"monarch.aiSubagentTree.started" = "Started %@";

/* Start and end time of an agent that has ended. %1$@ is the start, %2$@ the end. */
"monarch.aiSubagentTree.ran" = "%1$@ to %2$@";

/* Spoken name of the buttons for the selected agent. %@ is the agent's name. */
"monarch.aiSubagentTree.actionsFor" = "Actions for %@";

/* Announced when an agent's status changes. %1$@ is the agent, %2$@ the new status. */
"monarch.aiSubagentTree.announce" = "%1$@: %2$@";

/* Spoken name of the button that shows the agents under an agent. %@ is its name. */
"monarch.aiSubagentTree.expand" = "Show agents under %@";

/* Spoken name of the button that hides the agents under an agent. %@ is its name. */
"monarch.aiSubagentTree.collapse" = "Hide agents under %@";
