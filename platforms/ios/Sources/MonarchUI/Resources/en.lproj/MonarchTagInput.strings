/* Shown under a tag input when the typed tag is already in the list. %@ is the tag. */
"monarch.tagInput.duplicate" = "“%@” is already added.";

/* Shown under a tag input when no more tags can be added. %ld is the maximum number of tags. */
"monarch.tagInput.maximum" = "You can add up to %ld.";

/* Announced after a tag was added to a tag input. %@ is the tag. */
"monarch.tagInput.added" = "Added %@.";

/* Announced after a tag was removed from a tag input. %@ is the tag. */
"monarch.tagInput.removed" = "Removed %@.";

/* The spoken name of a suggestion button under a tag input. %@ is the suggested tag. */
"monarch.tagInput.addSuggestion" = "Add %@";
