/* Small label above the title of a tool call waiting for approval. */
"monarch.aiToolApproval.eyebrow" = "Approval needed";

/* Risk badge of a tool call with little harm. */
"monarch.aiToolApproval.risk.low" = "Low risk";

/* Risk badge of a tool call with some harm. */
"monarch.aiToolApproval.risk.medium" = "Medium risk";

/* Risk badge of a tool call with much harm. */
"monarch.aiToolApproval.risk.high" = "High risk";

/* Risk badge of a tool call that cannot be undone. */
"monarch.aiToolApproval.risk.destructive" = "Can’t be undone";

/* Consequence line of a tool call that cannot be undone. */
"monarch.aiToolApproval.consequence.destructive" = "This can’t be undone once it runs.";

/* Heading of the arguments of a tool call. */
"monarch.aiToolApproval.arguments" = "Details";

/* Shown when a tool call has no arguments. */
"monarch.aiToolApproval.noArguments" = "No arguments.";

/* Button that lets the tool call run. */
"monarch.aiToolApproval.approve" = "Approve";

/* Button that stops the tool call from running. */
"monarch.aiToolApproval.deny" = "Deny";

/* Button that opens the editor of the arguments. */
"monarch.aiToolApproval.editArguments" = "Edit arguments";

/* Button that closes the editor of the arguments and drops the edits. */
"monarch.aiToolApproval.discardEdits" = "Discard edits";

/* Label of the editor of the arguments. */
"monarch.aiToolApproval.argumentsJSON" = "Arguments (JSON)";

/* Error when the edited arguments are not valid JSON. */
"monarch.aiToolApproval.invalidJSON" = "Fix the JSON before approving.";

/* Button that opens the reason field. */
"monarch.aiToolApproval.addReason" = "Add a reason";

/* Label of the reason field. */
"monarch.aiToolApproval.reason" = "Reason (optional)";

/* Checkbox that approves this tool from now on. */
"monarch.aiToolApproval.alwaysAllow" = "Always allow this tool";

/* Shown once the tool call is approved. */
"monarch.aiToolApproval.approved" = "Approved";

/* Shown once the tool call is denied. */
"monarch.aiToolApproval.denied" = "Denied";

/* Shown when the reply stopped before anyone decided. */
"monarch.aiToolApproval.cancelled" = "Cancelled";

/* Announced when the card appears. %@ is the title of the call. */
"monarch.aiToolApproval.announce" = "Approval needed: %@";
