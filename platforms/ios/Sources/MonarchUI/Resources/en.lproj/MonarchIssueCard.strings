/* Due date of an issue. %@ is the short date, such as Mar 12. */
"monarch.issueCard.due" = "Due %@";
/* Marker after the due date of an issue when the date has passed. */
"monarch.issueCard.overdue" = "Overdue";
/* Spoken name of the labels of an issue. */
"monarch.issueCard.tags" = "Labels";
/* Spoken for an issue that nobody is assigned to. */
"monarch.issueCard.unassigned" = "Unassigned";
/* Spoken name of the assignee's avatar. %@ is the person's name. */
"monarch.issueCard.assignee" = "Assigned to %@";
/* Spoken status of an issue. %@ is the status name, such as In progress. */
"monarch.issueCard.status" = "Status: %@";
/* Spoken priority of an issue. %@ is the level name, such as High. */
"monarch.issueCard.priority" = "Priority: %@";
/* Priority level: needs attention now. */
"monarch.issueCard.priority.urgent" = "Urgent";
/* Priority level: next in line. */
"monarch.issueCard.priority.high" = "High";
/* Priority level: normal. */
"monarch.issueCard.priority.medium" = "Medium";
/* Priority level: when there is time. */
"monarch.issueCard.priority.low" = "Low";
/* Priority level: none set. */
"monarch.issueCard.priority.none" = "No priority";
/* Spoken on an issue card that is selected. */
"monarch.issueCard.selected" = "Selected";
