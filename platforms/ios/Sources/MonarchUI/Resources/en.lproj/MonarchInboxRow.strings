/* Read by VoiceOver for an unread conversation in an inbox. */
"monarch.inboxRow.unread" = "Unread";

/* Read by VoiceOver for a conversation with unread messages. %ld is the number of unread messages. */
"monarch.inboxRow.unreadCount" = "%ld unread";

/* The age of a conversation that changed less than a minute ago. */
"monarch.inboxRow.ageNow" = "now";

/* The compact age of a conversation in minutes. %ld is the number of minutes. */
"monarch.inboxRow.ageMinutes" = "%ldm";

/* The compact age of a conversation in hours. %ld is the number of hours. */
"monarch.inboxRow.ageHours" = "%ldh";

/* The compact age of a conversation in days. %ld is the number of days. */
"monarch.inboxRow.ageDays" = "%ldd";

/* The compact age of a conversation in weeks. %ld is the number of weeks. */
"monarch.inboxRow.ageWeeks" = "%ldw";

/* The swipe action that marks a conversation as read. */
"monarch.inboxRow.markRead" = "Read";

/* The swipe action that marks a conversation as unread. */
"monarch.inboxRow.markUnread" = "Unread";

/* The swipe action that archives a conversation. */
"monarch.inboxRow.archive" = "Archive";

/* The swipe action that deletes a conversation. */
"monarch.inboxRow.delete" = "Delete";

