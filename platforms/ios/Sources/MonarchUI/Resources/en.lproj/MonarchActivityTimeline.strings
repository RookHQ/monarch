/* Spoken name of an activity feed that is not grouped by day. */
"monarch.activityTimeline.list" = "Activity";
/* The heading of today's events in an activity feed. */
"monarch.activityTimeline.today" = "Today";
/* The heading of yesterday's events in an activity feed. */
"monarch.activityTimeline.yesterday" = "Yesterday";
/* The tag after an event done by an automation or the system, so readers can tell people from rules. */
"monarch.activityTimeline.automated" = "Automated";
/* The disclosure that shows the details of an event, such as a field change. */
"monarch.activityTimeline.details" = "Details";
/* The link that opens the details of an event. */
"monarch.activityTimeline.showDetails" = "Show details";
/* The link that closes the details of an event. */
"monarch.activityTimeline.hideDetails" = "Hide details";
/* Shown when an activity feed has no events. */
"monarch.activityTimeline.empty" = "No activity yet";
/* Spoken while an activity feed loads its first page. */
"monarch.activityTimeline.loading" = "Loading activity";
/* Shown when an activity feed failed to load. */
"monarch.activityTimeline.error" = "Couldn’t load activity.";
