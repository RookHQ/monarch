/* Shown under a message while it is being sent. */
"monarch.messageRow.sending" = "Sending…";

/* Shown under a message that could not be sent, when the app gives no reason. */
"monarch.messageRow.failed" = "Not sent";

/* The button that sends a failed message again. */
"monarch.messageRow.retry" = "Retry";

/* The button that removes a failed message. */
"monarch.messageRow.discard" = "Discard";

/* The marker after the body of a message that was edited. */
"monarch.messageRow.edited" = "(edited)";

/* The VoiceOver action that opens the edit history of an edited message. */
"monarch.messageRow.editHistory" = "Show edit history";

/* The body of a message that was deleted. */
"monarch.messageRow.deleted" = "This message was deleted.";

/* The thread button of a message with one reply. */
"monarch.messageRow.reply" = "1 reply";

/* The thread button of a message with several replies. %ld is the number of replies. */
"monarch.messageRow.replies" = "%ld replies";

/* Read by VoiceOver before a follow-up message whose author is not shown. %1$@ is the author, %2$@ the time. */
"monarch.messageRow.byline" = "%1$@, %2$@";
