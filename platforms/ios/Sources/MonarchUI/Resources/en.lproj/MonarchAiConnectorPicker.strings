/* The navigation title of the connector picker. */
"monarch.aiConnectorPicker.title" = "Connectors";

/* The prompt of the search field of the connector picker. */
"monarch.aiConnectorPicker.searchPrompt" = "Search connectors";

/* The button that closes the connector picker sheet. */
"monarch.aiConnectorPicker.done" = "Done";

/* The summary line. %1$@ is the first part (connectors on), %2$@ the second part (tools that ask first). */
"monarch.aiConnectorPicker.summary" = "%1$@ · %2$@";

/* First part of the summary when there is 1 connector. %1$@ is the number on, %2$@ the total. */
"monarch.aiConnectorPicker.connectorsOn.one" = "%1$@ of %2$@ connector on";

/* First part of the summary for several connectors. %1$@ is the number on, %2$@ the total. */
"monarch.aiConnectorPicker.connectorsOn.other" = "%1$@ of %2$@ connectors on";

/* Second part of the summary when 1 tool asks first. %@ is the number. */
"monarch.aiConnectorPicker.toolsAsk.one" = "%@ tool asks first";

/* Second part of the summary when several or no tools ask first. %@ is the number. */
"monarch.aiConnectorPicker.toolsAsk.other" = "%@ tools ask first";

/* Announced when the search finds nothing. */
"monarch.aiConnectorPicker.results.none" = "No connectors found";

/* Announced when the search finds 1 connector. %@ is the number. */
"monarch.aiConnectorPicker.results.one" = "%@ connector found";

/* Announced when the search finds several connectors. %@ is the number. */
"monarch.aiConnectorPicker.results.other" = "%@ connectors found";

/* Shown when the search matches no connector. %@ is the search text. */
"monarch.aiConnectorPicker.noResults" = "No connectors match “%@”.";

/* The button that clears the search. */
"monarch.aiConnectorPicker.clearSearch" = "Clear search";

/* Shown when there are no connectors at all. */
"monarch.aiConnectorPicker.empty" = "No connectors are available.";

/* The status of a connector that works. */
"monarch.aiConnectorPicker.status.connected" = "Connected";

/* The status of a connector that needs the person to sign in. */
"monarch.aiConnectorPicker.status.needsSignIn" = "Sign-in needed";

/* The status of a connector whose connection failed. */
"monarch.aiConnectorPicker.status.error" = "Connection problem";

/* The status of a connector that cannot be used now. */
"monarch.aiConnectorPicker.status.unavailable" = "Unavailable";

/* After Connected, who the connector is connected as. %@ is the account, such as an email address. */
"monarch.aiConnectorPicker.account" = "as %@";

/* The spoken name of a connector's switch. %@ is the connector name. */
"monarch.aiConnectorPicker.enable" = "Use %@ in this conversation";

/* Why the switch is off for a connector that needs sign-in. */
"monarch.aiConnectorPicker.disabledReason.needsSignIn" = "Sign in before turning this on.";

/* Why the switch is off for a connector with a connection problem. */
"monarch.aiConnectorPicker.disabledReason.error" = "Reconnect before turning this on.";

/* Why the switch is off for a connector that is unavailable. */
"monarch.aiConnectorPicker.disabledReason.unavailable" = "This connector cannot be used right now.";

/* Why the switch is off for a connected connector. Not normally shown. */
"monarch.aiConnectorPicker.disabledReason.connected" = "";

/* The button that signs in to a connector. */
"monarch.aiConnectorPicker.signIn" = "Sign in";

/* The button that reconnects a connector. */
"monarch.aiConnectorPicker.reconnect" = "Reconnect";

/* The button that opens a connector's settings. */
"monarch.aiConnectorPicker.manage" = "Manage";

/* The spoken name of a row button. %1$@ is the action, %2$@ the connector, as in "Sign in: Calendar". */
"monarch.aiConnectorPicker.actionLabel" = "%1$@: %2$@";

/* The title of a connector's list of tools when it has 1 tool. %@ is the number. */
"monarch.aiConnectorPicker.tools.one" = "%@ tool";

/* The title of a connector's list of tools. %@ is the number. */
"monarch.aiConnectorPicker.tools.other" = "%@ tools";

/* The name of a tool's permission picker. %@ is the tool name. */
"monarch.aiConnectorPicker.permissionLabel" = "Permission for %@";

/* The permission that runs a tool without asking. */
"monarch.aiConnectorPicker.permission.allow" = "Allow";

/* The permission that asks the person each time. */
"monarch.aiConnectorPicker.permission.ask" = "Ask first";

/* The permission that never runs a tool. */
"monarch.aiConnectorPicker.permission.never" = "Never";

/* The badge of a tool that only reads data. */
"monarch.aiConnectorPicker.risk.read" = "Reads data";

/* The badge of a tool that changes data. */
"monarch.aiConnectorPicker.risk.write" = "Changes data";

/* The badge of a tool that can delete data. */
"monarch.aiConnectorPicker.risk.destructive" = "Can delete data";

/* Why Allow is not offered for a tool that can delete data. */
"monarch.aiConnectorPicker.destructiveLocked" = "Tools that can delete data cannot run without asking.";
