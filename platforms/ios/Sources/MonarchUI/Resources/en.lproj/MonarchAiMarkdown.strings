/* Read by VoiceOver as the name of a table in an AI answer. */
"monarch.aiMarkdown.table" = "Table";

/* Read by VoiceOver as the size of a table in an AI answer. The first %d is the number of rows, the second the number of columns. */
"monarch.aiMarkdown.tableSize" = "%1$d rows, %2$d columns";

/* Heading of the footnotes listed at the end of an AI answer. */
"monarch.aiMarkdown.footnotes" = "Footnotes";

/* Read by VoiceOver as the name of a task-list check mark in an AI answer; its checked state is read after it. */
"monarch.aiMarkdown.task" = "Task";

/* Shown after a link in an AI answer whose text does not name the site it opens. %@ is the host, such as example.com. */
"monarch.aiMarkdown.linkHost" = "(%@)";
