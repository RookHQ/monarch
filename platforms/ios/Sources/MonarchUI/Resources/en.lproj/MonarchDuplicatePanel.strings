/* The heading of the duplicate panel when there is one likely duplicate. */
"monarch.duplicatePanel.title.one" = "Possible duplicate";

/* The heading of the duplicate panel when there are several likely duplicates. */
"monarch.duplicatePanel.title.other" = "Possible duplicates";

/* How confident a match is. %@ is a formatted percentage, for example 92%. */
"monarch.duplicatePanel.score" = "%@ match";

/* The title of the button that opens a likely duplicate. */
"monarch.duplicatePanel.open" = "Open";

/* The title of the button that merges a likely duplicate into the record. */
"monarch.duplicatePanel.merge" = "Merge";

/* The title of the button that says a match is not a duplicate. */
"monarch.duplicatePanel.dismiss" = "Not a duplicate";

/* The spoken name of an action button of one match. The first %@ is the button title, the second the name of the record. */
"monarch.duplicatePanel.actionLabel" = "%1$@: %2$@";
