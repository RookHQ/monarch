/* Shown while an embedded screen from another app loads. */
"monarch.embeddedAppFrame.loading" = "Loading…";

/* The title shown when an embedded screen did not open. */
"monarch.embeddedAppFrame.errorTitle" = "This page didn’t open";

/* The message shown when an embedded screen did not open. */
"monarch.embeddedAppFrame.errorDescription" = "The app didn’t respond in time. It may be briefly unavailable. Try again, or open the page directly.";

/* The button that loads an embedded screen again. */
"monarch.embeddedAppFrame.retry" = "Try again";

/* The button that opens the embedded page outside the frame. */
"monarch.embeddedAppFrame.open" = "Open page";
