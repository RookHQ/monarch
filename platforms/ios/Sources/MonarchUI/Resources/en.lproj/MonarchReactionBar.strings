/* The spoken name of the row of emoji reactions under a message or post. */
"monarch.reactionBar.label" = "Reactions";

/* The spoken name of a reaction chip with one reaction. %@ is the emoji's name, such as "thumbs up". */
"monarch.reactionBar.reactionOne" = "%@, 1 reaction";

/* The spoken name of a reaction chip. %1$@ is the emoji's name, such as "thumbs up", %2$ld the number of reactions. */
"monarch.reactionBar.reactionOther" = "%1$@, %2$ld reactions";

/* The button that opens the emoji picker to add a reaction. */
"monarch.reactionBar.add" = "Add reaction";

/* The heading of the people who reacted with an emoji, offered by VoiceOver as more content. */
"monarch.reactionBar.reactedBy" = "Reacted by";
