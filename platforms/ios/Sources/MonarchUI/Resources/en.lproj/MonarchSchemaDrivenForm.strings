/* The button that submits a form generated from a schema, and the Save button of an edit form. */
"monarch.schemaDrivenForm.submit" = "Save";

/* Shown in a danger banner when saving a form failed without a message of its own. */
"monarch.schemaDrivenForm.submitFailed" = "The form could not be saved. Try again.";

/* Spoken for a question without an answer in the read-only view of a form, which shows a dash. */
"monarch.schemaDrivenForm.empty" = "Not set";

/* Spoken for the progress indicator shown in place of the Save button while a form is saved. */
"monarch.schemaDrivenForm.saving" = "Saving";

/* The navigation bar button that throws away the unsaved changes of a form. */
"monarch.schemaDrivenForm.discard" = "Discard";

/* The title of the confirmation before unsaved changes of a form are thrown away. */
"monarch.schemaDrivenForm.discardTitle" = "Discard unsaved changes?";

/* The message of the confirmation before unsaved changes of a form are thrown away. */
"monarch.schemaDrivenForm.discardMessage" = "Your changes will be lost. This cannot be undone.";

/* The destructive button that confirms throwing away the unsaved changes of a form. */
"monarch.schemaDrivenForm.discardConfirm" = "Discard changes";

/* The button that closes the discard confirmation and keeps the changes of a form. */
"monarch.schemaDrivenForm.keepEditing" = "Keep editing";
