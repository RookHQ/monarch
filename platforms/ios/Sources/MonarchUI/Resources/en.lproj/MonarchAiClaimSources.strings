/* The heading of the view that ties the claims of an AI answer to their sources. */
"monarch.aiClaimSources.heading" = "Where this came from";

/* The summary when there are no claims. */
"monarch.aiClaimSources.summary.none" = "No claims";

/* The summary with one claim. %1$lld is the count, %2$@ the list of counts by support level. */
"monarch.aiClaimSources.summary.one" = "%1$lld claim: %2$@";

/* The summary with several claims. %1$lld is the count, %2$@ the list of counts by support level. */
"monarch.aiClaimSources.summary.other" = "%1$lld claims: %2$@";

/* Between the counts in the summary. */
"monarch.aiClaimSources.summary.separator" = ", ";

/* A count in the summary. %lld is the number of supported claims. */
"monarch.aiClaimSources.summary.supported" = "%lld supported";

/* A count in the summary. %lld is the number of partly supported claims. */
"monarch.aiClaimSources.summary.partial" = "%lld partly";

/* A count in the summary. %lld is the number of claims no source supports. */
"monarch.aiClaimSources.summary.unsupported" = "%lld without a source";

/* A count in the summary. %lld is the number of claims the sources disagree about. */
"monarch.aiClaimSources.summary.conflicting" = "%lld with sources that disagree";

/* A count in the summary. %lld is the number of claims not checked yet. */
"monarch.aiClaimSources.summary.unchecked" = "%lld not checked";

/* The name of the picker that filters the claims. */
"monarch.aiClaimSources.filterLabel" = "Show claims";

/* The filter option that shows every claim. */
"monarch.aiClaimSources.all" = "All";

/* The filter option that shows the claims that are not fully supported. */
"monarch.aiClaimSources.needsChecking" = "Needs checking";

/* The support level of a claim backed by its sources. */
"monarch.aiClaimSources.support.supported" = "Supported";

/* The support level of a claim backed only in part. */
"monarch.aiClaimSources.support.partial" = "Partly supported";

/* The support level of a claim no source backs. */
"monarch.aiClaimSources.support.unsupported" = "No source supports this";

/* The support level of a claim the sources disagree about. */
"monarch.aiClaimSources.support.conflicting" = "Sources disagree";

/* The support level of a claim not compared with the sources yet. */
"monarch.aiClaimSources.support.unchecked" = "Not checked yet";

/* The note in an open, partly supported claim. */
"monarch.aiClaimSources.note.partial" = "The sources back only part of this claim.";

/* The note in an open claim no source supports. */
"monarch.aiClaimSources.note.unsupported" = "No source supports this claim. Check it yourself before you rely on it.";

/* The note in an open claim the sources disagree about. */
"monarch.aiClaimSources.note.conflicting" = "Sources disagree about this claim. Read both sides before you rely on it.";

/* The note in an open claim not checked yet. */
"monarch.aiClaimSources.note.unchecked" = "This claim has not been checked against the sources yet.";

/* The number of passages of a claim with none. */
"monarch.aiClaimSources.passages.none" = "No passages";

/* The number of passages of a claim with one. %lld is the count. */
"monarch.aiClaimSources.passages.one" = "%lld passage";

/* The number of passages of a claim with several. %lld is the count. */
"monarch.aiClaimSources.passages.other" = "%lld passages";

/* The spoken name of a claim's list of passages. %@ is the claim. */
"monarch.aiClaimSources.evidenceLabel" = "Passages for: %@";

/* The stance of a passage that backs the claim. */
"monarch.aiClaimSources.stance.supports" = "Supports the claim";

/* The stance of a passage that speaks against the claim. */
"monarch.aiClaimSources.stance.contradicts" = "Contradicts the claim";

/* The title of a passage whose source is missing. */
"monarch.aiClaimSources.unknownSource" = "Unknown source";

/* The publication date of a source. %@ is the formatted date. */
"monarch.aiClaimSources.published" = "Published %@";

/* The button that opens a passage's source. */
"monarch.aiClaimSources.openSource" = "Open source";

/* Added to the spoken name of a passage's buttons. %@ is the source's title. */
"monarch.aiClaimSources.fromSource" = "from %@";

/* The button that copies a passage. */
"monarch.aiClaimSources.copyQuote" = "Copy quote";

/* The copy button after the passage is copied. */
"monarch.aiClaimSources.copied" = "Copied";

/* Announced after a passage is copied. */
"monarch.aiClaimSources.copiedAnnouncement" = "Quote copied to clipboard";

/* The button that reports a problem with a claim. */
"monarch.aiClaimSources.flag" = "Report a problem";

/* The button that checks an unchecked claim against the sources. */
"monarch.aiClaimSources.verify" = "Check again";

/* Shown when there are no claims. */
"monarch.aiClaimSources.empty" = "There are no claims to check.";

/* Shown when the Needs checking filter has nothing to show. */
"monarch.aiClaimSources.noneNeedChecking" = "Nothing needs checking: every claim is supported by a source.";

/* Shown in an open claim with no passages. */
"monarch.aiClaimSources.noEvidence" = "No passages were provided for this claim.";

/* Announced when the filter changes. %1$lld is how many claims are shown, %2$lld the total. */
"monarch.aiClaimSources.showing" = "Showing %1$lld of %2$lld claims";
