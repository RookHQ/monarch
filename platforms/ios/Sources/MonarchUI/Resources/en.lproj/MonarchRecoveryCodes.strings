/* Spoken name of the list of one-time account recovery codes. */
"monarch.recoveryCodes.listLabel" = "Recovery codes";

/* Line above the recovery codes once some are used. %1$d is the number of unused codes, %2$d the total. */
"monarch.recoveryCodes.remaining" = "%1$d of %2$d codes left";

/* Read after a recovery code that has been used. */
"monarch.recoveryCodes.used" = "Used";

/* Button that copies the unused recovery codes. */
"monarch.recoveryCodes.copy" = "Copy codes";

/* Title of the copy button after the codes were copied. */
"monarch.recoveryCodes.copied" = "Copied";

/* Button that opens the system share sheet, where the codes can be saved to a file. */
"monarch.recoveryCodes.save" = "Save or share";

/* Button that saves the recovery codes as a text file with the system file exporter. */
"monarch.recoveryCodes.saveToFiles" = "Save to Files";

/* Announced after the recovery codes file was saved. */
"monarch.recoveryCodes.saved" = "Recovery codes saved.";

/* Announced when the recovery codes file could not be saved. */
"monarch.recoveryCodes.saveFailed" = "Couldn’t save the recovery codes.";

/* Button that shows the hidden recovery codes. */
"monarch.recoveryCodes.reveal" = "Show codes";

/* Button that hides the recovery codes. */
"monarch.recoveryCodes.conceal" = "Hide codes";

/* Shown instead of the recovery codes while they are hidden. */
"monarch.recoveryCodes.concealedHint" = "Your codes are hidden. Show them only where nobody can see your screen.";

/* Button that replaces the recovery codes with new ones. */
"monarch.recoveryCodes.regenerate" = "Generate new codes";

/* Title of the confirmation before new recovery codes are generated. */
"monarch.recoveryCodes.regenerateTitle" = "Generate new recovery codes?";

/* Message of the confirmation before new recovery codes are generated. */
"monarch.recoveryCodes.regenerateDescription" = "Your current codes will stop working straight away. Save the new ones somewhere safe.";

/* Button that confirms generating new recovery codes. */
"monarch.recoveryCodes.regenerateConfirm" = "Generate new codes";

/* Button that closes the confirmation without generating new codes. */
"monarch.recoveryCodes.cancel" = "Cancel";

/* Announced after new recovery codes are generated. */
"monarch.recoveryCodes.regenerated" = "New recovery codes generated. The old ones no longer work.";

/* Checkbox the person ticks to confirm the recovery codes are saved. */
"monarch.recoveryCodes.acknowledge" = "I have saved my recovery codes";

/* Error shown when the person continues without confirming the codes are saved. */
"monarch.recoveryCodes.acknowledgeMissing" = "Confirm that you have saved the codes.";

/* Button that finishes the recovery codes step. */
"monarch.recoveryCodes.continue" = "Continue";
