/* The heading of the stage column in a funnel chart's data table. */
"monarch.funnelChart.stage" = "Stage";
/* The heading of the column of counts in a funnel chart's data table. */
"monarch.funnelChart.value" = "Count";
/* The heading of the column with the share of the previous stage that reached a stage. */
"monarch.funnelChart.fromPrevious" = "From previous";
/* The heading of the column with the share of the first stage that reached a stage. */
"monarch.funnelChart.ofFirst" = "Of first";
/* The line between two stages of a funnel. %1$@ is the share that continued, %2$@ is the number that dropped. */
"monarch.funnelChart.step" = "%1$@ continued · %2$@ dropped";
/* The summary of a funnel with one stage. %1$@ is its name. */
"monarch.funnelChart.oneStage" = "1 stage, %1$@";
/* The summary of a funnel. %1$@ is the number of stages, %2$@ the first stage, %3$@ the last. */
"monarch.funnelChart.stages" = "%1$@ stages from %2$@ to %3$@";
/* The overall conversion of a funnel. %1$@ is the share of the first stage that reached the last. */
"monarch.funnelChart.overall" = "Overall conversion %1$@";
/* The largest drop between two stages. %1$@ is the stage before, %2$@ the stage after, %3$@ the share lost. */
"monarch.funnelChart.largestDrop" = "Largest drop: %1$@ to %2$@, %3$@ lost";
/* Spoken for the first stage of a funnel. %1$@ is its name, %2$@ its value. */
"monarch.funnelChart.describeFirst" = "%1$@: %2$@";
/* Spoken for a later stage. %1$@ is its name, %2$@ its value, %3$@ the share of the previous stage, %4$@ the share of the first. */
"monarch.funnelChart.describe" = "%1$@: %2$@, %3$@ of previous, %4$@ of first";
