/* The state of a service-level target that is running with time to spare. */
"monarch.slaIndicator.onTrack" = "On track";

/* The state of a service-level target that is running and close to its due time. */
"monarch.slaIndicator.atRisk" = "At risk";

/* The state of a service-level target whose due time has passed. */
"monarch.slaIndicator.breached" = "Breached";

/* The state of a service-level target whose clock is stopped. */
"monarch.slaIndicator.paused" = "Paused";

/* The state of a service-level target that was achieved in time. */
"monarch.slaIndicator.met" = "Met";

/* Shown and read when no service-level target applies. */
"monarch.slaIndicator.notApplicable" = "No SLA";

/* Shown when no service-level target applies and the name is not wanted. Not read by VoiceOver. */
"monarch.slaIndicator.notApplicableMark" = "—";

/* The time left before a target is due. %@ is a duration such as "2h 15m". */
"monarch.slaIndicator.remaining" = "%@ left";

/* The time since a target was due. %@ is a duration such as "40m". */
"monarch.slaIndicator.overdue" = "Overdue %@";

/* A duration shorter than one minute, shown. */
"monarch.slaIndicator.lessThanMinute" = "<1m";

/* A duration shorter than one minute, read by VoiceOver. */
"monarch.slaIndicator.lessThanMinuteSpoken" = "less than a minute";

/* Read by VoiceOver after the state. %@ is the date and time the target is due. */
"monarch.slaIndicator.due" = "due %@";

/* Read by VoiceOver when an earlier target of the same item was breached. */
"monarch.slaIndicator.earlierBreach" = "an earlier target was breached";

/* Announced when the state of a named target changes. The first %@ is the name of the target, the second the new state. */
"monarch.slaIndicator.changedTarget" = "%1$@: %2$@";

/* Announced when the state of a target without a name changes. %@ is the new state. */
"monarch.slaIndicator.changed" = "SLA %@";
