/* The spoken name of a text with AI-suggested changes marked in it. */
"monarch.aiInlineDiff.label" = "AI suggested changes";

/* Read before text the AI suggests removing. */
"monarch.aiInlineDiff.deleted" = "Deleted:";

/* Read before text the AI suggests adding. */
"monarch.aiInlineDiff.inserted" = "Inserted:";

/* The position of the change on show. The first %ld is the change, the second the total. */
"monarch.aiInlineDiff.position" = "Change %1$ld of %2$ld";

/* Shown when there are no suggested changes. */
"monarch.aiInlineDiff.none" = "No suggested changes";

/* The button that shows the previous change. */
"monarch.aiInlineDiff.previous" = "Previous change";

/* The button that shows the next change. */
"monarch.aiInlineDiff.next" = "Next change";

/* The visible title of the button that accepts the change on show. */
"monarch.aiInlineDiff.acceptTitle" = "Accept";

/* The visible title of the button that rejects the change on show. */
"monarch.aiInlineDiff.rejectTitle" = "Reject";

/* The spoken name of the accept button. The first %ld is the change, the second the total. */
"monarch.aiInlineDiff.accept" = "Accept change %1$ld of %2$ld";

/* The spoken name of the reject button. The first %ld is the change, the second the total. */
"monarch.aiInlineDiff.reject" = "Reject change %1$ld of %2$ld";

/* Announced after a change is accepted. %ld is how many changes are left, more than zero. */
"monarch.aiInlineDiff.acceptedLeft" = "Change accepted. %ld left.";

/* Announced after the last change is accepted. */
"monarch.aiInlineDiff.acceptedNone" = "Change accepted. No changes left.";

/* Announced after a change is rejected. %ld is how many changes are left, more than zero. */
"monarch.aiInlineDiff.rejectedLeft" = "Change rejected. %ld left.";

/* Announced after the last change is rejected. */
"monarch.aiInlineDiff.rejectedNone" = "Change rejected. No changes left.";
