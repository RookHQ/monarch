/* The name of the lowest password strength. */
"monarch.passwordStrengthMeter.level.veryWeak" = "Very weak";

/* The name of the second lowest password strength. */
"monarch.passwordStrengthMeter.level.weak" = "Weak";

/* The name of the middle password strength. */
"monarch.passwordStrengthMeter.level.fair" = "Fair";

/* The name of the second highest password strength. */
"monarch.passwordStrengthMeter.level.good" = "Good";

/* The name of the highest password strength. */
"monarch.passwordStrengthMeter.level.strong" = "Strong";

/* Shown in place of a strength name while the password is empty. */
"monarch.passwordStrengthMeter.empty" = "Not entered";

/* The strength line under the bar. %@ is the strength name, or the text for an empty password. */
"monarch.passwordStrengthMeter.strength" = "Password strength: %@";

/* The spoken name of the list of password requirements. */
"monarch.passwordStrengthMeter.rulesLabel" = "Password requirements";

/* A requirement the password meets, as spoken. %@ is the requirement. */
"monarch.passwordStrengthMeter.met" = "Met: %@";

/* A requirement the password does not meet, as spoken. %@ is the requirement. */
"monarch.passwordStrengthMeter.unmet" = "Not met: %@";

/* The default requirement for the length of a password. */
"monarch.passwordStrengthMeter.rule.length" = "At least 8 characters";

/* The default requirement for letter case in a password. */
"monarch.passwordStrengthMeter.rule.case" = "Upper and lower case letters";

/* The default requirement for a digit in a password. */
"monarch.passwordStrengthMeter.rule.number" = "A number";

/* The default requirement for a character that is neither a letter nor a digit. */
"monarch.passwordStrengthMeter.rule.symbol" = "A symbol or space";
