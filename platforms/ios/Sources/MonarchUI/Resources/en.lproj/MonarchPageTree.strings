/* The spoken name of the tree of a document's pages. */
"monarch.pageTree.label" = "Pages";

/* The title shown for a page whose title is blank. */
"monarch.pageTree.untitled" = "Untitled page";

/* Shown in a group of pages that has no pages. */
"monarch.pageTree.noPages" = "No pages yet.";

/* The spoken name of the button that adds a page to a group. %@ is the group name. */
"monarch.pageTree.addPage" = "Add page to %@";

/* The button that adds a group of pages, and the confirm button of its dialog. */
"monarch.pageTree.addGroup" = "Add group";

/* The spoken name of a group's menu. %@ is the group name. */
"monarch.pageTree.groupActions" = "Actions for %@";

/* The menu item that renames a group, and the title of its dialog. */
"monarch.pageTree.renameGroup" = "Rename group";

/* The menu item that moves a group up. */
"monarch.pageTree.moveGroupUp" = "Move group up";

/* The menu item that moves a group down. */
"monarch.pageTree.moveGroupDown" = "Move group down";

/* The menu item that deletes a group, and the confirm button of its dialog. */
"monarch.pageTree.deleteGroup" = "Delete group";

/* The heading of the groups a page can be moved to. */
"monarch.pageTree.moveTo" = "Move to";

/* The accessibility action that moves a page up within its group. */
"monarch.pageTree.movePageUp" = "Move up";

/* The accessibility action that moves a page down within its group. */
"monarch.pageTree.movePageDown" = "Move down";

/* The menu item that deletes a page, and the confirm button of its dialog. */
"monarch.pageTree.deletePage" = "Delete page";

/* The title of the dialog that adds a group. */
"monarch.pageTree.addGroupTitle" = "Add a group";

/* The label of the field for a group's name. */
"monarch.pageTree.groupName" = "Group name";

/* The suggested name of a new group. */
"monarch.pageTree.newGroupName" = "New group";

/* The confirm button of the rename dialog. */
"monarch.pageTree.renameSubmit" = "Rename";

/* The cancel button of the page tree's dialogs. */
"monarch.pageTree.cancel" = "Cancel";

/* The title of the dialog that deletes a group. %@ is the group name. */
"monarch.pageTree.deleteGroupTitle" = "Delete the “%@” group?";

/* What deleting a group with one page also deletes. */
"monarch.pageTree.deleteGroupConsequence.one" = "Its page is deleted too.";

/* What deleting a group with several pages also deletes. %lld is the number of pages. */
"monarch.pageTree.deleteGroupConsequence.other" = "Its %lld pages are deleted too.";

/* Asks for the group name before a group with pages is deleted. %@ is the group name. */
"monarch.pageTree.typeToConfirm" = "Type “%@” to confirm.";

/* The title of the dialog that deletes a page. %@ is the page title. */
"monarch.pageTree.deletePageTitle" = "Delete “%@”?";

/* Said in the delete dialogs. */
"monarch.pageTree.cannotUndo" = "This cannot be undone.";

/* Announced when a page or a group moves. %1$@ is its name, %2$lld the new position, %3$lld the count. */
"monarch.pageTree.moved" = "%1$@ moved to position %2$lld of %3$lld.";

/* Announced when a page moves to another group. %1$@ is the page, %2$@ the group. */
"monarch.pageTree.movedTo" = "%1$@ moved to %2$@.";
