/* Spoken name of the list or the stack of agents. */
"monarch.aiMultiAgentRoster.label" = "Agents";

/* Shown when no agents take part. */
"monarch.aiMultiAgentRoster.empty" = "No agents are working on this.";

/* Separates the parts of the summary line. */
"monarch.aiMultiAgentRoster.separator" = " · ";

/* Summary part with one agent. %lld is 1. */
"monarch.aiMultiAgentRoster.agentsOne" = "%lld agent";

/* Summary part with the number of agents. %lld is the count. */
"monarch.aiMultiAgentRoster.agents" = "%lld agents";

/* Summary part with one working agent. %lld is 1. */
"monarch.aiMultiAgentRoster.workingOne" = "%lld working";

/* Summary part with the number of working agents. %lld is the count. */
"monarch.aiMultiAgentRoster.working" = "%lld working";

/* Summary part with one agent waiting for the person. %lld is 1. */
"monarch.aiMultiAgentRoster.waitingOne" = "%lld waiting for you";

/* Summary part with the number of agents waiting for the person. %lld is the count. */
"monarch.aiMultiAgentRoster.waiting" = "%lld waiting for you";

/* Summary part with one agent stopped with an error. %lld is 1. */
"monarch.aiMultiAgentRoster.errorsOne" = "%lld with errors";

/* Summary part with the number of agents stopped with an error. %lld is the count. */
"monarch.aiMultiAgentRoster.errors" = "%lld with errors";

/* Announced when an agent's state changes. %1$@ is the agent's name, %2$@ the new state. */
"monarch.aiMultiAgentRoster.changed" = "%1$@: %2$@";

/* An agent's spoken name in a row. %1$@ is the name, %2$@ the kind ("AI agent"). */
"monarch.aiMultiAgentRoster.agentName" = "%1$@ (%2$@)";

/* One agent hidden behind the "+N" tile. %1$@ is the name, %2$@ the state. */
"monarch.aiMultiAgentRoster.hiddenAgent" = "%1$@, %2$@";
