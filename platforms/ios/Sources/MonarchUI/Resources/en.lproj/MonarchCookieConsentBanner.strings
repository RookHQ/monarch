/* The title of the cookie banner. */
"monarch.cookieConsentBanner.title" = "Cookies on this site";

/* The message of the cookie banner where consent is asked first. */
"monarch.cookieConsentBanner.messageOptIn" = "We use strictly necessary cookies to make this site work. With your permission we would also like to use optional cookies to remember your preferences, measure use and show relevant ads.";

/* The message of the cookie banner where people opt out. */
"monarch.cookieConsentBanner.messageOptOut" = "We use cookies to make this site work, remember your preferences, measure use and show relevant ads. You can opt out of the sale or sharing of your personal information at any time.";

/* The message of a cookie notice. */
"monarch.cookieConsentBanner.messageNotice" = "We use cookies to make this site work and to understand how it is used.";

/* The button that allows every optional cookie. */
"monarch.cookieConsentBanner.acceptAll" = "Accept all";

/* The button that keeps only strictly necessary cookies. */
"monarch.cookieConsentBanner.rejectAll" = "Reject all";

/* The button that opens the per-category cookie choices. */
"monarch.cookieConsentBanner.customize" = "Customize";

/* The button that closes a cookie notice. */
"monarch.cookieConsentBanner.acknowledge" = "OK";

/* The button that opts out of the sale or sharing of personal information. */
"monarch.cookieConsentBanner.doNotSell" = "Do not sell or share my personal information";

/* Shown when a Global Privacy Control signal was honoured. */
"monarch.cookieConsentBanner.globalPrivacyControl" = "Your browser’s Global Privacy Control signal was honoured: sale and sharing are off.";

/* The link to the cookie policy at the end of the message. */
"monarch.cookieConsentBanner.policy" = "Cookie policy";

/* Announced by VoiceOver when the cookie banner appears. */
"monarch.cookieConsentBanner.announcement" = "Cookie notice shown at the bottom of the screen.";
