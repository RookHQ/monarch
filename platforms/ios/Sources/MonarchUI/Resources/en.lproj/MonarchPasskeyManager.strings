/* The title of the passkey manager card. */
"monarch.passkeyManager.title" = "Passkeys";

/* The line under the title of the passkey manager card. */
"monarch.passkeyManager.description" = "Sign in with Face ID, Touch ID or your device passcode instead of a password. Passkeys can’t be phished or reused.";

/* The spoken name of the list of passkeys. */
"monarch.passkeyManager.listLabel" = "Your passkeys";

/* The button that adds a passkey. */
"monarch.passkeyManager.add" = "Add a passkey";

/* The row button that renames a passkey. */
"monarch.passkeyManager.rename" = "Rename";

/* The spoken name of a row's rename button. %@ is the passkey name. */
"monarch.passkeyManager.renameLabel" = "Rename %@";

/* The title of the prompt that renames a passkey. */
"monarch.passkeyManager.renameTitle" = "Rename passkey";

/* The label of the name field in the rename prompt. */
"monarch.passkeyManager.nameField" = "Name";

/* The save button of the rename prompt. */
"monarch.passkeyManager.save" = "Save";

/* The row button that removes a passkey. */
"monarch.passkeyManager.remove" = "Remove";

/* The spoken name of a row's remove button. %@ is the passkey name. */
"monarch.passkeyManager.removeLabel" = "Remove %@";

/* Before the time a passkey was added, such as "Added 3 months ago". */
"monarch.passkeyManager.created" = "Added";

/* Before the time a passkey was last used, such as "Last used yesterday". */
"monarch.passkeyManager.lastUsed" = "Last used";

/* Shown for a passkey that was never used to sign in. */
"monarch.passkeyManager.neverUsed" = "Never used";

/* The badge of a passkey synced across devices. */
"monarch.passkeyManager.synced" = "Synced";

/* The title of the confirmation before removing a passkey. %@ is the passkey name. */
"monarch.passkeyManager.confirmTitle" = "Remove %@?";

/* The message of the confirmation before removing a passkey. */
"monarch.passkeyManager.confirmMessage" = "You won’t be able to sign in with this passkey any more.";

/* Added to the confirmation when the passkey is the person's only way to sign in. */
"monarch.passkeyManager.lastMethodWarning" = "This is your only way to sign in. Add another passkey or a password first, or you may lose access to your account.";

/* The confirm button of the removal confirmation. */
"monarch.passkeyManager.confirmRemove" = "Remove passkey";

/* The cancel button of the prompts. */
"monarch.passkeyManager.cancel" = "Cancel";

/* Shown when this device cannot create passkeys. */
"monarch.passkeyManager.unsupported" = "This device can’t create passkeys. Update its software or use another device.";

/* Shown when the person cancels the system passkey sheet. */
"monarch.passkeyManager.cancelled" = "Passkey setup was cancelled. Nothing was changed.";

/* Shown when adding a passkey fails without a message. */
"monarch.passkeyManager.addFailed" = "Couldn’t add the passkey. Try again.";

/* Announced after a passkey is added. */
"monarch.passkeyManager.added" = "Passkey added";

/* Announced after a passkey is removed. %@ is the passkey name. */
"monarch.passkeyManager.removed" = "Removed %@";

/* Shown when renaming a passkey fails. %@ is the passkey name. */
"monarch.passkeyManager.renameFailed" = "Couldn’t rename %@. Try again.";

/* Shown when removing a passkey fails. %@ is the passkey name. */
"monarch.passkeyManager.removeFailed" = "Couldn’t remove %@. Try again.";

/* Read while the passkeys load. */
"monarch.passkeyManager.loading" = "Loading passkeys";

/* The title of the empty state. */
"monarch.passkeyManager.emptyTitle" = "No passkeys yet";

/* The message of the empty state. */
"monarch.passkeyManager.emptyMessage" = "Add one to sign in faster and more safely.";

/* The title of the error state when the passkeys could not be loaded. */
"monarch.passkeyManager.errorTitle" = "Couldn’t load your passkeys";
