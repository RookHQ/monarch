/* The heading of the column of country names in a world map's data table. */
"monarch.worldMap.country" = "Country";
/* The heading of the column of values in a world map's data table. */
"monarch.worldMap.value" = "Value";
/* The spoken name of the tiles under a world map that hold values belonging to no single country, such as Global. */
"monarch.worldMap.extras" = "Other values";
/* A note under a world map listing country codes it cannot draw. %1$@ is their names, %2$@ their total, already formatted. */
"monarch.worldMap.unplaced" = "Not on the map: %1$@ (%2$@)";
/* The spoken summary of a world map with one country. %1$@ is the count, %2$@ the country and its value. */
"monarch.worldMap.summaryOne" = "%1$@ country. Highest: %2$@.";
/* The spoken summary of a world map with several countries. %1$@ is the count, %2$@ the top three countries and their values. */
"monarch.worldMap.summary" = "%1$@ countries. Highest: %2$@.";
/* One country of a world map as VoiceOver reads it. %1$@ is the country name, %2$@ its value and details. */
"monarch.worldMap.countryValue" = "%1$@: %2$@";
