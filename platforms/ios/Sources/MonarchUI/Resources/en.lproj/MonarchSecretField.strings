/* The spoken name of the toggle that shows or hides a secret. %@ is what the secret is, such as "API key". The name is the same in both states; the toggle's value says whether the secret is shown. */
"monarch.secretField.show" = "Show %@";

/* The spoken name of the button that copies a secret. %@ is what the secret is, such as "API key". */
"monarch.secretField.copy" = "Copy %@";

/* The spoken name of the copy button of a secret field for a short time after it copied the secret. */
"monarch.secretField.copied" = "Copied";

/* Announced by VoiceOver after a secret field copied its value. */
"monarch.secretField.announcement" = "Copied to clipboard";

/* The placeholder of an empty secret field whose value is saved on the server and not shown. */
"monarch.secretField.setPrompt" = "Saved. Enter a new value to replace it";

/* Spoken as the hint of a secret field whose value is saved on the server and not shown. */
"monarch.secretField.setDescription" = "A value is saved and hidden. Leave blank to keep it.";

/* The spoken value of a read-only secret while it is masked. */
"monarch.secretField.hidden" = "Hidden";

/* Spoken as the hint of a secret field that has an error, and announced when the error appears. %@ is the error message. */
"monarch.secretField.error" = "Error: %@";
