/* Title of the list of a document's headings, and its spoken name. */
"monarch.pageOutline.title" = "On this page";

/* Shown in the outline when the document has no headings yet. */
"monarch.pageOutline.empty" = "Headings you add appear here.";

/* Read by VoiceOver after the heading of the section being read. */
"monarch.pageOutline.current" = "Current section";

/* Word count and reading time under the outline. %1$@ is the formatted number of words, %2$d the minutes. */
"monarch.pageOutline.stats" = "%1$@ words · %2$d min read";

/* Word count and reading time for a document of one word. %1$@ is the formatted number, %2$d the minutes. */
"monarch.pageOutline.statsOne" = "%1$@ word · %2$d min read";
