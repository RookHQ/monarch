/* Read by VoiceOver as the name of the group of AI usage meters when it has no visible title. */
"monarch.aiUsageMeter.label" = "AI usage";

/* The unit after an amount of exactly one model token. */
"monarch.aiUsageMeter.token" = "token";

/* The unit after an amount of model tokens other than one. */
"monarch.aiUsageMeter.tokens" = "tokens";

/* The unit after an amount of exactly one billing credit. */
"monarch.aiUsageMeter.credit" = "credit";

/* The unit after an amount of billing credits other than one. */
"monarch.aiUsageMeter.credits" = "credits";

/* The status line of an item at or above its warning level, from the item's label and the share used. */
"monarch.aiUsageMeter.limitUsed" = "%1$@: %2$@ of the limit used";

/* The status line of an item above its limit, from the item's label and the share used. */
"monarch.aiUsageMeter.overLimit" = "%1$@: over the limit (%2$@ used)";
