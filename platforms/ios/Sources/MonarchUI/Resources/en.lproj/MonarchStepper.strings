/* The spoken name of a stepper, the list of steps of a wizard or a setup flow. */
"monarch.stepper.progress" = "Progress";

/* The position of a step, shown in the compact form and read before each step. The first %lld is the number of the step, the second the number of steps. */
"monarch.stepper.stepOf" = "Step %1$lld of %2$lld";

/* Read after a step that is finished. */
"monarch.stepper.complete" = "completed";

/* Read after a step that has an error. */
"monarch.stepper.error" = "needs attention";

/* Read after the step the user is on. */
"monarch.stepper.current" = "current step";

/* Shown under the name of a step that may be skipped. */
"monarch.stepper.optional" = "Optional";

/* Read after the current step while the stepper is working, for example while it saves. */
"monarch.stepper.busy" = "in progress";
