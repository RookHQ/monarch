<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plural strings of Monarch, read through MonarchStrings.plural. One key per
  countable phrase; each component's other strings stay in its own table.
-->
<plist version="1.0">
<dict>
	<key>monarch.loadMore.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Showing %lld item</string>
			<key>other</key>
			<string>Showing %lld items</string>
		</dict>
	</dict>
	<key>monarch.loadMore.countOfTotal</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Showing %1$lld of %2$#@total@</string>
		<key>total</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>monarch.loadMore.loaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld more item loaded.</string>
			<key>other</key>
			<string>%lld more items loaded.</string>
		</dict>
	</dict>
	<key>monarch.uploadQueue.summaryUploaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld of %2$#@total@</string>
		<key>total</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld uploaded</string>
			<key>other</key>
			<string>%lld uploaded</string>
		</dict>
	</dict>
	<key>monarch.uploadQueue.summaryFailed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@failed@</string>
		<key>failed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld failed</string>
			<key>other</key>
			<string>%lld failed</string>
		</dict>
	</dict>
	<key>monarch.avatar.groupSummary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld person</string>
			<key>other</key>
			<string>%lld people</string>
		</dict>
	</dict>
</dict>
</plist>
