/* Name of the template card that starts from scratch. */
"monarch.templatePicker.blank" = "Blank";

/* Spoken name of the row of category filters above the templates. */
"monarch.templatePicker.categories" = "Categories";

/* Category filter that shows the templates of every category. */
"monarch.templatePicker.allCategories" = "All";

/* Announced when the filters change. %d is the number of templates shown (more than one, or none). */
"monarch.templatePicker.results" = "%d templates";

/* Announced when the filters change and one template is shown. */
"monarch.templatePicker.resultsOne" = "%d template";

/* Shown when no template matches the search. %@ is the search text. */
"monarch.templatePicker.noResults" = "No templates match “%@”.";
