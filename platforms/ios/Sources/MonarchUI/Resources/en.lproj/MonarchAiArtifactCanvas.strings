/* The spoken name of the pane that shows an AI artifact. %@ is the artifact's title. */
"monarch.aiArtifactCanvas.label" = "Artifact: %@";

/* The segment that shows the rendered artifact. */
"monarch.aiArtifactCanvas.preview" = "Preview";

/* The segment that shows the artifact's source text. */
"monarch.aiArtifactCanvas.code" = "Code";

/* The spoken name of the control that switches between Preview and Code. */
"monarch.aiArtifactCanvas.views" = "View";

/* The button that closes the artifact pane. */
"monarch.aiArtifactCanvas.close" = "Close artifact";

/* The button that copies the artifact's content. */
"monarch.aiArtifactCanvas.copy" = "Copy";

/* The copy button's title just after copying. */
"monarch.aiArtifactCanvas.copied" = "Copied";

/* The button that opens the system share sheet for the artifact. */
"monarch.aiArtifactCanvas.share" = "Share";

/* The button that saves the artifact in the app. */
"monarch.aiArtifactCanvas.save" = "Save";

/* The spoken name of the web page preview. %@ is the artifact's title. */
"monarch.aiArtifactCanvas.frameTitle" = "Preview of %@";

/* Shown under the preview of a web page an AI made. */
"monarch.aiArtifactCanvas.sandboxNote" = "Sandboxed preview: scripts, forms and network requests are blocked.";

/* Shown when an image artifact's address is not allowed. */
"monarch.aiArtifactCanvas.unsafeImage" = "This image address is not allowed, so it is not shown.";

/* Shown in the preview when the kind of artifact has no preview. */
"monarch.aiArtifactCanvas.noPreview" = "No preview for this kind of artifact. See the Code tab.";
