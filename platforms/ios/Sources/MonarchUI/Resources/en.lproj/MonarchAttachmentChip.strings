/* The spoken name of the button that removes an attached file. %@ is the file name. */
"monarch.attachmentChip.remove" = "Remove %@";

/* The spoken name of the button that retries a failed upload. %@ is the file name. */
"monarch.attachmentChip.retry" = "Retry %@";

/* The spoken name of the progress bar of an upload. %@ is the file name. */
"monarch.attachmentChip.uploading" = "Uploading %@";

/* Shown under an attached file that is waiting to upload. */
"monarch.attachmentChip.queued" = "Waiting";

/* Shown under an attached file whose upload failed, when the app gives no reason. */
"monarch.attachmentChip.failed" = "Upload failed";

/* Shown under an attached file whose upload was cancelled. */
"monarch.attachmentChip.cancelled" = "Cancelled";
