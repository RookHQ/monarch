/* Status of a goal whose work has not started. */
"monarch.goalTree.status.notStarted" = "Not started";
/* Status of a goal that is expected to be met. */
"monarch.goalTree.status.onTrack" = "On track";
/* Status of a goal that might be missed. */
"monarch.goalTree.status.atRisk" = "At risk";
/* Status of a goal that is expected to be missed. */
"monarch.goalTree.status.offTrack" = "Off track";
/* Status of a goal that is met or closed. */
"monarch.goalTree.status.done" = "Done";
/* Spoken name of the button that shows a goal's children. %@ is the goal's title. */
"monarch.goalTree.expand" = "Expand %@";
/* Spoken name of the button that hides a goal's children. %@ is the goal's title. */
"monarch.goalTree.collapse" = "Collapse %@";
/* Words before the goal elsewhere that a goal supports. */
"monarch.goalTree.alignedTo" = "Aligned to";
/* Button under a goal that adds a key result to it. */
"monarch.goalTree.addChild" = "Add key result";
/* Spoken name of the add button. %@ is the goal's title. */
"monarch.goalTree.addChildTo" = "Add key result to %@";
/* Number of children of a closed goal when there is one. %@ is the formatted number 1. */
"monarch.goalTree.childCount.one" = "%@ key result";
/* Number of children of a closed goal. %@ is the formatted number. */
"monarch.goalTree.childCount.other" = "%@ key results";
/* Shown when there are no goals. */
"monarch.goalTree.empty" = "No goals yet";
