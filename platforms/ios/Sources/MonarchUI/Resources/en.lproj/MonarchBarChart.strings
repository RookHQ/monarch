/* The heading of the category column in the data table of a bar chart. */
"monarch.barChart.category" = "Category";
/* The name of the sum of every series in one stacked bar of a bar chart. */
"monarch.barChart.total" = "Total";
/* The spoken summary of a bar chart, or of one of its series, that has no values. */
"monarch.barChart.noData" = "No data";
/* The title of the button that opens the details of the category inspected in a bar chart. */
"monarch.barChart.details" = "Details";
/* The title of the button that ends the inspection of a category in a bar chart. */
"monarch.barChart.clearSelection" = "Clear";
/* The first sentence of the spoken summary of a bar chart with one category. %@ is the category. */
"monarch.barChart.onePoint" = "1 point, %@";
/* The first sentence of the spoken summary of a bar chart. %1$@ is the number of categories, %2$@ the first and %3$@ the last category. */
"monarch.barChart.points" = "%1$@ points from %2$@ to %3$@";
/* The spoken summary of one series of a bar chart. %1$@ is the series, %2$@ its total, %3$@ the category with the highest value and %4$@ that value. */
"monarch.barChart.series" = "%1$@: total %2$@, highest %3$@ at %4$@";
