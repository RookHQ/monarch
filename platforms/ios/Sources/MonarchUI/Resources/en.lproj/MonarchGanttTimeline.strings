/* The spoken name of the chart and the list of a Gantt timeline. */
"monarch.ganttTimeline.timeline" = "Timeline";

/* The heading of the row-label column of a Gantt timeline chart. */
"monarch.ganttTimeline.rowHeader" = "Item";

/* The spoken name of the zoom menu of a Gantt timeline. */
"monarch.ganttTimeline.zoom" = "Zoom";

/* Zoom level of a Gantt timeline: four weeks. */
"monarch.ganttTimeline.zoom.week" = "Weeks";

/* Zoom level of a Gantt timeline: thirteen weeks. */
"monarch.ganttTimeline.zoom.month" = "Months";

/* Zoom level of a Gantt timeline: nine months. */
"monarch.ganttTimeline.zoom.quarter" = "Quarters";

/* Zoom level of a Gantt timeline: two years. */
"monarch.ganttTimeline.zoom.year" = "Years";

/* The spoken name of the backward arrow of a Gantt timeline toolbar. */
"monarch.ganttTimeline.earlier" = "Earlier";

/* The spoken name of the forward arrow of a Gantt timeline toolbar. */
"monarch.ganttTimeline.later" = "Later";

/* The Today button of a Gantt timeline toolbar and the label of the today line. */
"monarch.ganttTimeline.today" = "Today";

/* The spoken name of the chart and list switch of a Gantt timeline. */
"monarch.ganttTimeline.view" = "View";

/* The chart choice of the Gantt timeline switch. */
"monarch.ganttTimeline.chart" = "Chart";

/* The list choice of the Gantt timeline switch. */
"monarch.ganttTimeline.list" = "Table";

/* The label of the milestone lane of a Gantt timeline and the heading of its milestones in the list. */
"monarch.ganttTimeline.milestones" = "Milestones";

/* The visible hint above an editable Gantt timeline chart. */
"monarch.ganttTimeline.hint" = "Touch and hold a bar to move it, or one of its ends to change that date.";

/* What VoiceOver reads for a bar. The first %@ is the label, the second the first day, the third the last day. */
"monarch.ganttTimeline.bar" = "%1$@, %2$@ to %3$@";

/* What VoiceOver reads for a one-day item. The first %@ is the label, the second the day. */
"monarch.ganttTimeline.barDay" = "%1$@, %2$@";

/* The completion of an item in words. %@ is a percentage such as 60%. */
"monarch.ganttTimeline.progress" = "%@ complete";

/* A conflict of an item in words. %@ is the app's message. */
"monarch.ganttTimeline.conflict" = "Conflict: %@";

/* What VoiceOver reads for a milestone. The first %@ is the name, the second the date. */
"monarch.ganttTimeline.milestone" = "Milestone %1$@, %2$@";

/* What VoiceOver reads for a reached milestone. The first %@ is the name, the second the date. */
"monarch.ganttTimeline.milestoneDone" = "Milestone %1$@, %2$@, done";

/* The row text of an item that ended before the visible window. %@ is the date. */
"monarch.ganttTimeline.ended" = "Ended %@";

/* The row text of an item that starts after the visible window. %@ is the date. */
"monarch.ganttTimeline.starts" = "Starts %@";

/* The row text of an item without dates. */
"monarch.ganttTimeline.noDates" = "No dates";

/* The heading of the items without dates, when there is one. */
"monarch.ganttTimeline.unscheduled.one" = "Unscheduled · 1 without dates";

/* The heading of the items without dates, when there are several. %d is the number. */
"monarch.ganttTimeline.unscheduled.other" = "Unscheduled · %d without dates";

/* Announced after an item's dates change. The first %@ is the label, the second and third the days. */
"monarch.ganttTimeline.changed" = "%1$@: %2$@ to %3$@";

/* Announced after a one-day item's date changes. The first %@ is the label, the second the day. */
"monarch.ganttTimeline.changedDay" = "%1$@: %2$@";

/* The button of a list row that opens the date sheet. */
"monarch.ganttTimeline.changeDates" = "Change dates";

/* The first date picker of the Gantt timeline date sheet. */
"monarch.ganttTimeline.startDate" = "Start";

/* The second date picker of the Gantt timeline date sheet. */
"monarch.ganttTimeline.endDate" = "End";

/* The confirm button of the Gantt timeline date sheet. */
"monarch.ganttTimeline.save" = "Save";

/* The dismiss button of the Gantt timeline date sheet. */
"monarch.ganttTimeline.cancel" = "Cancel";

/* The length of an item of one day. */
"monarch.ganttTimeline.duration.one" = "1 day";

/* The length of an item of several days. %d is the number. */
"monarch.ganttTimeline.duration.other" = "%d days";

/* The items an item depends on. %@ is a list of names. */
"monarch.ganttTimeline.dependsOn" = "Depends on %@";

/* The value of a parent item whose children are shown. */
"monarch.ganttTimeline.expanded" = "Expanded";

/* The value of a parent item whose children are hidden. */
"monarch.ganttTimeline.collapsed" = "Collapsed";

/* The caption of a parent item with one child that is shown. */
"monarch.ganttTimeline.hideChildren.one" = "Hide 1 sub-item";

/* The caption of a parent item whose children are shown. %d is the number. */
"monarch.ganttTimeline.hideChildren.other" = "Hide %d sub-items";

/* The caption of a parent item with one child that is hidden. */
"monarch.ganttTimeline.showChildren.one" = "Show 1 sub-item";

/* The caption of a parent item whose children are hidden. %d is the number. */
"monarch.ganttTimeline.showChildren.other" = "Show %d sub-items";

/* A VoiceOver action of a bar. */
"monarch.ganttTimeline.moveEarlier" = "Move a day earlier";

/* A VoiceOver action of a bar. */
"monarch.ganttTimeline.moveLater" = "Move a day later";

/* A VoiceOver action of a bar. */
"monarch.ganttTimeline.startEarlier" = "Start a day earlier";

/* A VoiceOver action of a bar. */
"monarch.ganttTimeline.startLater" = "Start a day later";

/* A VoiceOver action of a bar. */
"monarch.ganttTimeline.endEarlier" = "End a day earlier";

/* A VoiceOver action of a bar. */
"monarch.ganttTimeline.endLater" = "End a day later";

/* The visible window and a span of dates. The first %@ is the first day, the second the last. */
"monarch.ganttTimeline.range" = "%1$@ – %2$@";
