/* Spoken name of the row of files attached to a message for an AI assistant. */
"monarch.aiAttachmentTray.label" = "Attachments";

/* Announced when a file finishes uploading. %@ is the file name. */
"monarch.aiAttachmentTray.ready" = "%@ uploaded";

/* Announced after the person removes a file from the attachments. %@ is the file name. */
"monarch.aiAttachmentTray.removed" = "%@ removed";

/* Written before the percentage under a file that is still uploading, as in "375 KB Uploading 10%". */
"monarch.aiAttachmentTray.uploading" = "Uploading";

/* The visible word beside the retry arrow of a file whose upload failed. */
"monarch.aiAttachmentTray.retry" = "Retry";
