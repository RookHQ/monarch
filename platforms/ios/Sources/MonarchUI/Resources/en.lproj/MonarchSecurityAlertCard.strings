/* Title of the card that lists recent security alerts for an account. */
"monarch.securityAlertCard.title" = "Security alerts";

/* Line under the title of the security alerts card. */
"monarch.securityAlertCard.description" = "Recent security notifications and account activity.";

/* Spoken name of the list of security alerts. */
"monarch.securityAlertCard.listLabel" = "Security alerts";

/* Severity name of an informational security alert, shown in its badge. */
"monarch.securityAlertCard.severity.info" = "Info";

/* Severity name of a low security alert, shown in its badge. */
"monarch.securityAlertCard.severity.low" = "Low";

/* Severity name of a medium security alert, shown in its badge. */
"monarch.securityAlertCard.severity.medium" = "Medium";

/* Severity name of a high security alert, shown in its badge. */
"monarch.securityAlertCard.severity.high" = "High";

/* Severity name of a critical security alert, shown in its badge. */
"monarch.securityAlertCard.severity.critical" = "Critical";

/* Read for a security alert the person has not seen yet. */
"monarch.securityAlertCard.unread" = "Unread";

/* Number of unread security alerts, in the card header. %d is the count. */
"monarch.securityAlertCard.unreadCount" = "%d unread";

/* Button that marks one security alert as read. */
"monarch.securityAlertCard.markRead" = "Mark as read";

/* Button that marks every security alert as read. */
"monarch.securityAlertCard.markAllRead" = "Mark all as read";

/* Spoken name of the button that dismisses a security alert. %@ is the alert title. */
"monarch.securityAlertCard.dismiss" = "Dismiss %@";

/* Announced after a security alert is dismissed. %@ is the alert title. */
"monarch.securityAlertCard.dismissed" = "Dismissed %@";

/* Shown while security alerts load. */
"monarch.securityAlertCard.loading" = "Loading alerts";

/* Title shown when there are no security alerts. */
"monarch.securityAlertCard.emptyTitle" = "No security alerts";

/* Message shown when there are no security alerts. */
"monarch.securityAlertCard.emptyDescription" = "Alerts about sign-ins and account changes appear here.";

/* Title shown when security alerts could not be loaded. */
"monarch.securityAlertCard.errorTitle" = "Couldn’t load security alerts";
