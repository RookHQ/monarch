/* The spoken name of the list of things AI agents did. */
"monarch.aiActionLog.label" = "AI activity";

/* The button that reverses something an AI agent did. */
"monarch.aiActionLog.undo" = "Undo";

/* The spoken name of an undo button. %@ is the entry, such as "Research agent added a summary to Quarterly report". */
"monarch.aiActionLog.undoLabel" = "Undo: %@";

/* Shown on an entry whose action was reversed. */
"monarch.aiActionLog.undone" = "Undone";

/* Announced after an undo. %@ is the entry. */
"monarch.aiActionLog.undoneAnnouncement" = "Undone: %@";

/* Shown and announced when an undo failed. %@ is the entry. */
"monarch.aiActionLog.undoFailed" = "Could not undo: %@";

/* The VoiceOver action that opens what the agent acted on. %@ is its name. */
"monarch.aiActionLog.openTarget" = "Open %@";

/* Shown when no AI agent has done anything yet. */
"monarch.aiActionLog.empty" = "No AI activity yet.";

/* The button that shows one more entry of a long log. */
"monarch.aiActionLog.showMoreOne" = "Show 1 more action";

/* The button that shows more entries of a long log. %ld is how many it adds, more than one. */
"monarch.aiActionLog.showMoreOther" = "Show %ld more actions";
