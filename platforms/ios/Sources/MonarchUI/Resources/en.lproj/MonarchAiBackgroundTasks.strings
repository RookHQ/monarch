/* Text of the tray button and title of the panel of background agent tasks. */
"monarch.aiBackgroundTasks.title" = "Background tasks";
/* Heading of the tasks that wait on the person. */
"monarch.aiBackgroundTasks.group.needsInput" = "Needs you";
/* Heading of the running and queued tasks. */
"monarch.aiBackgroundTasks.group.running" = "Running";
/* Heading of the finished tasks. */
"monarch.aiBackgroundTasks.group.finished" = "Finished";
/* Button that opens a task's conversation or result. */
"monarch.aiBackgroundTasks.open" = "Open";
/* Button that stops a task. */
"monarch.aiBackgroundTasks.cancel" = "Cancel";
/* Button that runs a failed task again. */
"monarch.aiBackgroundTasks.retry" = "Retry";
/* Button that answers a task waiting on the person. */
"monarch.aiBackgroundTasks.respond" = "Respond";
/* Button that removes a finished task from the list. */
"monarch.aiBackgroundTasks.dismiss" = "Dismiss";
/* Button that removes every finished task. */
"monarch.aiBackgroundTasks.clearFinished" = "Clear finished";
/* Shown when there are no background tasks. */
"monarch.aiBackgroundTasks.empty" = "No background tasks";
/* Count of running tasks on the tray button. %@ is the formatted number. */
"monarch.aiBackgroundTasks.count.running" = "%@ running";
/* Count of tasks waiting to start on the tray button. %@ is the formatted number. */
"monarch.aiBackgroundTasks.count.queued" = "%@ queued";
/* One task waits on the person, on the tray button. */
"monarch.aiBackgroundTasks.count.needsInput.one" = "1 needs you";
/* Several tasks wait on the person, on the tray button. %@ is the formatted number. */
"monarch.aiBackgroundTasks.count.needsInput.other" = "%@ need you";
/* A section heading with its count. The first %@ is the heading, the second the number. */
"monarch.aiBackgroundTasks.groupHeading" = "%1$@ (%2$@)";
/* How long a running task has run. %@ is a duration such as "3 min 12 sec". */
"monarch.aiBackgroundTasks.elapsed" = "Running for %@";
/* When a finished task ended. %@ is a relative time such as "5 minutes ago". */
"monarch.aiBackgroundTasks.ended" = "Ended %@";
/* Spoken name of a task's progress bar. %@ is the task title. */
"monarch.aiBackgroundTasks.progressLabel" = "%@ progress";
/* Spoken name of a row action. The first %@ is the action, the second the task title. */
"monarch.aiBackgroundTasks.actionLabel" = "%1$@: %2$@";
/* Announced when a task changes status. The first %@ is the task title, the second the status. */
"monarch.aiBackgroundTasks.announce" = "%1$@: %2$@";
/* Status of a task waiting to start. */
"monarch.aiBackgroundTasks.status.queued" = "Queued";
/* Status of a task the agent is working on. */
"monarch.aiBackgroundTasks.status.running" = "Running";
/* Status of a task that waits on the person. */
"monarch.aiBackgroundTasks.status.needsInput" = "Needs your input";
/* Status of a task that finished with a result. */
"monarch.aiBackgroundTasks.status.succeeded" = "Done";
/* Status of a task that finished with an error. */
"monarch.aiBackgroundTasks.status.failed" = "Failed";
/* Status of a task that was stopped. */
"monarch.aiBackgroundTasks.status.cancelled" = "Cancelled";

/* A number of hours in a duration, "1 hr 4 min". */
"monarch.aiBackgroundTasks.unit.hours" = "%lld hr";
/* A number of minutes in a duration, "3 min 12 sec". */
"monarch.aiBackgroundTasks.unit.minutes" = "%lld min";
/* A number of seconds in a duration, "42 sec". */
"monarch.aiBackgroundTasks.unit.seconds" = "%lld sec";
