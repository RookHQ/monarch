/* The main text of the file upload area. */
"monarch.fileUpload.title" = "Choose files to upload";

/* The button that opens the document picker. */
"monarch.fileUpload.browse" = "Browse files";

/* The button that opens the photo picker. */
"monarch.fileUpload.photos" = "Choose photos";

/* Shown while files are dragged over the upload area. */
"monarch.fileUpload.dropHere" = "Drop to upload";

/* A refused file whose type is not allowed. %@ is the file name. */
"monarch.fileUpload.invalidType" = "%@ is not an allowed file type.";

/* A refused file that is too large. %1$@ is the file name, %2$@ the size limit, such as 10 MB. */
"monarch.fileUpload.tooLarge" = "%1$@ is larger than %2$@.";

/* A refused file over a limit of one file. %@ is the file name. */
"monarch.fileUpload.tooMany.one" = "%@ was not added: up to 1 file.";

/* A refused file over a limit of several files. %1$@ is the file name, %2$lld the limit. */
"monarch.fileUpload.tooMany.other" = "%1$@ was not added: up to %2$lld files.";

/* The size part of the hint under the upload area. %@ is the size limit, such as 10 MB. */
"monarch.fileUpload.limitSize" = "Up to %@ each";

/* The count part of the hint under the upload area, for a limit of one file. */
"monarch.fileUpload.limitCount.one" = "1 file max";

/* The count part of the hint under the upload area. %lld is the limit. */
"monarch.fileUpload.limitCount.other" = "%lld files max";

/* The hint once one file, the limit, is attached. */
"monarch.fileUpload.limitReached.one" = "Limit reached: 1 file attached.";

/* The hint once the limit of files is attached. %lld is the limit. */
"monarch.fileUpload.limitReached.other" = "Limit reached: %lld files attached.";

/* Announced after one file is accepted. */
"monarch.fileUpload.added.one" = "1 file added.";

/* Announced after several files are accepted. %lld is the number. */
"monarch.fileUpload.added.other" = "%lld files added.";
