/* The select-all checkbox in the header. */
"monarch.dataGrid.selectAll" = "Select all rows";

/* The header of the actions column. */
"monarch.dataGrid.actionsHeader" = "Actions";

/* The hint of a header that opens the column menu. */
"monarch.dataGrid.columnOptions" = "Column options";

/* The column menu item that sorts ascending. */
"monarch.dataGrid.sortAscending" = "Sort ascending";

/* The column menu item that sorts descending. */
"monarch.dataGrid.sortDescending" = "Sort descending";

/* The column menu item that removes the sort. */
"monarch.dataGrid.clearSort" = "Clear sort";

/* The column menu item that pins the column to the leading edge. */
"monarch.dataGrid.pinStart" = "Pin to start";

/* The column menu item that pins the column to the trailing edge. */
"monarch.dataGrid.pinEnd" = "Pin to end";

/* The column menu item that unpins the column. */
"monarch.dataGrid.unpin" = "Unpin";

/* The column menu item that hides the column. */
"monarch.dataGrid.hideColumn" = "Hide column";

/* The column menu item that makes the column wider. */
"monarch.dataGrid.widen" = "Widen column";

/* The column menu item that makes the column narrower. */
"monarch.dataGrid.narrow" = "Narrow column";

/* The spoken state of a header sorted ascending. */
"monarch.dataGrid.sortedAscending" = "Sorted ascending";

/* The spoken state of a header sorted descending. */
"monarch.dataGrid.sortedDescending" = "Sorted descending";

/* The spoken state of a sortable header that is not sorted. */
"monarch.dataGrid.notSorted" = "Not sorted";

/* The spoken state of a header pinned to the leading edge. */
"monarch.dataGrid.pinnedStart" = "Pinned to start";

/* The spoken state of a header pinned to the trailing edge. */
"monarch.dataGrid.pinnedEnd" = "Pinned to end";

/* The action that opens a row's details. */
"monarch.dataGrid.open" = "Open details";

/* The hint of a record that opens the record editor, and the editor's title when the row has no name. */
"monarch.dataGrid.editRecord" = "Edit";

/* The button that closes the record editor. */
"monarch.dataGrid.done" = "Done";

/* Read for an empty cell. */
"monarch.dataGrid.noValue" = "No value";

/* The spoken name of the first-load placeholder. */
"monarch.dataGrid.loading" = "Loading rows";

/* The empty state title. */
"monarch.dataGrid.emptyTitle" = "Nothing here yet";

/* The empty state message. */
"monarch.dataGrid.emptyMessage" = "Rows appear here once they are added.";

/* A row's checkbox, from the row's name. %@ is the row's name. */
"monarch.dataGrid.selectRow" = "Select %@";

/* A row's actions menu, from the row's name. %@ is the row's name. */
"monarch.dataGrid.rowActions" = "Actions for %@";

/* An editable cell, from the column and the row's name. The first %@ is the column, the second the row. */
"monarch.dataGrid.editLabel" = "%1$@ for %2$@";

/* A read-only cell, from the column and the value. The first %@ is the column, the second the value. */
"monarch.dataGrid.cell" = "%1$@: %2$@";

/* The count of selected rows. %lld is the count. */
"monarch.dataGrid.selectedCount" = "%lld selected";
