/* The spoken name of the full-screen viewer for images and videos. */
"monarch.lightbox.title" = "Media viewer";

/* The spoken name of the button that shows the item before the current one. */
"monarch.lightbox.previous" = "Previous";

/* The spoken name of the button that shows the item after the current one. */
"monarch.lightbox.next" = "Next";

/* The spoken name of the button that makes the image larger. */
"monarch.lightbox.zoomIn" = "Zoom in";

/* The spoken name of the button that makes the image smaller. */
"monarch.lightbox.zoomOut" = "Zoom out";

/* The spoken name of the button that shows the zoom level and returns the image to its fitted size. */
"monarch.lightbox.resetZoom" = "Reset zoom";

/* The spoken name of the button that closes the viewer. */
"monarch.lightbox.close" = "Close";

/* The spoken name of the button that opens the share sheet for the current item. */
"monarch.lightbox.share" = "Share";

/* Where the current item sits. %1$lld is its position, starting at 1; %2$lld is the number of items. */
"monarch.lightbox.position" = "%1$lld of %2$lld";

/* Shown instead of an image or video that has no source or did not load. */
"monarch.lightbox.unavailable" = "This file can’t be shown.";

/* The spoken name of the progress indicator while an image loads. */
"monarch.lightbox.loading" = "Loading";
