/* The title of the sheet that shows a newly created key once. */
"monarch.keyCreatedDialog.title" = "Copy your new key";

/* What the value is when the app does not say. Names the copy button and goes into the acknowledgement. */
"monarch.keyCreatedDialog.label" = "API key";

/* The heading of the warning shown with a newly created secret. */
"monarch.keyCreatedDialog.secretNoticeTitle" = "Copy it now. It will not be shown again.";

/* The body of the warning shown with a newly created secret. */
"monarch.keyCreatedDialog.secretNotice" = "Keep it in a secret manager or a server environment variable, never in source control. If you lose it, create a new one.";

/* The heading of the notice shown with a new value that can be viewed again later. */
"monarch.keyCreatedDialog.publicNoticeTitle" = "You can view this again later.";

/* The body of the notice shown with a new value that can be viewed again later. */
"monarch.keyCreatedDialog.publicNotice" = "It is meant to be public, so you can copy it again from its details page.";

/* The checkbox the person ticks before the sheet can close. %@ is what the value is, such as "API key". */
"monarch.keyCreatedDialog.acknowledge" = "I have saved this %@ somewhere safe.";

/* Shown and announced when Done is pressed before the checkbox is ticked. */
"monarch.keyCreatedDialog.acknowledgeRequired" = "Confirm that you have saved it before you close this dialog.";

/* The button that closes the sheet. */
"monarch.keyCreatedDialog.done" = "Done";

/* The title of the copy button. */
"monarch.keyCreatedDialog.copy" = "Copy";

/* The title of the copy button for a short time after a copy. */
"monarch.keyCreatedDialog.copied" = "Copied";
