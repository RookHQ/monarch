/* Spoken name of the list of things the AI will see with the next prompt. */
"monarch.aiContextChips.label" = "Context";

/* Spoken before the name of a context item that is a file. */
"monarch.aiContextChips.kind.file" = "File";

/* Spoken before the name of a context item that is selected text. */
"monarch.aiContextChips.kind.selection" = "Selection";

/* Spoken before the name of a context item that is the current page. */
"monarch.aiContextChips.kind.page" = "Page";

/* Spoken before the name of a context item that is a record, such as a customer. */
"monarch.aiContextChips.kind.record" = "Record";

/* Spoken before the name of a context item that is a connected app. */
"monarch.aiContextChips.kind.app" = "App";

/* Spoken before the name of a context item that is a person. */
"monarch.aiContextChips.kind.person" = "Person";

/* Token count of one context item. %@ is a compact number such as 1.2K. */
"monarch.aiContextChips.tokens" = "%@ tokens";

/* Token count of one context item that adds exactly one token. */
"monarch.aiContextChips.tokens.one" = "1 token";

/* Estimated total tokens of all context items. %@ is a compact number such as 1.2K. */
"monarch.aiContextChips.total" = "≈ %@ tokens in context";

/* Estimated total when the context adds exactly one token. */
"monarch.aiContextChips.total.one" = "≈ 1 token in context";

/* Spoken name of the button that removes a context item. %@ is the item's name. */
"monarch.aiContextChips.remove" = "Remove %@ from context";

/* Announced after a context item is removed. %@ is the item's name. */
"monarch.aiContextChips.removed" = "%@ removed from context";
