/* Heading of the time zone this device is set to. */
"monarch.timezoneSelect.detected" = "Detected";

/* Heading of the time zones the app pinned, such as the offices of a workspace. */
"monarch.timezoneSelect.pinned" = "Pinned";

/* Heading of the time zones the person chose lately. */
"monarch.timezoneSelect.recent" = "Recent";

/* Heading of the full list of time zones. */
"monarch.timezoneSelect.all" = "All time zones";

/* Shown when no time zone matches the search. */
"monarch.timezoneSelect.empty" = "No time zones match";

/* An option. %1$@ is the offset ("UTC+05:30"), %2$@ the city ("Kolkata"). */
"monarch.timezoneSelect.label" = "(%1$@) %2$@";
