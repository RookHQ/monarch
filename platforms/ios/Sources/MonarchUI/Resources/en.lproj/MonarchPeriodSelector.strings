/* The name of the period selector, read by VoiceOver. */
"monarch.periodSelector.label" = "Period";

/* The label of the date range shown for a custom period. */
"monarch.periodSelector.customRange" = "Custom period";

/* The preset that covers today. */
"monarch.periodSelector.preset.today" = "Today";

/* The preset that covers yesterday. */
"monarch.periodSelector.preset.yesterday" = "Yesterday";

/* The preset that covers the 7 days ending today. */
"monarch.periodSelector.preset.last7Days" = "Last 7 days";

/* The preset that covers the 14 days ending today. */
"monarch.periodSelector.preset.last14Days" = "Last 14 days";

/* The preset that covers the 30 days ending today. */
"monarch.periodSelector.preset.last30Days" = "Last 30 days";

/* The preset that covers the 90 days ending today. */
"monarch.periodSelector.preset.last90Days" = "Last 90 days";

/* The preset that covers the 180 days ending today. */
"monarch.periodSelector.preset.last180Days" = "Last 180 days";

/* The preset that covers the 365 days ending today. */
"monarch.periodSelector.preset.last365Days" = "Last 12 months";

/* The preset from the first day of this week to today. */
"monarch.periodSelector.preset.thisWeek" = "This week";

/* The preset from the first day of this month to today. */
"monarch.periodSelector.preset.thisMonth" = "This month";

/* The preset that covers the whole previous month. */
"monarch.periodSelector.preset.lastMonth" = "Last month";

/* The preset from the first day of this quarter to today. */
"monarch.periodSelector.preset.thisQuarter" = "This quarter";

/* The preset that covers the whole previous quarter. */
"monarch.periodSelector.preset.lastQuarter" = "Last quarter";

/* The preset from the first day of this year to today. */
"monarch.periodSelector.preset.thisYear" = "This year";

/* The preset that lets people choose the dates. */
"monarch.periodSelector.preset.custom" = "Custom";
