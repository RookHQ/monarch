/* Spoken name of the list of things that can be added to the AI's context. */
"monarch.aiMentionContext.label" = "Add context";

/* Shown and announced while results are searched. */
"monarch.aiMentionContext.loading" = "Searching…";

/* Shown and announced when the search failed. */
"monarch.aiMentionContext.error" = "Couldn’t load results.";

/* Shown when nothing has been typed after @ and there are no results. */
"monarch.aiMentionContext.typeToSearch" = "Type to search";

/* Shown when nothing matches the typed text. %@ is the text typed after @. */
"monarch.aiMentionContext.noMatch" = "Nothing matches “%@”";

/* Heading of document results. */
"monarch.aiMentionContext.group.doc" = "Documents";

/* Heading of people results. */
"monarch.aiMentionContext.group.person" = "People";

/* Heading of record results. */
"monarch.aiMentionContext.group.record" = "Records";

/* Heading of app results. */
"monarch.aiMentionContext.group.app" = "Apps";

/* Announced when one result arrives. %lld is 1. */
"monarch.aiMentionContext.countOne" = "%lld result";

/* Announced when results arrive. %lld is the number of results. */
"monarch.aiMentionContext.count" = "%lld results";
