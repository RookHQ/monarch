/* The spoken name of the whole query builder. */
"monarch.queryBuilder.label" = "Query";

/* The name of the outermost group of rules. */
"monarch.queryBuilder.topGroup" = "Top group";

/* The name of a nested group of rules. %@ is its position, such as 2 or 2.1. */
"monarch.queryBuilder.group" = "Group %@";

/* Text before the switch that joins the rules of a group with AND or OR. */
"monarch.queryBuilder.combinatorBefore" = "Join rules with";

/* The switch choice meaning every rule must hold. */
"monarch.queryBuilder.and" = "AND";

/* The switch choice meaning at least one rule must hold. */
"monarch.queryBuilder.or" = "OR";

/* The spoken name of a group's AND / OR switch. %@ is the group's name. */
"monarch.queryBuilder.combinatorLabel" = "%@ combinator";

/* The visible title of a rule. %ld is its position in the group. */
"monarch.queryBuilder.ruleTitle" = "Rule %ld";

/* The spoken name of a rule. %1$@ is the group's name, %2$ld the rule's position. */
"monarch.queryBuilder.rule" = "%1$@, rule %2$ld";

/* The spoken name of a rule's field menu. %1$@ is the group's name, %2$ld the rule's position. */
"monarch.queryBuilder.field" = "%1$@, rule %2$ld field";

/* The spoken name of a rule's operator menu. %1$@ is the group's name, %2$ld the rule's position. */
"monarch.queryBuilder.operatorLabel" = "%1$@, rule %2$ld operator";

/* The spoken name of a rule's value. %1$@ is the group's name, %2$ld the rule's position. */
"monarch.queryBuilder.value" = "%1$@, rule %2$ld value";

/* The spoken name of the button that removes a rule. %1$@ is the group's name in lower case, %2$ld the rule's position. */
"monarch.queryBuilder.removeRule" = "Remove %1$@, rule %2$ld";

/* The button that adds a rule to a group. */
"monarch.queryBuilder.addRule" = "Add rule";

/* The button that adds a nested group. */
"monarch.queryBuilder.addGroup" = "Add group";

/* The spoken name of the button that removes a group. %@ is the group's name in lower case. */
"monarch.queryBuilder.removeGroup" = "Remove %@";

/* Shown in a group that has no rules. */
"monarch.queryBuilder.emptyGroup" = "No rules in this group.";

/* Shown instead of Add group when groups cannot be nested further. */
"monarch.queryBuilder.maxDepthReached" = "Groups cannot be nested any deeper.";

/* Shown instead of Add rule when a group is full. %ld is the most rules a group can have. */
"monarch.queryBuilder.maxRulesReached" = "A group can have up to %ld rules.";

/* The empty choice of a menu. */
"monarch.queryBuilder.choose" = "Choose…";

/* A field stored on a rule that the list of fields no longer has. %@ is the field's key. */
"monarch.queryBuilder.removedField" = "%@ (removed)";

/* The button that sets the date of a rule. */
"monarch.queryBuilder.chooseDate" = "Choose a date";

/* Operator: the value equals. */
"monarch.queryBuilder.operator.equals" = "is";

/* Operator: the value does not equal. */
"monarch.queryBuilder.operator.notEquals" = "is not";

/* Operator: the text contains. */
"monarch.queryBuilder.operator.contains" = "contains";

/* Operator: the text does not contain. */
"monarch.queryBuilder.operator.notContains" = "does not contain";

/* Operator: the number is greater than. */
"monarch.queryBuilder.operator.greaterThan" = "is greater than";

/* Operator: the number is at least. */
"monarch.queryBuilder.operator.atLeast" = "is at least";

/* Operator: the number is less than. */
"monarch.queryBuilder.operator.lessThan" = "is less than";

/* Operator: the number is at most. */
"monarch.queryBuilder.operator.atMost" = "is at most";

/* Operator: the date is before. */
"monarch.queryBuilder.operator.before" = "is before";

/* Operator: the date is after. */
"monarch.queryBuilder.operator.after" = "is after";

/* Operator: the value is yes. */
"monarch.queryBuilder.operator.isTrue" = "is yes";

/* Operator: the value is no. */
"monarch.queryBuilder.operator.isFalse" = "is no";

/* Operator: the field has no value. */
"monarch.queryBuilder.operator.isEmpty" = "is empty";

/* Operator: the value is one of several. */
"monarch.queryBuilder.operator.anyOf" = "is any of";

/* Operator: the value is none of several. */
"monarch.queryBuilder.operator.noneOf" = "is none of";

/* Operator: the field has a value. */
"monarch.queryBuilder.operator.isNotEmpty" = "is not empty";

/* Problem: the rule has no field. */
"monarch.queryBuilder.problem.field" = "Choose a field.";

/* Problem: the rule needs a value. */
"monarch.queryBuilder.problem.value" = "Enter a value.";

/* Problem: the chosen value is no longer a choice of the field. */
"monarch.queryBuilder.problem.option" = "The chosen value no longer exists. Pick another.";
