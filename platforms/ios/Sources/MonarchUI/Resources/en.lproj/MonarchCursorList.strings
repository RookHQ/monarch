/* The spoken name of the placeholder while the first page of a list loads. */
"monarch.cursorList.loading" = "Loading";

/* The title shown when a paginated list has no items. */
"monarch.cursorList.emptyTitle" = "Nothing here yet";

/* The message under the title when a paginated list has no items. */
"monarch.cursorList.emptyMessage" = "Items appear here once they are added.";

/* The title shown when the first page of a list failed to load. */
"monarch.cursorList.errorTitle" = "This list could not be loaded";
