/* The spoken name of a live view of an AI assistant using a web browser. */
"monarch.aiComputerView.label.browser" = "Assistant browser view";

/* The spoken name of a live view of an AI assistant using a computer. */
"monarch.aiComputerView.label.computer" = "Assistant computer view";

/* Status: the assistant's session is starting. */
"monarch.aiComputerView.status.starting" = "Starting";

/* Status: the assistant is acting. */
"monarch.aiComputerView.status.working" = "Working";

/* Status: the person paused the assistant. */
"monarch.aiComputerView.status.paused" = "Paused";

/* Status: the assistant waits for the person to do a step. */
"monarch.aiComputerView.status.waitingForYou" = "Waiting for you";

/* Status: the person has taken control from the assistant. */
"monarch.aiComputerView.status.takenOver" = "You are in control";

/* Status: the task is finished. */
"monarch.aiComputerView.status.done" = "Done";

/* Status: the task failed. */
"monarch.aiComputerView.status.failed" = "Failed";

/* Status: the person stopped the assistant. */
"monarch.aiComputerView.status.stopped" = "Stopped";

/* The kind of an action, read before its label: a click or tap. */
"monarch.aiComputerView.kind.click" = "Click";

/* The kind of an action: typing. */
"monarch.aiComputerView.kind.type" = "Type";

/* The kind of an action: scrolling. */
"monarch.aiComputerView.kind.scroll" = "Scroll";

/* The kind of an action: opening an address. */
"monarch.aiComputerView.kind.navigate" = "Navigate";

/* The kind of an action: pressing a key. */
"monarch.aiComputerView.kind.key" = "Key press";

/* The kind of an action: waiting. */
"monarch.aiComputerView.kind.wait" = "Wait";

/* The kind of an action: reading the screen. */
"monarch.aiComputerView.kind.read" = "Read";

/* The kind of any other action. */
"monarch.aiComputerView.kind.other" = "Action";

/* Banner while the AI assistant controls a web browser. */
"monarch.aiComputerView.agentInControl.browser" = "The assistant is controlling this browser";

/* Banner while the AI assistant controls a computer. */
"monarch.aiComputerView.agentInControl.computer" = "The assistant is controlling this computer";

/* Banner while the person controls the browser instead of the assistant. */
"monarch.aiComputerView.youInControl.browser" = "You are controlling this browser";

/* Banner while the person controls the computer instead of the assistant. */
"monarch.aiComputerView.youInControl.computer" = "You are controlling this computer";

/* Title of the notice shown while the assistant waits for the person. */
"monarch.aiComputerView.waitingTitle" = "The assistant needs you to continue";

/* The reason shown while the assistant waits, when the app gives none. */
"monarch.aiComputerView.waitingFallback" = "This step is one the assistant must not do itself.";

/* The button that pauses the assistant. */
"monarch.aiComputerView.pause" = "Pause";

/* The button that lets a paused assistant continue. */
"monarch.aiComputerView.resume" = "Resume";

/* The button that gives the person control instead of the assistant. */
"monarch.aiComputerView.takeOver" = "Take over";

/* The button that gives control back to the assistant. */
"monarch.aiComputerView.handBack" = "Hand back";

/* The button that stops the assistant. */
"monarch.aiComputerView.stop" = "Stop";

/* The question that confirms stopping the assistant. */
"monarch.aiComputerView.stopQuestion" = "Stop the assistant? It will not finish the task.";

/* The button that confirms stopping the assistant. */
"monarch.aiComputerView.stopConfirm" = "Stop now";

/* The button that closes the stop confirmation and lets the assistant continue. */
"monarch.aiComputerView.stopCancel" = "Keep going";

/* The heading and spoken name of the list of actions the assistant took. */
"monarch.aiComputerView.logLabel" = "Actions";

/* The button that shows or hides the list of actions. %ld is how many actions there are. */
"monarch.aiComputerView.logToggle" = "Actions (%ld)";

/* Shown when the assistant has not acted yet. */
"monarch.aiComputerView.empty" = "No actions yet.";

/* Shown in place of a detail that is withheld, such as typed text. */
"monarch.aiComputerView.hidden" = "Hidden";

/* Shown and announced in place of the label of an action that touched private information. */
"monarch.aiComputerView.sensitiveLabel" = "Private action";

/* Shown in the screenshot area before the first screenshot arrives. */
"monarch.aiComputerView.noFrame" = "No screenshot yet";

/* Shown in the screenshot area when the screenshot address is not allowed. */
"monarch.aiComputerView.frameUnavailable" = "Screenshot unavailable";

/* Shown in the screenshot area when the screenshot may show private information. */
"monarch.aiComputerView.frameHidden" = "Screenshot hidden: it may show private information";

/* The description of a screenshot of a browser when the app gives none. */
"monarch.aiComputerView.frameAlt.browser" = "Screenshot of the browser the assistant is using";

/* The description of a screenshot of a computer when the app gives none. */
"monarch.aiComputerView.frameAlt.computer" = "Screenshot of the computer the assistant is using";

/* Joins a screenshot's description and the latest action. The first %@ is the description, the second the action. */
"monarch.aiComputerView.latestAction" = "%1$@. Latest action: %2$@";

/* Caption under the screenshot. %@ is the time it was taken. */
"monarch.aiComputerView.capturedAt" = "Screenshot from %@";

/* Read before the address of the page the assistant is on. */
"monarch.aiComputerView.address" = "Address";

/* The button that shows the screenshot full screen, where it can be zoomed. */
"monarch.aiComputerView.zoom" = "Zoom screenshot";

/* The button that shows one older action. */
"monarch.aiComputerView.showEarlierOne" = "Show 1 earlier action";

/* The button that shows older actions. %ld is how many, more than one. */
"monarch.aiComputerView.showEarlierOther" = "Show %ld earlier actions";

/* Announced when several actions arrived together. %1$ld is how many, %2$@ the latest action. */
"monarch.aiComputerView.announceActions" = "%1$ld new actions. Latest: %2$@";

/* Announced when the assistant's status changes. %@ is the status. */
"monarch.aiComputerView.announceStatus" = "Assistant status: %@";

/* Announced when the person takes control of the browser. */
"monarch.aiComputerView.announceTakenOver.browser" = "You are in control of this browser. The assistant has stopped acting.";

/* Announced when the person takes control of the computer. */
"monarch.aiComputerView.announceTakenOver.computer" = "You are in control of this computer. The assistant has stopped acting.";

/* Announced when control of the browser goes back to the assistant. */
"monarch.aiComputerView.announceReleased.browser" = "The assistant is in control of this browser again.";

/* Announced when control of the computer goes back to the assistant. */
"monarch.aiComputerView.announceReleased.computer" = "The assistant is in control of this computer again.";
