/* The heading of the column of row names in a heatmap's data table. */
"monarch.heatmap.rowHeader" = "Row";
/* Shown before the lightest colour step of a heatmap legend. */
"monarch.heatmap.less" = "Less";
/* Shown after the darkest colour step of a heatmap legend. */
"monarch.heatmap.more" = "More";
/* The heatmap legend step for cells that have no data. */
"monarch.heatmap.noData" = "No data";
/* Spoken range of the lightest positive step of a heatmap legend. %1$@ is the first cut point. */
"monarch.heatmap.rangeBelow" = "Under %1$@";
/* Spoken range of a middle step of a heatmap legend. %1$@ is the lower bound, %2$@ the upper bound. */
"monarch.heatmap.range" = "%1$@ to %2$@";
/* Spoken range of the darkest step of a heatmap legend. %1$@ is the last cut point. */
"monarch.heatmap.rangeAbove" = "%1$@ or more";
/* The size of a heatmap in its spoken summary. %1$@ is the rows, %2$@ the columns, each with its noun. */
"monarch.heatmap.size" = "%1$@ by %2$@";
/* The highest cell of a heatmap in its spoken summary. %1$@ is the cell, read as row, column and value. */
"monarch.heatmap.highest" = "Highest: %1$@";
/* Spoken for one heatmap cell. %1$@ is the row, %2$@ the column, %3$@ the value. */
"monarch.heatmap.cell" = "%1$@, %2$@: %3$@";
/* One row of a heatmap. %1$@ is the count. */
"monarch.heatmap.rowCountOne" = "%1$@ row";
/* Several rows of a heatmap. %1$@ is the count. */
"monarch.heatmap.rowCount" = "%1$@ rows";
/* One column of a heatmap. %1$@ is the count. */
"monarch.heatmap.columnCountOne" = "%1$@ column";
/* Several columns of a heatmap. %1$@ is the count. */
"monarch.heatmap.columnCount" = "%1$@ columns";
