/* The title of the button in a chart frame that replaces the chart with its data table. */
"monarch.chartFrame.viewTable" = "View as table";
/* The title of the button in a chart frame that shows the chart again instead of its data table. */
"monarch.chartFrame.viewChart" = "View as chart";
/* Spoken by VoiceOver while the data of a chart is loading. */
"monarch.chartFrame.loading" = "Loading chart";
/* The title of the empty state of a chart that has no data. */
"monarch.chartFrame.emptyTitle" = "No data yet";
/* The message shown when the data of a chart could not be loaded. */
"monarch.chartFrame.error" = "This chart didn't load.";
/* Spoken for a cell of a chart's data table that has no value. */
"monarch.chartFrame.noValue" = "No value";
