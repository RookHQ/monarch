/* The navigation title of the panel that shows the replies to one message. */
"monarch.threadPanel.title" = "Thread";

/* The button that closes the thread panel. */
"monarch.threadPanel.close" = "Close";

/* The button that turns on notifications about replies to a thread. */
"monarch.threadPanel.follow" = "Follow";

/* The same button while notifications about replies to the thread are on. */
"monarch.threadPanel.following" = "Following";

/* Announced after the person follows a thread. */
"monarch.threadPanel.followedNotice" = "You’ll be notified about replies";

/* Announced after the person stops following a thread. */
"monarch.threadPanel.unfollowedNotice" = "You won’t be notified about replies";

/* Announced when following or unfollowing a thread fails. */
"monarch.threadPanel.followFailed" = "Thread notifications didn’t change. Try again.";

/* The spoken name of the list of replies in a thread. */
"monarch.threadPanel.replies" = "Replies";

/* Spoken while a thread loads. */
"monarch.threadPanel.loading" = "Loading thread";

/* Shown when a thread could not be loaded. */
"monarch.threadPanel.error" = "This thread couldn’t be loaded.";

/* Shown when the thread was deleted. */
"monarch.threadPanel.deleted" = "This thread was deleted.";

/* The divider between a message and its replies. %lld is 1. */
"monarch.threadPanel.replyCount.one" = "%lld reply";

/* The divider between a message and its replies. %lld is the count. */
"monarch.threadPanel.replyCount.other" = "%lld replies";
