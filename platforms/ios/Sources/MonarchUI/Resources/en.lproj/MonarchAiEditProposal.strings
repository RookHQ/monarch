/* Title of the card of edits an AI proposes. */
"monarch.aiEditProposal.title" = "Suggested edits";

/* Provenance badge of the proposed edits. */
"monarch.aiEditProposal.badge" = "AI generated";

/* State badge: waiting for a person. */
"monarch.aiEditProposal.state.proposed" = "Proposed";

/* State badge: the edits were applied. */
"monarch.aiEditProposal.state.applied" = "Applied";

/* State badge: the edits were rejected. */
"monarch.aiEditProposal.state.rejected" = "Rejected";

/* State badge: the edits were applied and then undone. */
"monarch.aiEditProposal.state.reverted" = "Reverted";

/* Decision of one change: not decided. Not shown. */
"monarch.aiEditProposal.hunkState.proposed" = "Proposed";

/* Decision of one change: accepted. */
"monarch.aiEditProposal.hunkState.accepted" = "Accepted";

/* Decision of one change: rejected. */
"monarch.aiEditProposal.hunkState.rejected" = "Rejected";

/* Note of a proposal that is still proposed. Not shown. */
"monarch.aiEditProposal.readOnly.proposed" = "These edits are waiting for a decision.";

/* Note after the edits were applied. */
"monarch.aiEditProposal.readOnly.applied" = "These edits were applied.";

/* Note after the edits were rejected. */
"monarch.aiEditProposal.readOnly.rejected" = "These edits were rejected.";

/* Note after the edits were reverted. */
"monarch.aiEditProposal.readOnly.reverted" = "These edits were reverted.";

/* Count of one change, none decided. %lld is 1. */
"monarch.aiEditProposal.countOne" = "%lld change";

/* Count of the changes, none decided. %lld is the total. */
"monarch.aiEditProposal.count" = "%lld changes";

/* Undecided changes when the total is one. %1$lld is the undecided count, %2$lld the total. */
"monarch.aiEditProposal.leftOne" = "%1$lld of %2$lld change left";

/* Undecided changes. %1$lld is the undecided count, %2$lld the total. */
"monarch.aiEditProposal.left" = "%1$lld of %2$lld changes left";

/* Name of a change without a label. %1$lld is its position, %2$lld the total. */
"monarch.aiEditProposal.hunkName" = "Change %1$lld of %2$lld";

/* Button that accepts every undecided change. */
"monarch.aiEditProposal.acceptAll" = "Accept all";

/* Button that rejects every undecided change. */
"monarch.aiEditProposal.rejectAll" = "Reject all";

/* Button that accepts one change. */
"monarch.aiEditProposal.accept" = "Accept";

/* Button that rejects one change. */
"monarch.aiEditProposal.reject" = "Reject";

/* Button that undoes applied edits. */
"monarch.aiEditProposal.revert" = "Revert";

/* Spoken before removed text. */
"monarch.aiEditProposal.deleted" = "Deleted:";

/* Spoken before added text. */
"monarch.aiEditProposal.inserted" = "Inserted:";

/* Shown after a change whose text does not change. */
"monarch.aiEditProposal.unchanged" = "No change";

/* Announced after one change was accepted. */
"monarch.aiEditProposal.announce.accepted" = "Change accepted.";

/* Announced after one change was rejected. */
"monarch.aiEditProposal.announce.rejected" = "Change rejected.";

/* Announced after every change was accepted. */
"monarch.aiEditProposal.announce.acceptedAll" = "All changes accepted.";

/* Announced after every change was rejected. */
"monarch.aiEditProposal.announce.rejectedAll" = "All changes rejected.";

/* Announced after a decision when changes remain. %lld is the number left. */
"monarch.aiEditProposal.announce.left" = "%lld left.";

/* Announced after a decision when no changes remain. */
"monarch.aiEditProposal.announce.noneLeft" = "No changes left.";

/* Spoken name of a per-change button. %1$@ is the action, such as "Accept", %2$@ the change, such as "Change 2 of 3". */
"monarch.aiEditProposal.action" = "%1$@, %2$@";
