/* Heading and spoken name of the AI spending limit. */
"monarch.aiSpendCap.title" = "AI spending limit";

/* The daily period in running text, as in "£12.40 of £50.00 today". */
"monarch.aiSpendCap.period.day" = "today";

/* The weekly period in running text, as in "£12.40 of £50.00 this week". */
"monarch.aiSpendCap.period.week" = "this week";

/* The monthly period in running text, as in "£12.40 of £50.00 this month". */
"monarch.aiSpendCap.period.month" = "this month";

/* State: spending is below the warning share. */
"monarch.aiSpendCap.state.ok" = "Within limit";

/* State: spending is close to the limit. */
"monarch.aiSpendCap.state.warning" = "Close to the limit";

/* State: spending is at or over the limit. */
"monarch.aiSpendCap.state.reached" = "Limit reached";

/* State: there is no limit. */
"monarch.aiSpendCap.state.no-limit" = "No limit set";

/* Amount line. %1$@ is the spent amount, %2$@ the limit, %3$@ the period ("this month"). */
"monarch.aiSpendCap.spentOfLimit" = "%1$@ of %2$@ %3$@";

/* Amount line without a limit. %1$@ is the spent amount, %2$@ the period. */
"monarch.aiSpendCap.spentNoLimit" = "%1$@ spent %2$@";

/* Spoken name of the bar of spending against the limit. */
"monarch.aiSpendCap.meterLabel" = "Spent against the limit";

/* What is left before the limit. %@ is an amount. */
"monarch.aiSpendCap.remaining" = "%@ left";

/* How far spending is past the limit. %@ is an amount. */
"monarch.aiSpendCap.over" = "%@ over the limit";

/* When the warning starts. %@ is a percentage. */
"monarch.aiSpendCap.warnsAt" = "Warns at %@";

/* What happens at the limit when AI pauses. */
"monarch.aiSpendCap.behaviorSummary.pause" = "At the limit, AI pauses and asks";

/* What happens at the limit when AI keeps going. */
"monarch.aiSpendCap.behaviorSummary.notify" = "At the limit, AI keeps going and tells you";

/* When the period starts again. %@ is a date. */
"monarch.aiSpendCap.resets" = "Resets %@";

/* Heading of the list of what each agent or feature spent. */
"monarch.aiSpendCap.breakdownLabel" = "Where it was spent";

/* Button that opens the form when a limit is set. */
"monarch.aiSpendCap.edit" = "Edit limit";

/* Button that opens the form when there is no limit. */
"monarch.aiSpendCap.setLimit" = "Set a limit";

/* Title of the notice shown when the limit is reached and AI is paused. */
"monarch.aiSpendCap.pausedTitle" = "AI is paused.";

/* Body of the paused notice. %1$@ is the limit, %2$@ the period ("this month"). */
"monarch.aiSpendCap.pausedBody" = "The %1$@ limit for %2$@ has been reached. Nothing more is spent until the limit is raised or the period resets.";

/* Button in the paused notice that opens the form. */
"monarch.aiSpendCap.raiseLimit" = "Raise limit";

/* Button for people who cannot change the limit. */
"monarch.aiSpendCap.requestIncrease" = "Request a higher limit";

/* Explains who can change the limit, for people who cannot. */
"monarch.aiSpendCap.readOnly" = "Only a workspace admin can change this limit.";

/* Label of the amount field. */
"monarch.aiSpendCap.amountLabel" = "Limit";

/* Help under the amount field. %1$@ is the spent amount, %2$@ the period. */
"monarch.aiSpendCap.amountHint" = "%1$@ spent %2$@ so far.";

/* Error: the amount field is empty. */
"monarch.aiSpendCap.errorRequired" = "Enter an amount. To have no limit, use Remove limit.";

/* Error: the amount is zero or less. */
"monarch.aiSpendCap.errorPositive" = "Enter an amount greater than zero.";

/* Error: the amount is above the highest limit. %@ is that limit. */
"monarch.aiSpendCap.errorMax" = "Enter %@ or less.";

/* Warning: the new limit is below what is spent, and AI pauses. %1$@ is the spent amount, %2$@ the period. */
"monarch.aiSpendCap.belowSpent.pause" = "This is below the %1$@ already spent %2$@, so AI will pause straight away. Save again to confirm.";

/* Warning: the new limit is below what is spent, and AI keeps going. %1$@ is the spent amount, %2$@ the period. */
"monarch.aiSpendCap.belowSpent.notify" = "This is below the %1$@ already spent %2$@, so the limit counts as reached straight away. Save again to confirm.";

/* Label of the choice of when to warn. */
"monarch.aiSpendCap.warnAtLabel" = "Warn me at";

/* One choice of when to warn. %@ is a percentage. */
"monarch.aiSpendCap.warnAtOption" = "%@ of the limit";

/* Label of the choice of what happens at the limit. */
"monarch.aiSpendCap.behaviorLabel" = "When the limit is reached";

/* Choice: AI pauses at the limit. */
"monarch.aiSpendCap.behaviorOption.pause" = "Pause and ask";

/* Choice: AI keeps going at the limit. */
"monarch.aiSpendCap.behaviorOption.notify" = "Keep going and tell me";

/* What pausing at the limit means. */
"monarch.aiSpendCap.behaviorDescription.pause" = "AI stops. Nothing more is spent until someone raises the limit or the period resets.";

/* What keeping going at the limit means. */
"monarch.aiSpendCap.behaviorDescription.notify" = "AI carries on and you are notified. Spending can go over the limit.";

/* Save button. */
"monarch.aiSpendCap.save" = "Save";

/* Save button after the below-spent warning. */
"monarch.aiSpendCap.saveAnyway" = "Save anyway";

/* Cancel button. */
"monarch.aiSpendCap.cancel" = "Cancel";

/* Button that removes the limit, and the button that confirms it. */
"monarch.aiSpendCap.removeLimit" = "Remove limit";

/* Question asked before the limit is removed. */
"monarch.aiSpendCap.removeConfirmTitle" = "Remove the spending limit?";

/* What removing the limit means. */
"monarch.aiSpendCap.removeConfirmBody" = "AI will be able to spend without a cap until a new limit is set.";

/* Button that keeps the limit. */
"monarch.aiSpendCap.removeCancel" = "Keep limit";

/* Announced when the state changes. %1$@ is the title, %2$@ the state, %3$@ the amount line. */
"monarch.aiSpendCap.announce" = "%1$@: %2$@. %3$@";
