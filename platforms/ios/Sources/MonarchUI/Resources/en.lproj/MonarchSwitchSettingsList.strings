/* Shown beside the spinner of a setting that is saving. */
"monarch.switchSettingsList.saving" = "Saving";

/* Shown and announced after a setting was saved. */
"monarch.switchSettingsList.saved" = "Saved";

/* Shown and announced when a setting could not be saved, before the reason. */
"monarch.switchSettingsList.error" = "Couldn’t save.";

/* The title of the button that saves a setting again after a failure. */
"monarch.switchSettingsList.retry" = "Retry";

/* The spoken name of the retry button. %@ is the name of the setting. */
"monarch.switchSettingsList.retryLabel" = "Retry %@";
