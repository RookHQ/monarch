/* The heading of the list of billable rows of an invoice, quote or proposal. */
"monarch.lineItemsEditor.label" = "Line items";
/* The heading of one row. %d is the row number, from 1. */
"monarch.lineItemsEditor.item" = "Item %d";
/* The label of the description field of a row. */
"monarch.lineItemsEditor.description" = "Description";
/* The label of the quantity field of a row. */
"monarch.lineItemsEditor.quantity" = "Qty";
/* The label of the unit price field of a row. %@ is the currency code, such as USD. */
"monarch.lineItemsEditor.unitPrice" = "Unit price (%@)";
/* The name of a row's amount: quantity times unit price. */
"monarch.lineItemsEditor.amount" = "Amount";
/* The placeholder of an empty description field. */
"monarch.lineItemsEditor.descriptionPlaceholder" = "Item or service";
/* The button that adds a row. */
"monarch.lineItemsEditor.addItem" = "Add item";
/* The swipe action that removes a row. */
"monarch.lineItemsEditor.remove" = "Remove";
/* The spoken name of a row's remove button. %d is the row number. */
"monarch.lineItemsEditor.removeItem" = "Remove item %d";
/* The spoken name of a row's remove button when the row has a description. %1$d is the row number, %2$@ the description. */
"monarch.lineItemsEditor.removeItemNamed" = "Remove item %1$d: %2$@";
/* Shown when there are no rows. */
"monarch.lineItemsEditor.empty" = "No items yet. Add one to start.";
/* Announced after a row is added. %d is its number. */
"monarch.lineItemsEditor.added" = "Item %d added";
/* Announced after a row is removed. %d is the number it had. */
"monarch.lineItemsEditor.removed" = "Item %d removed";
/* The name of the sum of the rows. */
"monarch.lineItemsEditor.subtotal" = "Subtotal";
/* The name of the discount row. */
"monarch.lineItemsEditor.discount" = "Discount";
/* The discount row with its percentage. %@ is the percentage, such as 5%. */
"monarch.lineItemsEditor.discountRate" = "Discount (%@)";
/* The name of the picker between a percentage and an amount discount. */
"monarch.lineItemsEditor.discountType" = "Discount type";
/* The choice of a percentage discount. */
"monarch.lineItemsEditor.percentOption" = "%%";
/* The name of the tax row. */
"monarch.lineItemsEditor.tax" = "Tax";
/* The tax row with its rate. %@ is the rate, such as 18%. */
"monarch.lineItemsEditor.taxWithRate" = "Tax (%@)";
/* The label of the tax rate field or picker. */
"monarch.lineItemsEditor.taxRate" = "Tax rate";
/* The name of the total. */
"monarch.lineItemsEditor.total" = "Total";
/* Spoken after the heading when at least one row is required. */
"monarch.lineItemsEditor.required" = "Required";
/* A row of a sent document. %1$@ is the quantity, %2$@ the unit price. */
"monarch.lineItemsEditor.quantityTimesPrice" = "%1$@ × %2$@";
