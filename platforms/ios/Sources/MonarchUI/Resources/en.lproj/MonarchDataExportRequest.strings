/* Title of the card where a person requests a copy of their data. */
"monarch.dataExportRequest.title" = "Download your data";

/* Line under the title of the data export card. */
"monarch.dataExportRequest.description" = "Get a copy of the data in your account.";

/* Status badge of a data export that was never requested. */
"monarch.dataExportRequest.status.idle" = "Not requested";

/* Status badge of a data export that was requested and is queued. */
"monarch.dataExportRequest.status.requested" = "Requested";

/* Status badge of a data export whose file is being built. */
"monarch.dataExportRequest.status.preparing" = "Preparing";

/* Status badge of a data export that can be downloaded. */
"monarch.dataExportRequest.status.ready" = "Ready";

/* Status badge of a data export whose download expired. */
"monarch.dataExportRequest.status.expired" = "Expired";

/* Status badge of a data export that could not be built. */
"monarch.dataExportRequest.status.failed" = "Failed";

/* Button that requests the first data export. */
"monarch.dataExportRequest.request" = "Request export";

/* Button that requests a data export again after one expired or failed. */
"monarch.dataExportRequest.requestAgain" = "Request a new export";

/* Button that downloads the data export. */
"monarch.dataExportRequest.download" = "Download";

/* Label of the checklist of kinds of data to include in the export. */
"monarch.dataExportRequest.scopeLegend" = "Include";

/* Error shown when no kind of data is chosen for the export. */
"monarch.dataExportRequest.scopeRequired" = "Choose at least one kind of data.";

/* Label of the menu of file formats for the export. */
"monarch.dataExportRequest.formatLabel" = "Format";

/* Status line after the export was requested, when the date is unknown. */
"monarch.dataExportRequest.requested" = "We received your request.";

/* Status line after the export was requested. %@ is the date and time of the request. */
"monarch.dataExportRequest.requestedOn" = "We received your request on %@.";

/* Status line while the export is prepared, when the request date is unknown. */
"monarch.dataExportRequest.preparing" = "Your export is being prepared.";

/* Status line while the export is prepared. %@ is the date and time of the request. */
"monarch.dataExportRequest.preparingSince" = "Your export is being prepared. Requested on %@.";

/* Read by VoiceOver for the progress bar while the export is prepared. */
"monarch.dataExportRequest.preparingProgress" = "Preparing your export";

/* First sentence of the status line when the export is ready. */
"monarch.dataExportRequest.ready" = "Your export is ready.";

/* Sentence after "Your export is ready." %@ is the date and time it was prepared. */
"monarch.dataExportRequest.readyOn" = "Prepared on %@.";

/* Sentence after "Your export is ready." %@ is the date and time the download stops working. */
"monarch.dataExportRequest.readyUntil" = "You can download it until %@.";

/* Status line when the download expired and the date is unknown. */
"monarch.dataExportRequest.expired" = "The download has expired. Request a new export to get your data.";

/* Status line when the download expired. %@ is the date and time it expired. */
"monarch.dataExportRequest.expiredOn" = "The download expired on %@. Request a new export to get your data.";

/* Status line when the export could not be prepared. */
"monarch.dataExportRequest.failed" = "Your export could not be prepared. Request it again.";

/* Shown when the request for an export fails without a reason. */
"monarch.dataExportRequest.requestFailed" = "The request did not go through. Try again.";
