/* Spoken name of the visible start of an API key. %@ is the prefix, such as sk_live_4f2a. */
"monarch.apiKeyRow.prefix" = "Key starting with %@";

/* When the key was created. %@ is a relative time, such as 3 months ago. */
"monarch.apiKeyRow.created" = "Created: %@";

/* When the key was last used. %@ is a relative time, such as 2 days ago. */
"monarch.apiKeyRow.lastUsed" = "Last used: %@";

/* Shown when the key was never used. */
"monarch.apiKeyRow.neverUsed" = "Never used";

/* When the key expires. %@ is a relative time, such as in 5 days. */
"monarch.apiKeyRow.expires" = "Expires: %@";

/* Spoken name of the list of scopes. */
"monarch.apiKeyRow.scopes" = "Scopes";

/* Shown when the key has no scopes. */
"monarch.apiKeyRow.noScopes" = "No scopes";

/* Badge for scopes that are not listed. %lld is how many. */
"monarch.apiKeyRow.moreScopes" = "+%lld";

/* Status of a key that is in use. */
"monarch.apiKeyRow.status.active" = "Active";

/* Status of a key that expires soon. */
"monarch.apiKeyRow.status.expiring" = "Expiring soon";

/* Status of a key past its expiry date. */
"monarch.apiKeyRow.status.expired" = "Expired";

/* Status of a key that was revoked. */
"monarch.apiKeyRow.status.revoked" = "Revoked";

/* Menu action that replaces the key with a new one. */
"monarch.apiKeyRow.rotate" = "Rotate";

/* Menu action that revokes the key. */
"monarch.apiKeyRow.revoke" = "Revoke";

/* Spoken name of the actions menu. %@ is the key's name. */
"monarch.apiKeyRow.actions" = "Actions for %@";

/* Title of the rotate confirmation. %@ is the key's name. */
"monarch.apiKeyRow.rotateTitle" = "Rotate %@?";

/* Message of the rotate confirmation. */
"monarch.apiKeyRow.rotateMessage" = "A new key is issued and shown once. Update every place that uses this key before the old one stops working.";

/* Button that confirms the rotation. */
"monarch.apiKeyRow.rotateConfirm" = "Rotate key";

/* Title of the revoke confirmation. %@ is the key's name. */
"monarch.apiKeyRow.revokeTitle" = "Revoke %@?";

/* Message of the revoke confirmation. */
"monarch.apiKeyRow.revokeMessage" = "Requests that use this key will be rejected. This cannot be undone. Apps using this key stop working right away.";

/* Button that confirms the revocation. */
"monarch.apiKeyRow.revokeConfirm" = "Revoke key";

/* Prompt of the field in the revoke confirmation. %@ is the phrase to type. */
"monarch.apiKeyRow.revokePhrasePrompt" = "Type %@ to confirm";

/* Button that closes a confirmation without acting. */
"monarch.apiKeyRow.cancel" = "Cancel";

/* Shown while the key is being rotated. */
"monarch.apiKeyRow.rotating" = "Rotating…";

/* Shown while the key is being revoked. */
"monarch.apiKeyRow.revoking" = "Revoking…";

/* Shown when rotating the key failed without a reason. */
"monarch.apiKeyRow.rotateFailed" = "Couldn’t rotate the key.";

/* Shown when revoking the key failed without a reason. */
"monarch.apiKeyRow.revokeFailed" = "Couldn’t revoke the key.";
