/* The accessibility name of the timesheet grid. */
"monarch.timesheetGrid.caption" = "Time per row and day";

/* The heading of the first column of the timesheet grid, which names each row. */
"monarch.timesheetGrid.rowHeader" = "Project";

/* The heading of the column with each row's total for the period. */
"monarch.timesheetGrid.total" = "Total";

/* The heading of the footer row with the total of each day. */
"monarch.timesheetGrid.dayTotal" = "Day total";

/* The accessibility name of a row's actions menu. %@ is the row's name. */
"monarch.timesheetGrid.rowActions" = "Actions for %@";

/* The accessibility name of a cell. %1$@ is the row's name, %2$@ the day, such as "Mon, Jan 12". */
"monarch.timesheetGrid.cellLabel" = "%1$@, %2$@";

/* Read with a cell of a day that cannot be edited and has no reason. */
"monarch.timesheetGrid.locked" = "Locked";

/* Read for a cell with no time logged. */
"monarch.timesheetGrid.noTime" = "No time";

/* Shown when the text typed in a cell cannot be read as a duration. */
"monarch.timesheetGrid.invalid" = "Use a time such as 1:30, 1.5h or 90m.";

/* Shown when a cell is longer than a day allows. %@ is the maximum, such as "24h". */
"monarch.timesheetGrid.tooLong" = "A day has at most %@.";

/* Shown when saving a cell failed without a description. */
"monarch.timesheetGrid.saveFailed" = "That time could not be saved.";

/* Under a day total. %@ is the expected duration, such as "8h". */
"monarch.timesheetGrid.expected" = "of %@";

/* Read with a day total that is above the daily maximum. */
"monarch.timesheetGrid.overLimit" = "Over the daily limit";

/* Shown when the timesheet has no rows. */
"monarch.timesheetGrid.empty" = "No time logged for this period.";

/* Read with the heading of today's column. */
"monarch.timesheetGrid.today" = "Today";

/* Read for a cell whose value is being saved. */
"monarch.timesheetGrid.saving" = "Saving";

/* The button that shows the previous day on a day page. */
"monarch.timesheetGrid.previousDay" = "Previous day";

/* The button that shows the next day on a day page. */
"monarch.timesheetGrid.nextDay" = "Next day";

/* A row's total for the period on a day page. %@ is the duration, such as "7h 30m". */
"monarch.timesheetGrid.rowTotal" = "Total %@";

/* Read before an error message. %@ is the message. */
"monarch.timesheetGrid.error" = "Error: %@";
