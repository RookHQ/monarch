/* Read while the content of a section card loads. */
"monarch.sectionCard.loading" = "Loading";

/* Title of the empty state of a section card. */
"monarch.sectionCard.emptyTitle" = "Nothing here yet";

/* Title of the error state of a section card. */
"monarch.sectionCard.errorTitle" = "This section didn’t load";

/* Spoken value of the title of a collapsible section card that is open. */
"monarch.sectionCard.expanded" = "Expanded";

/* Spoken value of the title of a collapsible section card that is closed. */
"monarch.sectionCard.collapsed" = "Collapsed";
