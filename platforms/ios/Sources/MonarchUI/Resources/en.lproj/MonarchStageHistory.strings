/* The first entry of a stage history. %@ is the first stage. */
"monarch.stageHistory.started" = "Started at %@";

/* Read by VoiceOver between the stage moved from and the stage moved to. */
"monarch.stageHistory.to" = "to";

/* Shown after a move that went back to an earlier stage. */
"monarch.stageHistory.movedBack" = "(moved back)";

/* Shown when an item has no stage moves. */
"monarch.stageHistory.empty" = "No stage moves yet.";
