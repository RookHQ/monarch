/* The spoken name of a card's Move menu. %@ is the card. */
"monarch.kanbanBoard.moveMenu" = "Move %@ to…";

/* The heading of the columns in a card's Move menu. */
"monarch.kanbanBoard.moveToSection" = "Move to";

/* The VoiceOver action that moves a card to another column. %@ is the column. */
"monarch.kanbanBoard.moveTo" = "Move to %@";

/* The menu item and VoiceOver action that moves a card one place up in its column. */
"monarch.kanbanBoard.moveUp" = "Move up";

/* The menu item and VoiceOver action that moves a card one place down in its column. */
"monarch.kanbanBoard.moveDown" = "Move down";

/* The count in a column header without a limit. %ld is the count. */
"monarch.kanbanBoard.countText" = "%ld";

/* The count in a column header with a work-in-progress limit. %1$ld is the count, %2$ld the limit. */
"monarch.kanbanBoard.countTextLimit" = "%1$ld / %2$ld";

/* The spoken card count, for one. %ld is 1. */
"monarch.kanbanBoard.cards.one" = "%ld card";

/* The spoken card count. %ld is the count. */
"monarch.kanbanBoard.cards.other" = "%ld cards";

/* Added to the spoken count of a column with a limit. %ld is the limit. */
"monarch.kanbanBoard.limit" = "limit %ld";

/* Added to the spoken count of a column at its limit. */
"monarch.kanbanBoard.atLimit" = "at the limit";

/* Added to the spoken count of a column over its limit. */
"monarch.kanbanBoard.overLimit" = "over the limit";

/* Shown in a column with no cards. */
"monarch.kanbanBoard.empty" = "No cards";

/* The spoken name of the row of column tabs. */
"monarch.kanbanBoard.columns" = "Columns";

/* Announced after a move from the menu or a VoiceOver action. %1$@ is the card, %2$@ the column, %3$ld the position and %4$ld the total. */
"monarch.kanbanBoard.moved" = "%1$@: %2$@, position %3$ld of %4$ld.";

/* Announced after a drop. %1$@ is the card, %2$@ the column, %3$ld the position and %4$ld the total. */
"monarch.kanbanBoard.dropped" = "%1$@ dropped in %2$@, position %3$ld of %4$ld.";

/* Announced when a column refuses a dropped card. %1$@ is the card, %2$@ the column. */
"monarch.kanbanBoard.notAllowed" = "%1$@ cannot move to %2$@.";

/* Announced when saving a move failed and the card went back. %1$@ is the card, %2$@ the column it is back in. */
"monarch.kanbanBoard.failed" = "Could not move %1$@. It is back in %2$@.";
