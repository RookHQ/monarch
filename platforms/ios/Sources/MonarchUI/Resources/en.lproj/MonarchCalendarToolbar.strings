/* The button that moves a calendar to the range that contains today. */
"monarch.calendarToolbar.today" = "Today";

/* The spoken name of the button that moves a calendar back. %@ is the unit, such as "week". */
"monarch.calendarToolbar.previous" = "Previous %@";

/* The spoken name of the button that moves a calendar forward. %@ is the unit, such as "week". */
"monarch.calendarToolbar.next" = "Next %@";

/* The spoken name of the menu that switches between day, week, month and agenda views. */
"monarch.calendarToolbar.view" = "Calendar view";

/* The spoken name of the indicator shown while a calendar range loads. */
"monarch.calendarToolbar.loading" = "Loading";

/* A calendar view that shows one day. */
"monarch.calendarToolbar.view.day" = "Day";

/* A calendar view that shows one week. */
"monarch.calendarToolbar.view.week" = "Week";

/* A calendar view that shows one month. */
"monarch.calendarToolbar.view.month" = "Month";

/* A calendar view that lists events. */
"monarch.calendarToolbar.view.agenda" = "Agenda";

/* The unit the day view moves by, used in "Previous day". */
"monarch.calendarToolbar.unit.day" = "day";

/* The unit the week view moves by, used in "Previous week". */
"monarch.calendarToolbar.unit.week" = "week";

/* The unit the month view moves by, used in "Previous month". */
"monarch.calendarToolbar.unit.month" = "month";

/* The unit the agenda view moves by, used in "Previous period". */
"monarch.calendarToolbar.unit.agenda" = "period";
