/* The spoken name of the chart and the list of a roadmap. Replaced by MonarchGanttTimelineLabels.timeline. */
"monarch.roadmap.timeline" = "Roadmap";

/* The heading of the project-name column of a roadmap chart. Replaced by MonarchGanttTimelineLabels.rowHeader. */
"monarch.roadmap.rowHeader" = "Project";

/* Health of a roadmap project or group, written in its row heading. */
"monarch.roadmap.health.onTrack" = "On track";

/* Health of a roadmap project or group, written in its row heading. */
"monarch.roadmap.health.atRisk" = "At risk";

/* Health of a roadmap project or group, written in its row heading. */
"monarch.roadmap.health.offTrack" = "Off track";

/* Written in a roadmap row heading when health is tracked but none was reported. */
"monarch.roadmap.health.notReported" = "No health reported";

/* Number of projects in a roadmap group heading, when there is one. */
"monarch.roadmap.count.one" = "1 project";

/* Number of projects in a roadmap group heading. %d is the count. */
"monarch.roadmap.count.other" = "%d projects";

/* Joins two parts of the second line of a roadmap row heading. The arguments are the parts. */
"monarch.roadmap.meta" = "%1$@ · %2$@";
