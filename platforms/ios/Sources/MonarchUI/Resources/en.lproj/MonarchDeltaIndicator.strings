/* Spoken by VoiceOver before the size of an increase, as in "up 12%". */
"monarch.deltaIndicator.up" = "up";
/* Spoken by VoiceOver before the size of a decrease, as in "down 12%". */
"monarch.deltaIndicator.down" = "down";
/* Shown and spoken when a value did not change. */
"monarch.deltaIndicator.flat" = "No change";
/* Spoken by VoiceOver after a change in the good direction. */
"monarch.deltaIndicator.better" = "better";
/* Spoken by VoiceOver after a change in the bad direction. */
"monarch.deltaIndicator.worse" = "worse";
/* Shown and spoken when there is no earlier value to compare with. */
"monarch.deltaIndicator.noData" = "No earlier data";
