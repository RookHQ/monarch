/* The title of the toggle that wraps long lines of a code block instead of scrolling sideways. */
"monarch.codeBlock.wrap" = "Wrap lines";

/* Spoken before a line that a diff adds. */
"monarch.codeBlock.added" = "Added";

/* Spoken before a line that a diff removes. */
"monarch.codeBlock.removed" = "Removed";

/* The spoken name of a code block that has no title and no known language. */
"monarch.codeBlock.code" = "Code";

/* The spoken name of a code block that has no title. %@ is the language, such as "TypeScript". */
"monarch.codeBlock.languageCode" = "%@ code";

/* A changed line of a diff as VoiceOver reads it. The first %@ is "Added" or "Removed", the second the line. */
"monarch.codeBlock.diffLine" = "%1$@: %2$@";
