/* The spoken name of the list of conditions. */
"monarch.conditionEditor.label" = "Conditions";

/* The visible title and spoken name of one condition. %ld is its position. */
"monarch.conditionEditor.condition" = "Condition %ld";

/* The spoken name of a condition's field menu. %ld is its position. */
"monarch.conditionEditor.field" = "Condition %ld field";

/* The spoken name of a condition's operator menu. %ld is its position. */
"monarch.conditionEditor.operatorLabel" = "Condition %ld operator";

/* The spoken name of a condition's value. %ld is its position. */
"monarch.conditionEditor.value" = "Condition %ld value";

/* The spoken name of a condition's remove button. %ld is its position. */
"monarch.conditionEditor.remove" = "Remove condition %ld";

/* The title of the button that adds a condition. */
"monarch.conditionEditor.add" = "Add condition";

/* The text before the all or any switch: "Match [all] of these conditions". */
"monarch.conditionEditor.matchBefore" = "Match";

/* The text after the all or any switch: "Match [all] of these conditions". */
"monarch.conditionEditor.matchAfter" = "of these conditions";

/* The spoken name of the all or any switch. */
"monarch.conditionEditor.matchLabel" = "Conditions that must hold";

/* The all choice of the switch: every condition must hold. */
"monarch.conditionEditor.matchAll" = "all";

/* The any choice of the switch: at least one condition must hold. */
"monarch.conditionEditor.matchAny" = "any";

/* Shown when there are no conditions. */
"monarch.conditionEditor.empty" = "No conditions. This applies every time.";

/* Shown instead of the add button when the list is full. %ld is the most conditions. */
"monarch.conditionEditor.maxReached" = "You can add up to %ld conditions.";

/* Announced after a condition is removed. %ld is the position it had. */
"monarch.conditionEditor.removed" = "Condition %ld removed.";
