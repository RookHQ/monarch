/* The button that opens the photo picker when there is no profile picture yet. */
"monarch.avatarUpload.upload" = "Upload photo";

/* The button that opens the photo picker to replace the profile picture. */
"monarch.avatarUpload.change" = "Change photo";

/* The button that removes the profile picture. */
"monarch.avatarUpload.remove" = "Remove photo";

/* The title of the screen where the picked photo is moved and zoomed before saving. */
"monarch.avatarUpload.editorTitle" = "Position your photo";

/* The spoken name of the area where the photo is moved and zoomed. */
"monarch.avatarUpload.cropArea" = "Photo position";

/* The instructions under the crop area. */
"monarch.avatarUpload.cropHint" = "Drag to move the photo and pinch to zoom.";

/* The label of the slider that zooms the photo. */
"monarch.avatarUpload.zoom" = "Zoom";

/* The spoken value of the zoom. %lld is the zoom in percent. */
"monarch.avatarUpload.zoomValue" = "%lld%%";

/* The accessibility action that moves the photo left in the crop area. */
"monarch.avatarUpload.moveLeft" = "Move left";

/* The accessibility action that moves the photo right in the crop area. */
"monarch.avatarUpload.moveRight" = "Move right";

/* The accessibility action that moves the photo up in the crop area. */
"monarch.avatarUpload.moveUp" = "Move up";

/* The accessibility action that moves the photo down in the crop area. */
"monarch.avatarUpload.moveDown" = "Move down";

/* The accessibility action that centres the photo with no zoom. */
"monarch.avatarUpload.reset" = "Reset position";

/* The button that saves the cropped photo. */
"monarch.avatarUpload.save" = "Save photo";

/* The button that leaves the crop editor without saving. */
"monarch.avatarUpload.cancel" = "Cancel";

/* Shown when the cropped photo could not be saved. */
"monarch.avatarUpload.saveFailed" = "The photo could not be saved. Try again.";

/* Shown when the picked file cannot be read as a picture. */
"monarch.avatarUpload.unreadable" = "This file can’t be used as a photo.";

/* Shown when the picked file is too large. %@ is the largest size allowed, for example 5 MB. */
"monarch.avatarUpload.tooLarge" = "Choose a photo smaller than %@.";
