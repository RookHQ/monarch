/* Badge on content that AI wrote. */
"monarch.aiGeneratedBadge.generated" = "AI generated";

/* Badge on content a person wrote with AI help. */
"monarch.aiGeneratedBadge.assisted" = "AI assisted";

/* Badge on content AI wrote and a person has since changed. */
"monarch.aiGeneratedBadge.edited" = "Edited after AI";

/* Provenance read after the badge label. %@ is the model name. */
"monarch.aiGeneratedBadge.byModel" = "By %@";

/* Provenance read after the badge label. %1$@ is the model name, %2$@ the date and time. */
"monarch.aiGeneratedBadge.byModelAt" = "By %1$@, %2$@";
