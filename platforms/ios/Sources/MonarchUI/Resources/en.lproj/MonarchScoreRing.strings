/* The spoken name of a score ring that has no visible label. */
"monarch.scoreRing.name" = "Score";

/* The spoken value of a score ring. The first %1$@ is the score, the second %2$@ the top of the scale. */
"monarch.scoreRing.valueText" = "%1$@ out of %2$@";

/* The small text under the score. %@ is the top of the scale. */
"monarch.scoreRing.ofMax" = "/ %@";

/* Spoken when a score ring has no score yet. */
"monarch.scoreRing.noValue" = "No score yet";
