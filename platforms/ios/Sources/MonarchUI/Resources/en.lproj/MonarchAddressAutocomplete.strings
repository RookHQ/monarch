/* The label of the address search field. */
"monarch.addressAutocomplete.label" = "Address";

/* Shown in the address search field while it is empty. */
"monarch.addressAutocomplete.placeholder" = "Start typing an address";

/* Shown in the address suggestion list while suggestions load. */
"monarch.addressAutocomplete.searching" = "Searching…";

/* Shown while the details of the picked address load. */
"monarch.addressAutocomplete.resolving" = "Getting the address details…";

/* Shown when the address search finds nothing. */
"monarch.addressAutocomplete.empty" = "No addresses found";

/* Shown when the address search fails. A retry button follows. */
"monarch.addressAutocomplete.searchFailed" = "Couldn’t search addresses.";

/* Shown when the details of the picked address could not be loaded. */
"monarch.addressAutocomplete.resolveFailed" = "Couldn’t get that address. Enter it manually or try another.";

/* The button and list row that open the address form. */
"monarch.addressAutocomplete.enterManually" = "Enter the address manually";

/* The button that goes back from the address form to the search field. */
"monarch.addressAutocomplete.backToSearch" = "Search for an address";

/* Announced after a suggestion fills in the address form. */
"monarch.addressAutocomplete.filled" = "Address filled in. Check the details.";

/* The button that closes the address suggestion list. */
"monarch.addressAutocomplete.cancel" = "Cancel";

/* The label of the first street line. */
"monarch.addressAutocomplete.line1" = "Street address";

/* The label of the second street line. */
"monarch.addressAutocomplete.line2" = "Apartment, suite, etc.";

/* The label of the city field. */
"monarch.addressAutocomplete.city" = "City";

/* The label of the state, province or region field. */
"monarch.addressAutocomplete.region" = "State or region";

/* The label of the postal code field. */
"monarch.addressAutocomplete.postalCode" = "Postal code";

/* The label of the country field. */
"monarch.addressAutocomplete.country" = "Country";

/* Shown under the labels of optional address fields. */
"monarch.addressAutocomplete.optional" = "Optional";

/* The spoken value of the address search field when no address is filled in. */
"monarch.addressAutocomplete.noAddress" = "None";

/* Shown until the search is long enough. %lld is the number of characters needed. */
"monarch.addressAutocomplete.tooShort" = "Type at least %lld characters to search.";

/* Announced when the search finds one address. */
"monarch.addressAutocomplete.resultsOne" = "1 address found";

/* Announced when the search finds several addresses. %lld is the number. */
"monarch.addressAutocomplete.resultsMany" = "%lld addresses found";
