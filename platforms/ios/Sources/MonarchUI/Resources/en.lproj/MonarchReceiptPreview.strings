/* The title of the button that opens the receipt attached to an expense or bill. */
"monarch.receiptPreview.view" = "View receipt";
/* Shown in place of the receipt button when no receipt is attached. */
"monarch.receiptPreview.none" = "No receipt";
/* Spoken by VoiceOver while the receipt file is being fetched. */
"monarch.receiptPreview.loading" = "Loading receipt";
/* Shown when the receipt file could not be fetched. */
"monarch.receiptPreview.loadError" = "The receipt could not be loaded.";
