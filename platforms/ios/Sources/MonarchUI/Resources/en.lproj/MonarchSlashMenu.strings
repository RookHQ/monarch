/* The spoken name of the list of blocks a slash command can insert. */
"monarch.slashMenu.label" = "Insert block";

/* Shown when no slash command matches. %@ is what was typed, with the slash. */
"monarch.slashMenu.empty" = "Nothing matches “%@”";

/* Announced when one slash command matches. */
"monarch.slashMenu.countOne" = "1 option";

/* Announced when slash commands match. %ld is their number. */
"monarch.slashMenu.countOther" = "%ld options";
