/* Shown and read while one person is typing. %@ is the name of the person. */
"monarch.typingIndicator.one" = "%@ is typing…";

/* Shown and read while two people are typing. %1$@ and %2$@ are their names. */
"monarch.typingIndicator.two" = "%1$@ and %2$@ are typing…";

/* Shown and read while three or more people are typing. */
"monarch.typingIndicator.several" = "Several people are typing…";
