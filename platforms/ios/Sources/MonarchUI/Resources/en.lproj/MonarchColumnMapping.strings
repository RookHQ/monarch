/* The spoken name of the list that maps imported columns to fields. */
"monarch.columnMapping.label" = "Column mapping";

/* The spoken name of the field picker of one imported column. %@ is the column's header. */
"monarch.columnMapping.fieldFor" = "Field for %@";

/* The picker option that leaves an imported column out. */
"monarch.columnMapping.skip" = "Don’t import";

/* Added in brackets after a field that must be mapped, in the field picker. */
"monarch.columnMapping.required" = "required";

/* The badge of a field suggested because the column header matches it exactly. */
"monarch.columnMapping.exactMatch" = "Matched";

/* The badge of a field suggested because the column header is close to it. */
"monarch.columnMapping.suggested" = "Suggested";

/* Shown when an imported column has no example values. */
"monarch.columnMapping.noSamples" = "No values";

/* The summary of the mapping. The first %ld is the mapped columns, the second all columns. */
"monarch.columnMapping.summary" = "%1$ld of %2$ld columns mapped";

/* The error when required fields have no column. %@ is their names, separated by commas. */
"monarch.columnMapping.missing" = "Map a column to: %@.";

/* The error when a field is chosen for several columns. The first %@ is the field, the second the other columns. */
"monarch.columnMapping.duplicate" = "%1$@ is also chosen for %2$@.";

/* The button that sets every column to its suggested field. */
"monarch.columnMapping.useSuggestions" = "Use suggestions";

/* The button that leaves every column out of the import. */
"monarch.columnMapping.skipAll" = "Don’t import any";

/* The heading of the column that names the column of the file. */
"monarch.columnMapping.columnInFile" = "Column in file";

/* The heading of the column that shows example values. */
"monarch.columnMapping.exampleValues" = "Example values";

/* The heading of the column that picks the field to import into. */
"monarch.columnMapping.importAs" = "Import as";
