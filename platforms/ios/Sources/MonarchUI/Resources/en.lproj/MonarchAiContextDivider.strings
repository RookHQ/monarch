/* Label of the divider that marks where the assistant's memory of the conversation starts again. */
"monarch.aiContextDivider.contextReset" = "Context reset";

/* Shown under the context reset label and spoken with it. */
"monarch.aiContextDivider.contextResetDescription" = "The assistant does not see the messages above this line.";

/* Label of the divider that marks earlier messages that were condensed. */
"monarch.aiContextDivider.summarized" = "Earlier messages were summarized";

/* Title of the disclosure that reveals the summary the assistant works from. */
"monarch.aiContextDivider.showSummary" = "Show summary";

/* Spoken before the summary, so it is identified as written by AI. */
"monarch.aiContextDivider.summaryPrefix" = "AI-generated summary:";

/* Title of the button that loads or shows the original messages. */
"monarch.aiContextDivider.expand" = "Show earlier messages";
