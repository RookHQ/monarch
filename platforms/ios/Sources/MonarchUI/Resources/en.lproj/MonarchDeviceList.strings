/* The title of the device list card. */
"monarch.deviceList.title" = "Devices";

/* The line under the title of the device list card. */
"monarch.deviceList.description" = "Devices that have accessed your account.";

/* The spoken name of the list of devices. */
"monarch.deviceList.listLabel" = "Devices";

/* The name shown for a device that has no name. */
"monarch.deviceList.unnamed" = "Unknown device";

/* The badge on the device the person is using now. */
"monarch.deviceList.current" = "This device";

/* The badge on a device that is blocked from signing in. */
"monarch.deviceList.blocked" = "Blocked";

/* Before the time a device was last used, such as "Last used 5 minutes ago". */
"monarch.deviceList.lastUsed" = "Last used";

/* Before the time a device was first seen, such as "First seen 3 months ago". */
"monarch.deviceList.firstSeen" = "First seen";

/* The button that removes a device, and the confirm button of the confirmation. */
"monarch.deviceList.remove" = "Remove";

/* The spoken name of a row's remove button. %@ is the device name. */
"monarch.deviceList.removeLabel" = "Remove %@";

/* The title of the confirmation before removing a device. %@ is the device name. */
"monarch.deviceList.confirmTitle" = "Remove %@?";

/* The message of the confirmation before removing a device. */
"monarch.deviceList.confirmMessage" = "It is signed out and has to sign in again to get access.";

/* The cancel button of the confirmation. */
"monarch.deviceList.cancel" = "Cancel";

/* Announced after a device is removed. %@ is the device name. */
"monarch.deviceList.removed" = "Removed %@";

/* Shown when removing a device fails. %@ is the device name. */
"monarch.deviceList.removeFailed" = "Couldn’t remove %@. Try again.";

/* Read while the devices load. */
"monarch.deviceList.loading" = "Loading devices";

/* The title of the empty state. */
"monarch.deviceList.emptyTitle" = "No devices yet";

/* The message of the empty state. */
"monarch.deviceList.emptyMessage" = "Devices appear here when they access your account.";

/* The title of the error state when the devices could not be loaded. */
"monarch.deviceList.errorTitle" = "Couldn’t load your devices";
