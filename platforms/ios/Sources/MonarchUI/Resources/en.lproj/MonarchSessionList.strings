/* The title of the session list card. */
"monarch.sessionList.title" = "Where you’re signed in";

/* The line under the title of the session list card. */
"monarch.sessionList.description" = "Devices and browsers signed in to your account. Sign out any you don’t recognise.";

/* The spoken name of the list of sessions. */
"monarch.sessionList.listLabel" = "Signed-in sessions";

/* The badge on the session the person is using now. */
"monarch.sessionList.current" = "This device";

/* Before the time a session signed in, such as "Signed in 3 days ago". */
"monarch.sessionList.signedIn" = "Signed in";

/* Before the time a session was last used, such as "Last active 5 minutes ago". */
"monarch.sessionList.lastActive" = "Last active";

/* The button that signs out one session. */
"monarch.sessionList.signOut" = "Sign out";

/* The spoken name of the button that signs out one session. %@ is the session's label. */
"monarch.sessionList.signOutLabel" = "Sign out %@";

/* The button that signs out every session except the current one. */
"monarch.sessionList.signOutOthers" = "Sign out other devices";

/* The confirmation title for signing out another session. %@ is the session's label. */
"monarch.sessionList.confirmTitle" = "Sign out %@?";

/* The confirmation title for signing out the session in use. */
"monarch.sessionList.confirmTitleCurrent" = "Sign out of this device?";

/* The confirmation message for signing out another session. */
"monarch.sessionList.confirmMessage" = "That device will need to sign in again.";

/* The confirmation message for signing out the session in use. */
"monarch.sessionList.confirmMessageCurrent" = "You’ll need to sign in again on this device.";

/* The confirmation title for signing out every other session. */
"monarch.sessionList.othersTitle" = "Sign out other devices?";

/* The confirmation message for signing out one other session. %lld is the count. */
"monarch.sessionList.othersMessage.one" = "%lld other device will be signed out and need to sign in again. This device stays signed in.";

/* The confirmation message for signing out several other sessions. %lld is the count. */
"monarch.sessionList.othersMessage.other" = "%lld other devices will be signed out and need to sign in again. This device stays signed in.";

/* The cancel button of the confirmation. */
"monarch.sessionList.cancel" = "Cancel";

/* Announced after one session is signed out. %@ is the session's label. */
"monarch.sessionList.signedOut" = "Signed out %@";

/* Announced after one other session is signed out. %lld is the count. */
"monarch.sessionList.signedOutOthers.one" = "Signed out %lld other device";

/* Announced after several other sessions are signed out. %lld is the count. */
"monarch.sessionList.signedOutOthers.other" = "Signed out %lld other devices";

/* Shown and announced when signing out one session fails. %@ is the session's label. */
"monarch.sessionList.signOutFailed" = "Couldn’t sign out %@. Try again.";

/* Shown and announced when signing out the other sessions fails. */
"monarch.sessionList.signOutOthersFailed" = "Couldn’t sign out the other devices. Try again.";

/* Read while the sessions load. */
"monarch.sessionList.loading" = "Loading sessions";

/* The title of the empty state. */
"monarch.sessionList.emptyTitle" = "No active sessions";

/* The title of the error state. */
"monarch.sessionList.errorTitle" = "Couldn’t load your sessions";
