/* Title of the screen where people choose which optional storage and tracking the app may use. */
"monarch.consentPreferences.title" = "Privacy choices";

/* Text under the title of the privacy choices. */
"monarch.consentPreferences.description" = "Choose which optional data uses we may turn on. Strictly necessary ones keep the app working and are always on.";

/* Title of the link to the privacy policy. */
"monarch.consentPreferences.policy" = "Privacy policy";

/* Shown on a strictly necessary category that cannot be switched off. */
"monarch.consentPreferences.alwaysOn" = "Always on";

/* Shown on a category that sells or shares data while a Global Privacy Control signal is on. */
"monarch.consentPreferences.globalPrivacyControl" = "Off because a Global Privacy Control signal is on.";

/* Status of an optional category that is allowed. */
"monarch.consentPreferences.on" = "On";

/* Status of an optional category that is not allowed. */
"monarch.consentPreferences.off" = "Off";

/* Button that turns every optional category off. */
"monarch.consentPreferences.rejectAll" = "Reject all";

/* Button that turns every optional category on. */
"monarch.consentPreferences.acceptAll" = "Accept all";

/* Button that saves the categories as they are switched. */
"monarch.consentPreferences.save" = "Save choices";

/* Button that withdraws the saved choice, so the app asks again. */
"monarch.consentPreferences.withdraw" = "Withdraw consent";

/* Line naming the policy version of the saved choice. %@ is the version. */
"monarch.consentPreferences.policyVersion" = "Policy version %@";

/* Line saying when the choice was saved. %@ is a relative time such as "2 days ago" or a date. */
"monarch.consentPreferences.saved" = "Saved %@";
