/* The title of the button that reveals the hidden insights. %lld is how many are hidden. */
"monarch.insightStrip.showMore" = "Show %lld more";

/* The title of the button that hides the extra insights again. */
"monarch.insightStrip.showLess" = "Show fewer";

/* Shown when there are no insights. */
"monarch.insightStrip.empty" = "Nothing needs attention right now.";

/* The spoken name of the placeholder shown while insights load. */
"monarch.insightStrip.loading" = "Loading insights";

/* The title of the button that loads the insights again after a failure. */
"monarch.insightStrip.retry" = "Try again";

/* The spoken name of the button that dismisses one insight. */
"monarch.insightStrip.dismiss" = "Dismiss insight";

/* The label of the collapsed section that holds the evidence of an insight. */
"monarch.insightStrip.evidence" = "Show evidence";

/* The visible label of an insight raised by a fixed rule. */
"monarch.insightStrip.origin.rule" = "Rule-based";

/* The visible label of an insight produced by a model. */
"monarch.insightStrip.origin.ai" = "AI insight";
