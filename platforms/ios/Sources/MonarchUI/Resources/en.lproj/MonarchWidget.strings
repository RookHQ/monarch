/* The spoken name of a widget's overflow menu button. %@ is the widget's title. */
"monarch.widget.menu" = "More actions for %@";

/* The title of the button that opens the full list or report behind a widget. */
"monarch.widget.viewAll" = "View all";

/* The spoken name of the view-all button. It starts with the visible text. %@ is the widget's title. */
"monarch.widget.viewAllLabel" = "View all: %@";

/* The spoken name of a widget's loading placeholder. %@ is the widget's title. */
"monarch.widget.loading" = "Loading %@";

/* Shown when a widget's data could not be loaded and the app gave no message. */
"monarch.widget.error" = "This section could not be loaded.";

/* The title shown when a widget has nothing to show and the app gave no title. */
"monarch.widget.empty" = "Nothing to show yet";

/* The last-updated line in a widget's footer. %@ is a relative time such as "5 minutes ago". */
"monarch.widget.updated" = "Updated %@";
