/* Button that hands AI-written code to the app, for example to apply an edit to a file. */
"monarch.aiCodeBlock.apply" = "Apply";

/* Button that hands AI-written code to the app to insert it, for example at the cursor. */
"monarch.aiCodeBlock.insert" = "Insert";

/* VoiceOver hint of Apply and Insert while the code is still being written. */
"monarch.aiCodeBlock.incompleteHint" = "Available when the code is complete";

/* Spoken name of an action button. %1$@ is the action, such as "Apply"; %2$@ the code's name, such as "server.ts" or "TypeScript code". */
"monarch.aiCodeBlock.actionLabel" = "%1$@ %2$@";
