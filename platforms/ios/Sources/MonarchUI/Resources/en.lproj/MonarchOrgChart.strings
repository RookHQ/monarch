/* The spoken name of an organisation chart. */
"monarch.orgChart.label" = "Organisation chart";

/* Read after the title of an open position (a vacancy) in an organisation chart. */
"monarch.orgChart.vacant" = "Open position";

/* Read for a person whose reporting line is temporary or acting. */
"monarch.orgChart.dashed" = "Temporary reporting line";

/* Read for a person with one secondary (dotted-line) manager. %@ is the manager's name. */
"monarch.orgChart.alsoReportsTo" = "Also reports to %@";

/* The number of direct reports of a person, when there is one. */
"monarch.orgChart.reports.one" = "1 direct report";

/* The number of direct reports of a person, when there are several. %d is the number. */
"monarch.orgChart.reports.other" = "%d direct reports";

/* The state of a person whose team is shown. */
"monarch.orgChart.expanded" = "Team shown";

/* The state of a person whose team is hidden. */
"monarch.orgChart.collapsed" = "Team hidden";

/* The state of a person whose team is being loaded. */
"monarch.orgChart.loading" = "Loading team";

/* The accessibility action that shows a person's team. */
"monarch.orgChart.expand" = "Show team";

/* The accessibility action that hides a person's team. */
"monarch.orgChart.collapse" = "Hide team";

/* The menu item and accessibility action that asks to move a person to a new manager. */
"monarch.orgChart.move" = "Move…";

/* The hint shown above an organisation chart in which people can be moved. */
"monarch.orgChart.moveHint" = "Drag a person onto their new manager, or touch and hold a card and choose Move.";

/* Announced when a team could not be loaded. %@ is the manager's name. */
"monarch.orgChart.loadFailed" = "Could not load %@’s team.";

/* The button that makes the chart larger. */
"monarch.orgChart.zoomIn" = "Zoom in";

/* The button that makes the chart smaller. */
"monarch.orgChart.zoomOut" = "Zoom out";

/* The button that returns the chart to its normal size. */
"monarch.orgChart.zoomReset" = "Reset zoom";

/* The zoom level, shown and announced. %d is the percentage. */
"monarch.orgChart.zoomLevel" = "%d%%";
