/* The heading of the screen shown before joining a call. */
"monarch.preJoinLobby.title" = "Join the call";

/* The spoken name of the area that shows the person's own camera before joining. */
"monarch.preJoinLobby.preview" = "Your camera preview";

/* Shown in the preview area while the camera is off. */
"monarch.preJoinLobby.cameraOff" = "Camera is off";

/* Shown in the preview area while the camera starts. */
"monarch.preJoinLobby.startingCamera" = "Starting camera…";

/* Shown in the preview area when the camera cannot be shown, for example when access is blocked. */
"monarch.preJoinLobby.noPreview" = "No preview";

/* The spoken name of the microphone and camera toggles before joining a call. */
"monarch.preJoinLobby.controls" = "Microphone and camera";

/* The spoken name of the meter that shows how loud the microphone picks up the person. */
"monarch.preJoinLobby.micLevel" = "Microphone level";

/* The number of people already in the call, for one person. %lld is 1. */
"monarch.preJoinLobby.alreadyIn.one" = "%lld already in the call";

/* The number of people already in the call. %lld is the count. */
"monarch.preJoinLobby.alreadyIn.other" = "%lld already in the call";

/* The button that leaves the screen without joining the call. */
"monarch.preJoinLobby.cancel" = "Cancel";

/* The button that joins the call. */
"monarch.preJoinLobby.join" = "Join now";

/* The join button while the call is being joined. */
"monarch.preJoinLobby.joining" = "Joining…";
