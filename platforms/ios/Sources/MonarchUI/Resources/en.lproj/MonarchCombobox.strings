/* The placeholder of the search field at the top of the combobox list. */
"monarch.combobox.search" = "Search";

/* Shown in the combobox list while options load and there are none yet. */
"monarch.combobox.loading" = "Loading…";

/* Shown in the combobox list when no option matches the search. */
"monarch.combobox.empty" = "No matches";

/* The option that creates a new value from the typed text. %@ is the typed text. */
"monarch.combobox.create" = "Create “%@”";

/* Shown under a combobox list that is cut short. %1$lld is the number shown, %2$lld the number of matches. */
"monarch.combobox.more" = "Showing %1$lld of %2$lld. Type to narrow the list.";

/* The button that closes the combobox list without choosing. */
"monarch.combobox.cancel" = "Cancel";

/* The spoken name of the button that clears the combobox selection. */
"monarch.combobox.clear" = "Clear";

/* Read by VoiceOver as the value of a combobox while nothing is chosen. */
"monarch.combobox.noSelection" = "None";

/* Shown in the list when the options could not be loaded and the app gave no reason. */
"monarch.combobox.loadFailed" = "Couldn’t load the options.";
