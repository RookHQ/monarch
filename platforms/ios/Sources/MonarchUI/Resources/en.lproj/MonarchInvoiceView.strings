/* The title of an invoice when the app gives none. */
"monarch.invoiceView.title" = "Invoice";
/* The heading over the party that issues the invoice. */
"monarch.invoiceView.from" = "From";
/* The heading over the party the invoice is addressed to. */
"monarch.invoiceView.to" = "Bill to";
/* The label of the date the invoice was issued. */
"monarch.invoiceView.issueDate" = "Issue date";
/* The label of the date payment is due. */
"monarch.invoiceView.dueDate" = "Due date";
/* The heading over the billed lines. */
"monarch.invoiceView.lineItems" = "Line items";
/* The column of what was billed. */
"monarch.invoiceView.description" = "Description";
/* The column of quantities, abbreviated. */
"monarch.invoiceView.quantity" = "Qty";
/* The column of the price of one unit. */
"monarch.invoiceView.unitPrice" = "Unit price";
/* The column of line amounts. */
"monarch.invoiceView.amount" = "Amount";
/* The total row of the sum of the lines. */
"monarch.invoiceView.subtotal" = "Subtotal";
/* The total row of the discount. */
"monarch.invoiceView.discount" = "Discount";
/* The total row of the tax, when no rate is known. */
"monarch.invoiceView.tax" = "Tax";
/* The total row of the tax. %@ is the formatted rate, such as 18%. */
"monarch.invoiceView.taxWithRate" = "Tax (%@)";
/* The total row of the invoice total. */
"monarch.invoiceView.total" = "Total";
/* The total row of payments already received. */
"monarch.invoiceView.amountPaid" = "Amount paid";
/* The total row of what is still owed. */
"monarch.invoiceView.amountDue" = "Amount due";
/* Shown when an invoice has no lines. */
"monarch.invoiceView.noItems" = "No line items.";
/* The heading over the invoice's notes. */
"monarch.invoiceView.notes" = "Notes";
/* The title of the button that prints the invoice. */
"monarch.invoiceView.print" = "Print";
