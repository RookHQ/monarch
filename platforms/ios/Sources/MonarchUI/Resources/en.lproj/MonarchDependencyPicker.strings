/* Relation: the linked item must finish before this one. Heading and menu item. */
"monarch.dependencyPicker.relation.blockedBy" = "Blocked by";

/* Relation: this item must finish before the linked one. Heading and menu item. */
"monarch.dependencyPicker.relation.blocks" = "Blocks";

/* Relation: linked without an order. Heading and menu item. */
"monarch.dependencyPicker.relation.relates" = "Related to";

/* Relation: this item is the same work as the linked one. Heading and menu item. */
"monarch.dependencyPicker.relation.duplicates" = "Duplicates";

/* Relation: the linked item is the same work as this one. Heading and menu item. */
"monarch.dependencyPicker.relation.duplicatedBy" = "Duplicated by";

/* The label of the menu that chooses the relation of a new link. */
"monarch.dependencyPicker.relationLabel" = "Relation";

/* The label of the field that searches for an item to link. */
"monarch.dependencyPicker.searchLabel" = "Find an item to link";

/* The placeholder of the search field. */
"monarch.dependencyPicker.searchPrompt" = "Search by key or title";

/* Shown when the search finds no item. */
"monarch.dependencyPicker.noResults" = "No matching items.";

/* Shown when the item has no links. */
"monarch.dependencyPicker.empty" = "No linked items.";

/* The spoken name of the button that removes a link. %1$@ is the relation, %2$@ the linked item. */
"monarch.dependencyPicker.remove" = "Remove “%1$@” link to %2$@";

/* Announced after a link is added. %1$@ is the relation, %2$@ the linked item. */
"monarch.dependencyPicker.added" = "%1$@ %2$@ added.";

/* Announced after a link is removed. %1$@ is the relation, %2$@ the linked item. */
"monarch.dependencyPicker.removed" = "%1$@ %2$@ removed.";

/* The spoken status of a linked item. %@ is the status name. */
"monarch.dependencyPicker.status" = "Status: %@";
