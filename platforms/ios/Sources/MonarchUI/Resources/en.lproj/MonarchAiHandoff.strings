/* Spoken first, naming the marker where work moves to another agent or a person. */
"monarch.aiHandoff.label" = "Handoff";

/* Read after an agent's name, so an agent is never taken for a person. */
"monarch.aiHandoff.agentKind" = "AI agent";

/* Read before the reason of the handoff. */
"monarch.aiHandoff.reason" = "Reason:";

/* The handoff sentence. %1$@ is the agent that hands off, %2$@ the agent or person that takes over. */
"monarch.aiHandoff.handedOff" = "%1$@ handed off to %2$@";

/* An agent's spoken name. %1$@ is the name, %2$@ the kind ("AI agent"). */
"monarch.aiHandoff.agentName" = "%1$@ (%2$@)";
