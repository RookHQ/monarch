/* Spoken name of the list of steps of one approval. */
"monarch.approvalTimeline.label" = "Approval timeline";
/* Status of an approval step: the request was sent. */
"monarch.approvalTimeline.status.submitted" = "Submitted";
/* Status of an approval step: someone approved. */
"monarch.approvalTimeline.status.approved" = "Approved";
/* Status of an approval step: someone rejected it. */
"monarch.approvalTimeline.status.rejected" = "Rejected";
/* Status of an approval step that is waiting for a decision now. */
"monarch.approvalTimeline.status.pending" = "Waiting for a decision";
/* Status of a later approval step that has not started. */
"monarch.approvalTimeline.status.waiting" = "Up next";
/* Status of an approval step that was passed over. */
"monarch.approvalTimeline.status.skipped" = "Skipped";
/* Status of an approval step that was withdrawn before a decision. */
"monarch.approvalTimeline.status.cancelled" = "Cancelled";
/* The people who can decide a step that is not decided yet. %@ is a list of names. */
"monarch.approvalTimeline.approvers" = "Decided by %@";
/* After an approver who stands in for someone else. %@ is the other person's name. */
"monarch.approvalTimeline.delegatedFrom" = "standing in for %@";
/* Spoken on the approval step that is waiting for a decision now. */
"monarch.approvalTimeline.current" = "Current step";
/* Shown when an approval has no steps because it was not submitted. */
"monarch.approvalTimeline.empty" = "Not submitted yet";
