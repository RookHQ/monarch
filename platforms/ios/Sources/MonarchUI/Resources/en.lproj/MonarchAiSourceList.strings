/* Heading of the list of sources under an AI answer. */
"monarch.aiSourceList.heading" = "Sources";

/* Heading of the group of sources the answer relies on. %d is how many. */
"monarch.aiSourceList.used" = "Used (%d)";

/* Heading of the group of sources the assistant looked at but did not use. %d is how many. */
"monarch.aiSourceList.considered" = "Considered (%d)";

/* Button that expands a collapsed list of sources. %d is the number of sources. */
"monarch.aiSourceList.showAll" = "Show all %d sources";

/* Button that collapses the list of sources again. */
"monarch.aiSourceList.showFewer" = "Show fewer";

/* What VoiceOver reads for a numbered source. %1$d is its number, %2$@ its title. */
"monarch.aiSourceList.source" = "Source %1$d: %2$@";

/* Hint of a source that opens its address. */
"monarch.aiSourceList.opensSource" = "Opens the source.";

/* Name of a source that is a web page. */
"monarch.aiSourceList.kind.web" = "Web page";

/* Name of a source that is a document. */
"monarch.aiSourceList.kind.doc" = "Document";

/* Name of a source that is a record in a product. */
"monarch.aiSourceList.kind.record" = "Record";

/* Name of a source that is a file. */
"monarch.aiSourceList.kind.file" = "File";
