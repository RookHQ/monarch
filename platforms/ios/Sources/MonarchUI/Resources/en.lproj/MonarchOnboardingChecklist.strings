/* The progress of a setup checklist. The first number is the steps done, the second all steps. */
"monarch.onboardingChecklist.progress" = "%1$ld of %2$ld done";

/* The spoken name of the progress bar of a setup checklist. */
"monarch.onboardingChecklist.progressLabel" = "Setup progress";

/* The spoken name of the button that hides a setup checklist for good. */
"monarch.onboardingChecklist.dismiss" = "Dismiss checklist";

/* The spoken state of a checklist step that is complete. */
"monarch.onboardingChecklist.done" = "Done";

/* The spoken state of a checklist step that is not complete. */
"monarch.onboardingChecklist.notDone" = "Not done";

/* Spoken after the state of the first checklist step that is not complete. */
"monarch.onboardingChecklist.current" = "Current step";

/* Shown when every step of a setup checklist is complete. */
"monarch.onboardingChecklist.complete" = "All done. You are set up.";
