/* Name of a score produced by an AI model when the app gives none. */
"monarch.aiScore.label" = "Score";

/* Mark beside the score saying an AI model produced it. */
"monarch.aiScore.aiGenerated" = "AI score";

/* Spoken value of the score. %1$@ is the score, %2$@ the maximum. */
"monarch.aiScore.valueText" = "%1$@ out of %2$@";

/* Shown and spoken while there is no score. */
"monarch.aiScore.unavailable" = "No score yet";

/* Heading of the list of inputs that moved the score. */
"monarch.aiScore.factors" = "What affects this score";
"monarch.aiScore.factorColumn" = "Factor";
"monarch.aiScore.impactColumn" = "Impact";

/* Spoken effect of an input that raised the score. %@ is the number of points. */
"monarch.aiScore.raised" = "Raised the score by %@";

/* Spoken effect of an input that lowered the score. %@ is the number of points. */
"monarch.aiScore.lowered" = "Lowered the score by %@";

/* Spoken effect of an input that did not change the score. */
"monarch.aiScore.noImpact" = "No effect on the score";

/* Summary of the disclosure that lists the score's bands. */
"monarch.aiScore.bands" = "How to read this score";

/* Marks the band the current score is in, in the list of bands. */
"monarch.aiScore.currentBand" = "this score";

/* Name of the lowest built-in band of a score. */
"monarch.aiScore.band.low" = "Low";

/* Name of the middle built-in band of a score. */
"monarch.aiScore.band.medium" = "Medium";

/* Name of the highest built-in band of a score. */
"monarch.aiScore.band.high" = "High";
