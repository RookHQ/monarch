/* The title of the button that loads the next page of a list. */
"monarch.loadMore.loadMore" = "Load more";

/* The title of the load-more button while the next page loads. */
"monarch.loadMore.loading" = "Loading…";

/* Shown and announced when the next page of a list failed to load. */
"monarch.loadMore.failed" = "Couldn’t load more.";

/* The title of the button that tries the failed page again. */
"monarch.loadMore.retry" = "Retry";

/* Shown and announced at the end of a list when every item is loaded. */
"monarch.loadMore.end" = "That’s everything";

/* The counts and the "loaded" announcement are plurals, in Localizable.stringsdict. */
