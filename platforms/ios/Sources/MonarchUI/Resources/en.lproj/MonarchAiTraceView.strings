/* Heading and spoken name of the technical trace of one AI agent run. */
"monarch.aiTraceView.label" = "Run trace";

/* Spoken name of the filter of the trace. */
"monarch.aiTraceView.filterLabel" = "Show";

/* Filter: every span. */
"monarch.aiTraceView.filter.all" = "All";

/* Filter: only failed spans and the spans they ran inside. */
"monarch.aiTraceView.filter.errors" = "Errors only";

/* Filter: every span, the slowest first. */
"monarch.aiTraceView.filter.slowest" = "Slowest first";

/* Kind of a span: a call to a model. */
"monarch.aiTraceView.kind.model" = "Model";

/* Kind of a span: a call to a tool. */
"monarch.aiTraceView.kind.tool" = "Tool";

/* Kind of a span: a search of a knowledge source. */
"monarch.aiTraceView.kind.retrieval" = "Retrieval";

/* Kind of a span: a sub-agent. */
"monarch.aiTraceView.kind.agent" = "Agent";

/* Kind of a span: a guardrail check. */
"monarch.aiTraceView.kind.guardrail" = "Guardrail";

/* Kind of a span: anything else. */
"monarch.aiTraceView.kind.other" = "Other";

/* Status of a span: it finished. */
"monarch.aiTraceView.status.ok" = "OK";

/* Status of a span: it failed. */
"monarch.aiTraceView.status.error" = "Error";

/* Status of a span: it was stopped. */
"monarch.aiTraceView.status.cancelled" = "Cancelled";

/* Status of a span: it has not ended. */
"monarch.aiTraceView.status.running" = "Running";

/* Name of the wall-clock time of the run. */
"monarch.aiTraceView.totalDuration" = "Total time";

/* Name of the total input and output tokens. */
"monarch.aiTraceView.totalTokens" = "Tokens";

/* Name of the total cost. */
"monarch.aiTraceView.totalCost" = "Cost";

/* Name of the number of failed spans. */
"monarch.aiTraceView.errors" = "Errors";

/* Shown for a value that is not known. */
"monarch.aiTraceView.notAvailable" = "–";

/* Shown when the run has no spans. */
"monarch.aiTraceView.empty" = "No spans recorded";

/* Shown when the errors filter finds nothing. */
"monarch.aiTraceView.noErrors" = "No errors in this run";

/* Button that closes the details of a span. */
"monarch.aiTraceView.closeDetails" = "Close";

/* Button in the details that shows the part of the conversation the span produced. */
"monarch.aiTraceView.openPart" = "Show in conversation";

/* Name of when a span started, in the details. */
"monarch.aiTraceView.start" = "Start";

/* Name of when a span ended, in the details. */
"monarch.aiTraceView.end" = "End";

/* Name of how long a span took, in the details. */
"monarch.aiTraceView.duration" = "Duration";

/* Name of the input tokens, in the details. */
"monarch.aiTraceView.inputTokens" = "Input tokens";

/* Name of the output tokens, in the details. */
"monarch.aiTraceView.outputTokens" = "Output tokens";

/* Name of the model, in the details. */
"monarch.aiTraceView.model" = "Model";

/* Name of the status, in the details. */
"monarch.aiTraceView.statusName" = "Status";

/* Name of the kind, in the details. */
"monarch.aiTraceView.kindName" = "Kind";

/* Heading of the error text, in the details. */
"monarch.aiTraceView.error" = "Error";

/* Heading of the extra facts, in the details. */
"monarch.aiTraceView.attributes" = "Attributes";

/* Heading of what went into the span, in the details. */
"monarch.aiTraceView.input" = "Input";

/* Heading of what came out of the span, in the details. */
"monarch.aiTraceView.output" = "Output";

/* A time after the start of the run. %@ is a duration, such as "1.2 s". */
"monarch.aiTraceView.offset" = "+%@";

/* Read for a finished span's bar. %1$@ is the start offset, %2$@ the duration. */
"monarch.aiTraceView.timing" = "Starts at %1$@, takes %2$@";

/* Read for the bar of a span that is still running. %@ is the start offset. */
"monarch.aiTraceView.timingRunning" = "Starts at %@, still running";

/* Spoken name of the button that shows the spans inside a span. %@ is its name. */
"monarch.aiTraceView.expand" = "Show spans inside %@";

/* Spoken name of the button that hides the spans inside a span. %@ is its name. */
"monarch.aiTraceView.collapse" = "Hide spans inside %@";

/* The Span column heading of the trace table. */
"monarch.aiTraceView.column.span" = "Span";

/* The Timeline column heading of the trace table. */
"monarch.aiTraceView.column.timeline" = "Timeline";
