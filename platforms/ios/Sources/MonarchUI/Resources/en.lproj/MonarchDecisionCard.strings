/* The spoken name of the group of choices in a decision card. */
"monarch.decisionCard.choices" = "Decision";

/* The label of the choice that clears the decision. */
"monarch.decisionCard.none" = "No decision";

/* The label of the reason field when a reason is required. */
"monarch.decisionCard.reason" = "Reason";

/* The label of the reason field when a reason is optional. */
"monarch.decisionCard.reasonOptional" = "Reason (optional)";

/* The placeholder of the reason field. */
"monarch.decisionCard.reasonPrompt" = "Why? Others will see this.";

/* Shown under the reason field when a required reason is missing. */
"monarch.decisionCard.reasonRequired" = "Add a reason for this decision.";

/* Shown under the reason field when one more character fits. */
"monarch.decisionCard.charactersLeft.one" = "1 character left";

/* Shown under the reason field near the limit. %lld is the number of characters that still fit. */
"monarch.decisionCard.charactersLeft.other" = "%lld characters left";

/* The title of the button that saves the decision. */
"monarch.decisionCard.save" = "Save decision";

/* Announced after the decision is saved. */
"monarch.decisionCard.saved" = "Decision saved.";

/* When the decision was made. %@ is a relative time such as "3 hours ago". */
"monarch.decisionCard.decidedAt" = "Decided %@";

/* Who made the decision. %@ is the name of the person. */
"monarch.decisionCard.decidedBy" = "Decided by %@";

/* When and by whom the decision was made. %1$@ is a relative time, %2$@ the name of the person. */
"monarch.decisionCard.decidedAtBy" = "Decided %1$@ by %2$@";

/* Shown in the read-only view when nothing has been decided. */
"monarch.decisionCard.undecided" = "No decision yet";

/* Shown when saving the decision fails without a message. */
"monarch.decisionCard.failed" = "That did not work. Try again.";
