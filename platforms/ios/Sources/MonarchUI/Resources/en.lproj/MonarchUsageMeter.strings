/* The figures of a metered item. %1$@ is the amount used, %2$@ is the limit. */
"monarch.usageMeter.amount" = "%1$@ of %2$@";
/* The share of a limit that is used. %@ is a percentage such as 82%. */
"monarch.usageMeter.percent" = "%@ used";
/* Shown and spoken when a metered item is close to its limit. */
"monarch.usageMeter.nearLimit" = "Near the limit";
/* Shown and spoken when a metered item is above its limit. */
"monarch.usageMeter.overLimit" = "Over the limit";
/* When the quota resets. %@ is a date. */
"monarch.usageMeter.resets" = "Resets %@";
/* Announced by VoiceOver when a metered item reaches a level. %1$@ is the item, %2$@ is the level. */
"monarch.usageMeter.announcement" = "%1$@: %2$@";
/* Shown beside the spinner while usage is loading. */
"monarch.usageMeter.loading" = "Loading usage";
/* The title of the button that loads usage again after an error. */
"monarch.usageMeter.retry" = "Try again";
