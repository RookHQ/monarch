/* The heading of the panel of filters next to or above search results. */
"monarch.facetedFilterPanel.title" = "Filters";

/* The button that removes every filter of the panel. */
"monarch.facetedFilterPanel.clearAll" = "Clear all";

/* The visible text of the button that removes the filters of one group. */
"monarch.facetedFilterPanel.clearGroup" = "Clear";

/* The spoken name of the button that removes the filters of one group. %@ is the group's name, such as Status. */
"monarch.facetedFilterPanel.clearGroupLabel" = "Clear %@ filter";

/* How many filters of a group are active, shown under its heading. %ld is the number. */
"monarch.facetedFilterPanel.activeCount" = "%ld selected";

/* The button that shows the options hidden after the first few. %ld is how many are hidden. */
"monarch.facetedFilterPanel.showMore" = "Show %ld more";

/* The button that hides the extra options again. */
"monarch.facetedFilterPanel.showFewer" = "Show fewer";

/* Shown in a group of checkboxes that has no options. */
"monarch.facetedFilterPanel.noOptions" = "No options";
