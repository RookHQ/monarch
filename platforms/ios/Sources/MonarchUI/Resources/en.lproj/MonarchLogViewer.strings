/* Spoken name of the scrolling list of log lines. */
"monarch.logViewer.log" = "Log";
/* Spoken name of the group of level filter buttons in a log viewer. */
"monarch.logViewer.levels" = "Levels";
/* Short name of the debug level, shown on log lines and on its filter button. */
"monarch.logViewer.level.debug" = "Debug";
/* Short name of the info level, shown on log lines and on its filter button. */
"monarch.logViewer.level.info" = "Info";
/* Short name of the warning level, shown on log lines and on its filter button. */
"monarch.logViewer.level.warn" = "Warn";
/* Short name of the error level, shown on log lines and on its filter button. */
"monarch.logViewer.level.error" = "Error";
/* Spoken name of the search field of a log viewer. */
"monarch.logViewer.search" = "Search log";
/* Placeholder of the search field of a log viewer. */
"monarch.logViewer.searchPrompt" = "Search";
/* Spoken name of the button that empties the search field. */
"monarch.logViewer.clearSearch" = "Clear search";
/* Toggle that keeps the newest log line in view. */
"monarch.logViewer.follow" = "Follow";
/* Toggle that wraps long log lines instead of scrolling sideways. */
"monarch.logViewer.wrap" = "Wrap lines";
/* Line count when nothing is hidden and there is one line. %@ is the formatted number. */
"monarch.logViewer.count.one" = "%@ line";
/* Line count when nothing is hidden. %@ is the formatted number. */
"monarch.logViewer.count.other" = "%@ lines";
/* Line count when filters hide some lines. The first %@ is the number shown, the second the total. */
"monarch.logViewer.count.filtered" = "%1$@ of %2$@ lines";
/* Button that scrolls to the newest line and starts following again. */
"monarch.logViewer.jumpToLatest" = "Jump to latest";
/* Jump button when one line arrived while following was paused. %@ is the formatted number 1. */
"monarch.logViewer.newLines.one" = "%@ new line";
/* Jump button when lines arrived while following was paused. %@ is the formatted number. */
"monarch.logViewer.newLines.other" = "%@ new lines";
/* Announced when the log stops keeping the newest line in view. */
"monarch.logViewer.followPaused" = "Following paused";
/* Announced when the log starts keeping the newest line in view again. */
"monarch.logViewer.followResumed" = "Following new lines";
/* Shown when a log has no lines yet. */
"monarch.logViewer.empty" = "No log lines yet";
/* Shown when the level filters and the search hide every line. */
"monarch.logViewer.noMatches" = "No lines match the filters";
/* Shown and spoken while the first log lines load. */
"monarch.logViewer.loading" = "Loading log";
