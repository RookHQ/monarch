/* Shown while edits have not been saved yet. */
"monarch.saveStatusIndicator.unsaved" = "Unsaved changes";

/* Shown while a save is in flight. */
"monarch.saveStatusIndicator.saving" = "Saving…";

/* Shown and announced when a save finished. */
"monarch.saveStatusIndicator.saved" = "Saved";

/* Shown and announced when a save failed and the app gave no reason. */
"monarch.saveStatusIndicator.error" = "Couldn’t save";

/* The title of the button that tries a failed save again. */
"monarch.saveStatusIndicator.retry" = "Retry";
