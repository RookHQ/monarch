/* The spoken name of a gauge that has no label. */
"monarch.gauge.name" = "Gauge";
/* Spoken by VoiceOver for a gauge that has no value. */
"monarch.gauge.noValue" = "No data";
/* The spoken target of a gauge. %@ is the target value. */
"monarch.gauge.target" = "Target %@";
/* The spoken value of a gauge with bands. %1$@ is the value, %2$@ is the name of its band. */
"monarch.gauge.valueInBand" = "%1$@, %2$@";
/* The spoken value of a gauge without bands. %1$@ is the value, %2$@ and %3$@ are the ends of the scale. */
"monarch.gauge.valueInRange" = "%1$@ (from %2$@ to %3$@)";
