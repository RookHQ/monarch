/* The error of a required question without an answer. */
"monarch.fieldRenderer.required" = "This field is required.";

/* The error of a required consent that is not ticked. */
"monarch.fieldRenderer.mustAgree" = "Tick this to continue.";

/* The error of text that is not an email address. */
"monarch.fieldRenderer.email" = "Enter an email address, like name@example.com.";

/* The error of text that is not a web address. */
"monarch.fieldRenderer.url" = "Enter a web address, like https://example.com.";

/* The error of an answer that is not a number. */
"monarch.fieldRenderer.number" = "Enter a number.";

/* The error of a number below the minimum. %@ is the minimum, formatted. */
"monarch.fieldRenderer.min" = "Enter %@ or more.";

/* The error of a number above the maximum. %@ is the maximum, formatted. */
"monarch.fieldRenderer.max" = "Enter %@ or less.";

/* The error of text shorter than the minimum. %ld is the fewest characters. */
"monarch.fieldRenderer.minLength" = "Use at least %ld characters.";

/* The error of text longer than the maximum. %ld is the most characters. */
