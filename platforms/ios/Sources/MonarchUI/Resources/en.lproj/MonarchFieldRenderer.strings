/* The error of fewer options than the minimum. %ld is the fewest options. */
"monarch.fieldRenderer.minSelections" = "Choose at least %ld.";

/* The error of more options than the maximum. %ld is the most options. */
"monarch.fieldRenderer.maxSelections" = "Choose %ld or fewer.";

/* The yes choice of a yes-or-no question. */
"monarch.fieldRenderer.yes" = "Yes";

/* The no choice of a yes-or-no question. */
"monarch.fieldRenderer.no" = "No";

/* The empty choice of a menu, and the prompt of a multi-select question. */
"monarch.fieldRenderer.choose" = "Choose…";

/* The button of a date question without an answer. */
"monarch.fieldRenderer.chooseDate" = "Choose a date";

/* The button of a time question without an answer. */
"monarch.fieldRenderer.chooseTime" = "Choose a time";

/* The button that clears an optional date or time answer. */
"monarch.fieldRenderer.clear" = "Clear";

/* The note on an answer filled in automatically with enough confidence. */
"monarch.fieldRenderer.aiFilled" = "Filled in automatically. Check it is right.";

/* The note on an answer filled in automatically with low confidence. */
"monarch.fieldRenderer.aiCheck" = "Filled in automatically, but unsure. Please check.";

/* The visible title of a chosen file's remove button. */
"monarch.fieldRenderer.remove" = "Remove";

/* The spoken name of a chosen file's remove button. %@ is the file name. */
"monarch.fieldRenderer.removeFile" = "Remove %@";
