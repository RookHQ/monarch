/* The spoken name of the scrolling list of an AI conversation. */
"monarch.aiThread.label" = "Conversation";

/* The button that scrolls an AI conversation to the newest message. */
"monarch.aiThread.jumpToLatest" = "Jump to latest";

/* The jump button when one message arrived while the person was scrolled up. %lld is 1. */
"monarch.aiThread.newMessages.one" = "%lld new message";

/* The jump button when messages arrived while the person was scrolled up. %lld is the count. */
"monarch.aiThread.newMessages.other" = "%lld new messages";

/* The button at the top of an AI conversation that loads older messages. */
"monarch.aiThread.loadEarlier" = "Load earlier messages";

/* The load button while older messages of an AI conversation load. */
"monarch.aiThread.loadingEarlier" = "Loading earlier messages…";

/* Shown and announced while the assistant works on a reply before its first words. */
"monarch.aiThread.thinking" = "Thinking…";

/* Announced when the assistant's reply has finished. */
"monarch.aiThread.responseComplete" = "Response complete";

/* Announced when the person stopped the assistant's reply. */
"monarch.aiThread.responseStopped" = "Response stopped";

/* Announced for a conversation error that no message shows. %@ is the error message. */
"monarch.aiThread.error" = "Error: %@";

/* Spoken in place of the contents of a code block in a reply. */
"monarch.aiThread.codeBlock" = "Code block";

/* Spoken in place of the contents of a table in a reply. */
"monarch.aiThread.table" = "Table";

/* The day label above the messages sent today. */
"monarch.aiThread.today" = "Today";

/* The day label above the messages sent yesterday. */
"monarch.aiThread.yesterday" = "Yesterday";

/* Notice under the conversation while the device is offline and nothing waits to be sent. */
"monarch.aiThread.offline" = "You are offline. Messages you send will wait until you are back online.";

/* Notice while offline with one message waiting. %lld is 1. */
"monarch.aiThread.offlineQueued.one" = "You are offline. %lld message will send when you are back online.";

/* Notice while offline with messages waiting. %lld is the count. */
"monarch.aiThread.offlineQueued.other" = "You are offline. %lld messages will send when you are back online.";

/* Notice when the connection is back and one queued message is being sent. %lld is 1. */
"monarch.aiThread.sendingQueued.one" = "Back online. Sending %lld queued message…";

/* Notice when the connection is back and queued messages are being sent. %lld is the count. */
"monarch.aiThread.sendingQueued.other" = "Back online. Sending %lld queued messages…";

/* Notice while a running reply has sent nothing for a while. */
"monarch.aiThread.slow" = "This is taking longer than usual. Still working…";

/* The VoiceOver action that stops the assistant's running reply. */
"monarch.aiThread.stop" = "Stop response";
