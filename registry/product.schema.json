{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monarch.rookhq.com/schema/product.json",
  "title": "Monarch product registration",
  "description": "Declared facts about a Rook product. Measured facts (adoption, conformance, verification time) are generated into registry/status by `monarch registry verify` and are never hand-edited. Projects that run the CLI keep their own registry; this repository publishes only the declared brand data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "domain", "theme", "source"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Stable product ID. Used as data-mn-product and as the product CSS file name. Never reuse a retired ID."
    },
    "name": { "type": "string", "minLength": 2 },
    "kind": { "enum": ["application", "marketing", "public-surface"] },
    "repository": {
      "type": "string",
      "description": "Optional: the source repository, as owner/name.",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "schemes"],
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d+)? \\d{1,3}(\\.\\d+)?% \\d{1,3}(\\.\\d+)?%$",
          "description": "Brand accent as HSL channels. Monarch derives accessible variants from it."
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Directories the conformance engine scans, relative to the repository root."
        }
      }
    },
    "exceptions": {
      "type": "array",
      "description": "Approved deviations. Each needs an owner, a reason and an expiry; expired exceptions fail conformance.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "paths", "owner", "reason", "expires"],
        "properties": {
          "rule": { "type": "string" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "owner": { "type": "string" },
          "reason": { "type": "string", "minLength": 10 },
          "expires": { "type": "string", "format": "date" },
          "approvedBy": { "type": "string" }
        }
      }
    }
  }
}
