{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monarch.rookhq.com/schema/components.json",
  "title": "Monarch component registry",
  "description": "One entry per in-scope component (3+ products, or 2+ at P0), per component named in the roadmap waves, and per exported Monarch component family. Generated by scripts/registry/build-components.mjs; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$description",
    "monarchReactVersion",
    "sources",
    "summary",
    "components"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "$description": { "type": "string" },
    "monarchReactVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand", "manifest", "waves", "deprecations", "docs"],
      "properties": {
        "demand": { "type": "string" },
        "manifest": { "type": "string" },
        "waves": { "type": "string" },
        "deprecations": { "type": "string" },
        "docs": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "demandComponents",
        "byScope",
        "inScopeByGap",
        "inScopeByWave",
        "byStatus"
      ],
      "properties": {
        "entries": { "type": "integer" },
        "demandComponents": { "type": "integer" },
        "byScope": { "type": "object" },
        "inScopeByGap": { "type": "object" },
        "inScopeByWave": { "type": "object" },
        "byStatus": { "type": "object" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "layer",
          "package",
          "entry",
          "exports",
          "status",
          "scope",
          "sourceProducts",
          "productCount",
          "priority",
          "wave",
          "gap",
          "missingCapabilities",
          "buildsOn",
          "docs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Kebab-case Monarch id; equals the demand-data id when one exists."
          },
          "name": { "type": "string", "minLength": 2 },
          "category": {
            "enum": [
              "01-layout",
              "02-typography",
              "03-actions",
              "04-forms",
              "05-navigation",
              "06-data-display",
              "07-data-grid",
              "08-feedback",
              "09-overlays",
              "10-scheduling",
              "11-charts",
              "12-files",
              "13-search",
              "14-identity",
              "15-collaboration",
              "16-workflow",
              "17-intelligence",
              "18-crm",
              "19-technical",
              "20-billing",
              "21-geo",
              "22-interaction"
            ]
          },
          "layer": {
            "enum": ["primitive", "component", "pattern", "template", "product-extension"]
          },
          "package": {
            "enum": ["@rookcom/monarch-tokens", "@rookcom/monarch-react", "@rookcom/monarch-editor"]
          },
          "entry": {
            "enum": [
              ".",
              "./data",
              "./charts",
              "./scheduling",
              "./collaboration",
              "./patterns",
              "./marketing",
              "./editor",
              "./shell"
            ],
            "description": "Subpath export within the package (docs/architecture/PACKAGE-ARCHITECTURE.md)."
          },
          "exports": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "description": "Names exported today (packages/react/dist/manifest.json). Empty when planned."
          },
          "status": { "enum": ["stable", "beta", "planned", "deprecated"] },
          "scope": {
            "enum": ["in-scope", "roadmap", "shipped"],
            "description": "in-scope: meets the 3+/2+P0 rule. roadmap: below the rule but named in a wave. shipped: exported today, below the rule."
          },
          "sourceProducts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
          },
          "productCount": { "type": "integer" },
          "priority": { "enum": ["P0", "P1", "P2", "P3", "none"] },
          "wave": {
            "type": "integer",
            "description": "Roadmap wave 1-9; 0 means no work is scheduled."
          },
          "gap": {
            "enum": [
              "implemented-complete",
              "implemented-incomplete",
              "missing",
              "product-extension",
              "not-assessed"
            ],
            "description": "not-assessed: exported today but no demand data was recorded for it."
          },
          "missingCapabilities": { "type": "array", "items": { "type": "string" } },
          "buildsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "description": "Existing Monarch exports that products cited as the nearest equivalent."
          },
          "source": {
            "type": "string",
            "pattern": "^(packages/react/src/(components|patterns)/[a-z0-9-]+/[a-z0-9-]+|packages/tokens/src/[a-z0-9-]+\\.ts)$",
            "description": "Component folder that implements the exports (docs/architecture/SOURCE-LAYOUT.md), or for a tokens-package entry the module. Absent while planned."
          },
          "docs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "status"],
            "properties": {
              "route": {
                "type": "string",
                "pattern": "^/(components/[a-z0-9-]+|theming)$",
                "description": "Docs-site route: the component page, or the theming guide for tokens-package entries."
              },
              "status": {
                "enum": ["complete", "legacy-incomplete", "missing", "planned"],
                "description": "complete: all 16 sections (docs/architecture/SOURCE-LAYOUT.md#docs-file-contract); legacy-incomplete: a pre-0.4 component with sections still marked incomplete; missing: exported but no docs file; planned: not built."
              }
            }
          }
        }
      }
    }
  }
}
