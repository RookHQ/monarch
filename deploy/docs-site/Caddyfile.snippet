# Monarch docs site: static files served straight from disk. No upstream, no Node process.
# Applied by deploy/docs-site/server-setup.sh (backup, validate, restore on failure).
#
# The script-src hashes below must match the inline scripts in the built pages;
# `npm run docs:csp` checks that in CI and blocks a deploy that would break the site.
monarchui.dev {
	import rook_security_headers
	tls internal
	root * /opt/rook/static/monarchui
	encode zstd gzip

	header {
		Cache-Control "public, max-age=0, must-revalidate"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-YmBFy6fCAkcT3f61J8F5cdJlexU6nKhCYk1qi4KQqbw=' 'sha256-7mu4H06fwDCjmnxxr/xNHyuQC6pLTHr4M2E4jXw5WZs=' 'sha256-J/qDW99W6jEnr/+137mxPf84FrK3BwhhJ/pEhv6yOnw=' 'sha256-Ou10F5Qe+dMWKeWRNV8baJ+E8nADIUekzF/cipA1Tco=' 'sha256-QAlSewaQLi/NPCznjAZSyvQ72heD0VdxmNDDkZeCxgc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	# Content-hashed build assets never change.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@icons path /icon.svg /icon-*.png /apple-touch-icon.png /site.webmanifest
	header @icons Cache-Control "public, max-age=86400"

	handle_errors {
		rewrite * /404.html
		file_server
	}
	file_server
}

# One address for the site: everything else sends people (and search engines) there.
www.monarchui.dev, monarch.rookhq.com {
	import rook_security_headers
	tls internal
	redir https://monarchui.dev{uri} permanent
}
