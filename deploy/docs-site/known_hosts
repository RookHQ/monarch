# Placeholder. The real host key is NOT kept in this repository.
#
# The deploy workflow must read the pinned host key from the GitHub environment secret
# DEPLOY_KNOWN_HOSTS (environment "production"), not from this file.
#
# To produce the value, run this from a machine you trust and compare the fingerprint with the
# one the server prints (ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub on the server):
#
#   ssh-keyscan -t ed25519 <DEPLOY_HOST> > known_hosts.tmp
#   ssh-keygen -l -f known_hosts.tmp
#   gh secret set DEPLOY_KNOWN_HOSTS --env production < known_hosts.tmp
#   rm known_hosts.tmp
#
# The value is one line: <DEPLOY_HOST> ssh-ed25519 <HOST_PUBLIC_KEY>
