{
  "name": "@rookcom/monarch-tokens",
  "version": "0.5.0",
  "description": "Monarch design tokens: CSS variables, light, dark and high-contrast themes, accessible brand palettes from one colour, and a Tailwind preset. Framework-independent.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RookHQ/monarch.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "default": "./dist/tailwind.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "default": "./dist/appearance.js"
    },
    "./css": "./dist/css/monarch.css",
    "./css/base": "./dist/css/base.css",
    "./css/compat": "./dist/css/compat.css",
    "./css/products/*": "./dist/css/products/*.css",
    "./tokens.json": "./dist/tokens.json",
    "./contrast-report.json": "./dist/contrast-report.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "generate": "tsx scripts/generate.ts",
    "build": "rm -rf dist && tsx scripts/generate.ts && tsc -p tsconfig.build.json && tsx scripts/emit.ts",
    "typecheck": "tsx scripts/generate.ts && tsc -p tsconfig.json --noEmit"
  },
  "homepage": "https://github.com/RookHQ/monarch/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/RookHQ/monarch/issues"
  },
  "keywords": [
    "monarch",
    "design-system",
    "design-tokens",
    "css-variables",
    "theming",
    "dark-mode",
    "accessibility",
    "color-contrast",
    "tailwind-preset"
  ],
  "author": "Rook Platforms (https://rookhq.com)"
}
