{
  "package": "@rookcom/monarch-react",
  "version": "0.14.9",
  "styles": "@rookcom/monarch-react/styles.css",
  "tokens": "@rookcom/monarch-tokens/css",
  "components": [
    {
      "name": "Select",
      "entry": ".",
      "kind": "component",
      "scope": "general",
      "description": "Single-value select built on Radix Select. Typeahead included.",
      "usesClient": true,
      "clientOnly": true,
      "import": "import { Select } from '@rookcom/monarch-react';",
      "css": ["@rookcom/monarch-tokens/css", "@rookcom/monarch-react/styles/core.css"],
      "componentCss": "@rookcom/monarch-react/styles/components/select.css",
      "docs": "https://monarchui.dev/components/select/",
      "props": [
        { "name": "children", "type": "React.ReactNode", "required": false, "description": "" },
        {
          "name": "onValueChange",
          "type": "(value: string) => void",
          "required": false,
          "description": ""
        },
        { "name": "value", "type": "string", "required": false, "description": "" }
      ]
    },
    {
      "name": "SelectItem",
      "entry": ".",
      "kind": "component",
      "scope": "general",
      "description": "",
      "className": "mn-menu__item",
      "usesClient": true,
      "clientOnly": true,
      "import": "import { SelectItem } from '@rookcom/monarch-react';",
      "css": ["@rookcom/monarch-tokens/css", "@rookcom/monarch-react/styles/core.css"],
      "docs": "https://monarchui.dev/components/select/",
      "props": [
        { "name": "value", "type": "string", "required": true, "description": "" },
        { "name": "children", "type": "ReactNode", "required": false, "description": "" }
      ]
    },
    {
      "name": "Button",
      "entry": ".",
      "kind": "component",
      "scope": "general",
      "description": "The primary action control.",
      "className": "mn-button",
      "usesClient": true,
      "clientOnly": true,
      "import": "import { Button } from '@rookcom/monarch-react';",
      "css": ["@rookcom/monarch-tokens/css", "@rookcom/monarch-react/styles/core.css"],
      "docs": "https://monarchui.dev/components/button/",
      "props": [
        {
          "name": "variant",
          "type": "ButtonVariant",
          "required": false,
          "description": "Visual weight.",
          "default": "'secondary'",
          "values": ["primary", "secondary"]
        }
      ]
    },
    {
      "name": "AiThread",
      "entry": "./ai",
      "kind": "component",
      "description": "A conversation thread.",
      "clientOnly": false,
      "props": [{ "name": "messages", "type": "AiMessage[]", "required": true, "description": "" }]
    },
    {
      "name": "SignInWithRookButton",
      "entry": "./patterns",
      "kind": "component",
      "scope": "rook",
      "description": "Sign in with Rook ID button.",
      "usesClient": false,
      "clientOnly": false,
      "import": "import { SignInWithRookButton } from '@rookcom/monarch-react/patterns';",
      "css": [
        "@rookcom/monarch-tokens/css",
        "@rookcom/monarch-react/styles/core.css",
        "@rookcom/monarch-react/styles/patterns.css"
      ],
      "props": []
    },
    {
      "name": "SignInForm",
      "entry": "./patterns",
      "kind": "component",
      "scope": "general",
      "description": "Sign in form with providers.",
      "usesClient": false,
      "clientOnly": false,
      "import": "import { SignInForm } from '@rookcom/monarch-react/patterns';",
      "css": [
        "@rookcom/monarch-tokens/css",
        "@rookcom/monarch-react/styles/core.css",
        "@rookcom/monarch-react/styles/patterns.css"
      ],
      "props": []
    },
    {
      "name": "useConfirm",
      "entry": ".",
      "kind": "hook",
      "scope": "general",
      "description": "Asks for confirmation in a themed dialog.",
      "usesClient": true,
      "clientOnly": true,
      "props": []
    }
  ]
}
