{
  "name": "@rookcom/monarch-conformance",
  "version": "0.5.3",
  "description": "Monarch conformance CLI: static design-system checks with safe fixes and SARIF output, an ESLint plugin, component search, starter templates, an MCP server for coding agents and agent instruction templates. No runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RookHQ/monarch.git",
    "directory": "packages/conformance"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "monarch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle-assets.mjs && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "homepage": "https://github.com/RookHQ/monarch/tree/main/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/RookHQ/monarch/issues"
  },
  "keywords": [
    "monarch",
    "design-system",
    "lint",
    "eslint",
    "eslintplugin",
    "conformance",
    "design-system-governance",
    "accessibility",
    "sarif",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Rook Platforms (https://rookhq.com)"
}
