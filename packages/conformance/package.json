{
  "name": "@rookcom/monarch-conformance",
  "version": "0.4.0",
  "description": "Monarch conformance CLI: static design-system checks for raw colours, off-grid spacing and copied components, with SARIF output. No runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RookHQ/monarch.git",
    "directory": "packages/conformance"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "monarch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "homepage": "https://github.com/RookHQ/monarch/tree/main/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/RookHQ/monarch/issues"
  },
  "keywords": [
    "monarch",
    "design-system",
    "lint",
    "conformance",
    "design-system-governance",
    "accessibility",
    "sarif",
    "cli"
  ],
  "author": "Rook Platforms (https://rookhq.com)"
}
