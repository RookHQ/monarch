{
  "name": "@rookcom/monarch-react",
  "version": "0.14.5",
  "description": "Monarch React components: accessible, typed and themeable, with charts, data tables, scheduling, collaboration, an editor and marketing blocks. Server-render safe.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RookHQ/monarch.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./marketing": {
      "types": "./dist/entries/marketing.d.ts",
      "default": "./dist/entries/marketing.js"
    },
    "./scheduling": {
      "types": "./dist/entries/scheduling.d.ts",
      "default": "./dist/entries/scheduling.js"
    },
    "./data": {
      "types": "./dist/entries/data.d.ts",
      "default": "./dist/entries/data.js"
    },
    "./charts": {
      "types": "./dist/entries/charts.d.ts",
      "default": "./dist/entries/charts.js"
    },
    "./collaboration": {
      "types": "./dist/entries/collaboration.d.ts",
      "default": "./dist/entries/collaboration.js"
    },
    "./patterns": {
      "types": "./dist/entries/patterns.d.ts",
      "default": "./dist/entries/patterns.js"
    },
    "./editor": {
      "types": "./dist/entries/editor.d.ts",
      "default": "./dist/entries/editor.js"
    },
    "./shell": {
      "types": "./dist/entries/shell.d.ts",
      "default": "./dist/entries/shell.js"
    },
    "./ai": {
      "types": "./dist/entries/ai.d.ts",
      "default": "./dist/entries/ai.js"
    },
    "./rook": {
      "types": "./dist/entries/rook.d.ts",
      "default": "./dist/entries/rook.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css",
    "./styles/components/*.css": "./dist/styles/components/*.css",
    "./manifest.json": "./dist/manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsx scripts/build-css.ts && tsx scripts/manifest.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@rookcom/monarch-tokens": ">=0.5.3 <1.0.0",
    "@tiptap/core": "^3.30.4",
    "@tiptap/extension-image": "^3.30.4",
    "@tiptap/extension-link": "^3.30.4",
    "@tiptap/extension-list": "^3.30.4",
    "@tiptap/extension-mention": "^3.30.4",
    "@tiptap/extensions": "^3.30.4",
    "@tiptap/pm": "^3.30.4",
    "@tiptap/react": "^3.30.4",
    "@tiptap/starter-kit": "^3.30.4",
    "@tiptap/suggestion": "^3.30.4",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/extension-mention": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8"
  },
  "devDependencies": {
    "@rookcom/monarch-tokens": "0.5.4",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-mention": "3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0"
  },
  "homepage": "https://github.com/RookHQ/monarch/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/RookHQ/monarch/issues"
  },
  "keywords": [
    "monarch",
    "design-system",
    "react",
    "components",
    "ui",
    "accessibility",
    "dark-mode",
    "charts",
    "data-table",
    "ssr"
  ],
  "author": "Rook Platforms (https://rookhq.com)"
}
